_LINT_DATA = glob(
    ["lint/**"],
    exclude = ["lint/rust-check/target/**"],
) + [
    "//:node_modules/@oxlint/plugins",
    "//:node_modules/oxfmt",
    "//:node_modules/oxlint",
    "//:node_modules/typescript",
]

# `bazel run //scripts:lint -- format --check|--write` or `-- lint:js`. It checks the workspace
# it runs from, which may be a host workspace running @kitesurf//scripts:lint, with oxfmt and
# oxlint from Bazel's npm tree. The Rust gates are Bazel tests (`bazel test //:rust_lint`), wired
# per package through //bazel:rust_checks.bzl.
js_binary(
    name = "lint",
    data = _LINT_DATA,
    visibility = ["//visibility:public"],
    entry_point = "lint/run.mjs",
)

js_binary(
    name = "lint_complexity",
    data = _LINT_DATA,
    visibility = ["//visibility:public"],
    entry_point = "lint/complexity.mjs",
)

node_test(
    name = "lint_test",
    args = glob(["lint/*.test.mjs", "lint/*.test.ts"]),
    data = _LINT_DATA + ["//:oxlintrc"],
)

tsc_test(
    name = "lint_types",
    bin = tsc,
    data = _LINT_DATA + ["//:node_modules/@types/node"],
    project = "lint/tsconfig.json",
    project_in_data = True,
)

js_binary(
    name = "workspace_checks",
    data = [
        "check-license-headers.mjs",
        "check-public-imports.mjs",
        "//:node_modules/typescript",
    ],
    entry_point = "workspace-checks.mjs",
)


_PW_RESULTS = ["//tests/pw:%s/results.json" % spec for spec in PW_SPECS]

_PW_GATE_ARGS = [
    "--tests",
    "$(rootpath //:pw_tests)",
    "--expectations",
    "$(rootpath //:pw_expectations)",
] + [
    arg
    for result in _PW_RESULTS
    for arg in ["--results", "$(rootpath %s)" % result]
]

js_test(
    name = "pw_expectations_test",
    size = "small",
    args = _PW_GATE_ARGS,
    data = [
        ":pw_shared",
        ":wpt_shared",
        "//:pw_expectations",
        "//:pw_tests",
    ] + _PW_RESULTS,
    entry_point = "pw-gate.mjs",
    visibility = ["//tests/pw:__pkg__"],
)

js_binary(
    name = "pw_update_expectations",
    args = _PW_GATE_ARGS + ["--update-expectations"],
    data = [
        ":pw_shared",
        ":wpt_shared",
        "//:pw_expectations",
        "//:pw_tests",
    ] + _PW_RESULTS,
    entry_point = "pw-gate.mjs",
    visibility = ["//tests/pw:__pkg__"],
)

_PPTR_RESULTS = ["//tests/pptr:%s/results.json" % spec for spec in PPTR_SPECS]

_PPTR_GATE_ARGS = [
    "--tests",
    "$(rootpath //:pptr_tests)",
    "--expectations",
    "$(rootpath //:pptr_expectations)",
] + [
    arg
    for result in _PPTR_RESULTS
    for arg in ["--results", "$(rootpath %s)" % result]
]

_PPTR_GATE_DATA = [
    ":pptr_shared",
    ":pw_shared",
    ":wpt_shared",
    "//:pptr_expectations",
    "//:pptr_tests",
] + _PPTR_RESULTS

js_test(
    name = "pptr_expectations_test",
    size = "small",
    args = _PPTR_GATE_ARGS,
    data = _PPTR_GATE_DATA,
    entry_point = "pptr-gate.mjs",
    visibility = ["//tests/pptr:__pkg__"],
)

js_binary(
    name = "pptr_update_expectations",
    args = _PPTR_GATE_ARGS + ["--update-expectations"],
    data = _PPTR_GATE_DATA,
    entry_point = "pptr-gate.mjs",
    visibility = ["//tests/pptr:__pkg__"],
)

_E2E_REPORTS = [
    "//packages/engine/test/e2e:%s/report.json" % e2e_shard_name(index + 1)
    for index in range(len(E2E_SHARD_STARTS))
]

js_test(
    name = "e2e_gate_test",
    size = "small",
    args = [arg for report in _E2E_REPORTS for arg in ["--shard", "$(rootpath %s)" % report]],
    data = (
        [":wpt_shared"]
        + _E2E_REPORTS
        + [report.replace("/report.json", "/shard.json") for report in _E2E_REPORTS]
    ),
    entry_point = "e2e-gate.mjs",
    visibility = ["//tests/e2e:__pkg__"],
)

workspace_configs()

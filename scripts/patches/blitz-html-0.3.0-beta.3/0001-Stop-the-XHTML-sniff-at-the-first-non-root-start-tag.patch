From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Thu, 24 Sep 2026 13:14:58 +0100
Subject: [PATCH] Stop the XHTML sniff at the first non-root start tag

parse_into_mutator routed a document starting with <!DOCTYPE to xml5ever
when its first line contained "XHTML" or "xhtml". Minified pages are a
single line, so Google Maps (<!DOCTYPE html>, then a 171 KB inline
script comparing a contentType with "application/xhtml+xml") was parsed
as XML: every void <link>/<meta> swallowed the elements after it and the
script text was painted as page content.

The sniff now reads the first line only up to the first start tag other
than <html>: the doctype, internal subset included, and the root tag's
xmlns still decide, text after them does not. Comments, and quoted
literals inside declarations and the root tag, are text to the window,
so a `<svg>` inside `<!DOCTYPE html><!-- <svg> --><html xmlns=...>`
cannot cut it before the root's xmlns. Across the 817 XHTML documents in
kitesurf's WPT allow-list this routes every one exactly as before; only
the doctype alone would have sent the internal-subset tests
(<!DOCTYPE html [<!--x-->]><html xmlns=...>) to html5ever.
---
 src/html_sink.rs | 43 ++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 42 insertions(+), 1 deletion(-)

diff --git a/src/html_sink.rs b/src/html_sink.rs
index f0a77ba..6196776 100644
--- a/src/html_sink.rs
+++ b/src/html_sink.rs
@@ -64,6 +64,46 @@ impl<'m, 'doc> DocumentHtmlParser<'m, 'doc> {
     }
 }

+/// The doctype sniff reads only the declarations: the doctype and the root tag's xmlns.
+/// A minified page is one line, and "xhtml" in its scripts used to force the XML parser.
+fn prolog_end(line: &str) -> usize {
+    let bytes = line.as_bytes();
+    // Open `<!…>`, `<?…>` and root-tag markup: a `<tag` in their quoted literals, like
+    // one in any comment, is text, and must not end the window before the root's xmlns.
+    let mut depth = 0usize;
+    let mut i = 0;
+    while i < bytes.len() {
+        match bytes[i] {
+            b'<' if bytes[i..].starts_with(b"<!--") => match line[i + 4..].find("-->") {
+                Some(end) => i += 4 + end + 3,
+                None => return bytes.len(),
+            },
+            q @ (b'"' | b'\'') if depth > 0 => match bytes[i + 1..].iter().position(|&c| c == q) {
+                Some(end) => i += end + 2,
+                None => return bytes.len(),
+            },
+            b'<' => {
+                let rest = &bytes[i + 1..];
+                let is_start_tag = rest.first().is_some_and(|c| c.is_ascii_alphabetic());
+                let is_root = rest.len() >= 4 && rest[..4].eq_ignore_ascii_case(b"html");
+                if is_start_tag && !is_root {
+                    return i;
+                }
+                if is_start_tag || matches!(rest.first(), Some(b'!' | b'?')) {
+                    depth += 1;
+                }
+                i += 1;
+            }
+            b'>' => {
+                depth = depth.saturating_sub(1);
+                i += 1;
+            }
+            _ => i += 1,
+        }
+    }
+    bytes.len()
+}
+
 impl<'m, 'doc> DocumentHtmlParser<'m, 'doc> {
     pub fn new(mutr: &'m mut DocumentMutator<'doc>) -> DocumentHtmlParser<'m, 'doc> {
         DocumentHtmlParser {
@@ -92,6 +132,7 @@ impl<'m, 'doc> DocumentHtmlParser<'m, 'doc> {
         let is_xhtml_doc = html.starts_with("<?xml")
             || html.starts_with("<!DOCTYPE") && {
                 let first_line = html.lines().next().unwrap();
-                first_line.contains("XHTML") || first_line.contains("xhtml")
+                let prolog = &first_line[..prolog_end(first_line)];
+                prolog.contains("XHTML") || prolog.contains("xhtml")
             }
             || Self::root_element_has_xhtml_namespace(html);

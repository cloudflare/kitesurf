From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Tue, 15 Sep 2026 21:41:24 +0100
Subject: [PATCH] Honor unresolved anchor fallbacks in Taffy

Use explicit CSS fallbacks when Taffy cannot resolve an anchor. Keep
each property initial value when no fallback is available.
---
 src/convert.rs | 34 +++++++++++++++++++++++++++-------
 1 file changed, 27 insertions(+), 7 deletions(-)

diff --git a/src/convert.rs b/src/convert.rs
index 815d02f..199a500 100644
--- a/src/convert.rs
+++ b/src/convert.rs
@@ -121,7 +121,10 @@ pub fn dimension(val: &stylo::Size) -> taffy::Dimension {

         // Taffy does not resolve anchor-dependent values yet. Keep the CSSOM
         // value in Stylo, but use the property's unresolved auto behavior.
-        stylo::Size::AnchorSizeFunction(_) => taffy::Dimension::AUTO,
+        stylo::Size::AnchorSizeFunction(anchor) => anchor
+            .fallback
+            .as_ref()
+            .map_or(taffy::Dimension::AUTO, dimension),
         stylo::Size::AnchorContainingCalcFunction(_) => taffy::Dimension::AUTO,
     }
 }
@@ -140,7 +143,10 @@ pub fn min_size(val: &stylo::Size) -> taffy::LengthPercentageAuto {
         stylo::Size::Stretch => taffy::LengthPercentageAuto::AUTO,
         stylo::Size::WebkitFillAvailable => taffy::LengthPercentageAuto::AUTO,

-        stylo::Size::AnchorSizeFunction(_) => taffy::LengthPercentageAuto::AUTO,
+        stylo::Size::AnchorSizeFunction(anchor) => anchor
+            .fallback
+            .as_ref()
+            .map_or(taffy::LengthPercentageAuto::AUTO, min_size),
         stylo::Size::AnchorContainingCalcFunction(_) => taffy::LengthPercentageAuto::AUTO,
     }
 }
@@ -159,7 +165,10 @@ pub fn max_size(val: &stylo::MaxSize) -> taffy::LengthPercentageAuto {
         stylo::MaxSize::Stretch => taffy::LengthPercentageAuto::AUTO,
         stylo::MaxSize::WebkitFillAvailable => taffy::LengthPercentageAuto::AUTO,

-        stylo::MaxSize::AnchorSizeFunction(_) => taffy::LengthPercentageAuto::AUTO,
+        stylo::MaxSize::AnchorSizeFunction(anchor) => anchor
+            .fallback
+            .as_ref()
+            .map_or(taffy::LengthPercentageAuto::AUTO, max_size),
         stylo::MaxSize::AnchorContainingCalcFunction(_) => taffy::LengthPercentageAuto::AUTO,
     }
 }
@@ -170,8 +179,13 @@ pub fn margin(val: &stylo::MarginVal) -> taffy::LengthPercentageAuto {
         stylo::MarginVal::Auto => taffy::LengthPercentageAuto::AUTO,
         stylo::MarginVal::LengthPercentage(val) => length_percentage(val).into(),

-        stylo::MarginVal::AnchorSizeFunction(_) => taffy::LengthPercentageAuto::AUTO,
-        stylo::MarginVal::AnchorContainingCalcFunction(_) => taffy::LengthPercentageAuto::AUTO,
+        stylo::MarginVal::AnchorSizeFunction(anchor) => anchor
+            .fallback
+            .as_ref()
+            .map_or(taffy::LengthPercentageAuto::length(0.0), margin),
+        stylo::MarginVal::AnchorContainingCalcFunction(_) => {
+            taffy::LengthPercentageAuto::length(0.0)
+        },
     }
 }

@@ -192,8 +206,14 @@ pub fn inset(val: &stylo::InsetVal) -> taffy::LengthPercentageAuto {
         stylo::InsetVal::Auto => taffy::LengthPercentageAuto::AUTO,
         stylo::InsetVal::LengthPercentage(val) => length_percentage(val).into(),

-        stylo::InsetVal::AnchorSizeFunction(_) => taffy::LengthPercentageAuto::AUTO,
-        stylo::InsetVal::AnchorFunction(_) => taffy::LengthPercentageAuto::AUTO,
+        stylo::InsetVal::AnchorSizeFunction(anchor) => anchor
+            .fallback
+            .as_ref()
+            .map_or(taffy::LengthPercentageAuto::AUTO, inset),
+        stylo::InsetVal::AnchorFunction(anchor) => anchor
+            .fallback
+            .as_ref()
+            .map_or(taffy::LengthPercentageAuto::AUTO, inset),
         stylo::InsetVal::AnchorContainingCalcFunction(_) => taffy::LengthPercentageAuto::AUTO,
     }
 }

+/// A box edge for clipping and filling: a (rounded) rect that backends can recognise, or a
+/// path when `corner-shape` gives a corner a shape a rounded rect cannot express.
+#[derive(Debug, Clone)]
+pub enum BoxShape {
+    Rounded(NonUniformRoundedRect),
+    Shaped(BezPath),
+}
+
+impl From<NonUniformRoundedRect> for BoxShape {
+    fn from(shape: NonUniformRoundedRect) -> Self {
+        Self::Rounded(shape)
+    }
+}
+
+impl From<Rect> for BoxShape {
+    fn from(rect: Rect) -> Self {
+        Self::Rounded(rect.into())
+    }
+}
+
+pub enum BoxShapePathIter<R, P> {
+    Rounded(R),
+    Shaped(P),
+}
+
+impl<R: Iterator<Item = PathEl>, P: Iterator<Item = PathEl>> Iterator for BoxShapePathIter<R, P> {
+    type Item = PathEl;
+
+    fn next(&mut self) -> Option<PathEl> {
+        match self {
+            Self::Rounded(iter) => iter.next(),
+            Self::Shaped(iter) => iter.next(),
+        }
+    }
+}
+
+impl Shape for BoxShape {
+    type PathElementsIter<'iter> = BoxShapePathIter<
+        <NonUniformRoundedRect as Shape>::PathElementsIter<'iter>,
+        <BezPath as Shape>::PathElementsIter<'iter>,
+    >;
+
+    fn path_elements(&self, tolerance: f64) -> Self::PathElementsIter<'_> {
+        match self {
+            Self::Rounded(shape) => BoxShapePathIter::Rounded(shape.path_elements(tolerance)),
+            Self::Shaped(path) => BoxShapePathIter::Shaped(path.path_elements(tolerance)),
+        }
+    }
+
+    fn area(&self) -> f64 {
+        match self {
+            Self::Rounded(shape) => shape.area(),
+            Self::Shaped(path) => path.area(),
+        }
+    }
+
+    fn perimeter(&self, accuracy: f64) -> f64 {
+        match self {
+            Self::Rounded(shape) => shape.perimeter(accuracy),
+            Self::Shaped(path) => path.perimeter(accuracy),
+        }
+    }
+
+    fn winding(&self, pt: Point) -> i32 {
+        match self {
+            Self::Rounded(shape) => shape.winding(pt),
+            Self::Shaped(path) => path.winding(pt),
+        }
+    }
+
+    fn bounding_box(&self) -> Rect {
+        match self {
+            Self::Rounded(shape) => shape.bounding_box(),
+            Self::Shaped(path) => path.bounding_box(),
+        }
+    }
+
+    fn as_rect(&self) -> Option<Rect> {
+        match self {
+            Self::Rounded(shape) => shape.as_rect(),
+            Self::Shaped(_) => None,
+        }
+    }
+
+    fn as_rounded_rect(&self) -> Option<kurbo::RoundedRect> {
+        match self {
+            Self::Rounded(shape) => shape.as_rounded_rect(),
+            Self::Shaped(_) => None,
+        }
+    }
+
+    fn as_path_slice(&self) -> Option<&[PathEl]> {
+        match self {
+            Self::Rounded(shape) => shape.as_path_slice(),
+            Self::Shaped(path) => path.as_path_slice(),
+        }
+    }
 }


From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Fri, 20 Nov 2026 20:09:18 +0000
Subject: [PATCH] Give text-layer scenes each glyph run's source text

When the scene wants glyph text, pass the inline layout's text, the
text control's buffer or the marker string, with the per-glyph byte
ranges from parley, before each draw_glyphs call. Only runs that paint
get text: hidden, zero-size and fully transparent runs draw no glyphs,
and the background-clip text mask passes no text.

Signed-off-by: Rui Figueira <rfigueira@cloudflare.com>
---
 src/render.rs |  9 +++++++++
 src/text.rs   | 29 ++++++++++++++++++++++++-----
 2 files changed, 33 insertions(+), 5 deletions(-)

diff --git a/src/render.rs b/src/render.rs
index fd07af6..eae6348 100644
--- a/src/render.rs
+++ b/src/render.rs
@@ -542,6 +542,7 @@ impl<'dom, 'a> BlitzDomPainter<'dom, 'a> {
                     node.id(),
                     &mut self.draw_text_context.borrow_mut(),
                     None,
+                    None,
                 );
             }
         }
@@ -1277,6 +1278,7 @@ impl ElementCx<'_, '_> {
                 node_id,
                 &mut draw_text_context,
                 None,
+                Some(text_layout.text(self.context.dom.tree())),
             );

             crate::text_box_decorations::paint_span_fragment_borders(
@@ -1361,6 +1363,7 @@ impl ElementCx<'_, '_> {
                 self.node.id(),
                 &mut draw_text_context,
                 fill_override,
+                Some(input_data.editor.raw_text()),
             );
         }
     }
@@ -1386,6 +1389,11 @@ impl ElementCx<'_, '_> {
         let transform =
             self.transform * Affine::translate((pos.x * self.scale, pos.y * self.scale));

+        let mut buf = [0u8; 4];
+        let marker_text = match &list_item.marker {
+            Marker::Char(char) => &*char.encode_utf8(&mut buf),
+            Marker::String(str) => str.as_str(),
+        };
         let mut draw_text_context = self.context.draw_text_context.borrow_mut();
         crate::text::stroke_text(
             scene,
@@ -1399,6 +1407,7 @@ impl ElementCx<'_, '_> {
             self.node.id(),
             &mut draw_text_context,
             None,
+            Some(marker_text),
         );
     }

diff --git a/src/text.rs b/src/text.rs
index 6b466f0..9e005e9 100644
--- a/src/text.rs
+++ b/src/text.rs
@@ -32,6 +32,7 @@ pub(crate) struct DrawTextContext {
     deco_boxes: Vec<LineDecoration>,
     run_records: Vec<RunRecord>,
     win_ascent_ratios: WinAscentCache,
+    glyph_text_ranges: Vec<std::ops::Range<usize>>,
 }

 #[derive(Clone, Copy)]
@@ -71,6 +72,7 @@ pub(crate) fn stroke_text<'a>(
     inline_root_id: NodeId,
     context: &mut DrawTextContext,
     fill_override: Option<Color>,
+    text: Option<&str>,
 ) {
     let TextPaintOptions {
         scale,
@@ -82,7 +84,10 @@ pub(crate) fn stroke_text<'a>(
         deco_boxes,
         run_records,
         win_ascent_ratios,
+        glyph_text_ranges,
     } = context;
+    // The text the layout was shaped from, for scenes with a text layer.
+    let text = text.filter(|_| scene.wants_glyph_text());
     stack.clear();
     path_scratch.clear();
     deco_boxes.clear();
@@ -288,6 +293,15 @@ pub(crate) fn stroke_text<'a>(

         // Pass 3: the glyphs themselves.
         for (glyph_run, record) in glyph_runs(&line).zip(run_records.iter()) {
+            if let Some(text) = text
+                && glyph_run_paints(&glyph_run, record.fill_color)
+            {
+                glyph_text_ranges.clear();
+                glyph_run.glyph_text_ranges(glyph_text_ranges);
+                if glyph_text_ranges.iter().all(|range| text.get(range.clone()).is_some()) {
+                    scene.glyph_text(text, glyph_text_ranges);
+                }
+            }
             draw_glyph_run(scene, &glyph_run, record.fill_color, transform);
         }

@@ -327,6 +341,13 @@ pub(crate) fn glyph_runs<'a, 'b>(
     })
 }

+/// Whether [`draw_glyph_run`] draws anything for this run and colour. Zero-size text is
+/// invisible, but hinting can give its glyphs ink. Fully transparent text is skipped too:
+/// backends draw color (emoji) glyphs opaque.
+fn glyph_run_paints(glyph_run: &GlyphRun<'_, TextBrush>, color: Color) -> bool {
+    glyph_run.run().font_size() > 0.0 && color.components[3] > 0.0
+}
+
 /// Draw a glyph run's glyphs in a single colour.
 pub(crate) fn draw_glyph_run(
     scene: &mut impl PaintScene,
@@ -334,13 +355,11 @@ pub(crate) fn draw_glyph_run(
     color: Color,
     transform: Affine,
 ) {
-    let run = glyph_run.run();
-    let font_size = run.font_size();
-    // Zero-size text is invisible, but hinting can give its glyphs ink. Fully
-    // transparent text is skipped too: backends draw color (emoji) glyphs opaque.
-    if font_size <= 0.0 || color.components[3] <= 0.0 {
+    if !glyph_run_paints(glyph_run, color) {
         return;
     }
+    let run = glyph_run.run();
+    let font_size = run.font_size();
     let glyph_xform = run
         .synthesis()
         .skew()

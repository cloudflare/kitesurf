diff --git a/src/text_decorations.rs b/src/text_decorations.rs
index b9179e0..6e0dd55 100644
--- a/src/text_decorations.rs
+++ b/src/text_decorations.rs
@@ -120,6 +120,37 @@ pub(crate) struct DecorationStackEntry {
     /// Shared (via `Arc`) with the per-run records and decorating boxes so that
     /// consecutive runs with the same shadow can be batched by pointer equality.
     pub(crate) text_shadows: Option<Arc<[ResolvedTextShadow]>>,
+    /// `opacity` of this node times every inline ancestor's, up to
+    /// but excluding the inline root. The root's own opacity is a paint
+    /// layer in render.rs, but a non-atomic inline box paints no layer of its
+    /// own, so its opacity has to reach its glyphs and decorations here.
+    pub(crate) opacity: f32,
+}
+
+impl DecorationStackEntry {
+    /// Fade the decoration and text shadows by [`Self::opacity`]. Without it
+    /// `<span style="opacity:0">` paints fully opaque. Multiplying per run matches
+    /// group opacity everywhere except where glyphs of one span overlap.
+    pub(crate) fn apply_opacity(&mut self) {
+        if self.opacity >= 1.0 {
+            return;
+        }
+        let opacity = self.opacity;
+        if let Some(deco) = self.decoration.as_mut() {
+            deco.color = deco.color.multiply_alpha(opacity);
+        }
+        if let Some(shadows) = &self.text_shadows {
+            self.text_shadows = Some(
+                shadows
+                    .iter()
+                    .map(|shadow| ResolvedTextShadow {
+                        color: shadow.color.multiply_alpha(opacity),
+                        ..*shadow
+                    })
+                    .collect(),
+            );
+        }
+    }
 }

 /// One `text-shadow` layer with all lengths resolved to device pixels.
@@ -150,6 +181,7 @@ pub(crate) fn resolve_decoration_entry(
             fill_color: Color::BLACK,
             decoration: None,
             text_shadows: None,
+            opacity: 1.0,
         };
     };

@@ -228,5 +260,6 @@ pub(crate) fn resolve_decoration_entry(
         fill_color,
         decoration,
         text_shadows,
+        opacity: styles.get_effects().opacity,
     }
 }

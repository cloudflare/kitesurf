diff --git a/src/text.rs b/src/text.rs
index 7dc27fa..22812fc 100644
--- a/src/text.rs
+++ b/src/text.rs
@@ -37,6 +37,21 @@ pub(crate) struct TextPaintOptions {
     pub brush_override: Option<Color>,
 }

+/// The combined `opacity` of `node_id` and its inline ancestors, excluding
+/// `inline_root_id` (see `DecorationStackEntry::opacity`).
+pub(crate) fn inline_opacity(doc: &BaseDocument, node_id: NodeId, inline_root_id: NodeId) -> f32 {
+    let mut opacity = 1.0;
+    let mut walk_id = Some(node_id);
+    while let Some(id) = walk_id.filter(|&id| id != inline_root_id) {
+        let Some(node) = doc.get_node(id) else { break };
+        if let Some(styles) = node.primary_styles() {
+            opacity *= styles.get_effects().opacity;
+        }
+        walk_id = node.parent;
+    }
+    opacity
+}
+
 pub(crate) fn stroke_text<'a>(
     scene: &mut impl PaintScene,
     lines: impl Iterator<Item = Line<'a, TextBrush>>,
@@ -117,7 +132,13 @@ pub(crate) fn stroke_text<'a>(
                 .count();
             stack.truncate(shared);
             for &node_id in &path_scratch[shared..] {
-                let entry = resolve_decoration_entry(doc, node_id, stack.last(), scale);
+                let mut entry = resolve_decoration_entry(doc, node_id, stack.last(), scale);
+                entry.opacity = match stack.last() {
+                    _ if node_id == inline_root_id => 1.0,
+                    Some(parent) => parent.opacity * entry.opacity,
+                    None => entry.opacity,
+                };
+                entry.apply_opacity();
                 stack.push(entry);
             }

@@ -127,7 +148,7 @@ pub(crate) fn stroke_text<'a>(
             // they are dropped when the brush is overridden.
             let (fill_color, shadows) = stack
                 .last()
-                .map(|e| (e.fill_color, e.text_shadows.clone()))
+                .map(|e| (e.fill_color.multiply_alpha(e.opacity), e.text_shadows.clone()))
                 .unwrap_or((Color::BLACK, None));
             let fill_color = brush_override.unwrap_or(fill_color).multiply_alpha(alpha);
             let shadows = shadows.filter(|_| brush_override.is_none());

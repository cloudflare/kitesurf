+/// Where the segment `a` crosses the line through `b`, or else the line through `a` crosses
+/// the segment `b`.
+fn segment_line_intersection((a0, a1): (Point, Point), (b0, b1): (Point, Point)) -> Option<Point> {
+    let (a, b) = (a1 - a0, b1 - b0);
+    let denom = a.cross(b);
+    if denom.abs() < 1e-6 {
+        return None;
+    }
+    let a_scale = (b0 - a0).cross(b) / denom;
+    if (0.0..=1.0).contains(&a_scale) {
+        return Some(a0 + a * a_scale);
+    }
+    let b_scale = (b0 - a0).cross(a) / denom;
+    (0.0..=1.0).contains(&b_scale).then(|| b0 + b * b_scale)
+}

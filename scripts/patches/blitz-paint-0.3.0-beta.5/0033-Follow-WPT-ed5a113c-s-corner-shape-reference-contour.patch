+/// The reference cuts each corner out of the moved rect with an evenodd clip, so whatever a
+/// corner's points push past the rect's edges is dropped: each segment is split where it
+/// crosses an edge and the outside points are pulled onto the edge.
+fn clip_to(target: Rect, points: &[Point]) -> Vec<Point> {
+    let clamp = |p: Point| {
+        Point::new(
+            p.x.clamp(target.x0, target.x1),
+            p.y.clamp(target.y0, target.y1),
+        )
+    };
+    let mut clipped = Vec::with_capacity(points.len());
+    for (i, &p) in points.iter().enumerate() {
+        clipped.push(clamp(p));
+        let Some(&q) = points.get(i + 1) else {
+            break;
+        };
+        let d = q - p;
+        let mut crossings: Vec<f64> = [
+            (p.x, d.x, target.x0),
+            (p.x, d.x, target.x1),
+            (p.y, d.y, target.y0),
+            (p.y, d.y, target.y1),
+        ]
+        .into_iter()
+        .filter(|&(_, delta, _)| delta != 0.0)
+        .map(|(from, delta, edge)| (edge - from) / delta)
+        .filter(|t| *t > 0.0 && *t < 1.0)
+        .collect();
+        crossings.sort_by(f64::total_cmp);
+        clipped.extend(crossings.into_iter().map(|t| clamp(p + d * t)));
+    }
+    clipped
+}

+/// How far a corner's contour moves for an inset along one radius: the inset itself, except
+/// that an outset smaller than the radius grows it less, by the shadow spread's formula.
+fn adjusted_inset(coverage: f64, radius: f64, inset: f64) -> f64 {
+    let outset = -inset;
+    if radius > outset || coverage > 1.0 {
+        return inset;
     }
+    let ratio = radius / outset;
+    -outset * (1.0 - (1.0 - ratio).powi(3) * (1.0 - coverage.powi(3)))
+}
+
+/// The x (or y) coordinate of the half point along a unit `superellipse(k)`.
+fn normalized_half_corner(k: f64) -> f64 {
+    let convex = 0.5f64.powf(1.0 / 2f64.powf(k.abs()));
+    if k < 0.0 { 1.0 - convex } else { convex }
 }


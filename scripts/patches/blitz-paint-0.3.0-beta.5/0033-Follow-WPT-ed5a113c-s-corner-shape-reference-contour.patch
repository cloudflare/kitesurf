+        for ((rx, ry, k, left, top), [first, on_curve, last]) in cases {
+            let corner = Corner {
+                towards_start: Vec2::new(0.0, ry),
+                towards_end: Vec2::new(rx, 0.0),
+                k,
+                start_inset: left,
+                end_inset: top,
+                sharp: Point::new(left, top),
+                coverage: 2.0 * (rx / 200.0f64).min(ry / 100.0),
+            };
+            let mut points = Vec::new();
+            corner.push_points(&mut points);
+            let close = |a: Point, b: (f64, f64)| a.distance(Point::new(b.0, b.1)) < 1e-9;
+            assert!(close(points[0], first), "k={k}: {:?}", points[0]);
+            assert!(close(*points.last().unwrap(), last), "k={k}: {points:?}");
+            let target = Point::new(on_curve.0, on_curve.1);
+            let distance = points
+                .windows(2)
+                .map(|w| {
+                    kurbo::Line::new(w[0], w[1])
+                        .nearest(target, 1e-9)
+                        .distance_sq

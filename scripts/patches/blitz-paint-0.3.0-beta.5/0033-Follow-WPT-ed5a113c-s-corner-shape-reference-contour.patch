+                    (-15.0, 28.79472070570987),
+                    (14.218761586851244, 13.865428329015149),
+                    (28.79472070570987, -15.0),
+                ],
+            ),
+            // superellipse(-0.5), 10px by 30px radii grown by less than the 15px spread.
+            (
+                (10.0, 30.0, -0.5, -15.0, -15.0),
+                [
+                    (-15.0, 23.671504964983324),
+                    (-7.712252458713875, 12.497225212959547),
+                    (-4.200090270196445, -15.0),

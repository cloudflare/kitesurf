@@ -915,7 +1005,34 @@ mod box_shadow_tests {
             );
             let center = (50 * 100 + 50) * 4;
             assert_eq!(&buffer[center..center + 4], &[255, 255, 255, 255]);
+            // 3.5px inside the shadow's edge, a Gaussian of deviation 2 lets 1 - Φ(1.75), about

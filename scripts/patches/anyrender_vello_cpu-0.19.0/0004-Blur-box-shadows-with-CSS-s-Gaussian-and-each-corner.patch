+
+    #[test]
+    fn blurred_corner_quadrants_meet_without_a_seam() {
+        // The quadrants split at y = 74.5, between rows 74 and 75.
+        let radii = NonUniformRoundedRectRadii {
+            top_left: Vec2::new(8.0, 8.0),
+            top_right: Vec2::new(8.0, 8.0),
+            bottom_right: Vec2::ZERO,
+            bottom_left: Vec2::ZERO,
+        };
+        let shape = NonUniformRoundedRect::new(Rect::new(20.0, 20.0, 120.0, 121.0), radii);
+        let buffer = render_to_buffer::<VelloCpuImageRenderer, _>(
+            |scene| {
+                let kind = BoxShadowKind::Outset;
+                scene.draw_box_shadow(Affine::IDENTITY, &shape, Vec2::ZERO, 0.0, 4.0, RED, kind);
+            },
+            140,
+            140,
+        );
+        let alpha = |x: usize, y: usize| i32::from(buffer[(y * 140 + x) * 4 + 3]);
+        for x in [19, 120] {
+            let rows = [alpha(x, 73), alpha(x, 74), alpha(x, 75)];
+            assert!(rows.iter().all(|a| (a - rows[0]).abs() <= 1), "x={x}: {rows:?}");
         }
     }

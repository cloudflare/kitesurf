From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bernardo Pereira <bpereira@cloudflare.com>
Date: Tue, 24 Nov 2026 14:41:34 +0000
Subject: [PATCH] Forward backdrop_filter to vello_cpu
 RenderContext::push_backdrop_filter

---
 src/filters.rs |  4 ++--
 src/scene.rs   | 20 ++++++++++++++++++--
 2 files changed, 20 insertions(+), 4 deletions(-)

diff --git a/src/filters.rs b/src/filters.rs
index a0f5b95..4b52412 100644
--- a/src/filters.rs
+++ b/src/filters.rs
@@ -24,13 +24,13 @@ pub(crate) fn convert_filter_effect(effect: &FilterEffect) -> Option<FilterPrimi
     Some(match effect {
         FilterEffect::Flood(color) => FilterPrimitive::Flood { color: *color },
         FilterEffect::GaussianBlur(blur) => FilterPrimitive::GaussianBlur {
-            std_deviation: blur.std_deviation,
+            std_deviation: blur.std_deviation.clamp(0.0, 256.0),
             edge_mode: convert_edge_mode(blur.edge_mode),
         },
         FilterEffect::DropShadow(shadow) => FilterPrimitive::DropShadow {
             dx: shadow.dx,
             dy: shadow.dy,
-            std_deviation: shadow.std_deviation,
+            std_deviation: shadow.std_deviation.clamp(0.0, 256.0),
             color: shadow.color,
             edge_mode: convert_edge_mode(shadow.edge_mode),
         },
diff --git a/src/scene.rs b/src/scene.rs
index 9866334..101f02a 100644
--- a/src/scene.rs
+++ b/src/scene.rs
@@ -78,7 +78,7 @@ impl PaintScene for VelloCpuScenePainter {
         transform: Affine,
         clip: &impl Shape,
         filter: Option<Arc<Filter>>,
-        _backdrop_filter: Option<Arc<Filter>>,
+        backdrop_filter: Option<Arc<Filter>>,
     ) {
         #[cfg(feature = "filters")]
         let filter = filter
@@ -91,10 +91,26 @@ impl PaintScene for VelloCpuScenePainter {
             None
         };

+        #[cfg(feature = "filters")]
+        let backdrop_filter = backdrop_filter
+            .and_then(crate::filters::convert_filter)
+            .filter(|_| cfg!(not(feature = "multithreading")));
+
+        #[cfg(not(feature = "filters"))]
+        let backdrop_filter = {
+            let _ = backdrop_filter;
+            None
+        };
+
+        let clip_path = clip.into_path(DEFAULT_TOLERANCE);
         self.render_ctx.set_transform(transform);
         self.render_ctx.set_fill_rule(fill);
+        if let Some(bf) = backdrop_filter {
+            self.render_ctx
+                .push_backdrop_filter(&clip_path, Some(alpha), bf);
+        }
         self.render_ctx.push_layer(
-            Some(&clip.into_path(DEFAULT_TOLERANCE)),
+            Some(&clip_path),
             Some(blend.into()),
             Some(alpha),
             None,

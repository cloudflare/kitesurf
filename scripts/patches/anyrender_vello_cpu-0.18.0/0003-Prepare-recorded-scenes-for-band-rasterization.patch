From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Tue, 3 Nov 2026 08:56:49 +0000
Subject: [PATCH] Prepare recorded scenes for band rasterization

Keep the scene and its image and glyph resources together for the duration of a banded capture.

Signed-off-by: bpereira <bpereira@cloudflare.com>
---
 src/image_renderer.rs | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/src/image_renderer.rs b/src/image_renderer.rs
index 619d5d4..aefda26 100644
--- a/src/image_renderer.rs
+++ b/src/image_renderer.rs
@@ -1,7 +1,7 @@
 use crate::{ImageCacheConfig, VelloCpuScenePainter};
 use anyrender::{ImageRenderer, RenderContext as AnyRenderContext};
 use debug_timer::debug_timer;
-use vello_cpu::{PixmapMut, RenderContext};
+use vello_cpu::{PixmapMut, PreparedRender, RenderContext, RenderMode};

 pub struct VelloCpuImageRenderer {
     scene: VelloCpuScenePainter,
@@ -23,6 +23,16 @@ impl VelloCpuImageRenderer {
     pub fn clear_image_cache(&mut self) {
         self.scene.clear_image_cache();
     }
+
+    /// Record one scene and retain its resources while rendering regions of it.
+    pub fn prepare<F: FnOnce(&mut VelloCpuScenePainter)>(mut self, draw_fn: F) -> PreparedRender {
+        draw_fn(&mut self.scene);
+        PreparedRender::new(
+            self.scene.render_ctx,
+            self.scene.resources,
+            RenderMode::OptimizeSpeed,
+        )
+    }
 }

 impl AnyRenderContext for VelloCpuImageRenderer {}

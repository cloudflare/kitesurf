+
+/// Collects straight into the list, without a `Vec` to copy from first. One attribute goes
+/// inline, so the common case allocates nothing beyond its pool slot.
+impl FromIterator<Attribute> for Attributes {
+    fn from_iter<I: IntoIterator<Item = Attribute>>(iter: I) -> Self {
+        let mut iter = iter.into_iter();
+        let Some(first) = iter.next() else {
+            return Self::default();
+        };
+        let Some(second) = iter.next() else {
+            return Self::one(first);
+        };
+        let mut vec = ThinVec::with_capacity(iter.size_hint().0.saturating_add(2));
+        vec.push(first);
+        vec.push(second);
+        vec.extend(iter);
+        Self::many(vec)
     }
 }


+}
+
+impl Drop for Attributes {
+    fn drop(&mut self) {
+        match self.inline() {
+            // SAFETY: the pointer came from `into_raw` and is owned here, dropped exactly once.
+            Some(ptr) => drop(unsafe { PoolBox::from_raw(ptr) }),
+            // SAFETY: a clear low bit means the `ThinVec` variant, dropped exactly once here.
+            None => unsafe { ManuallyDrop::drop(&mut self.repr.many) },
+        }
+    }
+}
+
+impl Clone for Attributes {
+    fn clone(&self) -> Self {
+        match self.inline() {
+            // SAFETY: the box owns a live value.
+            Some(ptr) => Self::one(unsafe { ptr.as_ref() }.clone()),
+            // SAFETY: a clear low bit means the `ThinVec` variant.
+            None => Self::many(ThinVec::clone(unsafe { &self.repr.many })),
+        }
+    }
+}
+
+impl Default for Attributes {
+    fn default() -> Self {
+        Self::many(ThinVec::new())
+    }
+}
+
+impl std::fmt::Debug for Attributes {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("Attributes")
+            .field("inner", &self.as_slice())
+            .finish()
+    }
+}

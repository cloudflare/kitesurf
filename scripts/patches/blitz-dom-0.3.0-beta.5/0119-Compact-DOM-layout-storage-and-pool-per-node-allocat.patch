+/// Whether `elem` can produce any presentational hints, checked when attributes change so
+/// elements without hint attributes skip allocating `ElementRare` and scanning on restyle.
+pub(crate) fn may_have_hints(elem: &ElementData) -> bool {
+    let tag = &elem.name.local;
+    if *tag == local_name!("bdi") {
+        return true;
+    }
+    #[cfg(feature = "svg")]
+    let is_svg = *elem.namespace() == ns!(svg);
+    elem.attrs().iter().any(|attr| {
+        let name = &attr.name.local;
+        #[cfg(feature = "svg")]
+        if is_svg && *attr.namespace() == ns!() {
+            if super::svg_attrs::is_presentation_attribute(tag, name)
+                || (*tag == local_name!("svg")
+                    && matches_tag!(name, "width" | "height" | "transform"))
+            {
+                return true;
+            }
+        }
+        matches_tag!(
+            name,
+            "lang"
+                | "align"
+                | "valign"
+                | "width"
+                | "height"
+                | "hspace"
+                | "vspace"
+                | "color"
+                | "size"
+                | "face"
+                | "border"
+                | "cellspacing"
+                | "cellpadding"
+                | "bgcolor"
+                | "hidden"
+                | "dir"
+        ) || (*tag == local_name!("body")
+            && matches!(
+                &**name,
+                "marginwidth" | "marginheight" | "leftmargin" | "topmargin"
+            ))
+    })
+}

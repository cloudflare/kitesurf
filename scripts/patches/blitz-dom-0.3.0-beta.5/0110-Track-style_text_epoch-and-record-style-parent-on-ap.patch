From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Fri, 20 Nov 2026 07:13:14 +0000
Subject: [PATCH] Track style_text_epoch and record style parent on
 append_text_to_node

Add BaseDocument::style_text_epoch bumped whenever a style element or its children change, and damage/record the parent element in append_text_to_node to match set_node_text.
---
 src/document.rs | 25 +++++++++++++++++++++++++
 src/mutator.rs  | 18 ++++++++++++------
 2 files changed, 37 insertions(+), 6 deletions(-)

diff --git a/src/document.rs b/src/document.rs
index 2520453..eb39c5b 100644
--- a/src/document.rs
+++ b/src/document.rs
@@ -691,6 +691,8 @@ pub struct BaseDocument {
     pub(crate) linked_stylesheet_urls: BTreeMap<NodeId, String>,
     /// The `base_epoch` that `document_base_url` was last derived at.
     pub(crate) synced_base_epoch: u32,
+    /// Bumped whenever a `<style>` element's text or child list changes.
+    pub style_text_epoch: u32,

     /// Tracks in-flight image requests. When an image is being fetched, additional
     /// requests for the same URL are queued here instead of starting new fetches.
@@ -927,6 +929,7 @@ impl BaseDocument {
             connected_bases: BTreeSet::new(),
             linked_stylesheet_urls: BTreeMap::new(),
             synced_base_epoch: 0,
+            style_text_epoch: 0,
             pending_images: HashMap::new(),
             pending_style_image_nodes: Vec::new(),
             pending_critical_resources: HashSet::new(),
@@ -5267,6 +5270,28 @@ mod codepoint_probe_tests {
         assert!(doc.text_uses_codepoints(cjk));
         assert!(!doc.text_uses_codepoints(cyrillic));
     }
+
+    #[test]
+    fn appending_style_text_advances_style_text_epoch() {
+        use crate::qual_name;
+
+        let mut doc = BaseDocument::new(DocumentConfig::default());
+        let root_id = doc.root_node().id();
+        let style_id = doc.mutate().create_element(qual_name!("style"), Vec::new());
+        let style_text = doc.mutate().create_text_node(".a { color: red; }");
+        doc.mutate().append_children(style_id, &[style_text]);
+        doc.mutate().append_children(root_id, &[style_id]);
+
+        let epoch_after_attach = doc.style_text_epoch;
+        let div_id = doc.mutate().create_element(qual_name!("div"), Vec::new());
+        doc.mutate().append_children(root_id, &[div_id]);
+        assert_eq!(doc.style_text_epoch, epoch_after_attach);
+
+        doc.mutate()
+            .append_text_to_node(style_text, "\n.b { color: blue; }")
+            .expect("style text node");
+        assert_ne!(doc.style_text_epoch, epoch_after_attach);
+    }
 }

 #[cfg(test)]

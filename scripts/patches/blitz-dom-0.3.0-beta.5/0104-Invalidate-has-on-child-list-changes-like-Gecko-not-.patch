+    /// Restyle an in-document element a child was removed from at `index`. Slots, shadow hosts
+    /// and dir=auto restyle the whole parent, as an insertion does; anything else goes through
+    /// `restyle_for_child_list_change`.
+    fn restyle_for_removal(&mut self, parent_id: NodeId, index: usize) {
+        if insertion_restyles_whole_parent(&self.doc.nodes[parent_id]) {
+            self.restyle_whole_parent(parent_id);
+        } else {
+            self.restyle_for_child_list_change(parent_id, index..index);
+        }
+    }
+
+    /// Recascade the parent's whole subtree, and the `:has()` anchors outside it that read its
+    /// children's positions.
+    fn restyle_whole_parent(&mut self, parent_id: NodeId) {
+        let parent = &mut self.doc.nodes[parent_id];
+        if let Some(mut data) = parent
+            .try_stylo_element_data_mut()
+            .and_then(|s| s.get_mut())
+        {
+            data.hint |= RestyleHint::restyle_subtree();
+        }
+        parent.set_dirty_descendants();
+        // Mark ancestors dirty so the style traversal visits this subtree.
+        parent.mark_ancestors_dirty();
+        self.invalidate_structural_has_for_whole_parent(parent_id);
+    }
+
+    /// The `:has()` half of Gecko's `RestyleWholeContainer` and `RestyleForEmptyChange`: an anchor
+    /// that reads the parent's `:empty` or a child's position sits outside the parent's subtree,
+    /// so the parent's own restyle cannot reach it.
+    fn invalidate_structural_has_for_whole_parent(&self, parent_id: NodeId) {
+        let parent = &self.doc.nodes[parent_id];
+        // Shadow roots and fragments hold no selector flags.
+        if !parent.is_element() {
+            return;
+        }
+        let flags = parent.selector_flags().get();
+        if flags.contains(ElementSelectorFlags::HAS_EMPTY_SELECTOR) {
+            let empty = TSStateForInvalidation::EMPTY;
+            self.doc.invalidate_relative_selector_ts_dependency(parent_id, empty);
+        }
+        if !flags.intersects(NTH_FLAGS | ElementSelectorFlags::HAS_EDGE_CHILD_SELECTOR) {
+            return;
+        }
+        let positions = TSStateForInvalidation::NTH
+            | TSStateForInvalidation::NTH_EDGE_FIRST
+            | TSStateForInvalidation::NTH_EDGE_LAST;
+        for id in parent.children().iter() {
+            if self.doc.nodes[id].is_element() {
+                self.doc.invalidate_relative_selector_ts_dependency(id, positions);
+            }
+        }
+    }

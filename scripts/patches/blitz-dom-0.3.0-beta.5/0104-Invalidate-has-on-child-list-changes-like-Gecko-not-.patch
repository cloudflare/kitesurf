+    /// Gecko's side-effect pass for the two elements on either side of an inserted or removed
+    /// one: `.a:has(+ .b)` can gain or lose its match through a node that is neither `.a` nor `.b`.
+    /// The traversal maps make each side see the other as adjacent, as if the node were absent.
+    fn invalidate_relative_selectors_for_sibling_side_effects<'a>(
+        &'a self,
+        prev: BlitzNode<'a>,
+        next: BlitzNode<'a>,
+    ) {
+        use selectors::Element as _;
+
+        let prev_map = SiblingTraversalMap::new(prev, prev.prev_sibling_element(), Some(next));
+        self.mutation_invalidator(prev, prev_map)
+            .invalidate_relative_selectors_for_dom_mutation(
+                false,
+                &self.stylist,
+                ElementSelectorFlags::empty(),
+                DomMutationOperation::SideEffectPrevSibling,
+            );
+        let next_map = SiblingTraversalMap::new(next, Some(prev), next.next_sibling_element());
+        self.mutation_invalidator(next, next_map)
+            .invalidate_relative_selectors_for_dom_mutation(
+                false,
+                &self.stylist,
+                ElementSelectorFlags::empty(),
+                DomMutationOperation::SideEffectNextSibling,
+            );
+    }
+
+    /// Gecko's `MaybeInvalidateRelativeSelectorForRemoval`. Runs before the node is unlinked: the
+    /// collector reads its live parent and siblings.
     pub(crate) fn invalidate_relative_selectors_for_removal(&self, node_id: NodeId) {
-        self.invalidate_relative_selectors_for_dom_mutation(node_id, DomMutationOperation::Remove);
+        use selectors::Element as _;
+
+        let Some(element) = self.relative_selector_mutation_target(node_id) else {
+            return;
+        };
+        // An element that no `:has()` search reached cannot change any anchor's match.
+        let search_direction = element.relative_selector_search_direction();
+        if search_direction.is_empty() {
+            return;
+        }
+        let (prev, next) = (element.prev_sibling_element(), element.next_sibling_element());
+        let inherited = inherited_search_direction(element);
+        if inherited.is_empty() {
+            return;
+        }
+        // The removed element may be the one a search stopped at; the next one continues it.
+        if let Some(next) = next {
+            next.apply_selector_flags(search_direction);
+        }
+        if let (Some(prev), Some(next)) = (prev, next) {
+            self.invalidate_relative_selectors_for_sibling_side_effects(prev, next);
+        }
+        // `subtree`: the node may carry a whole subtree containing the
+        // subject, and upstream still gates the walk on the map's own flag.
+        self.mutation_invalidator(element, SiblingTraversalMap::default())
+            .invalidate_relative_selectors_for_dom_mutation(
+                true,
+                &self.stylist,
+                inherited,
+                DomMutationOperation::Remove,
+            );
     }

+    /// Gecko's `MaybeInvalidateRelativeSelectorForInsertion`. Runs after the node is linked.
     pub(crate) fn invalidate_relative_selectors_for_insertion(&self, node_id: NodeId) {
+        use selectors::Element as _;
+
+        let Some(element) = self.relative_selector_mutation_target(node_id) else {
+            return;
+        };
+        let inherited = inherited_search_direction(element);
+        if inherited.is_empty() {
+            return;
+        }
+        let siblings = (element.prev_sibling_element(), element.next_sibling_element());
+        if let (Some(prev), Some(next)) = siblings {
+            if prev
+                .relative_selector_search_direction()
+                .intersects(ElementSelectorFlags::RELATIVE_SELECTOR_SEARCH_DIRECTION_SIBLING)
+            {
+                element.apply_selector_flags(
+                    ElementSelectorFlags::RELATIVE_SELECTOR_SEARCH_DIRECTION_SIBLING,
+                );
+                self.invalidate_relative_selectors_for_sibling_side_effects(prev, next);
+            }
+        }
         // `Append` only unlocks an optimization that assumes a later sibling
         // can take over the match, so `Insert` is the conservative choice.
-        self.invalidate_relative_selectors_for_dom_mutation(node_id, DomMutationOperation::Insert);
+        self.mutation_invalidator(element, SiblingTraversalMap::default())
+            .invalidate_relative_selectors_for_dom_mutation(
+                true,
+                &self.stylist,
+                inherited,
+                DomMutationOperation::Insert,
+            );
     }
+
+    /// Gecko's `invalidate_relative_selector_ts_dependency`: re-match the anchors whose `:has()`
+    /// reads `node_id`'s `:empty`, `:nth-*` or edge-child state, which a child-list change altered
+    /// without touching the node itself.
+    pub(crate) fn invalidate_relative_selector_ts_dependency(
+        &self,
+        node_id: NodeId,
+        state: TSStateForInvalidation,
+    ) {
+        let Some(element) = self.relative_selector_mutation_target(node_id) else {
+            return;
+        };
+        self.mutation_invalidator(element, SiblingTraversalMap::default())
+            .invalidate_relative_selectors_for_this(
+                &self.stylist,
+                |element, scope, data, quirks_mode, collector| {
+                    data.relative_invalidation_map_attributes()
+                        .ts_state_to_selector
+                        .lookup_with_additional(
+                            *element,
+                            quirks_mode,
+                            None,
+                            &[],
+                            ElementState::empty(),
+                            |dependency| {
+                                if dependency.state.intersects(state) {
+                                    collector.add_dependency(&dependency.dep, *element, scope);
+                                }
+                                true
+                            },
+                        );
+                },
+            );
+    }
+}
+
+/// Gecko's `inherit_relative_selector_search_direction`: a mutated element continues the `:has()`
+/// searches that reached its parent downward and its previous sibling sideways, including
+/// `:has(~ .a .b)`, which runs through the sibling's subtree.
+fn inherited_search_direction(element: BlitzNode<'_>) -> ElementSelectorFlags {
+    use selectors::Element as _;
+
+    let direction = |e: Option<BlitzNode<'_>>, mask: ElementSelectorFlags| {
+        e.map_or_else(ElementSelectorFlags::empty, |e| e.relative_selector_search_direction() & mask)
+    };
+    direction(
+        selectors::Element::parent_element(&element),
+        ElementSelectorFlags::RELATIVE_SELECTOR_SEARCH_DIRECTION_ANCESTOR,
+    ) | direction(
+        element.prev_sibling_element(),
+        ElementSelectorFlags::RELATIVE_SELECTOR_SEARCH_DIRECTION_ANCESTOR_SIBLING,
+    )
 }


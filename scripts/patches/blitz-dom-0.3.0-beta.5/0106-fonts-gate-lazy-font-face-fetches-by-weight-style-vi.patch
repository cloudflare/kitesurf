+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(crate) struct DeclaredFontFace {
+    italic: bool,
+    weight_range: (u16, u16),
+    has_unicode_range: bool,
+}
+
+fn font_face_is_italic(style: Option<FontiqueStyle>) -> bool {
+    matches!(
+        style,
+        Some(FontiqueStyle::Italic | FontiqueStyle::Oblique(_))
+    )
+}
+
+/// CSS Fonts 4 §5.2 weight-distance rank for a face weight range against `req`.
+fn weight_range_rank(req: u16, range: (u16, u16)) -> (u8, u16) {
+    if range.0 <= req && req <= range.1 {
+        return (0, 0);
+    }
+    let w = if req < range.0 { range.0 } else { range.1 };
+    if (400..=500).contains(&req) {
+        if w > req && w <= 500 {
+            (1, w - req)
+        } else if w < req {
+            (2, req - w)
+        } else {
+            (3, w - 500)
+        }
+    } else if req < 400 {
+        if w < req {
+            (1, req - w)
+        } else {
+            (2, w - req)
+        }
+    } else if w > req {
+        (1, w - req)
+    } else {
+        (2, req - w)
+    }
+}
+
+/// CSS Fonts 4 §5.2 style + weight selection: returns whether `(face_italic, face_weight_range)`
+/// is selected among the family's declared faces for `(req_italic, req_weight)`.
+fn face_matches_css_selection(
+    declared: &[DeclaredFontFace],
+    req_italic: bool,
+    req_weight: u16,
+    face_italic: bool,
+    face_weight_range: (u16, u16),
+) -> bool {
+    let has_exact_style = declared.iter().any(|d| d.italic == req_italic);
+    let best_italic = if has_exact_style { req_italic } else { !req_italic };
+    if face_italic != best_italic {
+        return false;
+    }
+    let best_rank = declared
+        .iter()
+        .filter(|d| d.italic == best_italic)
+        .map(|d| weight_range_rank(req_weight, d.weight_range))
+        .min();
+    best_rank == Some(weight_range_rank(req_weight, face_weight_range))
+}
+
+fn lookup_loaded_face(
+    font_ctx: &Arc<Mutex<FontContext>>,
+    cache: &mut HashMap<(String, bool, u16), Option<(Blob<u8>, u32)>>,
+    fam_lc: &str,
+    req_italic: bool,
+    req_weight: u16,
+) -> Option<(Blob<u8>, u32)> {
+    let key = (fam_lc.to_string(), req_italic, req_weight);
+    if let Some(cached) = cache.get(&key) {
+        return cached.clone();
+    }
+    let mut ctx = font_ctx.lock().unwrap();
+    let ctx_ref = &mut *ctx;
+    let found = ctx_ref.collection.family_id(fam_lc).and_then(|fid| {
+        let mut query = ctx_ref.collection.query(&mut ctx_ref.source_cache);
+        query.set_families(std::iter::once(QueryFamily::from(fid)));
+        query.set_attributes(FontiqueAttributes {
+            weight: FontiqueWeight::new(req_weight as f32),
+            style: if req_italic {
+                FontiqueStyle::Italic
+            } else {
+                FontiqueStyle::Normal
+            },
+            ..Default::default()
+        });
+        let mut matched: Option<(Blob<u8>, u32)> = None;
+        query.matches_with(|q_font: &QueryFont| {
+            matched = Some((q_font.blob.clone(), q_font.index));
+            QueryStatus::Stop
+        });
+        matched
+    });
+    drop(ctx);
+    cache.insert(key, found.clone());
+    found
+}
+
+fn filter_uncovered_chars(remaining: &mut Vec<char>, blob: &Blob<u8>, index: u32) {
+    let Ok(font_ref) = FontRef::from_index(blob.as_ref(), index) else {
+        return;
+    };
+    let charmap = font_ref.charmap();
+    remaining.retain(|&ch| charmap.map(ch).is_none());
+}
+
+fn push_non_ws_chars(out: &mut Vec<char>, text: &str) {
+    for ch in text.chars() {
+        if !ch.is_ascii_whitespace() && !out.contains(&ch) {
+            out.push(ch);
+        }
+    }
+}

+#[inline]
+fn set_ascii_codepoint_bits(lo: &mut u64, hi: &mut u64, bytes: &[u8]) {
+    let mut w0 = *lo;
+    let mut w1 = *hi;
+    for &b in bytes {
+        if b < 64 {
+            w0 |= 1u64 << b;
+        } else {
+            w1 |= 1u64 << (b - 64);
+        }
+    }
+    *lo = w0;
+    *hi = w1;
+}
+
 pub(crate) fn note_connected_text_codepoints(
     used_codepoints: &mut Vec<u64>,
     non_latin_text_writes: &mut u32,
     text: &str,
 ) {
-    note_non_latin_text_write(non_latin_text_writes, text);
-    if !used_codepoints.is_empty() {
-        set_codepoint_bits(used_codepoints, text);
+    if text.is_ascii() {
+        if let [lo, hi, ..] = used_codepoints.as_mut_slice() {
+            set_ascii_codepoint_bits(lo, hi, text.as_bytes());
+        }
+        return;
+    }
+
+    if used_codepoints.is_empty() {
+        note_non_latin_text_write(non_latin_text_writes, text);
+        return;
+    }
+
+    let mut saw_non_latin = false;
+    for ch in text.chars() {
+        if ch >= '\u{0530}' {
+            saw_non_latin = true;
+        }
+        let cp = ch as usize;
+        used_codepoints[cp >> 6] |= 1u64 << (cp & 63);
+    }
+    if saw_non_latin {
+        *non_latin_text_writes = non_latin_text_writes.wrapping_add(1);
     }
 }

 /// Set the bit for every codepoint in `text`.
 pub(crate) fn set_codepoint_bits(bits: &mut [u64], text: &str) {
+    if text.is_ascii() {
+        if let [lo, hi, ..] = bits {
+            set_ascii_codepoint_bits(lo, hi, text.as_bytes());
+        }
+        return;
+    }
+
     for ch in text.chars() {
         let cp = ch as usize;
         bits[cp >> 6] |= 1u64 << (cp & 63);

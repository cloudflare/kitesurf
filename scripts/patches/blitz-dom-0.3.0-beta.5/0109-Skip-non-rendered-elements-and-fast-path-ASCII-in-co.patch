+    /// Whether text nodes directly inside `parent_id` are never rendered as document text.
+    pub(crate) fn is_non_rendered_text_parent(&self, parent_id: NodeId) -> bool {
+        self.nodes[parent_id].element_data().is_some_and(|el| {
+            matches!(
+                el.name.local,
+                local_name!("script")
+                    | local_name!("style")
+                    | local_name!("title")
+                    | local_name!("noscript")
+            )
+        })
+    }
+
     /// Build the used-codepoint bitset from in-document text nodes, unless built.
     /// O(text), once per document: the first time a range-gated face
     /// needs checking. Later connected text writes and subtree insertions
@@ -2486,6 +2499,12 @@ impl BaseDocument {
             if !node.flags.is_in_document() {
                 continue;
             }
+            if node
+                .parent_id()
+                .is_some_and(|parent_id| self.is_non_rendered_text_parent(parent_id))
+            {
+                continue;
+            }
             if let Some(text) = node.text_data() {
                 set_codepoint_bits(&mut bits, &text.content);
             }
@@ -5209,6 +5228,45 @@ mod codepoint_probe_tests {
         assert_eq!(doc.non_latin_text_writes(), writes_seen.wrapping_add(1));
         assert!(doc.text_uses_codepoints(cjk));
     }
+
+    #[test]
+    fn non_rendered_elements_do_not_pollute_codepoint_index() {
+        use crate::qual_name;
+
+        let mut doc = BaseDocument::new(DocumentConfig::default());
+        let root_id = doc.root_node().id();
+        let style_id = doc.mutate().create_element(qual_name!("style"), Vec::new());
+        let script_id = doc.mutate().create_element(qual_name!("script"), Vec::new());
+        let style_text = doc.mutate().create_text_node("/* 漢 */");
+        let script_text = doc.mutate().create_text_node("const s = 'Д';");
+
+        doc.mutate().append_children(style_id, &[style_text]);
+        doc.mutate().append_children(script_id, &[script_text]);
+        doc.mutate().append_children(root_id, &[style_id, script_id]);
+
+        let cjk = &[(0x4E00, 0x9FFF)];
+        let cyrillic = &[(0x0400, 0x04FF)];
+        let writes_before = doc.non_latin_text_writes();
+        assert!(!doc.text_uses_codepoints(cjk));
+        assert!(!doc.text_uses_codepoints(cyrillic));
+
+        doc.mutate().set_node_text(style_text, "/* 漢Ж */");
+        doc.mutate()
+            .append_text_to_node(script_text, "const t = '漢';")
+            .expect("text node");
+        assert_eq!(doc.non_latin_text_writes(), writes_before);
+        assert!(!doc.text_uses_codepoints(cjk));
+        assert!(!doc.text_uses_codepoints(cyrillic));
+
+        let p_id = doc.mutate().create_element(qual_name!("p"), Vec::new());
+        let visible_text = doc.mutate().create_text_node("Hello 漢");
+        doc.mutate().append_children(p_id, &[visible_text]);
+        doc.mutate().append_children(root_id, &[p_id]);
+
+        assert!(doc.text_uses_codepoints(&[(0x0048, 0x0048)]));
+        assert!(doc.text_uses_codepoints(cjk));
+        assert!(!doc.text_uses_codepoints(cyrillic));
+    }
 }


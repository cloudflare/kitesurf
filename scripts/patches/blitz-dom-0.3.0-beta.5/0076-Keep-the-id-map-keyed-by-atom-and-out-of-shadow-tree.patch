 src/document.rs       | 13 +++++----
 src/mutator.rs        | 55 ++++++++++++++++++++++++++++++++--
 src/query_selector.rs | 68 ++++++++++++++++++++++++++++++++++---------
 4 files changed, 116 insertions(+), 22 deletions(-)


 src/layout/damage.rs   | 102 +++++++++++++++++++++++++++++++++++++++++
 src/resolve.rs         |  38 +++++++++++++++
 src/stylo/traversal.rs |  23 +++++++++-
 4 files changed, 192 insertions(+), 3 deletions(-)


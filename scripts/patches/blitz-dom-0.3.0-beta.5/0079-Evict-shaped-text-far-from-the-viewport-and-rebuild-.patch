+        //   box, or below it if in-flow content precedes it on the line (its
+        //   hypothetical box would start a new line after that content).
+        let (inline_area, block_area) = if is_inline_level {
+            (
+                taffy::Line {
+                    start: line.x,
+                    end: line.x,

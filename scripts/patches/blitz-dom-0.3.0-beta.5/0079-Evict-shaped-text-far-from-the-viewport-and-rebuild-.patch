+/// Whether `node` lays out in a vertical writing mode.
+pub(super) fn is_vertical(node: &crate::Node) -> bool {
+    #[cfg(feature = "writing-mode")]
+    return node.writing_mode().is_vertical();
+    #[cfg(not(feature = "writing-mode"))]
+    {
+        let _ = node;
+        false
+    }
+}

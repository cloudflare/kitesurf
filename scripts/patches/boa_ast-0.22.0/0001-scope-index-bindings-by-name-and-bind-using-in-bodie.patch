 }

+impl Inner {
+    /// Position of `name` in `bindings`, or `usize::MAX` (which `Vec::get` maps to
+    /// `None`). Bindings are append-only, so a position never changes once taken.
+    #[inline]
+    fn pos(&self, name: &JsString) -> usize {
+        self.lookup
+            .borrow()
+            .get(name)
+            .copied()
+            .unwrap_or(usize::MAX)
+    }
+}

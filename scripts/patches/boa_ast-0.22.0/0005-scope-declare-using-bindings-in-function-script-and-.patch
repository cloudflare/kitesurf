From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Wed, 14 Oct 2026 17:31:08 +0100
Subject: [PATCH] scope: declare using bindings in function, script and eval
 bodies

Function, global and eval declaration instantiation matched only let
and const among lexical declarations, so a `using` or `await using` at
the top of a function body, script or eval got no binding. Its
initializer then wrote into a slot no scope had, and the VM panicked
with an index out of bounds in PutLexicalValue. Unpatched 0.22.0
panics the same way.

Blocks and modules already bind `using` like `let`, because the
bytecompiler has no disposal yet. Bind it the same way at these sites.
---
 src/scope_analyzer.rs | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/src/scope_analyzer.rs b/src/scope_analyzer.rs
index 4c67333..b978306 100644
--- a/src/scope_analyzer.rs
+++ b/src/scope_analyzer.rs
@@ -1800,6 +1800,16 @@ fn global_declaration_instantiation(
                         env.create_immutable_binding(name, true);
                     }
                 }
+                // Bind `using` like `let`, as blocks and modules do until disposal is
+                // implemented. Without a binding, the initializer writes to an undeclared slot.
+                Declaration::Lexical(
+                    LexicalDeclaration::Using(declaration) | LexicalDeclaration::AwaitUsing(declaration),
+                ) => {
+                    for name in bound_names(declaration) {
+                        let name = name.to_js_string(interner);
+                        drop(env.create_mutable_binding(name, false));
+                    }
+                }
                 _ => {}
             }
         }
@@ -2180,6 +2190,16 @@ fn function_declaration_instantiation(
                         lex_env.create_immutable_binding(name, true);
                     }
                 }
+                // Bind `using` like `let`, as blocks and modules do until disposal is
+                // implemented. Without a binding, the initializer writes to an undeclared slot.
+                Declaration::Lexical(
+                    LexicalDeclaration::Using(declaration) | LexicalDeclaration::AwaitUsing(declaration),
+                ) => {
+                    for name in bound_names(declaration) {
+                        let name = name.to_js_string(interner);
+                        drop(lex_env.create_mutable_binding(name, false));
+                    }
+                }
                 _ => {}
             }
         }
@@ -2498,6 +2518,16 @@ pub(crate) fn eval_declaration_instantiation_scope(
                         lex_env.create_immutable_binding(name, true);
                     }
                 }
+                // Bind `using` like `let`, as blocks and modules do until disposal is
+                // implemented. Without a binding, the initializer writes to an undeclared slot.
+                Declaration::Lexical(
+                    LexicalDeclaration::Using(declaration) | LexicalDeclaration::AwaitUsing(declaration),
+                ) => {
+                    for name in bound_names(declaration) {
+                        let name = name.to_js_string(interner);
+                        drop(lex_env.create_mutable_binding(name, false));
+                    }
+                }
                 _ => {}
             }
         }

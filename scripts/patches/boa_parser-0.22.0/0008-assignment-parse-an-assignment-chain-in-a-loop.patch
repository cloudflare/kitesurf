+                        return Ok(AssignmentStep::Target((target, assignop, name)));
                     }
+                    return Err(Error::lex(LexError::Syntax(
+                        "Invalid left-hand side in assignment".into(),
+                        tok.span().start(),
+                    )));
                 }
                 _ => {}
             }
         }

-        Ok(lhs)

 src/parser/expression/assignment/mod.rs | 112 ++++++++++++++++--------
 1 file changed, 75 insertions(+), 37 deletions(-)

diff --git a/src/parser/expression/assignment/mod.rs b/src/parser/expression/assignment/mod.rs
index c4e36ee..31260fd 100644
--- a/src/parser/expression/assignment/mod.rs
+++ b/src/parser/expression/assignment/mod.rs
@@ -33,7 +33,10 @@ use crate::{
 };
 use boa_ast::{
     Expression, Keyword, Punctuator, Span, Spanned,
-    expression::operator::assign::{Assign, AssignOp, AssignTarget},
+    expression::{
+        Identifier,
+        operator::assign::{Assign, AssignOp, AssignTarget},
+    },
     operations::{ContainsSymbol, bound_names, contains, lexically_declared_names},
 };
 use boa_interner::Interner;
@@ -81,6 +84,17 @@ impl AssignmentExpression {
     }
 }

+/// One `target op` of an assignment chain, waiting for its right-hand side, and the name an
+/// anonymous function on that side takes from the target.
+type PendingAssign = (AssignTarget, AssignOp, Option<Identifier>);
+
+/// What one step of [`AssignmentExpression`] parsed: the final value of the chain, or an
+/// assignment target whose right-hand side starts at the next token.
+enum AssignmentStep {
+    Value(Expression),
+    Target(PendingAssign),
+}
+
 impl<R> TokenParser<R> for AssignmentExpression
 where
     R: ReadChar,
@@ -88,13 +102,39 @@ where
     type Output = Expression;

     fn parse(self, cursor: &mut Cursor<R>, interner: &mut Interner) -> ParseResult<Expression> {
+        // `a = (b = ...)` recursed into this frame for every right-hand side, two frames per
+        // nesting level; a loop keeps one, and `a = b = c` does not recurse at all.
+        let mut pending: Vec<PendingAssign> = Vec::new();
+        let mut rhs = loop {
+            match self.step(cursor, interner)? {
+                AssignmentStep::Value(value) => break value,
+                AssignmentStep::Target(target) => pending.push(target),
+            }
+        };
+        while let Some((target, op, name)) = pending.pop() {
+            if let Some(ident) = name {
+                rhs.set_anonymous_function_definition_name(&ident);
+            }
+            rhs = Assign::new(op, target, rhs).into();
+        }
+        Ok(rhs)
+    }
+}
+
+impl AssignmentExpression {
+    fn step<R: ReadChar>(
+        self,
+        cursor: &mut Cursor<R>,
+        interner: &mut Interner,
+    ) -> ParseResult<AssignmentStep> {

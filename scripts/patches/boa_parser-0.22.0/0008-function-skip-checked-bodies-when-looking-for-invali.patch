+use std::ops::ControlFlow;
+
+/// Returns `true` if the node contains a `CoverInitializedName`, like
+/// [`ast::operations::contains_invalid_object_literal`], but does not descend into function bodies
+/// the parser has already checked.
+///
+/// Every function body `FunctionStatementList` parses is checked before it is returned, and a
+/// body that fails is a syntax error, so a checked body never contains one. Rechecking them made
+/// the check quadratic in function nesting depth. Arrow function bodies are still walked: a
+/// concise body (`x => expr`) is built without going through `FunctionStatementList`.
+pub(in crate::parser) fn contains_invalid_object_literal<N>(node: &N) -> bool
+where
+    N: VisitWith,
+{
+    struct ContainsInvalidObjectLiteral;
+
+    impl<'ast> Visitor<'ast> for ContainsInvalidObjectLiteral {
+        type BreakTy = ();
+
+        fn visit_object_literal(&mut self, node: &'ast ObjectLiteral) -> ControlFlow<()> {
+            for pd in node.properties() {
+                if let PropertyDefinition::CoverInitializedName(..) = pd {
+                    return ControlFlow::Break(());
+                }
+                self.visit_property_definition(pd)?;
+            }
+            ControlFlow::Continue(())
+        }
+
+        fn visit_function_body(&mut self, _: &'ast AstFunctionBody) -> ControlFlow<()> {
+            ControlFlow::Continue(())
+        }
+
+        fn visit_arrow_function(&mut self, node: &'ast ArrowFunction) -> ControlFlow<()> {
+            self.visit_formal_parameter_list(node.parameters())?;
+            node.body().visit_with(self)
+        }
+
+        fn visit_async_arrow_function(
+            &mut self,
+            node: &'ast AsyncArrowFunction,
+        ) -> ControlFlow<()> {
+            self.visit_formal_parameter_list(node.parameters())?;
+            node.body().visit_with(self)
+        }
+    }
+
+    node.visit_with(&mut ContainsInvalidObjectLiteral)
+        .is_break()
+}


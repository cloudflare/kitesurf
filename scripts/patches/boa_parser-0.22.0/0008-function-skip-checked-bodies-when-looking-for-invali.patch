+
+/// A `CoverInitializedName` left in an expression is a syntax error at any function nesting
+/// depth, including in a concise arrow body, which is not checked on its own.
+#[test]
+fn check_invalid_object_literal_in_nested_functions() {
+    for js in [
+        "function f() { function g() { ({a=1}); } }",
+        "function f() { return () => ({a=1}); }",
+        "function f() { return () => () => ({a=1}); }",
+        "function f() { return async x => ({a=1}); }",
+        "function f() { function g(x = {a=1}) {} }",
+        "function f() { return class { x = () => ({a=1}); }; }",
+        "function f() { return { m() { return () => ({a=1}); } }; }",
+        "x => x => ({a=1});",
+    ] {
+        check_invalid_script(js);
+    }
+}

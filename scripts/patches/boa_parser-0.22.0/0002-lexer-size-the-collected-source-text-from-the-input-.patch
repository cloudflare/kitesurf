From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Fri, 9 Oct 2026 20:34:21 +0100
Subject: [PATCH] lexer: size the collected source text from the input length

The lexer collects every code unit into a SourceText that starts at
4 KiB and doubles, so parsing a large bundle briefly held about three
times its text during the last reallocation, and up to twice it after.
ReadChar gains a defaulted len_hint (bytes for UTF-8, code units for
UTF-16, both upper bounds on what is collected), and the cursor sizes
the collector from it.
---
 src/lexer/cursor.rs |  8 +++++++-
 src/source/mod.rs   |  9 ++++++++-
 src/source/utf16.rs |  4 ++++
 src/source/utf8.rs  | 12 ++++++++++++
 4 files changed, 31 insertions(+), 2 deletions(-)

diff --git a/src/lexer/cursor.rs b/src/lexer/cursor.rs
index 97624b1..cf43904 100644
--- a/src/lexer/cursor.rs
+++ b/src/lexer/cursor.rs
@@ -77,13 +77,19 @@ impl<R> Cursor<R> {
 impl<R: ReadChar> Cursor<R> {
     /// Creates a new Lexer cursor.
     pub(super) fn new(inner: R) -> Self {
+        // Sized up front from the input: growing by doubling briefly held about
+        // three times the text while it reallocated.
+        let source_collector = match inner.len_hint() {
+            0 => SourceText::default(),
+            hint => SourceText::with_capacity(hint),
+        };
         Self {
             iter: inner,
             pos: Position::new(1, 1),
             strict: false,
             module: false,
             peeked: [None; 4],
-            source_collector: SourceText::default(),
+            source_collector,
         }
     }

diff --git a/src/source/mod.rs b/src/source/mod.rs
index 0b684ed..aabca24 100644
--- a/src/source/mod.rs
+++ b/src/source/mod.rs
@@ -37,8 +37,9 @@ impl<'bytes> Source<'static, UTF8Input<&'bytes [u8]>> {
     ///
     /// [slice]: std::slice
     pub fn from_bytes<T: AsRef<[u8]> + ?Sized>(source: &'bytes T) -> Self {
+        let bytes = source.as_ref();
         Self {
-            reader: UTF8Input::new(source.as_ref()),
+            reader: UTF8Input::with_len_hint(bytes, bytes.len()),
             path: None,
         }
     }
@@ -143,6 +144,12 @@ pub trait ReadChar {
     ///
     /// Returns an error if the next input in the input is not a valid unicode code point.
     fn next_char(&mut self) -> io::Result<Option<u32>>;
+
+    /// An upper bound on the UTF-16 code units left, or 0 if unknown. The
+    /// lexer sizes the retained source text with it instead of growing by doubling.
+    fn len_hint(&self) -> usize {
+        0
+    }
 }


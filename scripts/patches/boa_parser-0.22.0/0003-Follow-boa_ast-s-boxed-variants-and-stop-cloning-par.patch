From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Mon, 12 Oct 2026 11:07:14 +0100
Subject: [PATCH] Follow boa_ast's boxed variants and stop cloning parentheses

A parenthesized expression cloned its contents out of the cover
grammar's list and dropped the original, so every (function () {...})
wrapper briefly held two copies of the whole bundle. Take it instead.

Build the boxed boa_ast variants through their From impls rather than
the tuple constructors, which now take a Box.
---
 src/parser/expression/assignment/mod.rs |  2 +-
 src/parser/expression/primary/mod.rs    |  4 ++--
 src/parser/statement/switch/tests.rs    |  2 +-
 src/parser/statement/try_stm/tests.rs   | 20 ++++++++++----------
 4 files changed, 14 insertions(+), 14 deletions(-)

diff --git a/src/parser/expression/assignment/mod.rs b/src/parser/expression/assignment/mod.rs
index 8d305c6..c4e36ee 100644
--- a/src/parser/expression/assignment/mod.rs
+++ b/src/parser/expression/assignment/mod.rs
@@ -113,7 +113,7 @@ where
                 {
                     return ArrowFunction::new(self.allow_in, self.allow_yield, self.allow_await)
                         .parse(cursor, interner)
-                        .map(Expression::ArrowFunction);
+                        .map(Expression::from);
                 }
             }
             //  AsyncArrowFunction[?In, ?Yield, ?Await]
diff --git a/src/parser/expression/primary/mod.rs b/src/parser/expression/primary/mod.rs
index 63cd1fd..e773205 100644
--- a/src/parser/expression/primary/mod.rs
+++ b/src/parser/expression/primary/mod.rs
@@ -480,9 +480,9 @@ where
                     "multiple expressions in parenthesized expression",
                 ));
             }
-            if let InnerExpression::Expression(expression) = &expressions[0] {
+            if let Some(InnerExpression::Expression(expression)) = expressions.pop() {
                 return Ok(ast::Expression::Parenthesized(Parenthesized::new(
-                    expression.clone(),
+                    expression,
                     Span::new(span_start.start(), span.end()),
                 ))
                 .into());

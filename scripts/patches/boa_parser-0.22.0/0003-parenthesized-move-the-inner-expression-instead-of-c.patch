From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Mon, 12 Oct 2026 11:07:14 +0100
Subject: [PATCH] parenthesized: move the inner expression instead of cloning
 it

A parenthesized expression cloned its contents out of the cover
grammar's list and dropped the original, so every (function () {...})
wrapper briefly held two copies of the whole bundle. Take it instead.
---
 src/parser/expression/primary/mod.rs | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/parser/expression/primary/mod.rs b/src/parser/expression/primary/mod.rs
index 6b532da..61c5598 100644
--- a/src/parser/expression/primary/mod.rs
+++ b/src/parser/expression/primary/mod.rs
@@ -480,9 +480,9 @@ where
                     "multiple expressions in parenthesized expression",
                 ));
             }
-            if let InnerExpression::Expression(expression) = &expressions[0] {
+            if let Some(InnerExpression::Expression(expression)) = expressions.pop() {
                 return Ok(ast::Expression::Parenthesized(Parenthesized::new(
-                    expression.clone(),
+                    expression,
                     Span::new(span_start.start(), span.end()),
                 ))
                 .into());

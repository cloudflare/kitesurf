From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Mon, 5 Oct 2026 19:19:15 +0100
Subject: [PATCH] Match CSS shadow blurs and snap empty outer clips

CSS Gaussian deviation is half the blur radius; vello's erf input needs
the corresponding sqrt(2) conversion. Shadow quadrant bounds beyond the
kernel can snap outward to whole pixels so clipping avoids a group
composite.
---
 src/render/box_shadow.rs | 24 ++++++++++++++++++++++--
 1 file changed, 22 insertions(+), 2 deletions(-)

diff --git a/src/render/box_shadow.rs b/src/render/box_shadow.rs
index d6ee3eb..073692f 100644
--- a/src/render/box_shadow.rs
+++ b/src/render/box_shadow.rs
@@ -57,6 +57,22 @@ fn pixel_grid(transform: Affine) -> Option<Vec2> {
     (a == 1.0 && b == 0.0 && c == 0.0 && d == 1.0).then_some(Vec2::new(e, f))
 }

+/// `rect` grown outward to the device pixel grid at `grid`.
+fn snap_out(rect: Rect, grid: Vec2) -> Rect {
+    Rect::new(
+        (rect.x0 + grid.x).floor() - grid.x,
+        (rect.y0 + grid.y).floor() - grid.y,
+        (rect.x1 + grid.x).ceil() - grid.x,
+        (rect.y1 + grid.y).ceil() - grid.y,
+    )
+}
+
+/// CSS uses a Gaussian deviation of half the blur radius; vello's erf(d / std_dev)
+/// requires that deviation multiplied by sqrt(2) (css-backgrounds-3, "Blurring Shadow Edges").
+fn vello_std_dev(blur_radius: f64) -> f64 {
+    blur_radius * 0.5 * std::f64::consts::SQRT_2
+}
+
 impl ElementCx<'_, '_> {
     pub(super) fn draw_outset_box_shadow(&self, scene: &mut impl PaintScene) {
         let box_shadow = &self.style.get_effects().box_shadow.0;
@@ -112,7 +128,7 @@ impl ElementCx<'_, '_> {
                         });

                         let spread = shadow.spread.px() as f64 * self.scale;
-                        let std_dev = shadow.base.blur.px() as f64;
+                        let std_dev = vello_std_dev(shadow.base.blur.px() as f64);
                         self.draw_outset_shadow_shape(
                             scene,
                             transform,
@@ -181,6 +197,10 @@ impl ElementCx<'_, '_> {
             grid.map(|g| g.y),
         );
         let bounds = rect.inflate(4.0 * std_dev + 1.0, 4.0 * std_dev + 1.0);
+        // The splits already sit on the grid; putting the outer edges there too makes each
+        // quadrant a whole-pixel rect, which vello can clip per draw instead of shading the
+        // whole blur under a clip layer. Those edges lie past anything a blur can reach.
+        let bounds = grid.map_or(bounds, |g| snap_out(bounds, g));
         let quadrants = [
             (
                 Rect::new(bounds.x0, bounds.y0, split_x, split_y),
@@ -288,7 +308,7 @@ impl ElementCx<'_, '_> {
                 hole,
                 Color::WHITE,
                 radius,
-                shadow.base.blur.px() as f64 * self.scale,
+                vello_std_dev(shadow.base.blur.px() as f64 * self.scale),
             );

             scene.pop_layer();

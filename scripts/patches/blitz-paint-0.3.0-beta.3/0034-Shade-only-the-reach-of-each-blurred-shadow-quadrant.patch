From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Mon, 28 Sep 2026 21:52:04 +0100
Subject: [PATCH] Shade only the reach of each blurred shadow quadrant

A blurred shadow with uneven radii draws four clipped quadrants, and
vello shades each blur's whole inflated rect before the clip keeps a
quarter of it, so the shadow cost about four times one blur. Each
quadrant now blurs the shadow rect cut to the part that can reach it:
the corner radius plus three standard deviations past its edges, so
the pixels inside the quadrant come out the same.
---
 src/render/box_shadow.rs | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/src/render/box_shadow.rs b/src/render/box_shadow.rs
index 971c62e..d6ee3eb 100644
--- a/src/render/box_shadow.rs
+++ b/src/render/box_shadow.rs
@@ -200,6 +200,11 @@ impl ElementCx<'_, '_> {
             ),
         ];
         for (quadrant, radius) in quadrants {
+            let radius = (radius.x + radius.y) / 2.0;
+            // vello shades a blur's whole rect before the clip drops most of it; cut to what can
+            // reach the quadrant, it blurs the same there, its new corners beyond the kernel.
+            let reach = radius + 3.0 * std_dev + 1.0;
+            let local = rect.intersect(quadrant.inflate(reach, reach));
             self.context.layer_manager.maybe_with_layer(
                 scene,
                 true,
@@ -208,10 +213,7 @@ impl ElementCx<'_, '_> {
                 &quadrant,
                 None,
                 None,
-                |scene| {
-                    let radius = (radius.x + radius.y) / 2.0;
-                    scene.draw_box_shadow(transform, rect, color, radius, std_dev);
-                },
+                |scene| scene.draw_box_shadow(transform, local, color, radius, std_dev),
             );
         }
     }

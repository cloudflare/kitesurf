From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Tue, 29 Sep 2026 11:36:31 +0100
Subject: [PATCH] Keep corner-shaped border wedges on their own half of the box

Each edge's colour wedge runs along the ray from the outer corner
through the inner corner, scaled far enough to cover the corner's
radius box. The scale came from the thinner side, so with uneven widths
the thick side's part of the ray overshot by their ratio and crossed
the whole box: with a 12px bottom and 4px sides, the bottom wedge
covered the top border and painted it blue.

Rays now stop at the box's centre lines, so opposite wedges can't meet,
and always reach at least the inner corner.
---
 src/render/border.rs | 17 ++++++++++++++---
 1 file changed, 14 insertions(+), 3 deletions(-)

diff --git a/src/render/border.rs b/src/render/border.rs
index aa18366..e0de2b2 100644
--- a/src/render/border.rs
+++ b/src/render/border.rs
@@ -390,8 +390,8 @@ impl ElementCx<'_, '_> {
         }
     }

-    /// The part of a corner-shaped ring that takes `edge`'s colour: bounded by the rays from
-    /// each outer corner through its inner corner, run on past the corner's radius box.
+    /// The part of a corner-shaped ring that takes `edge`'s colour, split along each corner's
+    /// outer-to-inner ray; rays stop at the centre lines, or a thick side's ray crossed the box.
     fn corner_shaped_edge_wedge(&self, edge: Edge) -> BezPath {
         let (bb, bw, r) = (
             self.frame.border_box,
@@ -400,7 +400,18 @@ impl ElementCx<'_, '_> {
         );
         let inner = |outer: Point, inward: Vec2, radius: Vec2| {
             let reach = |r: f64, w: f64| if w != 0.0 { r / w.abs() } else { 0.0 };
-            outer + inward * (1.0 + reach(radius.x, inward.x).max(reach(radius.y, inward.y)))
+            let to_centre = |side: f64, w: f64| {
+                if w != 0.0 {
+                    side / 2.0 / w.abs()
+                } else {
+                    f64::INFINITY
+                }
+            };
+            let scale = (1.0 + reach(radius.x, inward.x).max(reach(radius.y, inward.y)))
+                .min(to_centre(bb.width(), inward.x))
+                .min(to_centre(bb.height(), inward.y))
+                .max(1.0);
+            outer + inward * scale
         };
         let (tl, tr) = (Point::new(bb.x0, bb.y0), Point::new(bb.x1, bb.y0));
         let (br, bl) = (Point::new(bb.x1, bb.y1), Point::new(bb.x0, bb.y1));

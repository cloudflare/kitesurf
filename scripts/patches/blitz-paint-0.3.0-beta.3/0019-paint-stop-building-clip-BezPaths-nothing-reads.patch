From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Sun, 9 Aug 2026 03:09:12 +0100
Subject: [PATCH] paint: stop building clip BezPaths nothing reads

Three per-element allocations were thrown away. The effect layer clip
and the descendant clip rect both built a box path only to take its
bounding box, but a box path's bbox is the box, since corner radii round
inward. The clip-path layer shape and the overflow clip shape were
built unconditionally, though maybe_with_layer ignores the shape when
its condition is false, which is the common case for an element.
---
 src/render.rs | 49 +++++++++++++++++++++++++++++++------------------
 1 file changed, 31 insertions(+), 18 deletions(-)

diff --git a/src/render.rs b/src/render.rs
index a7b2318..f38ace5 100644
--- a/src/render.rs
+++ b/src/render.rs
@@ -469,12 +469,14 @@ impl<'dom, 'a> BlitzDomPainter<'dom, 'a> {
         // scrolled out of view is culled rather than drawn and clipped away. The box used
         // here matches the clip applied to the content below.
         let child_clip_rect = if should_clip {
+            // The rect is the path's bounding box, since corner radii only
+            // round inward, so there is no need to build a BezPath to ask.
             let clip_box = if is_text_input {
-                cx.frame.content_box_path()
+                cx.frame.content_box
             } else {
-                cx.frame.padding_box_path()
+                cx.frame.padding_box
             };
-            clip_rect.intersect(screen_transform.transform_rect_bbox(clip_box.bounding_box()))
+            clip_rect.intersect(screen_transform.transform_rect_bbox(clip_box))
         } else {
             clip_rect
         };
@@ -514,9 +516,15 @@ impl<'dom, 'a> BlitzDomPainter<'dom, 'a> {
             return;
         }

-        let default_clip = cx.frame.border_box_path();
-        let mut clip_path_for_layer = clip_path_shape.unwrap_or(default_clip);
-        clip_path_for_layer.apply_affine(Affine::scale(self.scale));
+        // Only the clip-path maybe_with_layer call below reads this, and it
+        // does nothing when its flag is false, the common case for an element.
+        let clip_path_for_layer = if has_clip_path {
+            let mut path = clip_path_shape.unwrap_or_else(|| cx.frame.border_box_path());
+            path.apply_affine(Affine::scale(self.scale));
+            path
+        } else {
+            BezPath::new()
+        };

         // clip-path clip ayer
         self.layer_manager.maybe_with_layer(
@@ -553,15 +561,14 @@ impl<'dom, 'a> BlitzDomPainter<'dom, 'a> {

                 // The effect layer covers the element's whole painted subtree:
                 // filter/opacity apply to overflowing content and to abspos
-
-                // descendants re-homed here for paint (a filter IS their
-                // containing block). Border-box-only clipping amputated them
-
-                // (WPT filtered-block-is-container: the abspos child painted
-                // in the transform reference but vanished under the filter).
-                // Live reach, not the resolve-time cache: pure-scroll frames
-                // skip resolve and the cached rect goes stale by the delta.
-                let mut effect_layer_clip = cx.frame.border_box_path().bounding_box();
+                // descendants re-homed here for paint (a filter is their
+                // containing block). Clipping to the border box alone cuts them
+                // off (WPT filtered-block-is-container).
+                // Use the live reach, not the resolve-time cache: pure-scroll
+                // frames skip resolve, so the cached rect goes stale by the delta.
+                // The border box path's bounding box is the border box, since
+                // corner radii only round inward, so no path is built here.
+                let mut effect_layer_clip = cx.frame.border_box;
                 effect_layer_clip = effect_layer_clip.union(*cx.node.scrollable_overflow());
                 if let Some((x0, y0, x1, y1)) = cx.node.live_rehomed_reach() {
                     effect_layer_clip = effect_layer_clip.union(Rect::new(
@@ -601,10 +608,16 @@ impl<'dom, 'a> BlitzDomPainter<'dom, 'a> {
                         cx.stroke_devtools(scene);

                         // TODO: allow layers with opacity to be unclipped (overflow: visible)
-                        let clip = if is_text_input {
-                            &cx.frame.content_box_path()
+                        // Only built when it will actually be used as a clip;
+                        // maybe_with_layer ignores it when should_clip is false.
+                        let clip = &if should_clip {
+                            if is_text_input {
+                                cx.frame.content_box_path()
+                            } else {
+                                cx.frame.padding_box_path()
+                            }
                         } else {
-                            &cx.frame.padding_box_path()
+                            BezPath::new()
                         };

                         // Clip layer if box requires clipping. Opacity set to 1.0

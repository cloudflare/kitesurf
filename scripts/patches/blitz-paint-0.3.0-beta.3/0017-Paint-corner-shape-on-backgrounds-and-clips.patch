+//! `corner-shape` contours, ported from WPT's render-corner-shape.js (which follows Blink) so
+//! inner edges and shadow spreads move along the same approximate normal the reference uses.
+
+use kurbo::{BezPath, Insets, Point, Rect, Vec2};
+use std::f64::consts::FRAC_PI_2;
+
+use super::NonUniformRoundedRectRadii;
+
+/// The computed `superellipse(K)` parameter of each corner: `round` is 1, `bevel` 0,
+/// `square` +infinity and `notch` -infinity.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct CornerShapes {
+    pub top_left: f64,
+    pub top_right: f64,
+    pub bottom_right: f64,
+    pub bottom_left: f64,
+}
+
+impl CornerShapes {
+    pub const ROUND: Self = Self {
+        top_left: 1.0,
+        top_right: 1.0,
+        bottom_right: 1.0,
+        bottom_left: 1.0,
+    };
+}
+
+impl Default for CornerShapes {
+    fn default() -> Self {
+        Self::ROUND
+    }
+}
+
+const TOLERANCE: f64 = 0.1;
+
+/// The clockwise contour of `rect` moved in by `insets`: zero for the border edge, the border
+/// widths for the padding edge, minus the spread (so outwards) for an outset shadow.
+pub fn contour(
+    rect: Rect,
+    radii: &NonUniformRoundedRectRadii,
+    shapes: &CornerShapes,
+    insets: Insets,
+) -> BezPath {
+    let target = Rect::new(
+        rect.x0 + insets.x0,
+        rect.y0 + insets.y0,
+        rect.x1 - insets.x1,
+        rect.y1 - insets.y1,
+    );
+    if target.x0 > target.x1 || target.y0 > target.y1 {
+        return BezPath::new();
+    }
+    let corners = [
+        Corner {
+            outer: Point::new(rect.x0, rect.y0),
+            towards_start: Vec2::new(0.0, radii.top_left.y),
+            towards_end: Vec2::new(radii.top_left.x, 0.0),
+            k: shapes.top_left,
+            start_inset: insets.x0,
+            end_inset: insets.y0,
+            sharp: Point::new(target.x0, target.y0),
+        },
+        Corner {
+            outer: Point::new(rect.x1, rect.y0),
+            towards_start: Vec2::new(-radii.top_right.x, 0.0),
+            towards_end: Vec2::new(0.0, radii.top_right.y),
+            k: shapes.top_right,
+            start_inset: insets.y0,
+            end_inset: insets.x1,
+            sharp: Point::new(target.x1, target.y0),
+        },
+        Corner {
+            outer: Point::new(rect.x1, rect.y1),
+            towards_start: Vec2::new(0.0, -radii.bottom_right.y),
+            towards_end: Vec2::new(-radii.bottom_right.x, 0.0),
+            k: shapes.bottom_right,
+            start_inset: insets.x1,
+            end_inset: insets.y1,
+            sharp: Point::new(target.x1, target.y1),
+        },
+        Corner {
+            outer: Point::new(rect.x0, rect.y1),
+            towards_start: Vec2::new(radii.bottom_left.x, 0.0),
+            towards_end: Vec2::new(0.0, -radii.bottom_left.y),
+            k: shapes.bottom_left,
+            start_inset: insets.y1,
+            end_inset: insets.x0,
+            sharp: Point::new(target.x0, target.y1),
+        },
+    ];
+
+    // The reference cuts each corner out of the moved rect with an evenodd clip, so whatever
+    // a corner's offset points push past the rect's edges is dropped, not painted.
+    let clamp = |p: Point| {
+        Point::new(
+            p.x.clamp(target.x0, target.x1),
+            p.y.clamp(target.y0, target.y1),
+        )
+    };
+    let mut runs: Vec<Vec<Point>> = corners
+        .iter()
+        .map(|corner| {
+            let mut points = Vec::new();
+            corner.push_points(&mut points);
+            points.into_iter().map(clamp).collect()
+        })
+        .collect();
+    let along = [
+        Vec2::new(1.0, 0.0),
+        Vec2::new(0.0, 1.0),
+        Vec2::new(-1.0, 0.0),
+        Vec2::new(0.0, -1.0),
+    ];
+    for (i, direction) in along.into_iter().enumerate() {
+        let (first, second) = if i < 3 {
+            let (head, tail) = runs.split_at_mut(i + 1);
+            (&mut head[i], &mut tail[0])
+        } else {
+            let (head, tail) = runs.split_at_mut(3);
+            (&mut tail[0], &mut head[0])
+        };
+        trim_overlap(first, second, direction);
+    }
+
+    let mut path = BezPath::new();
+    let mut points = runs.into_iter().flatten();
+    if let Some(first) = points.next() {
+        path.move_to(first);
+        for point in points {
+            path.line_to(point);
+        }
+        path.close_path();
+    }
+    path
+}
+
+/// Inner edges of big radii can make one corner's curve run past where the next one starts
+/// on their shared edge; both are cut back to where they cross, as the reference's clips are.
+fn trim_overlap(first: &mut Vec<Point>, second: &mut Vec<Point>, direction: Vec2) {
+    let (Some(&end), Some(&start)) = (first.last(), second.first()) else {
+        return;
+    };
+    if (end - start).dot(direction) <= 0.0 {
+        return;
+    }
+    for i in (1..first.len()).rev() {
+        for j in 1..second.len() {
+            if let Some(p) =
+                segment_intersection((first[i - 1], first[i]), (second[j - 1], second[j]))
+            {
+                first.truncate(i);
+                first.push(p);
+                second.drain(..j);
+                second.insert(0, p);
+                return;
+            }
+        }
+    }
+}
+
+fn segment_intersection((a0, a1): (Point, Point), (b0, b1): (Point, Point)) -> Option<Point> {
+    let (a, b) = (a1 - a0, b1 - b0);
+    let denom = a.cross(b);
+    if denom.abs() < 1e-12 {
+        return None;
+    }
+    let t = (b0 - a0).cross(b) / denom;
+    let u = (b0 - a0).cross(a) / denom;
+    ((0.0..=1.0).contains(&t) && (0.0..=1.0).contains(&u)).then(|| a0 + a * t)
+}
+
+/// One corner of the unmoved rect at `outer`, running clockwise from the edge before it
+/// (`towards_start`, moved in by `start_inset`) to the edge after it.
+struct Corner {
+    outer: Point,
+    towards_start: Vec2,
+    towards_end: Vec2,
+    k: f64,
+    start_inset: f64,
+    end_inset: f64,
+    sharp: Point,
+}
+
+impl Corner {
+    fn push_points(&self, points: &mut Vec<Point>) {
+        // A border at least as thick as the radius leaves a square inner corner,
+        // as it does for a round corner, instead of a curve turned inside out.
+        if self.k == f64::INFINITY
+            || self.towards_start.hypot() < 0.1
+            || self.towards_end.hypot() < 0.1
+            || self.start_inset >= self.towards_end.hypot()
+            || self.end_inset >= self.towards_start.hypot()
+        {
+            points.push(self.sharp);
+            return;
+        }
+
+        let mut curvature = if self.k < -10.0 {
+            0.01
+        } else {
+            2f64.powf(self.k)
+        };
+        let inverse = curvature < 1.0;
+        let near_notch = self.k < -8.0;
+        if inverse {
+            curvature = 1.0 / curvature;
+        }
+
+        let outer = self.outer;
+        let start = outer + self.towards_start;
+        let end = outer + self.towards_end;
+        let center = outer + self.towards_start + self.towards_end;
+
+        let extend_start = normalized(center - start) * self.start_inset;
+        let extend_end = normalized(center - end) * self.end_inset;
+        let clip_start = start + extend_start;
+        let clip_outer = outer + extend_start + extend_end;
+        let clip_end = end + extend_end;
+
+        let convex_half_corner = if near_notch {
+            0.75
+        } else {
+            0.5f64.powf(1.0 / curvature.min(2.0))
+        };
+        let half_corner = if inverse {
+            1.0 - convex_half_corner
+        } else {
+            convex_half_corner
+        };
+        let to_control = Vec2::new(2.0 * half_corner - 0.5, 1.5 - 2.0 * half_corner);
+        let stroke = perpendicular(normalized(to_control));
+
+        let offsets = [
+            normalized(outer - start) * (self.start_inset * stroke.x),
+            normalized(end - outer) * (self.start_inset * stroke.y),
+            normalized(center - end) * (self.end_inset * stroke.y),
+            normalized(start - center) * (self.end_inset * stroke.x),
+        ];
+        let adjusted_start = start + offsets[0] + offsets[1];
+        let adjusted_outer = outer + offsets[1] + offsets[2];
+        let adjusted_end = end + offsets[2] + offsets[3];
+        let adjusted_center = center + offsets[3] + offsets[0];
+        let curve_center = if inverse {
+            adjusted_outer
+        } else {
+            adjusted_center
+        };
+        let map = |x: f64, y: f64| {
+            curve_center + (adjusted_end - curve_center) * x + (adjusted_start - curve_center) * y
+        };
+
+        let control = map(to_control.y, 1.0 - to_control.x);
+        let aligned_start = intersection((adjusted_start, control), (clip_start, clip_outer))
+            .unwrap_or(adjusted_start);
+        let aligned_end =
+            intersection((adjusted_end, control), (clip_outer, clip_end)).unwrap_or(adjusted_end);
+
+        points.push(aligned_start);
+        if near_notch {
+            points.push(adjusted_center);
+        } else {
+            // x = sin²θ^(1/c), y = cos²θ^(1/c) walks |x|^c + |y|^c = 1 from the start (0, 1)
+            // to the end (1, 0).
+            let exponent = 2.0 / curvature;
+            let at = |theta: f64| {
+                let (sin, cos) = theta.sin_cos();
+                map(sin.abs().powf(exponent), cos.abs().powf(exponent))
+            };
+            flatten(&at, 0.0, FRAC_PI_2, points);
+        }
+        points.push(aligned_end);
+    }
+}
+
+fn flatten(curve: &impl Fn(f64) -> Point, from: f64, to: f64, points: &mut Vec<Point>) {
+    const SEGMENTS: usize = 8;
+    const MAX_DEPTH: u32 = 12;
+
+    fn subdivide(
+        curve: &impl Fn(f64) -> Point,
+        (t0, p0): (f64, Point),
+        (t1, p1): (f64, Point),
+        depth: u32,
+        points: &mut Vec<Point>,
+    ) {
+        let tm = (t0 + t1) / 2.0;
+        let pm = curve(tm);
+        if depth < MAX_DEPTH && pm.distance(p0.midpoint(p1)) > TOLERANCE {
+            subdivide(curve, (t0, p0), (tm, pm), depth + 1, points);
+            subdivide(curve, (tm, pm), (t1, p1), depth + 1, points);
+        } else {
+            points.push(p1);
+        }
+    }
+
+    let mut previous = (from, curve(from));
+    points.push(previous.1);
+    for i in 1..=SEGMENTS {
+        let t = from + (to - from) * i as f64 / SEGMENTS as f64;
+        let next = (t, curve(t));
+        subdivide(curve, previous, next, 0, points);
+        previous = next;
+    }
+}
+
+fn normalized(v: Vec2) -> Vec2 {
+    let length = v.hypot();
+    if length == 0.0 { v } else { v / length }
+}
+
+fn perpendicular(v: Vec2) -> Vec2 {
+    Vec2::new(-v.y, v.x)
+}
+
+fn intersection((a0, a1): (Point, Point), (b0, b1): (Point, Point)) -> Option<Point> {
+    let a = a1 - a0;
+    let b = b1 - b0;
+    let denom = a.cross(b);
+    if denom.abs() < 1e-6 {
+        return None;
+    }
+    let scale = (b0 - a0).cross(b) / denom;
+    Some(a0 + a * scale)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use kurbo::Shape;
+
+    fn uniform(r: f64) -> NonUniformRoundedRectRadii {
+        let v = Vec2::new(r, r);
+        NonUniformRoundedRectRadii {
+            top_left: v,
+            top_right: v,
+            bottom_right: v,
+            bottom_left: v,
+        }
+    }
+
+    fn shapes(k: f64) -> CornerShapes {
+        CornerShapes {
+            top_left: k,
+            top_right: k,
+            bottom_right: k,
+            bottom_left: k,
+        }
+    }
+
+    fn area(k: f64, insets: Insets) -> f64 {
+        contour(
+            Rect::new(0.0, 0.0, 100.0, 100.0),
+            &uniform(40.0),
+            &shapes(k),
+            insets,
+        )
+        .area()
+        .abs()
+    }
+
+    const SQUARE: f64 = 100.0 * 100.0;
+    const CORNER: f64 = 40.0 * 40.0;
+
+    #[test]
+    fn round_matches_a_quarter_circle() {
+        let expected = SQUARE - 4.0 * CORNER * (1.0 - std::f64::consts::FRAC_PI_4);
+        assert!((area(1.0, Insets::ZERO) - expected).abs() < 12.0);
+    }
+
+    #[test]
+    fn bevel_cuts_each_corner_with_a_chord() {
+        let expected = SQUARE - 4.0 * CORNER / 2.0;
+        assert!((area(0.0, Insets::ZERO) - expected).abs() < 1e-6);
+    }
+
+    #[test]
+    fn square_and_notch_bound_the_family() {
+        assert!((area(f64::INFINITY, Insets::ZERO) - SQUARE).abs() < 1e-6);
+        assert!((area(f64::NEG_INFINITY, Insets::ZERO) - (SQUARE - 4.0 * CORNER)).abs() < 1e-6);
+        let scoop = SQUARE - 4.0 * CORNER * std::f64::consts::FRAC_PI_4;
+        assert!((area(-1.0, Insets::ZERO) - scoop).abs() < 12.0);
+    }
+
+    #[test]
+    fn shape_area_grows_with_k() {
+        let areas: Vec<f64> = [-4.0, -1.0, 0.0, 0.5, 1.0, 2.0, 5.0]
+            .iter()
+            .map(|&k| area(k, Insets::ZERO))
+            .collect();
+        assert!(areas.windows(2).all(|w| w[0] < w[1]), "{areas:?}");
+    }
+
+    #[test]
+    fn insets_move_the_contour_in_and_out() {
+        for k in [-1.0, 0.0, 1.0, 2.0] {
+            let border = area(k, Insets::ZERO);
+            assert!(area(k, Insets::uniform(10.0)) < border);
+            assert!(area(k, Insets::uniform(-10.0)) > border);
+        }
+    }
+
+    #[test]
+    fn overlapping_inner_corners_meet_where_they_cross() {
+        // A 100px square with 50px bevels is a diamond; its 10px inner edge is the diamond
+        // grown inwards by 10px along each side's normal, clipped to the inset square.
+        let rect = Rect::new(0.0, 0.0, 100.0, 100.0);
+        let inner = contour(rect, &uniform(50.0), &shapes(0.0), Insets::uniform(10.0));
+        let half_diagonal = 50.0 - 10.0 * std::f64::consts::SQRT_2;
+        assert!((inner.area().abs() - 2.0 * half_diagonal * half_diagonal).abs() < 1e-6);
+    }
+
+    #[test]
+    fn contour_stays_inside_its_moved_rect() {
+        let rect = Rect::new(0.0, 0.0, 200.0, 100.0);
+        let radii = NonUniformRoundedRectRadii {
+            top_left: Vec2::new(100.0, 50.0),
+            top_right: Vec2::new(30.0, 30.0),
+            bottom_right: Vec2::ZERO,
+            bottom_left: Vec2::new(20.0, 40.0),
+        };
+        for k in [-9.0, -2.0, 0.0, 0.7, 3.0] {
+            for inset in [-20.0, 0.0, 15.0] {
+                let bounds = rect.inset(-inset);
+                let path = contour(rect, &radii, &shapes(k), Insets::uniform(inset));
+                for el in path.elements() {
+                    if let kurbo::PathEl::MoveTo(p) | kurbo::PathEl::LineTo(p) = *el {
+                        assert!(
+                            bounds.inflate(1e-6, 1e-6).contains(p),
+                            "k={k} inset={inset}: {p:?} outside {bounds:?}"
+                        );
+                    }
+                }
+            }
+        }
+    }
+}

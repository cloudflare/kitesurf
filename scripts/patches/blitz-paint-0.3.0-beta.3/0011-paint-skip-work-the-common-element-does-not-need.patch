From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Sun, 9 Aug 2026 03:09:12 +0100
Subject: [PATCH] paint: skip work the common element does not need

Zero width on every border edge, and a background layer whose image is
none, are both the overwhelmingly common case, and both still ran the
full path: four colours resolved per element for the border, and a clip
path built and a layer pushed per background layer. The solid background
colour likewise built its box path before finding the colour
transparent.

Three per-element allocations were thrown away. The effect layer clip
and the descendant clip rect both built a box path only to take its
bounding box, but a box path's bbox is the box, since corner radii round
inward. The clip-path layer shape and the overflow clip shape were built
unconditionally, though maybe_with_layer ignores the shape when its
condition is false, which is the common case for an element.

element_cx built its fallback with unwrap_or, so every element on the
page constructed and heap-allocated a full initial ComputedValues and
dropped it unread; the fallback only fires when a node has no primary
styles. draw_outline likewise resolved the outline colour off the
cascade before checking outline-style, which is Auto and returns for
almost every element.

On a heavy page these two cost 260 us of a 719 us frame.
---
 src/render.rs            | 49 +++++++++++++++++++++++++---------------
 src/render/background.rs | 12 +++++-----
 src/render/border.rs     | 16 ++++++++-----
 3 files changed, 47 insertions(+), 30 deletions(-)

diff --git a/src/render.rs b/src/render.rs
index e8c45d2..deee9c6 100644
--- a/src/render.rs
+++ b/src/render.rs
@@ -469,12 +469,14 @@ impl<'dom, 'a> BlitzDomPainter<'dom, 'a> {
         // scrolled out of view is culled rather than drawn and clipped away. The box used
         // here matches the clip applied to the content below.
         let child_clip_rect = if should_clip {
+            // The rect is the path's bounding box, since corner radii only
+            // round inward, so there is no need to build a BezPath to ask.
             let clip_box = if is_text_input {
-                cx.frame.content_box_path()
+                cx.frame.content_box
             } else {
-                cx.frame.padding_box_path()
+                cx.frame.padding_box
             };
-            clip_rect.intersect(screen_transform.transform_rect_bbox(clip_box.bounding_box()))
+            clip_rect.intersect(screen_transform.transform_rect_bbox(clip_box))
         } else {
             clip_rect
         };
@@ -514,9 +516,15 @@ impl<'dom, 'a> BlitzDomPainter<'dom, 'a> {
             return;
         }

-        let default_clip = cx.frame.border_box_path();
-        let mut clip_path_for_layer = clip_path_shape.unwrap_or(default_clip);
-        clip_path_for_layer.apply_affine(Affine::scale(self.scale));
+        // Only the clip-path maybe_with_layer call below reads this, and it
+        // does nothing when its flag is false, the common case for an element.
+        let clip_path_for_layer = if has_clip_path {
+            let mut path = clip_path_shape.unwrap_or_else(|| cx.frame.border_box_path());
+            path.apply_affine(Affine::scale(self.scale));
+            path
+        } else {
+            BezPath::new()
+        };

         // clip-path clip ayer
         self.layer_manager.maybe_with_layer(
@@ -553,15 +561,14 @@ impl<'dom, 'a> BlitzDomPainter<'dom, 'a> {

                 // The effect layer covers the element's whole painted subtree:
                 // filter/opacity apply to overflowing content and to abspos
-
-                // descendants re-homed here for paint (a filter IS their
-                // containing block). Border-box-only clipping amputated them
-
-                // (WPT filtered-block-is-container: the abspos child painted
-                // in the transform reference but vanished under the filter).
-                // Live reach, not the resolve-time cache: pure-scroll frames
-                // skip resolve and the cached rect goes stale by the delta.
-                let mut effect_layer_clip = cx.frame.border_box_path().bounding_box();
+                // descendants re-homed here for paint (a filter is their
+                // containing block). Clipping to the border box alone cuts them
+                // off (WPT filtered-block-is-container).
+                // Use the live reach, not the resolve-time cache: pure-scroll
+                // frames skip resolve, so the cached rect goes stale by the delta.
+                // The border box path's bounding box is the border box, since
+                // corner radii only round inward, so no path is built here.
+                let mut effect_layer_clip = cx.frame.border_box;
                 effect_layer_clip = effect_layer_clip.union(*cx.node.scrollable_overflow());
                 if let Some((x0, y0, x1, y1)) = cx.node.live_rehomed_reach() {
                     effect_layer_clip = effect_layer_clip.union(Rect::new(
@@ -601,10 +608,16 @@ impl<'dom, 'a> BlitzDomPainter<'dom, 'a> {
                         cx.stroke_devtools(scene);

                         // TODO: allow layers with opacity to be unclipped (overflow: visible)
-                        let clip = if is_text_input {
-                            &cx.frame.content_box_path()
+                        // Only built when it will actually be used as a clip;
+                        // maybe_with_layer ignores it when should_clip is false.
+                        let clip = &if should_clip {
+                            if is_text_input {
+                                cx.frame.content_box_path()
+                            } else {
+                                cx.frame.padding_box_path()
+                            }
                         } else {
-                            &cx.frame.padding_box_path()
+                            BezPath::new()
                         };

                         // Clip layer if box requires clipping. Opacity set to 1.0
diff --git a/src/render/background.rs b/src/render/background.rs
index b1e7070..6d9c878 100644
--- a/src/render/background.rs
+++ b/src/render/background.rs
@@ -144,8 +144,7 @@ impl ElementCx<'_, '_> {
         // The background color is clipped by the clip of the last layer in the list
         let last_clip = *get_cyclic(&bg_styles.background_clip.0, layer_count - 1);
         if last_clip != StyloBackgroundClip::Text {
-            let background_clip_path = self.box_path(last_clip.into());
-            self.draw_solid_bg(scene, &background_clip_path);
+            self.draw_solid_bg(scene, last_clip.into());
         }

         for idx in (0..layer_count).rev() {
@@ -335,17 +334,18 @@ impl ElementCx<'_, '_> {
         }
     }

-    fn draw_solid_bg(&self, scene: &mut impl PaintScene, shape: &BezPath) {
+    fn draw_solid_bg(&self, scene: &mut impl PaintScene, css_box: BoxModelBox) {
         let current_color = self.style.clone_color();
         let background_color = &self.style.get_background().background_color;
         let bg_color = background_color
             .resolve_to_absolute(&current_color)
             .as_srgb_color();

-        if bg_color != Color::TRANSPARENT {
-            // Fill the color
-            scene.fill(Fill::NonZero, self.transform, bg_color, None, shape);
+        if bg_color == Color::TRANSPARENT {
+            return;
         }
+        let shape = self.box_path(css_box);
+        scene.fill(Fill::NonZero, self.transform, bg_color, None, &shape);
     }

     /// Whether the layer is positioned against the viewport
diff --git a/src/render/border.rs b/src/render/border.rs
index c7ecb2e..196f4d7 100644
--- a/src/render/border.rs
+++ b/src/render/border.rs
@@ -147,6 +147,11 @@ fn sample_points_along_path(path: &BezPath, spacing: f64, count: usize) -> Vec<P
 impl ElementCx<'_, '_> {
     /// Draw all borders for a node
     pub(crate) fn draw_border(&self, scene: &mut impl PaintScene) {
+        let widths = self.frame.border_width;
+        if widths.x0 == 0.0 && widths.y0 == 0.0 && widths.x1 == 0.0 && widths.y1 == 0.0 {
+            return;
+        }
+
         let style = &*self.style;
         let border = style.get_border();
         let current_color = style.clone_color();
@@ -601,12 +606,6 @@ impl ElementCx<'_, '_> {
     pub(crate) fn draw_outline(&self, scene: &mut impl PaintScene) {
         let outline = self.style.get_outline();

-        let current_color = self.style.clone_color();
-        let color = outline
-            .outline_color
-            .resolve_to_absolute(&current_color)
-            .as_srgb_color();
-
         let style = match outline.outline_style {
             OutlineStyle::Auto => return,
             OutlineStyle::BorderStyle(style) => style,
@@ -626,6 +625,11 @@ impl ElementCx<'_, '_> {
             | BorderStyle::Double => self.frame.outline(),
         };

+        let current_color = self.style.clone_color();
+        let color = outline
+            .outline_color
+            .resolve_to_absolute(&current_color)
+            .as_srgb_color();
         scene.fill(Fill::NonZero, self.transform, color, None, &path);
     }
 }

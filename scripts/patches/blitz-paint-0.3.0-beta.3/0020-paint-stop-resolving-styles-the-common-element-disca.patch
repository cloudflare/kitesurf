From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Sun, 9 Aug 2026 03:09:25 +0100
Subject: [PATCH] paint: stop resolving styles the common element discards

element_cx built its fallback with unwrap_or, so every element on the
page constructed and heap-allocated a full initial ComputedValues and
dropped it unread; the fallback only fires when a node has no primary
styles. draw_outline likewise resolved the outline colour off the
cascade before checking outline-style, which is Auto and returns for
almost every element.

On a heavy page these two cost 260 us of a 719 us frame.
---
 src/render/border.rs | 11 +++++------
 1 file changed, 5 insertions(+), 6 deletions(-)

diff --git a/src/render/border.rs b/src/render/border.rs
index a0147c2..196f4d7 100644
--- a/src/render/border.rs
+++ b/src/render/border.rs
@@ -606,12 +606,6 @@ impl ElementCx<'_, '_> {
     pub(crate) fn draw_outline(&self, scene: &mut impl PaintScene) {
         let outline = self.style.get_outline();

-        let current_color = self.style.clone_color();
-        let color = outline
-            .outline_color
-            .resolve_to_absolute(&current_color)
-            .as_srgb_color();
-
         let style = match outline.outline_style {
             OutlineStyle::Auto => return,
             OutlineStyle::BorderStyle(style) => style,
@@ -631,6 +625,11 @@ impl ElementCx<'_, '_> {
             | BorderStyle::Double => self.frame.outline(),
         };

+        let current_color = self.style.clone_color();
+        let color = outline
+            .outline_color
+            .resolve_to_absolute(&current_color)
+            .as_srgb_color();
         scene.fill(Fill::NonZero, self.transform, color, None, &path);
     }
 }

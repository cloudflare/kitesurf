From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Wed, 29 Jul 2026 12:11:10 +0100
Subject: [PATCH] Clip replaced-svg painting to the element's content box

An svg viewport establishes overflow:hidden by default, but draw_svg
handed render_svg_tree the object-fit transform with no clip layer, so
tree content outside the viewBox painted past the element's box. The
visible case: shrinking a viewBox at runtime (viewBox="0 0 10 10" on a
200px element) scales user units 20x, and the pre-shrink geometry bled
across the page. Push a clip layer over the content box around the tree
render; Mix::Normal with full alpha keeps it a pure clip.
---
 src/render.rs | 39 +++++++++++++++++++++++++++++++++++++++
 1 file changed, 39 insertions(+)

diff --git a/src/render.rs b/src/render.rs
index e602786..246fcd7 100644
--- a/src/render.rs
+++ b/src/render.rs
@@ -1146,7 +1146,46 @@ impl ElementCx<'_, '_> {
             .pre_scale_non_uniform(x_scale, y_scale)
             .then_translate(Vec2 { x, y });

+        // Clip to the content box. An svg viewport establishes
+        // overflow:hidden by default (UA stylesheet), but render_svg_tree
+        // paints the tree unclipped, so content past the viewBox (for
+        // example after a dynamic viewBox shrink scales user units up)
+        // would bleed outside the element. Only an inline <svg> element ties
+        // its CSS overflow to viewport clipping (author overflow:visible
+        // paints outside). Any other host of svg content, such as an <img>,
+        // is a replaced element that never bleeds, whatever its computed
+        // overflow says (img's initial overflow is visible).
+        let clips = {
+            let is_inline_svg_element = self.element.name.local.as_ref() == "svg";
+            if is_inline_svg_element {
+                let box_styles = self.style.get_box();
+                !matches!(box_styles.overflow_x, Overflow::Visible)
+                    || !matches!(box_styles.overflow_y, Overflow::Visible)
+            } else {
+                true
+            }
+        };
+        if clips {
+            let clip_rect = kurbo::Rect::new(
+                self.frame.content_box.origin().x,
+                self.frame.content_box.origin().y,
+                self.frame.content_box.origin().x + self.frame.content_box.width(),
+                self.frame.content_box.origin().y + self.frame.content_box.height(),
+            );
+            scene.push_layer(
+                Fill::NonZero,
+                peniko::Mix::Normal,
+                1.0,
+                self.transform,
+                &clip_rect,
+                None,
+                None,
+            );
+        }
         anyrender_svg::render_svg_tree(scene, svg, transform);
+        if clips {
+            scene.pop_layer();
+        }
     }

     fn draw_image(&self, scene: &mut impl PaintScene) {

From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Wed, 29 Jul 2026 14:18:40 +0100
Subject: [PATCH] Zero disables rendering; negative is an error that ignores
 the viewBox

has_rendering_disabling_viewbox treated any non-positive extent as
disabling. SVG2 distinguishes the two: a zero viewBox extent disables
rendering of the element, while a negative extent is an error, and
error processing ignores the attribute, so the element renders its
normal view. Treat only a zero extent as disabling. This fixes the
dynamic-invalidation case in WPT viewBox-baseVal-change-invalid, where
a valid viewBox flips to width -100 and the content must come back,
unscaled.
---
 src/parser/converter.rs | 17 +++++++++++++++--
 1 file changed, 15 insertions(+), 2 deletions(-)

diff --git a/src/parser/converter.rs b/src/parser/converter.rs
index 70a42e6..f9e8856 100644
--- a/src/parser/converter.rs
+++ b/src/parser/converter.rs
@@ -319,16 +319,29 @@ impl<'a, 'input: 'a> SvgNode<'a, 'input> {
     /// zero viewBox from a missing one. Only a well-formed four-number
     /// value disables rendering; anything unparseable keeps usvg's existing
     /// lenient behaviour of ignoring the attribute.
+    ///
+    /// Only a zero extent disables rendering. A negative extent is an
+    /// error, and error processing ignores the attribute, so the element
+    /// renders its normal view.
     pub fn has_rendering_disabling_viewbox(&self) -> bool {
         let Some(raw) = self.attribute::<&str>(AId::ViewBox) else {
             return false;
         };
-        let nums: Vec<f64> = raw
+        // Every token must parse (filter_map would let "0 0 bogus 0 100"
+        // masquerade as four numbers) and be finite.
+        let tokens: Vec<&str> = raw
             .split(|c: char| c == ',' || c.is_ascii_whitespace())
             .filter(|s| !s.is_empty())
+            .collect();
+        if tokens.len() != 4 {
+            return false;
+        }
+        let nums: Vec<f64> = tokens
+            .iter()
             .filter_map(|s| s.parse::<f64>().ok())
+            .filter(|n| n.is_finite())
             .collect();
-        nums.len() == 4 && (nums[2] <= 0.0 || nums[3] <= 0.0)
+        nums.len() == 4 && nums[2] >= 0.0 && nums[3] >= 0.0 && (nums[2] == 0.0 || nums[3] == 0.0)
     }

     pub fn resolve_length(&self, aid: AId, state: &State, def: f32) -> f32 {

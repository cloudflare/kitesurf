+/// ASCII-case-insensitive "calc(" prefix test over bytes, immune to the
+/// UTF-8 boundary panic a `&str[..5]` slice hits on multibyte input.
+pub(crate) fn starts_with_calc(raw: &str) -> bool {
+    let b = raw.trim_start().as_bytes();
+    b.len() >= 5 && b[..5].eq_ignore_ascii_case(b"calc(")

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Tue, 28 Jul 2026 17:22:43 +0100
Subject: [PATCH] Apply SVG2 geometry properties from CSS

cx, cy, r, rx, ry, x, y, width and height became presentation attributes
in SVG2, so a stylesheet may set them: `circle { r: 65px }` is valid and
WPT's svg/geometry reftests are built on it. is_presentation() predates
that, so every such declaration was dropped: shapes styled only by CSS
rendered at their initial geometry, or not at all.

They are also added to is_non_inheritable(): is_inheritable() is defined
as is_presentation() minus that list, so without it an ancestor's
`style="r: 10px"` would cascade a radius onto every descendant shape.

`d` is excluded on purpose. As a property it takes path("...") function
syntax, which the attribute value parser does not accept.

Values the length parser cannot handle (calc(), auto) are dropped as
before, leaving the initial geometry. For a required dimension that
means the shape is not rendered, matching the spec's treatment of an
invalid value.
---
 src/parser/svgtree/mod.rs | 28 ++++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/src/parser/svgtree/mod.rs b/src/parser/svgtree/mod.rs
index 1618f32..7694a17 100644
--- a/src/parser/svgtree/mod.rs
+++ b/src/parser/svgtree/mod.rs
@@ -752,6 +752,21 @@ impl AId {
                 | AId::WhiteSpace
                 | AId::WordSpacing
                 | AId::WritingMode
+                // SVG2 geometry properties: settable from CSS, not just as
+                // attributes. `circle { r: 65px }` is a valid stylesheet.
+                // https://www.w3.org/TR/SVG2/geometry.html
+                // `d` is deliberately absent: as a property it takes
+                // `path("...")` function syntax, which the attribute
+                // parser here does not accept.
+                | AId::Cx
+                | AId::Cy
+                | AId::R
+                | AId::Rx
+                | AId::Ry
+                | AId::X
+                | AId::Y
+                | AId::Width
+                | AId::Height
         )
     }

@@ -840,5 +855,18 @@ fn is_non_inheritable(id: AId) -> bool {
             | AId::TextDecoration
             | AId::Transform
             | AId::TransformOrigin
+            // Geometry properties are presentation attributes but are not
+            // inherited: without this a `<g style="r: 10px">` would push
+            // its radius onto every descendant shape. is_inheritable() is
+            // is_presentation() minus this list, so they must be here.
+            | AId::Cx
+            | AId::Cy
+            | AId::R
+            | AId::Rx
+            | AId::Ry
+            | AId::X
+            | AId::Y
+            | AId::Width
+            | AId::Height
     )
 }

-/// Write the `hsl()` or `hwb()` functional form while preserving `none`.
-pub(crate) fn write_hsl_hwb_functional<W>(
-    color: &AbsoluteColor,
-    dest: &mut CssWriter<W>,
-    c1_percent: bool,
-    c2_percent: bool,
-) -> fmt::Result
+/// Write the `hsl()` or `hwb()` functional form while preserving `none`. The second and third
+/// components are percentages in both forms, whichever way the author wrote them.
+fn write_hsl_hwb_functional<W>(color: &AbsoluteColor, dest: &mut CssWriter<W>) -> fmt::Result
 where
     W: Write,
 {
     debug_assert!(matches!(color.color_space, ColorSpace::Hsl | ColorSpace::Hwb));
     dest.write_str(if color.color_space == ColorSpace::Hsl { "hsl(" } else { "hwb(" })?;
     ModernComponent(&color.c0()).to_css(dest)?;
-    for (component, percent) in [(color.c1(), c1_percent), (color.c2(), c2_percent)] {
+    for component in [color.c1(), color.c2()] {
         dest.write_char(' ')?;
         ModernComponent(&component).to_css(dest)?;
-        if percent && matches!(component, Some(value) if value.is_finite()) {
+        if matches!(component, Some(value) if value.is_finite()) {
             dest.write_char('%')?;
         }
     }
@@ -126,12 +122,7 @@ impl ToCss for AbsoluteColor {
                 if self.flags.contains(ColorFlags::IS_LEGACY_SRGB) {
                     self.into_srgb_legacy().to_css(dest)
                 } else if self.has_none_components() {
-                    write_hsl_hwb_functional(
-                        self,
-                        dest,
-                        self.flags.contains(ColorFlags::C1_AS_PERCENT),
-                        self.flags.contains(ColorFlags::C2_AS_PERCENT),
-                    )
+                    write_hsl_hwb_functional(self, dest)
                 } else {
                     self.to_color_space(ColorSpace::Srgb).to_css(dest)
                 }

+/// Normalize a hue into [0, 360), but keep an infinite or NaN hue for the specified value to
+/// serialize. Computing the color turns it into 0 (AbsoluteColor::zero_non_finite_hue).
+fn normalize_specified_hue(hue: f32) -> f32 {
+    if hue.is_finite() { normalize_hue(hue) } else { hue }
+}

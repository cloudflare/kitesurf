 impl<C: style_traits::ToCss> style_traits::ToCss for ColorFunction<C> {
     fn to_css<W>(&self, dest: &mut style_traits::CssWriter<W>) -> std::fmt::Result
     where
diff --git a/color/convert.rs b/color/convert.rs
index 53787f0..1ba9b80 100644
--- a/color/convert.rs
+++ b/color/convert.rs
@@ -18,9 +18,13 @@ use crate::values::normalize;
 type Transform = euclid::default::Transform3D<f32>;
 type Vector = euclid::default::Vector3D<f32>;

-/// Normalize hue into [0, 360).
+/// Normalize hue into [0, 360). An infinite or NaN hue becomes 0 degrees.
+/// <https://drafts.csswg.org/css-color-4/#hue-syntax>
 #[inline]
 pub fn normalize_hue(hue: f32) -> f32 {
+    if !hue.is_finite() {
+        return 0.;
+    }
     hue - 360. * (hue / 360.).floor()
 }

@@ -66,8 +70,10 @@ pub fn hsl_to_rgb(from: &ColorComponents) -> ColorComponents {
         }
     }

-    // Convert missing components to 0.0.
+    // Convert missing components to 0.0, and a non-finite hue to 0deg before the hue_to_rgb
+    // offsets keep it infinite.
     let ColorComponents(hue, saturation, lightness) = from.map(normalize);
+    let hue = normalize_hue(hue);
     let saturation = saturation / 100.0;
     let lightness = lightness / 100.0;

diff --git a/color/mod.rs b/color/mod.rs
index 311569e..1d0a571 100644
--- a/color/mod.rs
+++ b/color/mod.rs
@@ -375,6 +375,20 @@ impl From<ColorComponent<f32>> for ComponentDetails {
 }

 impl AbsoluteColor {
+    /// Turn an infinite or NaN hue into 0 degrees, as computing the color does. The specified
+    /// value keeps it, so that it serializes as calc(infinity) or calc(NaN).
+    /// <https://drafts.csswg.org/css-color-4/#hue-syntax>
+    pub fn zero_non_finite_hue(&mut self) {
+        let hue = match self.color_space {
+            ColorSpace::Hsl | ColorSpace::Hwb => &mut self.components.0,
+            ColorSpace::Lch | ColorSpace::Oklch => &mut self.components.2,
+            _ => return,
+        };
+        if !hue.is_finite() {
+            *hue = 0.0;
+        }
+    }
+
     /// Returns whether any color component or alpha is `none`.
     #[inline]
     pub fn has_none_components(&self) -> bool {

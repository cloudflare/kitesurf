-            measure_entries: [NONE_MEASURE_ENTRY; CACHE_SIZE],
-            recently_used_entries: 0,
-            next_measure_entry: 0,
-            is_empty: true,
-            mode: CacheMode::INITIAL,
-        }
+        Self { inner: None }
     }


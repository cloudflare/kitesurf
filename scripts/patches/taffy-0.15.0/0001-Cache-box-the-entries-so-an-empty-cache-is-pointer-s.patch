-                self.final_layout_entry.as_ref().filter(|entry| entry.key == key).map(|e| e.content.clone())
+                inner.final_layout_entry.as_ref().filter(|entry| entry.key == key).map(|e| e.content.clone())
             }
             RunMode::ComputeSize => {
-                for (index, entry) in self.measure_entries.iter().enumerate() {
+                for (index, entry) in inner.measure_entries.iter().enumerate() {
                     let Some(entry) = entry else { continue };
                     if entry.key.kd_available_space == key.kd_available_space
                         && entry.key.known_dimensions_are_definite == key.known_dimensions_are_definite
                         && (entry.key.x_axis_parent_size() == key.x_axis_parent_size())
                         && entry.key.size_is_valid_for(&key)
                     {
-                        self.recently_used_entries |= 1 << index;
+                        inner.recently_used_entries |= 1 << index;
                         return Some(LayoutOutput::from_outer_size(entry.content));
                     }
                 }
@@ -285,19 +297,17 @@ impl Cache {
             return;
         }
         let mode = CacheMode::from(input);
-        if self.mode != mode {
+        if self.inner.as_ref().is_some_and(|inner| inner.mode != mode) {
+            // A live box is never empty, so every mode change here drops entries
             #[cfg(all(debug_assertions, feature = "std"))]
-            if !self.is_empty {
-                MODE_CHANGE_EVICTIONS.with(|count| count.set(count.get() + 1));
-            }
+            MODE_CHANGE_EVICTIONS.with(|count| count.set(count.get() + 1));
             self.clear();
-            self.mode = mode;
         }
         let key = CacheKey::from(input);
         match input.run_mode {
             RunMode::PerformLayout => {
-                self.is_empty = false;
-                self.final_layout_entry = Some(CacheEntry { key, content: layout_output })
+                let inner = self.inner.get_or_insert_with(|| Box::new(CacheInner::new(mode)));
+                inner.final_layout_entry = Some(CacheEntry { key, content: layout_output })
             }
             RunMode::ComputeSize => {
                 // Measure entries only store the size, and cache hits are reconstructed with
@@ -310,27 +320,27 @@ impl Cache {
                 {
                     return;
                 }
-                self.is_empty = false;
+                let inner = self.inner.get_or_insert_with(|| Box::new(CacheInner::new(mode)));
                 if let Some(index) =
-                    self.measure_entries.iter().position(|entry| entry.as_ref().is_some_and(|entry| entry.key == key))
+                    inner.measure_entries.iter().position(|entry| entry.as_ref().is_some_and(|entry| entry.key == key))
                 {
-                    self.measure_entries[index].as_mut().unwrap().content = layout_output.size;

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Tue, 1 Sep 2026 19:46:49 +0100
Subject: [PATCH] Account for table ancestors when snapping tracks

Taffy rounds from document-wide unrounded coordinates. Include every
layout ancestor in the table content origin so borders remain aligned
when the table sits below an off-grid parent.
---
 src/resolve.rs | 15 +--------------
 1 file changed, 1 insertion(+), 14 deletions(-)

diff --git a/src/resolve.rs b/src/resolve.rs
index 94361d4..bef94f1 100644
--- a/src/resolve.rs
+++ b/src/resolve.rs
@@ -775,7 +775,7 @@ impl BaseDocument {
         // Paint reads table tracks rather than the cell layouts rounded above.
         let (grid_x, grid_y) = self.round_grid;
         if grid_x > 1.0 || grid_y > 1.0 {
-            for (_, node) in self.nodes.iter() {
+            for (node_id, node) in self.nodes.iter() {
                 let Some(element) = node.element_data() else {
                     continue;
                 };
@@ -785,12 +785,6 @@ impl BaseDocument {
                 let Some(grid_info) = &mut *table.computed_grid_info.borrow_mut() else {
                     continue;
                 };
-<<<<<<< HEAD
-                let layout = node.final_layout();
-                snap_table_tracks(
-                    &mut grid_info.columns,
-                    layout.border.left + layout.padding.left,
-=======
                 let mut table_x = 0.0;
                 let mut table_y = 0.0;
                 let mut ancestor_id = Some(node_id);
@@ -803,18 +797,11 @@ impl BaseDocument {
                 snap_table_tracks(
                     &mut grid_info.columns,
                     table_x,
-                    (table_x / grid_x).round() * grid_x,
->>>>>>> 8fd1df8 (fixup! Snap terminal table tracks with cell layout)
                     grid_x,
                 );
                 snap_table_tracks(
                     &mut grid_info.rows,
-<<<<<<< HEAD
-                    layout.border.top + layout.padding.top,
-=======
                     table_y,
-                    (table_y / grid_y).round() * grid_y,
->>>>>>> 8fd1df8 (fixup! Snap terminal table tracks with cell layout)
                     grid_y,
                 );
             }

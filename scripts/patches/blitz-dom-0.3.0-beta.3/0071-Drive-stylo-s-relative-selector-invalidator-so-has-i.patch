From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Tue, 4 Aug 2026 23:45:35 +0100
Subject: [PATCH] Drive stylo's relative-selector invalidator so :has()
 invalidates

stylo ships a complete relative-selector invalidator but nothing ever
constructed it: Gecko drives it from C++ `RestyleManager`, and blitz has
no equivalent, so the pass simply never ran. `:has()` still appeared to
work because `set_attribute` stamped a blanket `restyle_subtree()` on
the mutated node's parent, which recascades an anchor that is the
parent, or that is a sibling of the mutated node, and nothing else. So
`#p:has(.t)` held at depth 1 and every deeper anchor silently kept its
stale style. That blanket hint carried the upstream TODO asking for
exactly this.

`resolve_stylist` now runs the invalidator over the pass's snapshots,
before `traverse_dom`. Ordering matters: stylo's `invalidated_self`
writes RESTYLE_SELF into the anchor's own `ElementData` and does not
mark anything, but the mutation already marked the whole root-to-node
spine `dirty_descendants`, so the traversal reaches every ancestor and
every sibling of an ancestor with no further marking.

Both the element's live keys and the snapshot's are looked up. Only
looking at the element is wrong in the removal direction: the class that
just went away is already off the element and only the snapshot still
lists it, so the anchor would latch on and never invalidate back.
`snapshot_node` marks every attribute changed rather than diffing, so
matching that coarseness is consistent rather than wasteful.

Wiring the state map fixes a second, worse case: `:has(:focus)` was dead
at every depth, including 1, because `set_focus` snapshots the node
without stamping the parent hint that `set_attribute` does.

Dropping the blanket hint is what makes this a win rather than a wash.
On a flat 400-child subtree with one unrelated attribute write per
resolve, 28.3ms -> 22.6ms; 200 children 14.6 -> 11.5; 40 children 3.55
-> 2.61.

Should land upstream: blitz.
---
 src/mutator.rs |  15 ++-----
 src/stylo.rs   | 108 +++++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 112 insertions(+), 11 deletions(-)

diff --git a/src/mutator.rs b/src/mutator.rs
index 19d9059..1dc0eba 100644
--- a/src/mutator.rs
+++ b/src/mutator.rs
@@ -314,17 +314,10 @@ impl DocumentMutator<'_> {
             }
             node.mark_damaged();

-            // TODO: make this fine grained / conditional based on ElementSelectorFlags
-            let parent = node.parent;
-            if let Some(parent_id) = parent {
-                let parent = &mut self.doc.nodes[parent_id];
-                if let Some(mut data) = parent
-                    .try_stylo_element_data_mut()
-                    .and_then(|s| s.get_mut())
-                {
-                    data.hint |= RestyleHint::restyle_subtree();
-                }
-            }
+            // No blanket restyle_subtree() on the parent here: it would
+            // recascade every sibling on every attribute write. `:has()`
+            // anchors invalidate through stylo's relative-selector
+            // invalidator (resolve_stylist).

             // Mark ancestors dirty so the style traversal visits this subtree.
             // Without this, the traversal may skip nodes with pending RestyleHint/damage
diff --git a/src/stylo.rs b/src/stylo.rs
index f1650df..1dcfaa3 100644
--- a/src/stylo.rs
+++ b/src/stylo.rs
@@ -2,6 +2,7 @@
 //!

 use blitz_traits::node_id::NodeId;
+use std::marker::PhantomData;
 use std::ptr::NonNull;
 use std::sync::Mutex;
 use std::sync::atomic::Ordering;
@@ -26,6 +27,9 @@ use style::bloom::each_relevant_element_hash;
 use style::color::AbsoluteColor;
 use style::data::{ElementDataMut, ElementDataRef};
 use style::global_style_data::STYLE_THREAD_POOL;
+use style::invalidation::element::element_wrapper::ElementSnapshot;
+use style::invalidation::element::invalidator::SiblingTraversalMap;
+use style::invalidation::element::relative_selector::RelativeSelectorInvalidator;
 use style::invalidation::element::restyle_hints::RestyleHint;
 use style::properties::ComputedValues;
 use style::properties::{Importance, PropertyDeclaration};
@@ -152,6 +156,8 @@ impl crate::document::BaseDocument {
         }
         drop(sets);

+        self.invalidate_relative_selectors();
+
         // Build the style context used by the style traversal
         let context = SharedStyleContext {
             traversal_flags: TraversalFlags::empty(),
@@ -255,6 +261,108 @@ impl crate::document::BaseDocument {

         Some(styles.primary().clone())
     }
+
+    /// Run stylo's relative-selector invalidator over this pass's snapshots so
+    /// a `:has()` anchor is recascaded when its subject changes. Gecko drives
+    /// this from C++ `RestyleManager`; blitz never did, so the anchor was only
+    /// recascaded when it happened to fall inside the blunt `restyle_subtree()`
+    /// that `set_attribute` stamped on the mutated node's parent.
+    ///
+    /// Must run before `traverse_dom`: `invalidated_self` writes RESTYLE_SELF
+    /// into the anchor's `ElementData`, and the mutation already marked the
+    /// root-to-node spine `dirty_descendants`, so the traversal reaches every
+    /// ancestor and every sibling of an ancestor with no extra marking.
+    fn invalidate_relative_selectors(&self) {
+        let quirks_mode = self.stylist.quirks_mode();
+
+        for (opaque, snapshot) in self.snapshots.iter() {
+            let Some(node) = self.nodes.get(NodeId::from_u64(opaque.id() as u64)) else {
+                continue;
+            };
+            let Some(element) = TNode::as_element(&node) else {
+                continue;
+            };
+
+            // The snapshot holds the pre-mutation state, so the XOR is exactly
+            // the bits a `:has(:hover)`-shaped dependency can have flipped.
+            let state_changes = snapshot
+                .state
+                .map_or_else(ElementState::empty, |state| state ^ element.state());
+            let has_attrs = snapshot.has_attrs();
+            let snapshot_id = if has_attrs { snapshot.id_attr() } else { None };
+
+            RelativeSelectorInvalidator {
+                element,
+                quirks_mode,
+                snapshot_table: Some(&self.snapshots),
+                invalidated: |_, _| {},
+                sibling_traversal_map: SiblingTraversalMap::default(),
+                _marker: PhantomData,
+            }
+            .invalidate_relative_selectors_for_this(
+                &self.stylist,
+                |element, scope, data, quirks_mode, collector| {
+                    let map = data.relative_selector_invalidation_map();
+
+                    // A key the mutation removed is already gone from the
+                    // element but still in the snapshot, and vice versa.
+
+                    // Both sides have to be looked up, or the anchor latches on
+                    // and never invalidates back when the subject goes away.
+                    for id in element.id().into_iter().chain(snapshot_id) {
+                        for dep in map.id_to_selector.get(id, quirks_mode).into_iter().flatten() {
+                            collector.add_dependency(dep, *element, scope);
+                        }
+                    }
+
+                    let mut each_class = |class: &AtomIdent| {
+                        for dep in map
+                            .class_to_selector
+                            .get(class, quirks_mode)
+                            .into_iter()
+                            .flatten()
+                        {
+                            collector.add_dependency(dep, *element, scope);
+                        }
+                    };
+                    element.each_class(&mut each_class);
+                    if has_attrs {
+                        snapshot.each_class(&mut each_class);
+                    }
+
+                    let mut each_attr = |name: &GenericAtomIdent<LocalNameStaticSet>| {
+                        for dep in map
+                            .other_attribute_affecting_selectors
+                            .get(name)
+                            .into_iter()
+                            .flatten()
+                        {
+                            collector.add_dependency(dep, *element, scope);
+                        }
+                    };
+                    element.each_attr_name(&mut each_attr);
+                    snapshot.each_attr_changed(&mut each_attr);
+
+                    if state_changes.is_empty() {
+                        return;
+                    }
+                    map.state_affecting_selectors.lookup_with_additional(
+                        *element,
+                        quirks_mode,
+                        None,
+                        &[],
+                        state_changes,
+                        |dep| {
+                            if dep.state.intersects(state_changes) {
+                                collector.add_dependency(&dep.dep, *element, scope);
+                            }
+                            true
+                        },
+                    );
+                },
+            );
+        }
+    }
 }

 /// A handle to a node that Servo's style traits are implemented against

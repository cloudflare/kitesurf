From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Sun, 4 Oct 2026 11:37:54 +0100
Subject: [PATCH] map re-homed paint reach through each box's transform

Floating UI (Base UI, Radix, MUI) parks every popup at left:0;top:0
and moves it with transform: translate(...). The popup is an abspos
box re-homed to its containing block, so the hit descent only reaches
it through its paint parent's rehomed_reach; and that rect was built
from taffy's untransformed location and size. It sat at the origin,
the paint parent pruned the point, and no pointer event reached a
dropdown item (Dash's user menu never opened its Appearance submenu).

rehomed_paint_rect maps the box and its overflow through the box's own
transform, and folds in scrollable_overflow, which already unions the
transformed boxes below it. compute_rehomed_reach and
live_rehomed_reach both use it. The reach pass already runs after
resolve_transforms, so it reads this resolve's transforms.
---
 src/node/node.rs | 45 +++++++++++++++++++++++++++++++++------------
 src/resolve.rs   | 18 ++++++------------
 2 files changed, 39 insertions(+), 24 deletions(-)

diff --git a/src/node/node.rs b/src/node/node.rs
index 27d0914..2413f4d 100644
--- a/src/node/node.rs
+++ b/src/node/node.rs
@@ -1643,12 +1643,40 @@ impl Node {
         taffy::Point { x: 0.0, y: 0.0 }
     }

+    /// This re-homed paint child's painted extent in `host`'s CSS-px space:
+    /// its layout box and overflow, mapped through its own transform.
+    /// Floating UI parks every popup at `left:0;top:0` and moves it with
+    /// `transform: translate(...)`, so a reach built from layout alone sat
+    /// at the origin and the hit descent pruned the popup at its paint
+    /// parent. `scrollable_overflow` is device px and already unions the
+    /// transformed boxes below this one, so read it once transforms resolve.
+    pub fn rehomed_paint_rect(&self, host: NodeId, scale: f64) -> (f32, f32, f32, f32) {
+        let t = self.rehomed_paint_translate(host);
+        let layout = self.final_layout();
+        let w = layout.size.width.max(layout.scrollable_overflow_rect.right) as f64 * scale;
+        let h = layout.size.height.max(layout.scrollable_overflow_rect.bottom) as f64 * scale;
+        let local = KurboRect::new(0.0, 0.0, w, h).union(*self.scrollable_overflow());
+        let mut full = Affine::translate((
+            (t.x + layout.location.x) as f64 * scale,
+            (t.y + layout.location.y) as f64 * scale,
+        ));
+        if let Some(transform) = self.transform().as_deref() {
+            full *= *transform;
+        }
+        let r = full.transform_rect_bbox(local);
+        (
+            (r.x0 / scale) as f32,
+            (r.y0 / scale) as f32,
+            (r.x1 / scale) as f32,
+            (r.y1 / scale) as f32,
+        )
+    }
+
     // Live union of re-homed paint-child boxes in this node's own
     // coordinate space. rehomed_paint_translate reads scroll offsets
-
     // at call time, unlike the resolve-time rehomed_reach cache, so
     // this stays correct on pure-scroll frames that skip resolve.
-    pub fn live_rehomed_reach(&self) -> Option<(f32, f32, f32, f32)> {
+    pub fn live_rehomed_reach(&self, scale: f64) -> Option<(f32, f32, f32, f32)> {
         let children = self.rehomed_paint_children.borrow();
         if children.is_empty() {
             return None;
@@ -1657,17 +1685,10 @@ impl Node {
         let mut rect: Option<(f32, f32, f32, f32)> = None;
         for &child_id in children.iter() {
             let Some(child) = tree.get(child_id) else { continue };
-            let t = child.rehomed_paint_translate(self.id);
-            let loc = child.final_layout().location;
-            let size = child.final_layout().size;
-            let overflow = child.final_layout().scrollable_overflow_rect;
-            let x0 = t.x + loc.x;
-            let y0 = t.y + loc.y;
-            let w = size.width.max(overflow.right);
-            let h = size.height.max(overflow.bottom);
+            let r = child.rehomed_paint_rect(self.id, scale);
             rect = Some(match rect {
-                None => (x0, y0, x0 + w, y0 + h),
-                Some(a) => (a.0.min(x0), a.1.min(y0), a.2.max(x0 + w), a.3.max(y0 + h)),
+                None => r,
+                Some(a) => (a.0.min(r.0), a.1.min(r.1), a.2.max(r.2), a.3.max(r.3)),
             });
         }
         rect
diff --git a/src/resolve.rs b/src/resolve.rs
index 7fce7b6..947406b 100644
--- a/src/resolve.rs
+++ b/src/resolve.rs
@@ -269,8 +269,10 @@ impl BaseDocument {

         // Re-homed paint boxes live outside their flow parent's taffy
         // bounds; compute the reach rects paint-cull and hit-prune widen
-        // by. Must run AFTER taffy layout (the one geometry pass in resolve
-        // that is never stale) and after the paint tree records re-homes.
+        // by. Must run after taffy layout (the one geometry pass in resolve
+        // that is never stale), after the transform pass, whose transforms
+        // and overflow it maps each re-homed box through, and after the
+        // paint tree records re-homes.
         self.compute_rehomed_reach();
         timer.record_time("rehomed");

@@ -441,6 +443,7 @@ impl BaseDocument {
                 )),
             };

+        let scale = self.viewport.scale_f64();
         for host_id in host_ids.iter().copied() {
             let mut rect: Option<(f32, f32, f32, f32)> = None;
             let rehomed: Vec<NodeId> = self.nodes[host_id]
@@ -451,15 +454,6 @@ impl BaseDocument {
                 .filter(|id| self.nodes.contains_key(*id))
                 .collect();
             for child_id in rehomed {
-                let child = &self.nodes[child_id];
-                let t = child.rehomed_paint_translate(host_id);
-                let loc = child.final_layout().location;
-                let size = child.final_layout().size;
-                let overflow = child.final_layout().scrollable_overflow_rect;
-                let x0 = t.x + loc.x;
-                let y0 = t.y + loc.y;
-                let w = size.width.max(overflow.right);
-                let h = size.height.max(overflow.bottom);
-                rect = union(rect, (x0, y0, x0 + w, y0 + h));
+                rect = union(rect, self.nodes[child_id].rehomed_paint_rect(host_id, scale));
             }
             let Some(mut rect) = rect else { continue };

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Sat, 5 Sep 2026 09:15:32 +0100
Subject: [PATCH] Treat shadow roots as transparent damage boundaries

Blitz beta.2 exposes layout state only on styled layout nodes. Handle
shadow roots before generic damage processing so their real children
still bubble construction damage to the flat-tree host without reading
element-only fields.

Against blitz-dom 0.3.0-beta.3: upstream's walk takes no damage from the
parent, so the shadow root returns its children's union; the damaged-
descendants skip exemption added by the earlier pass-through goes with
it.
---
 src/layout/damage.rs | 24 ++++++++++++++----------
 1 file changed, 14 insertions(+), 10 deletions(-)

diff --git a/src/layout/damage.rs b/src/layout/damage.rs
index a34f0a2..6969fe5 100644
--- a/src/layout/damage.rs
+++ b/src/layout/damage.rs
@@ -54,16 +54,24 @@ impl BaseDocument {
     /// without revisiting their DOM children. Damage inside an anonymous box
     /// also invalidates its cache by walking `layout_parent` upward.
     pub(crate) fn propagate_damage_flags(&mut self, node_id: NodeId) -> RestyleDamage {
+        // Shadow roots are transparent flat-tree boundaries, not layout nodes.
+        // Walk their real children and bubble that damage to the host without
+        // touching the element-only layout accessors.
+        if self.nodes[node_id].is_shadow_root() {
+            let children = std::mem::take(&mut self.nodes[node_id].children);
+            let mut damage = RestyleDamage::empty();
+            for child in children.iter() {
+                damage |= self.propagate_damage_flags(*child);
+            }
+            self.nodes[node_id].children = children;
+            return damage;
+        }
+
         let own_damage = if let Some(data) = self.nodes[node_id]
             .try_stylo_element_data_mut()
             .and_then(|s| s.get_mut())
         {
             data.damage
-        } else if self.nodes[node_id].is_shadow_root() {
-            // A shadow root has no stylo data, but bailing here strands damage
-            // inside the shadow subtree. Pass through shadow roots (they carry
-            // no damaged-descendants flag either, so never skip them below).
-            RestyleDamage::empty()
         } else {
             return RestyleDamage::empty();
         };
@@ -75,11 +83,7 @@ impl BaseDocument {
         // ancestors may reach it only through an unflagged anonymous wrapper.
         {
             let node = &self.nodes[node_id];
-            if damage.is_empty()
-                && !node.has_damaged_descendants()
-                && !node.is_anonymous()
-                && !node.is_shadow_root()
-            {
+            if damage.is_empty() && !node.has_damaged_descendants() && !node.is_anonymous() {
                 return RestyleDamage::empty();
             }
         }

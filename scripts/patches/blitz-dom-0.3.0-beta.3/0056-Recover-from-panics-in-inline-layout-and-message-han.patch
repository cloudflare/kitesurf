From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Sun, 18 Oct 2026 18:59:03 +0100
Subject: [PATCH] Recover from panics in inline layout and message handling

A panic during recursive inline layout drops the temporarily removed
parley tree. Mark stranded inline roots for reconstruction so the next
resolve does not panic on missing layout data.

handle_messages took the receiver out of the document for the whole
drain and put it back after the loop. A panic in handle_message unwound
past that, so the receiver stayed None. The embedder builds with
panic=unwind and keeps the document after a caught panic. From then on
every resolve panicked on the unwrap in handle_messages, and the page
never handled another resource message: later CSS, images and fonts were
lost. One page logged 1,314 of these panics.

The loop now borrows the receiver for one try_recv at a time, so it
never leaves the document. The message that panicked is lost, but the
messages after it are handled. Nothing in handle_message needs the
receiver taken: a nested handle_messages call would have panicked on the
unwrap before.
---
 src/document.rs | 67 +++++++++++++++++++++++++++++++++++++++++++------
 src/resolve.rs  | 15 +++++++++++
 2 files changed, 74 insertions(+), 8 deletions(-)

diff --git a/src/document.rs b/src/document.rs
index 8c8767d..d8125f9 100644
--- a/src/document.rs
+++ b/src/document.rs
@@ -1957,16 +1957,16 @@ impl BaseDocument {
     }

     pub fn handle_messages(&mut self) {
-        // Remove event Reciever from the Document so that we can process events
-        // without holding a borrow to the Document
-        let rx = self.rx.take().unwrap();
-
-        while let Ok(msg) = rx.try_recv() {
+        // Borrow the receiver for one try_recv at a time instead of
+        // taking it out of the document for the whole drain. Under panic=unwind
+        // the embedder catches a panic in handle_message and keeps the document
+        // and keeps the document. A taken receiver would never be put back, so
+        // every later call would panic on the unwrap here and no resource
+        // message would be handled again. A panic costs only the message that
+        // raised it.
+        while let Some(msg) = self.rx.as_ref().and_then(|rx| rx.try_recv().ok()) {
             self.handle_message(msg);
         }
-
-        // Put Reciever back
-        self.rx = Some(rx);
     }

     pub fn handle_message(&mut self, msg: DocumentEvent) {
@@ -4797,6 +4797,57 @@ mod font_face_override_tests {
     }
 }

+#[cfg(test)]
+mod handle_messages_tests {
+    use super::*;
+    use crate::net::{Resource, ResourceLoadResponse};
+    use std::panic::{AssertUnwindSafe, catch_unwind};
+
+    fn send(doc: &BaseDocument, request_id: usize, result: Result<Resource, String>) {
+        let response = ResourceLoadResponse {
+            request_id,
+            node_id: None,
+            resolved_url: None,
+            result,
+        };
+        doc.tx.send(DocumentEvent::ResourceLoad(response)).unwrap();
+    }
+
+    /// The embedder builds with panic=unwind and keeps the document after a
+    /// caught panic, so a panic in one message must not stop the document
+    /// from handling the messages after it.
+    #[test]
+    fn a_panicking_message_keeps_the_receiver() {
+        let mut doc = BaseDocument::new(DocumentConfig::default());
+
+        // Any panic in handle_message will do. A poisoned font context makes
+        // a font delivery panic on its lock().unwrap().
+        let font_ctx = doc.font_ctx.clone();
+        let _ = catch_unwind(AssertUnwindSafe(|| {
+            let _held = font_ctx.lock().unwrap();
+            panic!("poison the font context");
+        }));
+        send(
+            &doc,
+            1,
+            Ok(Resource::Font(Default::default(), Default::default())),
+        );
+        let caught = catch_unwind(AssertUnwindSafe(|| doc.handle_messages()));
+        assert!(caught.is_err(), "the font delivery must panic");
+        assert!(
+            doc.rx.is_some(),
+            "the panic must leave the receiver in place"
+        );
+
+        // load_resource settles a critical request first thing, so a failed
+        // load is enough to show that the next message is handled.
+        doc.pending_critical_resources.insert(2);
+        send(&doc, 2, Err(String::from("network error")));
+        doc.handle_messages();
+        assert!(!doc.has_pending_critical_resources());
+    }
+}
+
 /// Decode an EncodedRaster-style ImageData (RGBA blob
 /// flagged `encoded`) in place. Shared by the materialize paths.
 /// hint = painted/laid-out size in device px ((0,0) = none);
diff --git a/src/resolve.rs b/src/resolve.rs
index 46fdd38..f332ecc 100644
--- a/src/resolve.rs
+++ b/src/resolve.rs
@@ -61,6 +61,21 @@ fn container_sizes(doc: &BaseDocument) -> Vec<(NodeId, taffy::Size<f32>)> {
 const CONTAINER_QUERY_SETTLE_PASSES: usize = 8;

 impl BaseDocument {
+    /// Restore construction damage after a panic strands an inline root
+    /// without the layout data that `compute_inline_layout_inner` took.
+    pub fn recover_from_layout_panic(&mut self) {
+        for (_, node) in self.nodes.iter_mut() {
+            let missing_inline_layout = node.flags.is_inline_root()
+                && node
+                    .data
+                    .downcast_element()
+                    .is_some_and(|element| element.inline_layout_data.is_none());
+            if missing_inline_layout {
+                node.insert_damage(ALL_DAMAGE);
+            }
+        }
+    }
+
     /// Restyle the tree and then relayout it
     pub fn resolve(&mut self, current_time_for_animations: f64) {
         if TDocument::as_node(&self.root_node())

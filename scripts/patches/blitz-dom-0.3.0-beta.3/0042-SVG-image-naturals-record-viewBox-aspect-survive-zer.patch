From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Thu, 30 Jul 2026 12:52:46 +0100
Subject: [PATCH] SVG image naturals: record viewBox aspect, survive
 zero/negative sizes

CSS natural dimensions need three inputs the old shape couldn't give:
the absolute root attrs (with zero as a real dimension and negatives/
percentages as absent; the old is_absolute_length accepted -5), the
viewBox aspect ratio for deriving a missing axis, and a parsed tree
even when usvg rejects the root size as invalid. Dimensions now parse
from the attributes directly, view_box_aspect rides SvgImageData, and
an InvalidSize retry strips the offending root attrs so zero/negative
sized documents still build (they previously failed outright).
---
 src/node/svg.rs | 73 +++++++++++++++++++++++++++++++++++++++++--------
 src/util.rs     | 16 +++++++++++
 2 files changed, 77 insertions(+), 12 deletions(-)

diff --git a/src/node/svg.rs b/src/node/svg.rs
index 4c3be49..736850e 100644
--- a/src/node/svg.rs
+++ b/src/node/svg.rs
@@ -98,10 +98,24 @@ impl SvgImageData {
         };
         let doc = roxmltree::Document::parse_with_options(text, xml_options)
             .map_err(usvg::Error::ParsingFailed)?;
-        let tree = usvg::Tree::from_xmltree(&doc, options)?;
+        let intrinsic_dimensions = SvgIntrinsicDimensions::from_xmltree(&doc);
+        let tree = match usvg::Tree::from_xmltree(&doc, options) {
+            Ok(tree) => tree,
+            Err(usvg::Error::InvalidSize) => {
+                let stripped = strip_invalid_root_dimensions(text, intrinsic_dimensions);
+                let retry_options = roxmltree::ParsingOptions {
+                    allow_dtd: true,
+                    ..Default::default()
+                };
+                let retry_doc = roxmltree::Document::parse_with_options(&stripped, retry_options)
+                    .map_err(usvg::Error::ParsingFailed)?;
+                usvg::Tree::from_xmltree(&retry_doc, options)?
+            }
+            Err(err) => return Err(err),
+        };
         Ok(Self {
             tree: Arc::new(tree),
-            intrinsic_dimensions: SvgIntrinsicDimensions::from_xmltree(&doc),
+            intrinsic_dimensions,
         })
     }

@@ -109,22 +123,26 @@ impl SvgImageData {
     /// declared an absolute (non-percentage) `width`.
     pub fn intrinsic_width(&self) -> Option<f32> {
         use svgtypes::LengthUnit;
-        let declared = self
-            .intrinsic_dimensions
-            .width
-            .is_some_and(|len| len.unit != LengthUnit::Percent);
-        declared.then(|| self.tree.size().width())
+        match self.intrinsic_dimensions.width {
+            Some(len) if len.unit != LengthUnit::Percent && len.number == 0.0 => Some(0.0),
+            Some(len) if len.unit != LengthUnit::Percent && len.number > 0.0 => {
+                Some(self.tree.size().width())
+            }
+            _ => None,
+        }
     }

     /// The intrinsic height in CSS px, present only when the root `<svg>`
     /// declared an absolute (non-percentage) `height`.
     pub fn intrinsic_height(&self) -> Option<f32> {
         use svgtypes::LengthUnit;
-        let declared = self
-            .intrinsic_dimensions
-            .height
-            .is_some_and(|len| len.unit != LengthUnit::Percent);
-        declared.then(|| self.tree.size().height())
+        match self.intrinsic_dimensions.height {
+            Some(len) if len.unit != LengthUnit::Percent && len.number == 0.0 => Some(0.0),
+            Some(len) if len.unit != LengthUnit::Percent && len.number > 0.0 => {
+                Some(self.tree.size().height())
+            }
+            _ => None,
+        }
     }

     /// The aspect ratio of the root `<svg>`'s `viewBox`, if it declares one.
@@ -199,3 +217,34 @@ impl SvgImageData {
         }
     }
 }
+
+fn strip_invalid_root_dimensions(source: &str, dimensions: SvgIntrinsicDimensions) -> String {
+    let Some(root_start) = source.find("<svg") else {
+        return source.to_string();
+    };
+    let Some(rel_end) = source[root_start..].find('>') else {
+        return source.to_string();
+    };
+    let root_end = root_start + rel_end;
+    let mut root = source[root_start..root_end].to_string();
+
+    for (name, length) in [
+        ("width", dimensions.width),
+        ("height", dimensions.height),
+    ] {
+        if !length.is_some_and(|length| length.number <= 0.0) {
+            continue;
+        }
+        if let Some(pos) = root.find(&format!(" {name}=")) {
+            let value = &root[pos + name.len() + 2..];
+            if let Some(quote @ ('"' | '\'')) = value.chars().next() {
+                if let Some(close) = value[1..].find(quote) {
+                    let end = pos + name.len() + 2 + close + 2;
+                    root.replace_range(pos..end, "");
+                }
+            }
+        }
+    }
+
+    format!("{}{}{}", &source[..root_start], root, &source[root_end..])
+}
diff --git a/src/util.rs b/src/util.rs
index 6c23e7f..fe358a3 100644
--- a/src/util.rs
+++ b/src/util.rs
@@ -336,6 +336,22 @@ mod svg_tests {
         assert_eq!(svg.intrinsic_width(), None);
         assert_eq!(svg.intrinsic_height(), None);
     }
+
+    #[test]
+    fn zero_dimension_survives_usvg_invalid_size() {
+        let src = br#"<svg xmlns="http://www.w3.org/2000/svg" width="0" height="20"></svg>"#;
+        let svg = parse_svg_image(src).unwrap();
+        assert_eq!(svg.intrinsic_width(), Some(0.0));
+        assert_eq!(svg.intrinsic_height(), Some(20.0));
+    }
+
+    #[test]
+    fn negative_dimension_is_not_intrinsic() {
+        let src = br#"<svg xmlns="http://www.w3.org/2000/svg" width="-5" height="20"></svg>"#;
+        let svg = parse_svg_image(src).unwrap();
+        assert_eq!(svg.intrinsic_width(), None);
+        assert_eq!(svg.intrinsic_height(), Some(20.0));
+    }
 }

 /// Creates an markup5ever::QualName.

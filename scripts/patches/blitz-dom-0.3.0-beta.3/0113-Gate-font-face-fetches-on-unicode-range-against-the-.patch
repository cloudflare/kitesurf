From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ruskin Constant <ruskin@cloudflare.com>
Date: Sun, 13 Sep 2026 18:03:19 +0100
Subject: [PATCH] Gate @font-face fetches on unicode-range against the
 document's text

The lazy loader (0017) fetched a declared face once its family appeared
in some computed style. Google Fonts and next/font split every family
into 5-7 script subsets, each an @font-face with a unicode-range, so a
used family pulled every subset of every weight/style it declared: a
Portuguese page loaded 26 files where Chrome loads 6.

Chrome fetches a subset only when font matching needs a glyph from it.
This lands that at document granularity: PendingFontFace carries the
descriptor's ranges; flush_needed_font_faces additionally requires
that some text node contains a codepoint inside them, tested against a
136 KiB bitset over U+0000..=U+10FFFF. The bitset is built by one
O(text) scan the first time a range-gated face needs checking; after
that every text write (create_text_node, set_node_text,
append_text_to_node, pseudo-element content) folds its codepoints in,
so the style-resolve path never walks text again. The set is
monotonic, so incremental upkeep is exact. Before the build, writes
skip it: pages with no range-gated face pay nothing. A face whose
ranges cover no text stays queued and is re-probed each flush (a few
bitset words per range), so a later script-inserted string in a new
script pulls its subset then. Faces without the descriptor behave as
before.

Faces are now marked UNLOADED at fetch time rather than at declaration:
a face this gate never releases must not block its family's style in
face_pending_for_style (0079) forever. Before the first flush nothing is
delivered, so there is no mid-load substitution to guard against.
---
 src/document.rs         | 104 ++++++++++++++++++++++++++++++++++++++--
 src/layout/construct.rs |   3 ++
 src/mutator.rs          |   2 +
 src/net.rs              |  14 +++++-
 4 files changed, 117 insertions(+), 6 deletions(-)

diff --git a/src/document.rs b/src/document.rs
index 2e7f2f2..ee119b2 100644
--- a/src/document.rs
+++ b/src/document.rs
@@ -424,6 +424,22 @@ pub struct BaseDocument {
     /// Sticky, so newly-declared faces for known-used families
     /// fetch on the next flush without a rescan hit.
     pub(crate) used_font_families: std::collections::HashSet<String>,
+    /// Every codepoint that appears in some text node, as a
+    /// bitset over U+0000..=U+10FFFF (136 KiB, allocated on first use).
+    /// A `unicode-range`-subsetted face fetches only once the document
+    /// contains a codepoint it covers: Chrome's rule, at document
+    /// granularity rather than per styled text run. Google Fonts and
+    /// next/font split every family into 5-7 script subsets; without
+    /// this a Portuguese page pulled cyrillic, vietnamese and
+    /// latin-ext for every weight and style it declared (26 files where
+    /// Chrome loads 10).
+    ///
+    /// Built by one full scan the first time a range-gated face needs
+    /// checking; from then on every text write folds its codepoints in
+    /// (`note_text_codepoints`), so the set stays current without
+    /// rescanning. Empty = not built yet, and text writes skip it, so a
+    /// page with no range-gated faces pays nothing.
+    pub(crate) used_codepoints: Vec<u64>,

     /// Tracks in-flight image requests. When an image is being fetched, additional
     /// requests for the same URL are queued here instead of starting new fetches.
@@ -605,6 +621,7 @@ impl BaseDocument {
             dims_only_images: config.dims_only_images,
             pending_font_faces: Vec::new(),
             used_font_families: std::collections::HashSet::new(),
+            used_codepoints: Vec::new(),
             pending_images: HashMap::new(),
             pending_style_image_nodes: Vec::new(),
             pending_critical_resources: HashSet::new(),
@@ -1244,6 +1261,7 @@ impl BaseDocument {
     }

     pub fn create_text_node(&mut self, text: &str) -> NodeId {
+        self.note_text_codepoints(text);
         let content = text.to_string();
         let data = NodeData::Text(TextNodeData::new(content));
         self.create_node(data)
@@ -1672,14 +1690,60 @@ impl BaseDocument {
             if !self.seen_font_faces.insert(key) {
                 continue;
             }
-            crate::net::note_unloaded_faces(std::iter::once((
-                face.family_lc.clone(),
-                face.overrides.style,
-            )));
             self.pending_font_faces.push(face);
         }
     }

+    /// Build the used-codepoint bitset from every text node.
+    /// O(text), once per document: the first time a range-gated face
+    /// needs checking. Later text writes keep it current incrementally
+    /// (the set is monotonic: removed text never un-needs a face).
+    fn build_used_codepoints(&mut self) {
+        let mut bits = vec![0u64; (0x110000 + 63) / 64];
+        for (_, node) in self.nodes.iter() {
+            if let Some(text) = node.text_data() {
+                set_codepoint_bits(&mut bits, &text.content);
+            }
+        }
+        self.used_codepoints = bits;
+    }
+
+    /// Fold a text write into `used_codepoints`. Every site
+    /// that creates or rewrites text content calls this. No-op until
+    /// the bitset is built; the build's full scan covers earlier text.
+    pub(crate) fn note_text_codepoints(&mut self, text: &str) {
+        if !self.used_codepoints.is_empty() {
+            set_codepoint_bits(&mut self.used_codepoints, text);
+        }
+    }
+
+    /// True when some text node holds a codepoint inside one of the
+    /// face's `unicode-range`s. A face without the descriptor covers
+    /// everything and is always needed.
+    fn face_covers_used_text(&self, ranges: Option<&[(u32, u32)]>) -> bool {
+        let Some(ranges) = ranges else {
+            return true;
+        };
+        let bits = &self.used_codepoints;
+        if bits.is_empty() {
+            return false;
+        }
+        ranges.iter().any(|&(start, end)| {
+            let end = end.min(0x10FFFF);
+            if start > end {
+                return false;
+            }
+            let (first, last) = ((start >> 6) as usize, (end >> 6) as usize);
+            (first..=last).any(|w| {
+                let lo = if w == first { start & 63 } else { 0 };
+                let hi = if w == last { end & 63 } else { 63 };
+                // Bits lo..=hi of this word.
+                let mask = (u64::MAX >> (63 - hi)) & (u64::MAX << lo);
+                bits[w] & mask != 0
+            })
+        })
+    }
+
     /// Fetch pending @font-face sources whose family is
     /// referenced by some element's computed font-family. Runs
     /// after every style resolve; O(nodes) only while faces are
@@ -1712,7 +1776,30 @@ impl BaseDocument {
                 .retain(|f| !used.contains(&f.family_lc) || { ready.push(f.clone()); false });
             self.used_font_families = used;
         }
+        // unicode-range gate. A face whose ranges cover none of the
+        // document's text goes back on the queue and is re-tested on the
+        // next flush: a bitset probe per range, no text walk, since
+        // text writes keep used_codepoints current (a later
+        // script-inserted Cyrillic string fetches the cyrillic subset
+        // then, as in Chrome). Its family is in the sticky used set, so
+        // it rides the fast path above, not the O(nodes) scan. Faces are
+        // marked UNLOADED here, at fetch time, not at declaration: a face
+        // this gate never releases must not block its family's style
+        // forever in face_pending_for_style.
+        let needs_range_check = ready.iter().any(|f| f.unicode_range.is_some());
+        if needs_range_check && self.used_codepoints.is_empty() {
+            self.build_used_codepoints();
+        }
+        let mut deferred: Vec<crate::net::PendingFontFace> = Vec::new();
         for face in ready {
+            if !self.face_covers_used_text(face.unicode_range.as_deref()) {
+                deferred.push(face);
+                continue;
+            }
+            crate::net::note_unloaded_faces(std::iter::once((
+                face.family_lc.clone(),
+                face.overrides.style,
+            )));
             crate::net::fetch_pending_font_face(
                 self.tx.clone(),
                 self.id,
@@ -1722,6 +1809,7 @@ impl BaseDocument {
                 face,
             );
         }
+        self.pending_font_faces.extend(deferred);
     }

     pub fn handle_messages(&mut self) {
@@ -4654,3 +4742,11 @@ fn note_changed_attr(snapshot: &mut ServoElementSnapshot, name: &LocalName) {
         snapshot.changed_attrs.push(ident);
     }
 }
+
+/// Set the bit for every codepoint in `text`.
+fn set_codepoint_bits(bits: &mut [u64], text: &str) {
+    for ch in text.chars() {
+        let cp = ch as usize;
+        bits[cp >> 6] |= 1u64 << (cp & 63);
+    }
+}
diff --git a/src/layout/construct.rs b/src/layout/construct.rs
index 601ded8..c094cd1 100644
--- a/src/layout/construct.rs
+++ b/src/layout/construct.rs
@@ -1341,6 +1341,9 @@ fn flush_pseudo_elements(doc: &mut BaseDocument, node_id: NodeId) {
                 (Some(text_node_id), Some(new_text)) => {
                     let text_data = doc.nodes[text_node_id].text_data_mut().unwrap();
                     if text_data.content != new_text {
+                        // Generated content needs glyphs too.
+                        doc.note_text_codepoints(&new_text);
+                        let text_data = doc.nodes[text_node_id].text_data_mut().unwrap();
                         text_data.content = new_text;
                         doc.nodes[node_id].insert_damage(ALL_DAMAGE);
                     }
diff --git a/src/mutator.rs b/src/mutator.rs
index 0233a22..73a22dc 100644
--- a/src/mutator.rs
+++ b/src/mutator.rs
@@ -245,6 +245,7 @@ impl DocumentMutator<'_> {
                 parent.insert_damage(ALL_DAMAGE);
             }

+            self.doc.note_text_codepoints(value);
             self.maybe_record_node(parent_id);
         }
     }
@@ -262,6 +263,7 @@ impl DocumentMutator<'_> {
             Some(data) => {
                 data.content += text;
                 self.mutations_occurred |= node_is_in_document;
+                self.doc.note_text_codepoints(text);
                 Ok(())
             }
             None => Err(AppendTextErr::NotTextNode),
diff --git a/src/net.rs b/src/net.rs
index dc98a27..884cef2 100644
--- a/src/net.rs
+++ b/src/net.rs
@@ -493,6 +493,11 @@ pub struct PendingFontFace {
     pub format: FontFaceSourceFormatKeyword,
     pub overrides: FontFaceOverrides,
     pub node_id: Option<NodeId>,
+    /// `unicode-range` descriptor as inclusive (start, end) pairs;
+    /// `None` = the whole codepoint space (the descriptor's default).
+    /// Gates the fetch on the document's text: see
+    /// BaseDocument::flush_needed_font_faces.
+    pub unicode_range: Option<Vec<(u32, u32)>>,
 }

 thread_local! {
@@ -597,11 +602,15 @@ pub(crate) fn collect_font_face_rules<'a>(
                     style: descriptor.font_style.as_ref().map(stylo_to_fontique_style),
                 };
                 let family_lc = family.name.to_string().to_lowercase();
-                Some((family_lc, src, overrides))
+                let unicode_range = descriptor
+                    .unicode_range
+                    .as_ref()
+                    .map(|ranges| ranges.iter().map(|r| (r.start, r.end)).collect());
+                Some((family_lc, src, overrides, unicode_range))
             }
             _ => None,
         })
-        .filter_map(|(family_lc, source_list, overrides)| {
+        .filter_map(|(family_lc, source_list, overrides, unicode_range)| {
             // Find the first font source in the source list that specifies a font of a type
             // that we support.
             let preferred_source = source_list
@@ -684,6 +693,7 @@ pub(crate) fn collect_font_face_rules<'a>(
                 format,
                 overrides,
                 node_id,
+                unicode_range,
             })
         })
         .collect()

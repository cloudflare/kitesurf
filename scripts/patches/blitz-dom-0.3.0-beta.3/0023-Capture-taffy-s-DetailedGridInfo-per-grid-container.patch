From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Fri, 31 Jul 2026 22:52:37 +0100
Subject: [PATCH] Capture taffy's DetailedGridInfo per grid container

taffy's detailed_layout_info feature was already enabled but the
LayoutGridContainer impl for BaseDocument left set_detailed_grid_info
at its default no-op (only the table wrapper stored it). Store the
used track sizes in a doc-level map keyed by node id, cleared at the
top of every resolve_layout so entries never outlive the pass that
produced them (slab ids recycle). This backs
an embedder's resolved grid-template-* serialization for
getComputedStyle.
---
 src/document.rs | 9 +++++++++
 src/resolve.rs  | 2 ++
 2 files changed, 11 insertions(+)

diff --git a/src/document.rs b/src/document.rs
index fd1b403..71bc71e 100644
--- a/src/document.rs
+++ b/src/document.rs
@@ -2636,6 +2636,15 @@ impl BaseDocument {
         &self.viewport
     }

+    /// Used grid track sizes for a grid container laid out in the
+    /// last resolve_layout pass; None for non-grid / stale ids.
+    pub fn grid_track_info(&self, node_id: NodeId) -> Option<&taffy::DetailedGridInfo<Atom>> {
+        match &self.get_node(node_id)?.element_data()?.detailed_layout_info {
+            taffy::DetailedLayoutInfo::Grid(info) => Some(info),
+            _ => None,
+        }
+    }
+
     pub fn viewport_mut(&mut self) -> ViewportMut<'_> {
         ViewportMut::new(self)
     }
diff --git a/src/resolve.rs b/src/resolve.rs
index 6558bd4..6c9b970 100644
--- a/src/resolve.rs
+++ b/src/resolve.rs
@@ -449,6 +449,8 @@ impl BaseDocument {
     /// TODO: update taffy to use an associated type instead of slab key
     /// TODO: update taffy to support traited styles so we don't even need to rely on taffy for storage
     pub fn resolve_layout(&mut self) {
+        // Track info is layout-pass-scoped: stale entries would pin
+        // recycled slab ids to a different element's tracks.
         let size = self.stylist.device().au_viewport_size();

         let available_space = taffy::Size {

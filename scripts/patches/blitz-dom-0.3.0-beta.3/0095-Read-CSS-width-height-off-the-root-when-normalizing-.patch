From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Sat, 5 Sep 2026 08:04:29 +0100
Subject: [PATCH] Read CSS width/height off the root when normalizing an SVG
 viewport

Read the root style sizing from the intrinsic metadata so normalization
sees the same dimensions as usvg.
---
 src/node/svg.rs | 14 +++++++++++++-
 src/util.rs     | 10 ++++++++++
 2 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/src/node/svg.rs b/src/node/svg.rs
index 317e4d2..1561359 100644
--- a/src/node/svg.rs
+++ b/src/node/svg.rs
@@ -32,7 +32,19 @@ impl SvgIntrinsicDimensions {
         let root = doc.root_element();

         let parse_length = |name: &str| -> Option<svgtypes::Length> {
-            root.attribute(name)?.parse::<svgtypes::Length>().ok()
+            // Root CSS beats the equivalent presentation attribute. Read the
+            // last declaration, matching normal declaration-list precedence.
+            let from_style = root.attribute("style").and_then(|style| {
+                style.split(';').rev().find_map(|declaration| {
+                    let (property, value) = declaration.split_once(':')?;
+                    property
+                        .trim()
+                        .eq_ignore_ascii_case(name)
+                        .then(|| value.trim().parse::<svgtypes::Length>().ok())
+                        .flatten()
+                })
+            });
+            from_style.or_else(|| root.attribute(name)?.parse::<svgtypes::Length>().ok())
         };
         // Parsed manually rather than via `svgtypes::ViewBox`, which rejects
         // zero sizes: a zero `viewBox` width/height is distinguished from an
diff --git a/src/util.rs b/src/util.rs
index eddc15f..5aa3753 100644
--- a/src/util.rs
+++ b/src/util.rs
@@ -454,6 +454,16 @@ mod svg_tests {
         assert_eq!(svg.intrinsic_height(), Some(16.0));
     }

+    #[test]
+    fn root_style_dimensions_override_attributes() {
+        let src = br#"<svg xmlns="http://www.w3.org/2000/svg" width="20" height="10" style="width: 400px; height: 50px" viewBox="0 0 200 100"></svg>"#;
+        let svg = parse_svg_image(src).unwrap();
+        assert_eq!(svg.intrinsic_width(), Some(400.0));
+        assert_eq!(svg.intrinsic_height(), Some(50.0));
+        assert_eq!(svg.tree.size().width(), 400.0);
+        assert_eq!(svg.tree.size().height(), 50.0);
+    }
+
     #[test]
     fn percentage_dimensions_are_not_intrinsic() {
         let src = br#"<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="50%" viewBox="0 0 200 100"></svg>"#;

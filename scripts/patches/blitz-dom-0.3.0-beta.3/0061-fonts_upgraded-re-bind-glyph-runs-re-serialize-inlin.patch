From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Mon, 3 Aug 2026 16:57:57 +0100
Subject: [PATCH] fonts_upgraded: re-bind glyph runs + re-serialize inline-svg
 snapshots

kitesurf's shaping-until-raster sessions swap font blobs in the
shared collection after registration (stripped shaping-only faces
upgraded to full files on first outline demand). Two caches bake the
OLD blob and need explicit invalidation: inline contexts hold glyph
runs bound to the swapped-out blob (krilla PDF embeds read them), and
inline-SVG snapshots were serialized while usvg's fontdb had no
outline-bearing faces, dropping <text> from the parsed tree for good.
Reset both: invalidate_inline_contexts plus per-snapshot special_data
clear + subtree ALL_DAMAGE so construct re-serializes.
---
 src/document.rs | 29 +++++++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/src/document.rs b/src/document.rs
index 818491a..32f57ce 100644
--- a/src/document.rs
+++ b/src/document.rs
@@ -2610,6 +2610,35 @@ impl BaseDocument {
         self.queue_device_changes(changes);
     }

+    /// Font blobs were swapped in the shared collection
+    /// (shaping-only faces upgraded to full files). Re-shape every
+    /// inline context so glyph runs re-bind to the new blobs, and
+    /// throw away every inline-SVG snapshot: those were serialized
+    /// while usvg's fontdb had no outline-bearing faces, so their
+    /// `<text>` was dropped from the parsed tree for good.
+    pub fn fonts_upgraded(&mut self) {
+        self.invalidate_inline_contexts();
+        let svg_roots: Vec<NodeId> = self
+            .nodes
+            .iter()
+            .filter_map(|(id, node)| {
+                let has_svg_snapshot = node
+                    .element_data()
+                    .and_then(|el| el.svg_image_data())
+                    .is_some();
+                has_svg_snapshot.then_some(id)
+            })
+            .collect();
+        for id in svg_roots {
+            if let Some(el) = self.nodes[id].element_data_mut() {
+                el.special_data = SpecialElementData::None;
+            }
+            self.iter_subtree_mut(id, |sid, doc| {
+                doc.nodes[sid].insert_damage(crate::layout::damage::ALL_DAMAGE);
+            });
+        }
+    }
+
     /// Returns the current CSS media type used to evaluate `@media` rules.
     pub fn media_type(&self) -> &MediaType {
         &self.media_type

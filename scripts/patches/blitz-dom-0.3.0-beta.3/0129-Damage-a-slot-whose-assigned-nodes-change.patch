From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Mon, 28 Sep 2026 12:50:38 +0100
Subject: [PATCH] Damage a slot whose assigned nodes change

A slot's box parent hoists the slot's assigned nodes into its own layout
children, but those nodes are the host's DOM children, so appending or
removing one damages the host and never the slot's container. Under
incremental layout that container kept its cached child list, and a
slottable added after the first layout never got a box: the whole
DevTools frontend is built that way and rendered blank.

flush_slot_assignments now compares each slot's assignment with the
previous one and stamps CONSTRUCT_BOX on the slots that changed.
---
 src/document.rs | 20 +++++++++++++++++---
 1 file changed, 17 insertions(+), 3 deletions(-)

diff --git a/src/document.rs b/src/document.rs
index 9125ae4..a323494 100644
--- a/src/document.rs
+++ b/src/document.rs
@@ -1082,9 +1082,13 @@ impl BaseDocument {
                     .to_string();
                 by_name.entry(name).or_insert(slot_id);
             }
-            for &slot_id in &slots {
-                self.nodes[slot_id].assigned_nodes = Some(ThinVec::new());
-            }
+            let previous: Vec<(NodeId, Option<ThinVec<NodeId>>)> = slots
+                .iter()
+                .map(|&slot_id| {
+                    let old = self.nodes[slot_id].assigned_nodes.replace(ThinVec::new());
+                    (slot_id, old)
+                })
+                .collect();

             let host_children: Vec<NodeId> = self
                 .nodes
@@ -1117,5 +1121,15 @@ impl BaseDocument {
                         .push(child_id);
                 }
             }
+
+            // A slot's box parent hoists its assigned nodes but gets no damage from
+            // the host's children, so its cached layout children go stale otherwise.
+            for (slot_id, old) in previous {
+                let old = old.as_deref().unwrap_or(&[]);
+                let new = self.nodes[slot_id].assigned_nodes.as_deref().unwrap_or(&[]);
+                if old != new {
+                    self.nodes[slot_id].insert_damage(CONSTRUCT_BOX);
+                }
+            }
         }
     }

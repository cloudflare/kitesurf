From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Wed, 12 Aug 2026 14:40:39 +0100
Subject: [PATCH] bust the float container's layout cache, not the float's

`YieldData::InlineBoxBreak` binds the float's id as `node_id`, shadowing
the container the whole function is laying out; so the cache bust meant
for the container landed on the float box. The container it was written
to protect kept cache-hitting, and its floats never re-registered into
the block formatting context: a float in a sibling container held the
band position the first float had before it grew.

The float's id is `float_id` now, which is what the shadowing cost us.

Retire the flag where the node's boxes are rebuilt rather than latching
it for the document's life. The inline pass is the wrong place to clear
it: `float:none` restructures the content into anonymous blocks and the
old container never runs an inline pass again, so it would bust its
cache forever. A float change is box-tree damage, so the re-collect that
handles it is exactly the point the registration stops being true.
---
 src/layout/inline.rs | 10 ++++++----
 src/resolve.rs       |  5 +++++
 2 files changed, 11 insertions(+), 4 deletions(-)

diff --git a/src/layout/inline.rs b/src/layout/inline.rs
index 91b49a1..4efcc01 100644
--- a/src/layout/inline.rs
+++ b/src/layout/inline.rs
@@ -718,10 +718,12 @@ impl LayoutPassState<'_> {
                     }
                     YieldData::InlineBoxBreak(box_break_data) => {
                         let state = breaker.state_mut();
-                        let node_id = NodeId::from_u64(box_break_data.inline_box_id);
+                        // Not the container: naming it node_id
+                        // shadowed the container and sent its cache bust here.
+                        let float_id = NodeId::from_u64(box_break_data.inline_box_id);

                         let (direction, clear, margin) = {
-                            let style = self.child_layout_style(&self.nodes[node_id]);
+                            let style = self.child_layout_style(&self.nodes[float_id]);
                             // We can assume that the box is a float because we only set `break_on_box: true` for floats
                             let direction = match style.float() {
                                 Float::Left => taffy::FloatDirection::Left,
@@ -740,7 +742,7 @@ impl LayoutPassState<'_> {
                         let margin_sum = margin.sum_axes();

                         let mut output = self.compute_child_layout(
-                            crate::taffy_node_id(node_id),
+                            crate::taffy_node_id(float_id),
                             float_child_inputs,
                         );
                         let min_y = state.line_y() as f32 / scale;
@@ -768,7 +770,7 @@ impl LayoutPassState<'_> {
                             x: pos.x + margin.left + container_pb.left,
                             y: pos.y + margin.top + container_pb.top,
                         };
-                        let layout = self.nodes[node_id].unrounded_layout_mut();
+                        let layout = self.nodes[float_id].unrounded_layout_mut();
                         layout.size = output.size;
                         layout.location = location;
                         layout.margin = margin;
diff --git a/src/resolve.rs b/src/resolve.rs
index 07deb47..155bf0a 100644
--- a/src/resolve.rs
+++ b/src/resolve.rs
@@ -406,6 +406,11 @@ impl BaseDocument {
                 collect_layout_children(doc, node_id, &mut collected);
                 let layout_children = collected.children;
                 doc.nodes[node_id].anonymous_blocks = collected.anonymous_blocks;
+                // Float registration is a product of this node's boxes, so
+                // a rebuild retires the cache bust its last inline pass
+                // left behind: otherwise a block that ever held a float
+                // is locked out of taffy's cache for the document's life.
+                doc.nodes[node_id].placed_floats.set(false);

                 // Recurse into newly collected layout children
                 for child_id in layout_children.iter().copied() {

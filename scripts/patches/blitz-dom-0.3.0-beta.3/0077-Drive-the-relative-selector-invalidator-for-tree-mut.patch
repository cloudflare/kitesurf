From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Wed, 5 Aug 2026 00:57:26 +0100
Subject: [PATCH] Drive the relative-selector invalidator for tree mutations
 too

The snapshot-driven pass only covers attribute and state changes,
because those are the only mutations that take a snapshot. Inserting or
removing an element never did, so a structural :has(div) was invalidated
only when the anchor happened to be the mutated node's parent, via the
same blunt restyle_subtree() the attribute path used to rely on.

Tree mutations therefore invalidate at mutation time, where the node is
still linked. Ordering is forced by the collector reading the node's
live parent and siblings: insertions invalidate after the node is
linked, removals before it is unlinked, including the removal half of a
reparent. inherited_search_path is seeded from the parent because a
freshly created element carries no selector flags and
DomMutationOperation::accept rejects those outright, which would
otherwise make every insertion a no-op.

Both passes now share a document-level gate so a page with no :has()
anywhere pays nothing. It deliberately treats any shadow root as
"maybe", since iter_origins cannot see shadow cascade data and a false
negative would silently drop invalidation.

each_custom_state can no longer be todo!(): the relative-selector
collector calls it. Blitz has no CustomStateSet, matching
has_custom_state already returning false, so it is a no-op.
---
 src/mutator.rs | 33 +++++++++++++++++++
 src/stylo.rs   | 88 ++++++++++++++++++++++++++++++++++++++++++++++++--
 2 files changed, 119 insertions(+), 2 deletions(-)

diff --git a/src/mutator.rs b/src/mutator.rs
index 4e15e46..ce13b8f 100644
--- a/src/mutator.rs
+++ b/src/mutator.rs
@@ -677,6 +677,10 @@ impl DocumentMutator<'_> {
     pub fn remove_node(&mut self, node_id: NodeId) {
         let node_is_in_document = self.doc.nodes[node_id].flags.is_in_document();
         self.doc.slot_assignments_dirty = true;
+        // Relative selectors are collected off the still-linked node, so this
+        // has to run before either interaction cleanup or unlinking.
+        self.doc.invalidate_relative_selectors_for_removal(node_id);
+
         // Process the subtree *before* severing the parent link so that
         // interaction state referencing removed nodes can retarget to the
         // nearest surviving ancestor.
@@ -720,6 +724,11 @@ impl DocumentMutator<'_> {
     ) -> Option<Node> {
         let node_is_in_document = self.doc.nodes[node_id].flags.is_in_document();
         self.doc.slot_assignments_dirty = true;
+
+        // Must precede the drop; the invalidator walks the node's
+        // own ancestors and siblings to find `:has()` anchors.
+        self.doc.invalidate_relative_selectors_for_removal(node_id);
+
         self.process_removed_subtree(node_id);

         let node = self.doc.drop_node_ignoring_parent_with(node_id, on_drop);
@@ -752,6 +761,13 @@ impl DocumentMutator<'_> {

     pub fn remove_and_drop_all_children(&mut self, node_id: NodeId) {
         self.doc.slot_assignments_dirty = true;
+
+        // Same ordering constraint as remove_node, once per child
+        // since each is a separate removal as far as `:has()` is concerned.
+        for child_id in self.doc.nodes[node_id].children.clone() {
+            self.doc.invalidate_relative_selectors_for_removal(child_id);
+        }
+
         let parent = &mut self.doc.nodes[node_id];
         let parent_is_in_doc = parent.flags.is_in_document();

@@ -823,6 +839,15 @@ impl DocumentMutator<'_> {
         self.doc.slot_assignments_dirty = true;
         let new_parent_is_in_document = self.doc.nodes[parent_id].flags.is_in_document();
         self.mutations_occurred |= new_parent_is_in_document && !child_ids.is_empty();
+
+        // A reparent is a removal from the old position, so it needs the same
+        // pre-unlink invalidation as remove_node.
+        for &child_id in child_ids {
+            if self.doc.nodes[child_id].parent.is_some() {
+                self.doc.invalidate_relative_selectors_for_removal(child_id);
+            }
+        }
+
         // Detach the children from their old parents *before* inserting them into
         // the new parent (matching DOM `insertBefore` semantics). If a child is
         // being moved within the same parent then detaching it after insertion
@@ -888,6 +913,14 @@ impl DocumentMutator<'_> {
             }
         }

+        // Insertions invalidate after linking, since the collector
+        // reads the node's final parent and sibling positions.
+        if new_parent_is_in_document {
+            for &child_id in child_ids.iter() {
+                self.doc.invalidate_relative_selectors_for_insertion(child_id);
+            }
+        }
+
         self.maybe_record_node(parent_id);
     }


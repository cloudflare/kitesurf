+    if position == Position::Static && is_positioned_only_wrapper(node, 0) {
+        return (position_to_order(Position::Absolute), 0);
+    }
+    let Some(style) = node.primary_styles() else {
+        return (0, 0);
+    };
     if is_flex_or_grid {

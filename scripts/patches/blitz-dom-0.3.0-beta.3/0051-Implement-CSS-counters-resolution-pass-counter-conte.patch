+    doc: &BaseDocument,
+    node_id: NodeId,
+    pseudo_idx: usize,
+    style: &style::properties::ComputedValues,
+) -> Option<String> {
+    let over = if pseudo_idx == 1 {
+        doc.counters.before_text.get(&node_id)
+    } else {
+        doc.counters.after_text.get(&node_id)
+    };
+    if let Some(t) = over {
+        return Some(t.clone());
+    }
+    pe_content_text(style)
+}

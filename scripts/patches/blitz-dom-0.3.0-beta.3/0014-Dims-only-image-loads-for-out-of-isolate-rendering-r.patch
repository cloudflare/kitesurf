+    /// Decode one encoded (dims-only) image in place:
+    /// RGBA-materialise a node's replaced image so local raster
+    /// paths (canvas drawImage, legacy screenshot/PDF fallback)
+    /// see real pixels. Returns true if anything changed.
+    ///
+    /// Decoded dims can differ from the header dims when max_dim
+    /// caps them; damage + cache clears keep layout honest.
+    pub fn kitesurf_materialize_node_image(&mut self, node_id: usize, max_dim: u32) -> bool {
+        let Some(node) = self.get_node_mut(node_id) else {
+            return false;
+        };
+        let Some(el) = node.element_data_mut() else {
+            return false;
+        };
+        let mut changed = false;
+        if let SpecialElementData::Image(data) = &mut el.special_data {
+            changed |= kitesurf_materialize_image_data(data, max_dim);
+        }
+        for layer in el.background_images.iter_mut().chain(el.mask_images.iter_mut()) {
+            if let Some(res) = layer {
+                changed |= kitesurf_materialize_image_data(&mut res.image, max_dim);
+            }
+        }
+        if changed {
+            node.clear_layout_cache();
+            node.insert_damage(ALL_DAMAGE);
+        }
+        changed
+    }
+
+    /// Materialise EVERY encoded image in the document
+    /// (nodes + url cache). Safety net before local rasterization
+    /// in dims-only mode; a no-op when nothing is encoded.
+    pub fn kitesurf_materialize_encoded_images(&mut self, max_dim: u32) -> usize {
+        let ids: Vec<usize> = self.nodes.iter().map(|(id, _)| id).collect();
+        let mut count = 0;
+        for id in ids {
+            if self.kitesurf_materialize_node_image(id, max_dim) {
+                count += 1;
+            }
+        }
+        for image in self.image_cache.values_mut() {
+            if kitesurf_materialize_image_data(image, max_dim) {
+                count += 1;
+            }
+        }
+        count
+    }
+
     /// Cache a loaded image and apply it to all nodes waiting on it
     /// (`<img>` elements, `background-image` layers and `mask-image` layers).
     /// Set a canvas element's framebuffer as its replaced
@@ -3721,3 +3786,34 @@ mod font_face_override_tests {
         );
     }
 }
+
+/// Decode an EncodedRaster-style ImageData (RGBA blob
+/// flagged `encoded`) in place. Shared by the materialize paths.
+fn kitesurf_materialize_image_data(image: &mut ImageData, max_dim: u32) -> bool {
+    let ImageData::Raster(raster) = image else {
+        return false;
+    };
+    if !raster.encoded {
+        return false;
+    }
+    let decoded = match image::load_from_memory(raster.data.as_ref()) {
+        Ok(d) => d,
+        // Undecodable bytes: drop to None so paint skips it
+        // instead of feeding garbage to vello.
+        Err(_) => {
+            *image = ImageData::None;
+            return true;
+        }
+    };
+    let (w, h) = (decoded.width(), decoded.height());
+    let scaled = if w > max_dim || h > max_dim {
+        use image::imageops::FilterType;
+        decoded.resize(max_dim, max_dim, FilterType::Triangle)
+    } else {
+        decoded
+    };
+    let (fw, fh) = (scaled.width(), scaled.height());
+    let rgba = scaled.into_rgba8().into_raw();
+    *image = ImageData::Raster(RasterImageData::new(fw, fh, std::sync::Arc::new(rgba)));
+    true
+}

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Mon, 28 Sep 2026 12:50:38 +0100
Subject: [PATCH] Skip shadow roots when applying parent selector flags

:nth-child and friends deposit for_parent() flags on the parent node,
and for a shadow root's direct child that parent is the ShadowRoot,
which carries no selector_flags: the accessor panicked mid-cascade. The
document got a flags field for the same reason; a shadow root does not
need one, because nothing reads parent flags and mutations under a root
restyle through the host's subtree hint.
---
 src/stylo.rs | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/stylo.rs b/src/stylo.rs
index 359074a..6b30ad1 100644
--- a/src/stylo.rs
+++ b/src/stylo.rs
@@ -865,7 +865,9 @@ impl selectors::Element for BlitzNode<'_> {
         // Handle flags that apply to the parent.
         let parent_flags = flags.for_parent();
         if !parent_flags.is_empty() {
-            if let Some(parent) = self.parent_node() {
+            // Shadow roots hold no selector flags, and nothing here reads parent
+            // flags: mutations under a root restyle through the host's subtree hint.
+            if let Some(parent) = self.parent_node().filter(|p| !p.is_shadow_root()) {
                 parent
                     .selector_flags()
                     .set(parent.selector_flags().get() | parent_flags);

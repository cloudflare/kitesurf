From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Fri, 25 Sep 2026 02:17:43 +0100
Subject: [PATCH] reparse replaced <style> sheets once per resolve

CSSOM insertRule mirrors the whole rule list into the <style> text on
every call, and each mutate session reparsed that growing sheet, so N
inserts cost O(N^2) parse work (a CSS-in-JS library can insert ~130
rules). A registered sheet's replacement is now queued and reparsed at
the start of resolve, which every style consumer goes through. A first
sheet still parses at flush so its @import and @font-face loads start
early; a removed node drops its queued reparse.
---
 src/document.rs | 18 ++++++++++++++++++
 src/mutator.rs  |  9 ++++++++-
 src/resolve.rs  |  2 ++
 3 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/src/document.rs b/src/document.rs
index ee119b2..645b445 100644
--- a/src/document.rs
+++ b/src/document.rs
@@ -353,6 +353,10 @@ pub struct BaseDocument {
     /// (an Arc bump), while each <style> node still registers
     /// individually with the stylist (so cascade order is unchanged).
     pub(crate) author_sheet_cache: HashMap<u64, DocumentStyleSheet>,
+    /// Registered <style> nodes whose text changed since the last
+    /// resolve. CSSOM insertRule rewrites the whole sheet text per call, so
+    /// reparsing on every mutate session was quadratic; resolve reparses once.
+    pub(crate) pending_style_nodes: HashSet<NodeId>,
     /// The cache key currently registered for each style node. Replacing a
     /// CSS-in-JS sheet must release the previous parse when no node shares it.
     pub(crate) author_sheet_keys: HashMap<NodeId, u64>,
@@ -579,6 +583,7 @@ impl BaseDocument {
             url: base_url,
             ua_stylesheets: HashMap::new(),
             author_sheet_cache: HashMap::new(),
+            pending_style_nodes: HashSet::new(),
             author_sheet_keys: HashMap::new(),
             seen_font_faces: std::collections::HashSet::new(),
             dirty_shadow_style_roots: Vec::new(),
@@ -1392,6 +1397,19 @@ impl BaseDocument {
         }
     }

+    /// Reparse the <style> sheets deferred by DocumentMutator::flush.
+    pub fn process_pending_style_elements(&mut self) {
+        for id in std::mem::take(&mut self.pending_style_nodes) {
+            let is_style = self
+                .nodes
+                .get(id)
+                .is_some_and(|n| n.data.is_element_with_tag_name(&local_name!("style")));
+            if is_style {
+                self.process_style_element(id);
+            }
+        }
+    }
+
     pub fn process_style_element(&mut self, target_id: NodeId) {
         // HTML §the-style-element: the sheet applies only while the element's
         // media attribute matches. Ignoring it applies mobile-only rules
diff --git a/src/mutator.rs b/src/mutator.rs
index 1618a59..fb02348 100644
--- a/src/mutator.rs
+++ b/src/mutator.rs
@@ -1109,8 +1109,14 @@ impl<'doc> DocumentMutator<'doc> {
         }

         // Add/Update inline stylesheets (<style> elements)
+        // A first sheet is parsed now so its @import and @font-face loads start
+        // early; replacing an already registered one waits for resolve.
         for id in self.style_nodes.drain() {
-            self.doc.process_style_element(id);
+            if self.doc.nodes_to_stylesheet.contains_key(&id) {
+                self.doc.pending_style_nodes.insert(id);
+            } else {
+                self.doc.process_style_element(id);
+            }
         }

         // Snapshot form_nodes so we can both reset_form_owner
@@ -1301,6 +1307,7 @@ impl<'doc> DocumentMutator<'doc> {
                 .data
                 .is_element_with_tag_name(&local_name!("style"));
             if is_style {
+                doc.pending_style_nodes.remove(&node_id);
                 doc.remove_author_stylesheet(node_id);
             }

diff --git a/src/resolve.rs b/src/resolve.rs
index 83339a1..46fdd38 100644
--- a/src/resolve.rs
+++ b/src/resolve.rs
@@ -72,5 +72,7 @@ impl BaseDocument {
             return;
         }

+        self.process_pending_style_elements();
+
         // Process messages that have been sent to our message channel (e.g. loaded resource)
         self.handle_messages();

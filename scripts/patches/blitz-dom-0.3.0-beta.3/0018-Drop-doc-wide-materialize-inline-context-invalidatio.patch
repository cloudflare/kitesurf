From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Sun, 26 Jul 2026 01:08:49 +0100
Subject: [PATCH] Drop doc-wide materialize + inline-context invalidation
 wrappers

The embedder no longer rasterizes in the page isolate: nothing calls
kitesurf_materialize_encoded_images (the pre-local-raster decode
safety net) or kitesurf_invalidate_inline_contexts (the emoji
full-font-upgrade re-shape hook) anymore. Node-level materialize
(kitesurf_materialize_node_image) stays; canvas drawImage of an
<img> still decodes at the laid-out size.
---
 src/document.rs | 31 -------------------------------
 1 file changed, 31 deletions(-)

diff --git a/src/document.rs b/src/document.rs
index 9560d01..1dea9fe 100644
--- a/src/document.rs
+++ b/src/document.rs
@@ -1795,37 +1795,6 @@ impl BaseDocument {
         changed
     }

-    /// Materialise EVERY encoded image in the document
-    /// (nodes + url cache). Safety net before local rasterization
-    /// in dims-only mode; a no-op when nothing is encoded.
-    pub fn kitesurf_materialize_encoded_images(&mut self, ceiling: u32) -> usize {
-        let ids: Vec<usize> = self.nodes.iter().map(|(id, _)| id).collect();
-        let mut count = 0;
-        for id in ids {
-            if self.kitesurf_materialize_node_image(id, ceiling) {
-                count += 1;
-            }
-        }
-        for image in self.image_cache.values_mut() {
-            // URL-cache entries have no layout box; full decode
-            // (ceiling-capped). Node slots above were already
-            // materialised at their own hints.
-            if kitesurf_materialize_image_data(image, (0, 0), ceiling) {
-                count += 1;
-            }
-        }
-        count
-    }
-
-    /// Re-shape every inline context. Needed after a
-    /// font-collection swap that layout can't observe (e.g. the
-    /// emoji full-font upgrade replaces the fallback chain, but
-    /// shaped runs still reference the old FontData). Wraps the
-    /// crate-private invalidate_inline_contexts.
-    pub fn kitesurf_invalidate_inline_contexts(&mut self) {
-        self.invalidate_inline_contexts();
-    }
-
     /// Cache a loaded image and apply it to all nodes waiting on it
     /// (`<img>` elements, `background-image` layers and `mask-image` layers).
     /// Set a canvas element's framebuffer as its replaced

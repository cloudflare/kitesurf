From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Tue, 1 Sep 2026 19:50:36 +0100
Subject: [PATCH] Retain raw table tracks across terminal reflow

An ancestor-only move can change the terminal-grid phase while the table
cache keeps its tracks. Preserve Taffy's raw metadata and derive a
separate paint copy on each resolve.
---
 src/layout/table.rs | 5 +++++
 src/resolve.rs      | 3 ++-
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/layout/table.rs b/src/layout/table.rs
index 743ccc5..85791be 100644
--- a/src/layout/table.rs
+++ b/src/layout/table.rs
@@ -47,7 +47,10 @@ pub struct TableContext {
     pub oof_children: Vec<(NodeId, taffy::Position)>,
     pub rows: Vec<TableRow>,
     pub columns: Vec<TableColumn>,
+    /// Raw Taffy tracks, retained so a changed terminal-grid phase can re-snap them.
     pub computed_grid_info: AtomicRefCell<Option<DetailedGridInfo<Atom>>>,
+    /// Tracks consumed by paint; identical to computed_grid_info outside tty mode.
+    pub paint_grid_info: AtomicRefCell<Option<DetailedGridInfo<Atom>>>,
     pub border_style: Option<ServoArc<Border>>,
     pub border_collapse: BorderCollapse,
     /// Backing storage for `calc()` track sizes synthesised by the table layout code.
@@ -518,6 +521,7 @@ pub(crate) fn build_table_context(
             rows,
             columns,
             computed_grid_info: AtomicRefCell::new(None),
+            paint_grid_info: AtomicRefCell::new(None),
             border_collapse,
             border_style: first_cell_border,
             calc_values,
@@ -1018,6 +1022,7 @@ impl taffy::LayoutGridContainer for TableTreeWrapper<'_, '_> {
         _node_id: taffy::NodeId,
         detailed_grid_info: DetailedGridInfo<Atom>,
     ) {
+        *self.ctx.paint_grid_info.borrow_mut() = Some(detailed_grid_info.clone());
         *self.ctx.computed_grid_info.borrow_mut() = Some(detailed_grid_info);
     }
 }
diff --git a/src/resolve.rs b/src/resolve.rs
index bef94f1..b2b7dfb 100644
--- a/src/resolve.rs
+++ b/src/resolve.rs
@@ -782,7 +782,7 @@ impl BaseDocument {
                 let SpecialElementData::TableRoot(table) = &element.special_data else {
                     continue;
                 };
-                let Some(grid_info) = &mut *table.computed_grid_info.borrow_mut() else {
+                let Some(mut grid_info) = table.computed_grid_info.borrow().clone() else {
                     continue;
                 };
                 let mut table_x = 0.0;
@@ -804,5 +804,6 @@ impl BaseDocument {
                     table_y,
                     grid_y,
                 );
+                *table.paint_grid_info.borrow_mut() = Some(grid_info);
             }
         }

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Mon, 12 Oct 2026 17:34:48 +0100
Subject: [PATCH] Cancel the viewport scroll for fixed boxes of the root

hoisted_child_position cancels the scroll for a fixed box contained by
the root element, and recognised the root by its containing block being
None. But the root element is a layout child of the Document node, so
its containing block is the Document and the check never held. A fixed
box with a z-index (hoisted into the root's stacking context) then
scrolled away with the page: fixed headers vanished once the page
scrolled. Recognise the root by its containing block being the Document.

hit_inner made the same check for fixed paint children of the root, so
once the page scrolled a click on a fixed box with no z-index hit
whatever scrolled under it at document coordinates instead.
---
 src/layout/paint_tree.rs | 9 +++++++--
 src/node/node.rs         | 9 ++++++++-
 2 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/src/layout/paint_tree.rs b/src/layout/paint_tree.rs
index e631bff..e485a17 100644
--- a/src/layout/paint_tree.rs
+++ b/src/layout/paint_tree.rs
@@ -15,7 +15,7 @@ use thin_vec::ThinVec;

 use crate::layout::damage::ALL_DAMAGE;
 use crate::tree::NodeTree;
-use crate::{BaseDocument, Node};
+use crate::{BaseDocument, Node, NodeData};
 use style::properties::generated::longhands::position::computed_value::T as Position;
 use style::selector_parser::RestyleDamage;
 use style::values::computed::Float;
@@ -39,9 +39,14 @@ pub fn hoisted_child_position(tree: &NodeTree, sc_root_id: NodeId, child_id: Nod
     // positioned against the viewport and does not scroll with it: cancel the
     // scroll the walk below (or the stacking-context root itself) applies.
     // A fixed box contained by a transformed ancestor scrolls with it.
+    // The root element is a layout child of the Document node, so it is
+    // recognised by its containing block being the Document, not `None`.
     if child.taffy_position() == taffy::Position::Fixed
         && let Some(cb) = current.and_then(|id| tree.get(id))
-        && cb.containing_block().is_none()
+        && cb
+            .containing_block()
+            .and_then(|id| tree.get(id))
+            .is_none_or(|parent| matches!(parent.data, NodeData::Document(_)))
     {
         let scroll_offset = *cb.scroll_offset();
         let viewport_scroll = tree.fixed_anchor_scroll();
diff --git a/src/node/node.rs b/src/node/node.rs
index a9fd431..27d0914 100644
--- a/src/node/node.rs
+++ b/src/node/node.rs
@@ -1886,7 +1886,14 @@ impl Node {
                 // against the viewport and do not scroll with it. (A fixed box
                 // whose containing block is a transformed ancestor scrolls with
                 // that ancestor like any other out-of-flow box.)
-                if child_position == taffy::Position::Fixed && self.containing_block().is_none() {
+                // The root element is a layout child of the Document
+                // node, so recognise it by that, not by a `None` containing block.
+                if child_position == taffy::Position::Fixed
+                    && self
+                        .containing_block()
+                        .map(|id| self.with(id))
+                        .is_none_or(|parent| matches!(parent.data, NodeData::Document(_)))
+                {
                     child_x -= self.scroll_offset().x as f32;
                     child_y -= self.scroll_offset().y as f32;
                     let viewport_scroll = self.tree().viewport_scroll();

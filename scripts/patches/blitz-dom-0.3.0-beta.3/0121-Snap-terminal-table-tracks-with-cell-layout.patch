Date: Tue, 1 Sep 2026 19:36:57 +0100
Subject: [PATCH] Snap terminal table tracks with cell layout

The terminal grid rounds table-cell boxes but left DetailedGridInfo at
fractional coordinates. Keep collapsed-border gutters at pixel width and
absorb cumulative grid rounding into adjacent tracks so table painting
follows the cells.

Against blitz-dom 0.3.0-beta.3: the origin walk climbs
containing_block(), the box a location is relative to under native
out-of-flow layout.
---
 src/resolve.rs | 67 +++++++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 66 insertions(+), 1 deletion(-)

diff --git a/src/resolve.rs b/src/resolve.rs
index cf0d2aa..94361d4 100644
--- a/src/resolve.rs
+++ b/src/resolve.rs
@@ -31,9 +31,26 @@ use crate::{
         },
         damage::{ALL_DAMAGE, CONSTRUCT_BOX, CONSTRUCT_DESCENDENT, CONSTRUCT_FC},
     },
-    node::TextBrush,
+    node::{SpecialElementData, TextBrush},
 };

+fn snap_table_tracks(
+    tracks: &mut taffy::DetailedGridTracksInfo<style::Atom>,
+    origin: f32,
+    step: f32,
+) {
+    if step <= 1.0 || tracks.positions.is_empty() {
+        return;
+    }
+
+    let snap = |value: f32| (value / step).round() * step;
+    let snapped_origin = snap(origin);
+    for position in &mut tracks.positions {
+        position.start = snap(origin + position.start, step) - snapped_origin;
+        position.end = snap(origin + position.end, step) - snapped_origin;
+    }
+}

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kitesurf-vendor <vendor@kitesurf.invalid>
Date: Sat, 1 Jan 2000 00:00:00 +0000
Subject: [PATCH] Index the inline roots instead of scanning the slab for them

restore_clobbered_inline_breaks has nothing dirty to key off, so it runs
every resolve and used to find its inline roots by walking the whole
slab. On a 271k-node page only 82.8k nodes carry inline_layout_data, and
hunting for them cost 3.9ms of an 8.1ms layout phase.

Append to an index at the four sites that install inline_layout_data
instead. It is a superset, pruned in the same retain that performs the
width check, and sorted only when a push site actually ran. A root
escaping it would silently never re-break, so a debug_assert beside the
loop re-derives the set the slow way on every debug resolve.

layout 8.1ms -> 6.4ms at s1200, three runs each (baseline 7.8-8.2,
patched 6.1-6.6).
---
 src/document.rs      |  9 +++++++++
 src/layout/inline.rs |  3 +++
 src/resolve.rs       | 43 +++++++++++++++++++++++++++++++++----------
 3 files changed, 45 insertions(+), 10 deletions(-)

diff --git a/src/document.rs b/src/document.rs
index 19f7f29..c7303f4 100644
--- a/src/document.rs
+++ b/src/document.rs
@@ -373,6 +373,13 @@ pub struct BaseDocument {
     pub(crate) iframe_loads: HashMap<NodeId, crate::iframe::IframeLoad>,
     /// Set of changed nodes for updating the accessibility tree
     pub(crate) changed_nodes: HashSet<NodeId>,
+    /// Nodes that have been given inline_layout_data. A superset, pruned
+    /// where it is read: restore_clobbered_inline_breaks only cares about
+    /// inline roots, and scanning the slab to find them dominated layout.
+    pub(crate) inline_roots: Vec<NodeId>,
+    /// Length of `inline_roots` when it was last left sorted+deduped, so a
+    /// frame that pushed nothing new can skip re-sorting 80k+ entries.
+    pub(crate) inline_roots_settled: usize,
     /// Set of changed nodes for updating the accessibility tree
     pub(crate) deferred_construction_nodes: Vec<ConstructionTask>,

@@ -563,6 +570,8 @@ impl BaseDocument {
             pending_resource_deallocations: Vec::new(),

             changed_nodes: HashSet::new(),
+            inline_roots: Vec::new(),
+            inline_roots_settled: 0,
             deferred_construction_nodes: Vec::new(),
             image_cache: HashMap::new(),
             dims_only_images: config.dims_only_images,
diff --git a/src/layout/inline.rs b/src/layout/inline.rs
index 4efcc01..17bc625 100644
--- a/src/layout/inline.rs
+++ b/src/layout/inline.rs
@@ -339,6 +339,7 @@ impl LayoutPassState<'_> {
                 .downcast_element_mut()
                 .unwrap()
                 .inline_layout_data = Some(inline_layout);
+            self.inline_roots.push(node_id);
             return LayoutOutput::from_outer_size(
                 Size::ZERO.maybe_max(container_pb.sum_axes().map(Some)),
             );
@@ -630,6 +631,7 @@ impl LayoutPassState<'_> {
                 .downcast_element_mut()
                 .unwrap()
                 .inline_layout_data = Some(inline_layout);
+            self.inline_roots.push(node_id);

             let measured_size = inputs.known_dimensions.unwrap_or(taffy::Size {
                 width: width.ceil() / scale,
@@ -1188,6 +1190,7 @@ impl LayoutPassState<'_> {
             .downcast_element_mut()
             .unwrap()
             .inline_layout_data = Some(inline_layout);
+        self.inline_roots.push(node_id);

         let oof_position_inset = taffy::Rect {
             left: border.left,
diff --git a/src/resolve.rs b/src/resolve.rs
index db7bc22..8b2f134 100644
--- a/src/resolve.rs
+++ b/src/resolve.rs
@@ -570,6 +570,7 @@ impl BaseDocument {
                         .element_data_mut()
                         .unwrap()
                         .inline_layout_data = Some(layout);
+                    self.inline_roots.push(result.node_id);
                 }
             }
         }
@@ -636,26 +637,48 @@ impl BaseDocument {
     /// Non-inline nodes bail on the downcast, well under the cascade above.
     fn restore_clobbered_inline_breaks(&mut self) {
         let mut stale: Vec<(NodeId, f32)> = Vec::new();
-        for (id, node) in self.nodes.iter() {
+        let mut roots = std::mem::take(&mut self.inline_roots);
+        // Only the push sites can add duplicates or unsorted ids; if none ran
+        // this frame the vec is still sorted from last time.
+        if roots.len() > self.inline_roots_settled {
+            roots.sort_unstable();
+            roots.dedup();
+        }
+        debug_assert!(
+            !self.nodes.iter().any(|(id, n)| n
+                .data
+                .downcast_element()
+                .is_some_and(|el| el.inline_layout_data.is_some())
+                && roots.binary_search(&id).is_err()),
+            "an inline root escaped the index; its breaks would never restore"
+        );
+        // Prune dead entries in the same pass that checks them: retain keeps
+        // the sort order, so the invariant above survives.
+        let nodes = &self.nodes;
+        roots.retain(|&id| {
+            let Some(node) = nodes.get(id) else {
+                return false;
+            };
             let Some(inline) = node
                 .data
                 .downcast_element()
                 .and_then(|el| el.inline_layout_data.as_ref())
             else {
-                continue;
+                return false;
             };
             let l = node.final_layout();
             let content_w =
                 l.size.width - l.padding.left - l.padding.right - l.border.left - l.border.right;
-            if content_w <= 0.0 {
-                continue;
-            }
-            let unbroken = !inline.last_break_width.is_finite();
-            if unbroken || (content_w - inline.last_break_width).abs() > 0.5 {
-                stale.push((id, content_w));
+            if content_w > 0.0 {
+                let unbroken = !inline.last_break_width.is_finite();
+                if unbroken || (content_w - inline.last_break_width).abs() > 0.5 {
+                    stale.push((id, content_w));
+                }
             }
-        }
-
+            true
+        });
+        self.inline_roots_settled = roots.len();
+        self.inline_roots = roots;
         for (id, content_w) in stale {
             self.rebreak_inline_to_width(id, content_w);
         }

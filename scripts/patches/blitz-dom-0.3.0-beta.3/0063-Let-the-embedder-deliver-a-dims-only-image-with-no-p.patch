From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Mon, 3 Aug 2026 11:23:40 +0100
Subject: [PATCH] Let the embedder deliver a dims-only image with no payload

Dimensions are the only thing layout takes from an image, so an embedder
that has already sniffed them can keep the payload out of the document's
isolate entirely. kitesurf needs that for cross-origin images: its page
isolate is a realm page JS controls, so image bytes there are bytes the
page can read.

kitesurf_set_pending_image stages a resource key and, optionally,
dimensions immediately around the synchronous handler.bytes() call that
parses a delivery. Non-zero dimensions mean the payload is absent by
design, so the dims-only parse skips the header sniff and stores an
empty encoded entry carrying just w/h plus the key.

The key rides in the Blob id via Blob::from_raw_parts, so it reaches the
paint brush with no new field and no change to any trait signature:
which is what lets a consumer holding no bytes name the resource it is
asking for. Zero keeps Blob::new's counter id and the embedder's
existing content-hash identity.
---
 src/document.rs     | 15 ++++++++++-----
 src/net.rs          | 45 ++++++++++++++++++++++++++++++++++++++++++++-
 src/node/element.rs | 16 +++++++++++++---
 3 files changed, 67 insertions(+), 9 deletions(-)

diff --git a/src/document.rs b/src/document.rs
index 7fcaf19..989550c 100644
--- a/src/document.rs
+++ b/src/document.rs
@@ -1773,11 +1773,16 @@ impl BaseDocument {
                 self.stylist
                     .force_stylesheet_origins_dirty(style::stylesheets::OriginSet::all());
             }
-            Resource::EncodedImage(_kind, width, height, encoded_bytes) => {
-                // Dims-only load; cache dims + encoded
-                // bytes; paint happens out-of-isolate.
-                let image =
-                    ImageData::Raster(RasterImageData::new_encoded(width, height, encoded_bytes));
+            Resource::EncodedImage(_kind, width, height, encoded_bytes, key) => {
+                // Dims-only load: cache dims + encoded
+                // bytes; paint happens out-of-isolate. The bytes are
+                // empty when the embedder kept the payload itself.
+                let image = ImageData::Raster(RasterImageData::new_encoded(
+                    width,
+                    height,
+                    encoded_bytes,
+                    key,
+                ));

                 let Some(url) = res.resolved_url.as_ref() else {
                     return;
diff --git a/src/net.rs b/src/net.rs
index 375e7c1..4740c71 100644
--- a/src/net.rs
+++ b/src/net.rs
@@ -60,7 +60,11 @@ pub enum Resource {
     /// the container header, payload = original encoded bytes.
     /// Used in renderer mode where paint happens out-of-isolate,
     /// so we never materialise decoded RGBA here.
-    EncodedImage(ImageType, u32, u32, Arc<Vec<u8>>),
+    ///
+    /// Trailing u64 is the embedder-supplied resource key (0 = none),
+    /// and the payload is empty when the embedder kept it: see
+    /// `kitesurf_set_pending_image`.
+    EncodedImage(ImageType, u32, u32, Arc<Vec<u8>>, u64),
     #[cfg(feature = "svg")]
     Svg(ImageType, crate::node::SvgImageData),
     Css(DocumentStyleSheet),
@@ -684,6 +688,32 @@ impl NetHandler for ResourceHandler<ImageHandler> {
     }
 }

+thread_local! {
+    /// Resource key and, when the embedder sniffed them,
+    /// dimensions for the delivery currently being parsed. Set right
+    /// before handing bytes to a stashed handler; `parse` runs
+    /// synchronously inside that call, so a thread-local is enough and
+    /// no trait signature has to change.
+    static KITESURF_PENDING_IMAGE: std::cell::Cell<(u64, u32, u32)> =
+        const { std::cell::Cell::new((0, 0, 0)) };
+}
+
+/// Stage the key + dimensions the next dims-only image parse
+/// will adopt. A non-zero key means the embedder owns this resource's
+/// identity, which is what lets a consumer holding no bytes name it.
+/// Non-zero dimensions mean the payload is absent and these are
+/// authoritative: layout reads nothing else from an image.
+///
+/// Always clear it (0, 0, 0) after the delivery, so an unkeyed load
+/// cannot inherit a stale id or, worse, stale dimensions.
+pub fn kitesurf_set_pending_image(key: u64, width: u32, height: u32) {
+    KITESURF_PENDING_IMAGE.with(|k| k.set((key, width, height)));
+}
+
+fn kitesurf_take_pending_image() -> (u64, u32, u32) {
+    KITESURF_PENDING_IMAGE.with(|k| k.get())
+}
+
 impl ImageHandler {
     fn parse(&self, bytes: Bytes) -> Result<Resource, String> {
         // Renderer-mode fast path: header-only dimension
@@ -691,6 +721,18 @@ impl ImageHandler {
         // isolate rasterizer. Falls through to the normal decode
         // (and the SVG fallback) when the header can't be read.
         if self.dims_only {
+            // Embedder-supplied dimensions: the payload is absent by
+            // design, so there is nothing to sniff and nothing to keep.
+            let (staged_key, staged_w, staged_h) = kitesurf_take_pending_image();
+            if staged_w > 0 && staged_h > 0 {
+                return Ok(Resource::EncodedImage(
+                    self.kind,
+                    staged_w,
+                    staged_h,
+                    Arc::new(Vec::new()),
+                    staged_key,
+                ));
+            }
             if let Ok((w, h)) = image::ImageReader::new(Cursor::new(&bytes))
                 .with_guessed_format()
                 .expect("IO errors impossible with Cursor")
@@ -702,6 +744,7 @@ impl ImageHandler {
                         w,
                         h,
                         Arc::new(bytes.to_vec()),
+                        staged_key,
                     ));
                 }
             }
diff --git a/src/node/element.rs b/src/node/element.rs
index 8029dae..8d997d0 100644
--- a/src/node/element.rs
+++ b/src/node/element.rs
@@ -887,12 +887,22 @@ impl RasterImageData {
         }
     }

-    /// Dims-only entry; see the `encoded` field doc.
-    pub fn new_encoded(width: u32, height: u32, data: Arc<Vec<u8>>) -> Self {
+    /// Dims-only entry: see the `encoded` field doc.
+    ///
+    /// `key` is the embedder-supplied resource id. Non-zero means the
+    /// embedder owns identity for these bytes, so it rides in the Blob
+    /// id rather than being derived from a content hash: the point
+    /// being that a consumer holding no bytes can still name the
+    /// resource. Zero keeps `Blob::new`'s counter id.
+    pub fn new_encoded(width: u32, height: u32, data: Arc<Vec<u8>>, key: u64) -> Self {
         Self {
             width,
             height,
-            data: Blob::new(data),
+            data: if key != 0 {
+                Blob::from_raw_parts(data, key)
+            } else {
+                Blob::new(data)
+            },
             encoded: true,
         }
     }

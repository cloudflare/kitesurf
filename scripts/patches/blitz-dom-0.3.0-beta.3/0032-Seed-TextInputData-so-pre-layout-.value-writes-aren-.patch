From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Wed, 29 Jul 2026 12:17:58 +0100
Subject: [PATCH] Seed TextInputData so pre-layout .value writes aren't dropped

set_text_input_value bailed with false when the element had no
text-input data yet: which is every .value write landing between
parse and the first layout pass (create_text_editor only runs at
construct). Scripts that assign input/textarea values at parse time
painted nothing until the next IDL write forced a repaint. Seed an
editor for text-bearing elements (textarea, text-ish inputs) and let
construct's update branch pick the override up on first layout.
---
 src/mutator.rs | 22 +++++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/src/mutator.rs b/src/mutator.rs
index de45cbf..c4d1e99 100644
--- a/src/mutator.rs
+++ b/src/mutator.rs
@@ -5,7 +5,7 @@ use std::ops::{Deref, DerefMut};

 use crate::layout::damage::ALL_DAMAGE;
 use crate::net::{ImageHandler, ResourceHandler, StylesheetHandler};
-use crate::node::{CanvasData, NodeFlags, ShadowRootMode, SpecialElementData};
+use crate::node::{CanvasData, NodeFlags, ShadowRootMode, SpecialElementData, TextInputData};
 use crate::stylo_device::DeviceChanges;
 use crate::util::ImageType;
 use crate::{
@@ -1742,6 +1742,26 @@ impl<'doc> DocumentMutator<'doc> {
         let NodeData::Element(ref mut element) = node.data else {
             return false;
         };
+        // A .value write can land before the first layout
+        // pass has run create_text_editor (script during parse):
+        // there is no editor yet and the write would be dropped.
+        // Seed one so construct's update branch picks it up.
+        if element.text_input_data_mut().is_none() {
+            let tag: &str = &element.name.local;
+            let is_multiline = tag == "textarea";
+            let is_text_input = tag == "input"
+                && matches!(
+                    element.attr(local_name!("type")),
+                    None | Some(
+                        "text" | "password" | "email" | "number" | "search" | "tel" | "url"
+                    )
+                );
+            if !(is_multiline || is_text_input) {
+                return false;
+            }
+            element.special_data =
+                SpecialElementData::TextInput(TextInputData::new(is_multiline));
+        }
         let Some(input_data) = element.text_input_data_mut() else {
             return false;
         };

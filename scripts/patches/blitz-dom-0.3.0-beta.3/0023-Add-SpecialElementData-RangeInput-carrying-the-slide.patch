From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Sat, 25 Jul 2026 23:17:30 +0100
Subject: [PATCH] Add SpecialElementData::RangeInput carrying the slider's live
 value

Range inputs previously got NO special data; no value display at
all. Seed RangeInput(value) at layout-construct from the value/min/
max attributes (HTML default: range midpoint) and keep an existing
variant across construct passes so the live IDL value set through
kitesurf's setInputText survives. range_input_value() accessor for
the paint layer.
---
 src/layout/construct.rs | 28 ++++++++++++++++++++++++++++
 src/mutator.rs          |  1 +
 src/node/element.rs     | 17 +++++++++++++++++
 3 files changed, 46 insertions(+)

diff --git a/src/layout/construct.rs b/src/layout/construct.rs
index 970f13e..5ce5867 100644
--- a/src/layout/construct.rs
+++ b/src/layout/construct.rs
@@ -470,6 +470,34 @@ fn collect_layout_children_with_wrap(
             } else if matches!(type_attr, Some("checkbox" | "radio")) {
                 create_checkbox_input(doc, container_node_id);
                 return;
+            } else if matches!(type_attr, Some("range")) {
+                // Seed the slider's live value from the
+                // value/min/max attributes (HTML default: midpoint
+                // of the range when no value attribute). Construct
+                // re-runs on every layout pass; keep an existing
+                // RangeInput (it carries the live IDL value).
+                let el = doc.nodes[container_node_id]
+                    .data
+                    .downcast_element_mut()
+                    .unwrap();
+                if !matches!(el.special_data, SpecialElementData::RangeInput(_)) {
+                    let min = el
+                        .attr(local_name!("min"))
+                        .and_then(|v| v.parse::<f64>().ok())
+                        .unwrap_or(0.0);
+                    let max = el
+                        .attr(local_name!("max"))
+                        .and_then(|v| v.parse::<f64>().ok())
+                        .unwrap_or(100.0);
+                    let max = max.max(min);
+                    let value = el
+                        .attr(local_name!("value"))
+                        .and_then(|v| v.parse::<f64>().ok())
+                        .unwrap_or((min + max) / 2.0)
+                        .clamp(min, max);
+                    el.special_data = SpecialElementData::RangeInput(value);
+                }
+                return;
             }
         }

diff --git a/src/mutator.rs b/src/mutator.rs
index 90d9dca..a39647a 100644
--- a/src/mutator.rs
+++ b/src/mutator.rs
@@ -1231,6 +1231,7 @@ impl<'doc> DocumentMutator<'doc> {
                 SpecialElementData::TableRoot(_) => {}
                 SpecialElementData::TextInput(_) => {}
                 SpecialElementData::CheckboxInput(_) => {}
+                SpecialElementData::RangeInput(_) => {}
                 #[cfg(feature = "file-input")]
                 SpecialElementData::FileInput(_) => {}
                 SpecialElementData::None => {}
diff --git a/src/node/element.rs b/src/node/element.rs
index 3fb3d93..c1860fd 100644
--- a/src/node/element.rs
+++ b/src/node/element.rs
@@ -369,6 +369,12 @@ pub enum SpecialElementData {
     TextInput(TextInputData),
     /// Checkbox checked state
     CheckboxInput(bool),
+    /// Live IDL value of an `<input type=range>` slider.
+    /// The paint layer combines it with the min/max/step attributes
+    /// to place the thumb; JS updates it via the setInputText wasm
+    /// entry (same IDL-vs-attribute decoupling as TextInput's
+    /// value_override).
+    RangeInput(f64),
     /// Selected files
     #[cfg(feature = "file-input")]
     FileInput(FileData),
@@ -389,6 +395,7 @@ impl Clone for SpecialElementData {
             Self::TableRoot(data) => Self::TableRoot(data.clone()),
             Self::TextInput(data) => Self::TextInput(data.clone()),
             Self::CheckboxInput(data) => Self::CheckboxInput(*data),
+            Self::RangeInput(data) => Self::RangeInput(*data),
             #[cfg(feature = "file-input")]
             Self::FileInput(data) => Self::FileInput(data.clone()),
             Self::None => Self::None,
@@ -604,6 +611,15 @@ impl ElementData {
         }
     }

+    /// Live value of an `<input type=range>`, when the
+    /// special data has been initialized (layout construct pass).
+    pub fn range_input_value(&self) -> Option<f64> {
+        match self.special_data {
+            SpecialElementData::RangeInput(value) => Some(value),
+            _ => None,
+        }
+    }
+
     pub fn checkbox_input_checked_mut(&mut self) -> Option<&mut bool> {
         match self.special_data {
             SpecialElementData::CheckboxInput(ref mut checked) => Some(checked),
@@ -929,6 +945,7 @@ impl std::fmt::Debug for SpecialElementData {
             SpecialElementData::TableRoot(_) => f.write_str("NodeSpecificData::TableRoot"),
             SpecialElementData::TextInput(_) => f.write_str("NodeSpecificData::TextInput"),
             SpecialElementData::CheckboxInput(_) => f.write_str("NodeSpecificData::CheckboxInput"),
+            SpecialElementData::RangeInput(_) => f.write_str("NodeSpecificData::RangeInput"),
             #[cfg(feature = "file-input")]
             SpecialElementData::FileInput(_) => f.write_str("NodeSpecificData::FileInput"),
             SpecialElementData::None => f.write_str("NodeSpecificData::None"),

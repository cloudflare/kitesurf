+) -> Vec<PendingFontFace> {
     rules
         .filter_map(|rule| match rule {
             CssRule::FontFace(font_face) => {
@@ -439,11 +438,12 @@ pub(crate) fn fetch_font_face_rules<'a>(
                     }),

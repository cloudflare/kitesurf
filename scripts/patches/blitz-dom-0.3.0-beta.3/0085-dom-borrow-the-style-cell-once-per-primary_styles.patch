From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Sun, 9 Aug 2026 03:09:37 +0100
Subject: [PATCH] dom: borrow the style cell once per primary_styles

The presence check took a borrow, dropped it, then took a second to
build the returned ref. Paint calls this per element and again per
glyph run, so the discarded borrow was pure overhead.
---
 src/node/stylo_data.rs | 12 +++++-------
 1 file changed, 5 insertions(+), 7 deletions(-)

diff --git a/src/node/stylo_data.rs b/src/node/stylo_data.rs
index 7323ebf..e221f5c 100644
--- a/src/node/stylo_data.rs
+++ b/src/node/stylo_data.rs
@@ -69,13 +69,11 @@ impl StyloData {
     }

     pub fn primary_styles(&self) -> Option<StyleDataRef<'_>> {
-        let stylo_element_data = self.get();
-        if stylo_element_data
-            .as_ref()
-            .and_then(|d| d.styles.get_primary())
-            .is_some()
-        {
-            Some(StyleDataRef(self.get().unwrap()))
+        // One borrow, not two: paint calls this per element and per glyph
+        // run, and the discarded first borrow was an atomic round trip.
+        let data = self.get()?;
+        if data.styles.get_primary().is_some() {
+            Some(StyleDataRef(data))
         } else {
             None
         }

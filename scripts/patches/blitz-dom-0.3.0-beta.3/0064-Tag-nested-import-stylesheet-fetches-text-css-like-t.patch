From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Mon, 3 Aug 2026 22:47:04 +0100
Subject: [PATCH] Tag nested @import stylesheet fetches text/css like the top
 level

load_linked_stylesheet stamps `content_type = "text/css"` so the
embedder's NetProvider can tell a stylesheet load from a generic one
without peeking at the NetHandler type. StylesheetLoader's nested
@import fetch never got the same stamp, so those requests fell through
to URL-extension inference.

Any @import whose URL carries no `.css` extension therefore resolved to
a generic resource kind and lost the stylesheet-specific handling the
top-level sheet receives. Wikipedia-style `load.php?modules=...` imports
are the common shape.
---
 src/net.rs | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/net.rs b/src/net.rs
index 4740c71..88301d4 100644
--- a/src/net.rs
+++ b/src/net.rs
@@ -234,9 +234,15 @@ impl ServoStylesheetLoader for StylesheetLoader {

         let url = import.url.url().unwrap().clone();
         let import = ServoArc::new(lock.wrap(import));
+        // Tag nested @import loads `text/css` too. Without
+        // it the embedder falls back to URL-extension inference, and
+        // an extension-less @import (load.php?…) resolves to a generic
+        // kind, losing the stylesheet handling the top level gets.
+        let mut req = stamped_request(url.as_ref().clone(), self.abort_signal.as_ref());
+        req.content_type = Some(String::from("text/css"));
         self.net_provider.fetch(
             self.doc_id,
-            stamped_request(url.as_ref().clone(), self.abort_signal.as_ref()),
+            req,
             ResourceHandler::boxed(
                 self.tx.clone(),
                 self.doc_id,

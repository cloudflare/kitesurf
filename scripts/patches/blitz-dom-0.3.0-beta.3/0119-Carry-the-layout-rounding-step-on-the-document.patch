From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Mon, 24 Aug 2026 18:08:34 +0100
Subject: [PATCH] Carry the layout rounding step on the document

The terminal backend needs boxes on cell boundaries rather than pixel
boundaries, and taffy now takes that step from the RoundTree. Store it
per-document so a single process can host both a terminal document and
an ordinary rasterised one; the default is (1, 1), taffy's own
behaviour, so nothing changes for a caller that never sets it.
---
 src/document.rs   | 11 +++++++++++
 src/layout/mod.rs |  4 ++++
 2 files changed, 15 insertions(+)

diff --git a/src/document.rs b/src/document.rs
index 645b445..66ad983 100644
--- a/src/document.rs
+++ b/src/document.rs
@@ -216,6 +216,10 @@ pub struct BaseDocument {
     pub(crate) devtool_settings: DevtoolSettings,
     // Viewport details such as the dimensions, HiDPI scale, and zoom factor,
     pub(crate) viewport: Viewport,
+    /// The step `taffy::round_layout` snaps this document's
+    /// boxes to, as (x, y). One pixel until a character-cell backend
+    /// sets the cell size.
+    pub(crate) round_grid: (f32, f32),
     /// CSS counter side tables (list-item values + resolved pseudo
     /// content), rebuilt by resolve_counters on every resolve pass.
     pub(crate) counters: crate::layout::counters::CounterOutput,
@@ -476,6 +480,12 @@ pub struct BaseDocument {
 }

 impl BaseDocument {
+    /// Snap layout to a `w` x `h` grid instead of whole pixels.
+    pub fn set_round_grid(&mut self, w: f32, h: f32) {
+        let ok = |v: f32| v.is_finite() && v >= 1.0;
+        self.round_grid = if ok(w) && ok(h) { (w, h) } else { (1.0, 1.0) };
+    }
+
     /// Create a new (empty) [`BaseDocument`] with the specified configuration
     pub fn new(config: DocumentConfig) -> Self {
         static ID_GENERATOR: AtomicUsize = AtomicUsize::new(1);
@@ -576,6 +586,7 @@ impl BaseDocument {
             subdocument_depth: config.subdocument_depth,
             damage_summary: DamageSummary::default(),
             devtool_settings: DevtoolSettings::default(),
+            round_grid: (1.0, 1.0),
             counters: Default::default(),
             author_font_registrations: Vec::new(),
             counters_seen: false,
diff --git a/src/layout/mod.rs b/src/layout/mod.rs
index 5fd9521..7e8623f 100644
--- a/src/layout/mod.rs
+++ b/src/layout/mod.rs
@@ -981,6 +981,10 @@ impl RoundTree for LayoutPassState<'_> {
     fn get_hoisted_child_id(&self, node_id: NodeId, index: usize) -> NodeId {
         taffy_node_id(self.node_from_id(node_id).hoisted_children.borrow()[index])
     }
+
+    fn round_grid(&self) -> (f32, f32) {
+        self.round_grid
+    }
 }

 pub(crate) struct TaffyDebugTree<'doc>(pub(crate) &'doc BaseDocument);

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Sat, 25 Jul 2026 11:27:26 +0100
Subject: [PATCH] Materialize decodes at the node's laid-out size
 (mip-quantized)

Chrome-style decode-at-need for the in-place materialize paths:
the node's final_layout box is the decode hint, quantized to the
largest power-of-two downscale of the header dims that still
covers it. The ceiling parameter is now only the extreme guard
(GPU-max-texture analog), not a quality policy. Zero-box nodes
(display:none / not laid out) and URL-cache entries decode at
header dims, ceiling-capped.

Mirrors kitesurf-core scene_replay::mip_dims; kept honest by the
renderer-vs-legacy pixel parity e2e.
---
 src/document.rs | 64 +++++++++++++++++++++++++++++++++++++++----------
 1 file changed, 52 insertions(+), 12 deletions(-)

diff --git a/src/document.rs b/src/document.rs
index 3f3e881..b15d9ac 100644
--- a/src/document.rs
+++ b/src/document.rs
@@ -1703,22 +1703,34 @@ impl BaseDocument {
     /// paths (canvas drawImage, legacy screenshot/PDF fallback)
     /// see real pixels. Returns true if anything changed.
     ///
-    /// Decoded dims can differ from the header dims when max_dim
-    /// caps them; damage + cache clears keep layout honest.
-    pub fn kitesurf_materialize_node_image(&mut self, node_id: usize, max_dim: u32) -> bool {
+    /// Chrome-style decode-at-need: the node's laid-out box size
+    /// is the decode hint; the decode picks the smallest power-of-
+    /// two mip of the header dims that still covers it (ceiling as
+    /// the extreme guard). Decoded dims can therefore differ from
+    /// header dims; damage + cache clears keep layout honest.
+    pub fn kitesurf_materialize_node_image(&mut self, node_id: NodeId, ceiling: u32) -> bool {
         let Some(node) = self.get_node_mut(node_id) else {
             return false;
         };
+        // Laid-out content box in CSS px (device px at scale 1).
+        // A zero box (display:none / not laid out) means no hint;
+        // decode at header dims, ceiling-capped.
+        let hint = {
+            let size = node.final_layout().size;
+            let w = size.width.ceil() as u32;
+            let h = size.height.ceil() as u32;
+            if w > 0 && h > 0 { (w, h) } else { (0, 0) }
+        };
         let Some(el) = node.element_data_mut() else {
             return false;
         };
         let mut changed = false;
         if let SpecialElementData::Image(data) = &mut el.special_data {
-            changed |= kitesurf_materialize_image_data(data, max_dim);
+            changed |= kitesurf_materialize_image_data(data, hint, ceiling);
         }
         for layer in el.background_images.iter_mut().chain(el.mask_images.iter_mut()) {
             if let Some(res) = layer {
-                changed |= kitesurf_materialize_image_data(&mut res.image, max_dim);
+                changed |= kitesurf_materialize_image_data(&mut res.image, hint, ceiling);
             }
         }
         if changed {
@@ -1731,16 +1743,19 @@ impl BaseDocument {
     /// Materialise EVERY encoded image in the document
     /// (nodes + url cache). Safety net before local rasterization
     /// in dims-only mode; a no-op when nothing is encoded.
-    pub fn kitesurf_materialize_encoded_images(&mut self, max_dim: u32) -> usize {
+    pub fn kitesurf_materialize_encoded_images(&mut self, ceiling: u32) -> usize {
         let ids: Vec<usize> = self.nodes.iter().map(|(id, _)| id).collect();
         let mut count = 0;
         for id in ids {
-            if self.kitesurf_materialize_node_image(id, max_dim) {
+            if self.kitesurf_materialize_node_image(id, ceiling) {
                 count += 1;
             }
         }
         for image in self.image_cache.values_mut() {
-            if kitesurf_materialize_image_data(image, max_dim) {
+            // URL-cache entries have no layout box; full decode
+            // (ceiling-capped). Node slots above were already
+            // materialised at their own hints.
+            if kitesurf_materialize_image_data(image, (0, 0), ceiling) {
                 count += 1;
             }
         }
@@ -3789,7 +3804,13 @@ mod font_face_override_tests {

 /// Decode an EncodedRaster-style ImageData (RGBA blob
 /// flagged `encoded`) in place. Shared by the materialize paths.
-fn kitesurf_materialize_image_data(image: &mut ImageData, max_dim: u32) -> bool {
+/// hint = painted/laid-out size in device px ((0,0) = none);
+/// ceiling = extreme guard on either axis.
+fn kitesurf_materialize_image_data(
+    image: &mut ImageData,
+    hint: (u32, u32),
+    ceiling: u32,
+) -> bool {
     let ImageData::Raster(raster) = image else {
         return false;
     };
@@ -3805,10 +3826,10 @@ fn kitesurf_materialize_image_data(image: &mut ImageData, max_dim: u32) -> bool
             return true;
         }
     };
-    let (w, h) = (decoded.width(), decoded.height());
-    let scaled = if w > max_dim || h > max_dim {
+    let (tw, th) = kitesurf_mip_dims(decoded.width(), decoded.height(), hint.0, hint.1, ceiling);
+    let scaled = if decoded.width() > tw || decoded.height() > th {
         use image::imageops::FilterType;
-        decoded.resize(max_dim, max_dim, FilterType::Triangle)
+        decoded.resize(tw, th, FilterType::Triangle)
     } else {
         decoded
     };
@@ -3817,3 +3838,22 @@ fn kitesurf_materialize_image_data(image: &mut ImageData, max_dim: u32) -> bool
     *image = ImageData::Raster(RasterImageData::new(fw, fh, std::sync::Arc::new(rgba)));
     true
 }
+
+/// Chrome-style mip selection: largest power-of-two
+/// downscale of the header dims still covering the hint, clamped
+/// to the ceiling. Mirrors scene_replay::mip_dims in kitesurf-core
+/// (kept in sync by the round-trip parity e2e).
+fn kitesurf_mip_dims(header_w: u32, header_h: u32, hint_w: u32, hint_h: u32, ceiling: u32) -> (u32, u32) {
+    let (mut w, mut h) = (header_w.max(1), header_h.max(1));
+    if hint_w > 0 && hint_h > 0 {
+        while w / 2 >= hint_w && h / 2 >= hint_h {
+            w /= 2;
+            h /= 2;
+        }
+    }
+    while w > ceiling || h > ceiling {
+        w = (w / 2).max(1);
+        h = (h / 2).max(1);
+    }
+    (w, h)
+}

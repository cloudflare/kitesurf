+        self.maybe_push_anon_block(doc);
+        if self.anonymous_table_id.is_none() {
+            self.create_anonymous_table(container_node_id, doc);
+        }
+        doc.nodes[self.anonymous_table_id.unwrap()]
+            .children
+            .push(child_id);
+    }

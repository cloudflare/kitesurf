From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Fri, 24 Jul 2026 13:35:01 +0100
Subject: [PATCH] Parse shadow-root innerHTML under a temp host-named element

html5ever's parse_fragment_for_element calls the sink's elem_name on
the context handle, which expects an element and panics for a shadow
root (nodeType 11 lives in the tree as a non-element container).
set_inner_html now parses into a throwaway element cloned from the
host's tag name - matching the context a browser would use - then
adopts the children into the root and drops the temp. Everything else
(scoped <style> registration, damage) rides the normal append path.
---
 src/mutator.rs | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/src/mutator.rs b/src/mutator.rs
index 102e43a..29cfcf0 100644
--- a/src/mutator.rs
+++ b/src/mutator.rs
@@ -1008,6 +1008,30 @@ impl<'doc> DocumentMutator<'doc> {

     pub fn set_inner_html(&mut self, node_id: NodeId, html: &str) {
         self.remove_and_drop_all_children(node_id);
+
+        // html5ever's fragment parser needs an element context (its
+        // elem_name callback panics otherwise). Shadow roots parse
+        // under a temp element named like the host, then adopt.
+        let shadow_host = self.doc.nodes[node_id]
+            .shadow_root_data()
+            .map(|data| data.host);
+        if let Some(host_id) = shadow_host {
+            let host_name = self.doc.nodes[host_id]
+                .element_data()
+                .expect("shadow host must be an element")
+                .name
+                .clone();
+            let tmp_id = self.create_element(host_name, Vec::new());
+            self.doc
+                .html_parser_provider
+                .clone()
+                .parse_inner_html(self, tmp_id, html);
+            let child_ids = self.child_ids(tmp_id);
+            self.append_children(node_id, &child_ids);
+            self.remove_and_drop_node(tmp_id);
+            return;
+        }
+
         self.doc
             .html_parser_provider
             .clone()

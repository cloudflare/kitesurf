From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Sat, 1 Aug 2026 19:34:38 +0100
Subject: [PATCH] SVG generic families fall back to the registered sans face

usvg's font selector ends its name list with fontdb's serif generic, so
an unregistered named family resolves to nothing and the text is dropped
outright: chart axis labels asking for `font-family="Arial"` vanished
even after the font database was populated.

Point every generic (serif, monospace, cursive, fantasy) at the sans
face when it is registered; a later register_svg_font for the serif or
monospace slot overwrites its own entry with the real face. Pages that
never load those faces (we skip them unless the content needs them) now
degrade to sans instead of to nothing.
---
 src/util.rs | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/util.rs b/src/util.rs
index b7f2e3d..c7751f5 100644
--- a/src/util.rs
+++ b/src/util.rs
@@ -90,6 +90,17 @@ pub fn register_svg_font(
         match slot {
             SvgGenericSlot::SansSerif => {
                 db.set_sans_serif_family(family.clone());
+                // usvg's font selector appends fontdb's serif generic as its
+                // last resort, so an unregistered named family such as
+                // `Arial` resolves to nothing and the text is dropped.
+
+                // Point every generic at the sans face as a floor; a later
+                // register_svg_font for the serif/monospace slots overwrites
+                // its own entry with the real face.
+                db.set_serif_family(family.clone());
+                db.set_monospace_family(family.clone());
+                db.set_cursive_family(family.clone());
+                db.set_fantasy_family(family.clone());
                 // usvg falls back to Options::font_family for text with no
                 // usable family; point that at the sans face too.
                 if let Ok(mut default) = SVG_DEFAULT_FAMILY.write() {

 mod author_sheet_cache_tests {
     use super::*;
     use crate::qual_name;

+    #[derive(Default)]
+    struct ConstantHasher;
+
+    impl std::hash::Hasher for ConstantHasher {
+        fn finish(&self) -> u64 {
+            0
+        }
+
+        fn write(&mut self, _: &[u8]) {}
+    }
+
+    #[test]
+    fn hash_map_collisions_keep_distinct_css_and_media_entries() {
+        use std::hash::BuildHasherDefault;
+
+        let doc = BaseDocument::new(DocumentConfig::default());
+        let red_css = "body { color: red; }";
+        let blue_css = "body { color: blue; }";
+        let media = "screen";
+        let mut cache: HashMap<
+            AuthorSheetCssKey,
+            AuthorSheetCacheEntry,
+            BuildHasherDefault<ConstantHasher>,
+        > = HashMap::default();
+        let mut red_entry = AuthorSheetCacheEntry {
+            without_media: Some(doc.make_stylesheet(red_css, Origin::Author)),
+            ..Default::default()
+        };
+        red_entry.media.insert(
+            Arc::from(media),
+            doc.make_stylesheet_with_media(red_css, Origin::Author, Some(media)),
+        );
+        cache.insert(author_sheet_css_key(red_css), red_entry);
+        cache.insert(
+            author_sheet_css_key(blue_css),
+            AuthorSheetCacheEntry {
+                without_media: Some(doc.make_stylesheet(blue_css, Origin::Author)),
+                ..Default::default()
+            },
+        );
+
+        assert_eq!(cache.len(), 2, "the test hasher forces a collision");
+        for (css, media) in [(red_css, None), (blue_css, None), (red_css, Some(media))] {
+            let key = author_sheet_css_key(css);
+            let (css_key, media_key, _sheet) =
+                find_author_sheet_cache_entry(&cache, &key, media).unwrap();
+            assert_eq!(*css_key, key);
+            assert_eq!(media_key.map(|key| key.as_ref()), media);
+        }
+        assert!(
+            find_author_sheet_cache_entry(
+                &cache,
+                &author_sheet_css_key("body { color: green; }"),
+                None
+            )
+            .is_none()
+        );
+    }

+#[derive(Clone, Copy, Debug, Hash, PartialEq, Eq)]
+pub(crate) struct AuthorSheetCssKey {
+    len: usize,
+    hash: u128,
+}
+
+fn author_sheet_css_key(css: &str) -> AuthorSheetCssKey {
+    use std::hash::{DefaultHasher, Hasher};
+    let half = |seed: u8| {
+        let mut hasher = DefaultHasher::new();
+        hasher.write_u8(seed);
+        hasher.write(css.as_bytes());
+        u128::from(hasher.finish())
+    };
+    AuthorSheetCssKey {
+        len: css.len(),
+        hash: half(0) << 64 | half(1),
+    }
+}
+
+#[derive(Clone, PartialEq, Eq)]
+pub(crate) struct AuthorSheetCacheKey {
+    css: AuthorSheetCssKey,
+    media: Option<Arc<str>>,
+}
+
+#[derive(Default)]
+pub(crate) struct AuthorSheetCacheEntry {
+    without_media: Option<DocumentStyleSheet>,
+    media: HashMap<Arc<str>, DocumentStyleSheet>,
+}
+
+fn find_author_sheet_cache_entry<'a, S: std::hash::BuildHasher>(
+    cache: &'a HashMap<AuthorSheetCssKey, AuthorSheetCacheEntry, S>,
+    css: &AuthorSheetCssKey,
+    media: Option<&str>,
+) -> Option<(
+    &'a AuthorSheetCssKey,
+    Option<&'a Arc<str>>,
+    Option<&'a DocumentStyleSheet>,
+)> {
+    let (css_key, entry) = cache.get_key_value(css)?;
+    let (media_key, sheet) = match media {
+        Some(media) => entry
+            .media
+            .get_key_value(media)
+            .map(|(key, sheet)| (Some(key), Some(sheet)))
+            .unwrap_or((None, None)),
+        None => (None, entry.without_media.as_ref()),
+    };
+    Some((css_key, media_key, sheet))
+}

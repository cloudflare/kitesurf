From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Sun, 26 Jul 2026 00:14:38 +0100
Subject: [PATCH] Flush nested inline pseudo-elements (child display, not
 parent's)

flush_inline_pseudos_recursive decided whether to recurse into a
child by reading the display of the node being iterated (the parent)
instead of the child's. For a block inline-context root the check was
always false, so ::before/::after on inline elements nested deeper
than one level (p > span > i.icon:before; every icon-font pattern)
were never synthesized. The inline layout builder already handles
nested pseudos; the nodes just never existed. Found on
azuleja.azulpop.pt's bootstrap-icons empty-state icons.
---
 src/layout/construct.rs | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/layout/construct.rs b/src/layout/construct.rs
index 5ce5867..d19f0b4 100644
--- a/src/layout/construct.rs
+++ b/src/layout/construct.rs
@@ -1075,7 +1075,15 @@ pub(crate) fn find_inline_layout_embedded_boxes(
     fn flush_inline_pseudos_recursive(doc: &mut BaseDocument, node_id: NodeId) {
         doc.iter_flat_children_mut(node_id, |child_id, doc| {
             flush_pseudo_elements(doc, child_id);
-            let display = doc.nodes[node_id]
+            // Recurse based on the child's display, not the
+            // parent's. Reading doc.nodes[node_id] (the node being
+            // iterated) would make do_recurse false for a block
+            // inline-context root (p, div), so ::before/::after on
+            // inline elements nested deeper than one level
+            // (p > span > i.icon:before) would never be synthesized.
+            // The recursive walk below (build_inline_layout_recursive)
+            // handles nested pseudos once they exist.
+            let display = doc.nodes[child_id]
                 .display_style()
                 .unwrap_or(Display::inline());
             let do_recurse = match (display.outside(), display.inside()) {

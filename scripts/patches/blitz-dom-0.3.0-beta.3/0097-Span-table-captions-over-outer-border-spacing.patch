From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Sat, 5 Sep 2026 09:46:41 +0100
Subject: [PATCH] Span table captions over outer border spacing

Blitz beta.2 models separate-border outer spacing as synthetic table
padding, which sits outside the caption's grid area. Extend caption grid
items across that padding without removing the spacing around the cells.

Against blitz-dom 0.3.0-beta.3: kept next to upstream's own synthesized
calc_values on TableContext.
---
 src/layout/table.rs | 62 +++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 62 insertions(+)

diff --git a/src/layout/table.rs b/src/layout/table.rs
index 0a9cf32..a20368b 100644
--- a/src/layout/table.rs
+++ b/src/layout/table.rs
@@ -52,6 +52,45 @@ pub struct TableContext {
     /// Taffy stores calc values as raw pointers, so these must outlive the `style`.
     #[allow(dead_code)]
     calc_values: Vec<LengthPercentage>,
+    caption_margin_adjustments: Vec<Arc<CaptionMarginAdjustment>>,
+}
+
+#[derive(Debug)]
+struct CaptionMarginAdjustment {
+    value: taffy::LengthPercentageAuto,
+    spacing: f32,
+}
+
+impl CaptionMarginAdjustment {
+    fn resolve(&self, inner_width: f32) -> f32 {
+        let outer_width = inner_width + 2.0 * self.spacing;
+        let value = match self.value.expand() {
+            taffy::ExpandedLengthPercentageAuto::Length(value) => value,
+            taffy::ExpandedLengthPercentageAuto::Percent(value) => value * outer_width,
+            taffy::ExpandedLengthPercentageAuto::Calc(value) => {
+                resolve_calc_value(value, outer_width)
+            }
+            taffy::ExpandedLengthPercentageAuto::Auto => unreachable!(),
+        };
+        value - self.spacing
+    }
+}
+
+fn compensate_caption_margin(
+    value: taffy::LengthPercentageAuto,
+    spacing: f32,
+    adjustments: &mut Vec<Arc<CaptionMarginAdjustment>>,
+) -> taffy::LengthPercentageAuto {
+    if value.is_auto() {
+        return value;
+    }
+
+    // Taffy's grid area excludes the synthetic outer border spacing. Resolve
+    // the author margin against the full table, then map it into that area.
+    let adjustment = Arc::new(CaptionMarginAdjustment { value, spacing });
+    let pointer = Arc::as_ptr(&adjustment).cast();
+    adjustments.push(adjustment);
+    taffy::LengthPercentageAuto::calc(pointer)
 }

 // #[derive(Debug, Clone, Eq, PartialEq)]
@@ -371,11 +410,25 @@ pub(crate) fn build_table_context(
         }
     }
     let column_count = num_columns.max(1);
+    let mut caption_margin_adjustments = Vec::new();
     for caption in cells.iter_mut().filter(|cell| cell.is_caption) {
         caption.style.grid_column = taffy::Line {
             start: style_helpers::line(1),
             end: style_helpers::span(column_count),
         };
+        if border_collapse == BorderCollapse::Separate {
+            let spacing_x = border_spacing.width.px();
+            caption.style.margin.left = compensate_caption_margin(
+                caption.style.margin.left,
+                spacing_x,
+                &mut caption_margin_adjustments,
+            );
+            caption.style.margin.right = compensate_caption_margin(
+                caption.style.margin.right,
+                spacing_x,
+                &mut caption_margin_adjustments,
+            );
+        }
     }

     style.grid_template_columns = column_sizes.into_iter().map(|dim| dim.into()).collect();
@@ -463,6 +516,7 @@ pub(crate) fn build_table_context(
             border_collapse,
             border_style: first_cell_border,
             calc_values,
+            caption_margin_adjustments,
         },
         layout_children,
     )
@@ -895,5 +949,13 @@ impl taffy::LayoutPartialTree for TableTreeWrapper<'_, '_> {
     }

     fn resolve_calc_value(&self, calc_ptr: *const (), parent_size: f32) -> f32 {
+        if let Some(adjustment) = self
+            .ctx
+            .caption_margin_adjustments
+            .iter()
+            .find(|adjustment| Arc::as_ptr(adjustment).cast() == calc_ptr)
+        {
+            return adjustment.resolve(parent_size);
+        }
         resolve_calc_value(calc_ptr, parent_size)
     }

+/// The `id` the svg snapshot serializer stamps on an id-less
+/// element (`Node::svg_source`), and the key a bbox lookup hands to
+/// `usvg::Tree::node_by_id` for the same DOM node. `index` is the element's
+/// 1-based pre-order position among the snapshot root's descendant elements
+/// (not its node id), so two identical icons at different DOM positions
+/// still serialize byte-for-byte the same and share one entry in the
+/// parsed-tree cache (`util::parse_svg_image`). Prefixed so it cannot
+/// collide with an author id or a `url(#…)` ref.
+pub fn svg_snapshot_id(index: u32) -> String {
+    format!("ks-svg-{index}")
+}

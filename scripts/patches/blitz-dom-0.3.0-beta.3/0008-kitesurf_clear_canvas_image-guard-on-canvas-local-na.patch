From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Fri, 24 Jul 2026 17:34:53 +0100
Subject: [PATCH] kitesurf_clear_canvas_image: guard on canvas local name

kitesurf_set_canvas_image refuses non-canvas elements, but the clear
path only checked for SpecialElementData::Image; and blitz reuses
node ids after remove_and_drop_node, so a stale canvas wrapper (or a
GC-timed surface reaper) clearing a recycled id could wipe a live
<img>'s replaced-image data. Apply the same local-name guard.
---
 src/document.rs | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/document.rs b/src/document.rs
index ecdef83..e5dae62 100644
--- a/src/document.rs
+++ b/src/document.rs
@@ -1549,6 +1549,11 @@ impl BaseDocument {
         let Some(el) = node.element_data_mut() else {
             return;
         };
+        // Same guard as the setter: node ids are reused (slab), so a
+        // stale canvas id may now be an <img> whose data must survive.
+        if el.name.local != local_name!("canvas") {
+            return;
+        }
         if !matches!(el.special_data, SpecialElementData::Image(_)) {
             return;
         }

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Mon, 21 Sep 2026 20:12:48 +0100
Subject: [PATCH] Keep fixed boxes of the root pinned to the viewport
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

hoisted_child_position cancels the scroll for a fixed box contained by
the root element, and recognised the root by its containing block being
None. But the root element is a layout child of the Document node, so
its containing block is the Document and the check never held. A fixed
box with a z-index (hoisted into the root's stacking context) then
scrolled away with the page: fixed headers vanished once the page
scrolled. Recognise the root by its containing block being the Document.

hit_inner made the same check for fixed paint children of the root, so
once the page scrolled a click on a fixed box with no z-index hit
whatever scrolled under it at document coordinates instead.

Fixed boxes are laid out against the viewport, and paint and hit-testing
cancel the root and viewport scroll for them (hoisted_child_position).
Rect queries did not: physical_unrounded_geometry, behind
getBoundingClientRect, applied the scroll like any other box, so a fixed
header's rect drifted up by the page scroll. Apply the same cancellation
there for fixed boxes whose containing block is the root element.

A clipped paint moves the viewport scroll to translate the scene, not
the page scroll, so fixed boxes, which cancel the viewport scroll, moved
with the clip. set_viewport_scroll_with_fixed_anchor sets the viewport
scroll together with the page scroll that fixed boxes stay anchored at.
NodeTree::fixed_anchor_scroll() returns that anchor until the next
set_viewport_scroll clears it, and the paint-tree position of a hoisted
fixed box cancels it in place of the viewport scroll.

blitz-paint's cancel for fixed children of the root has to read the same
value.

Co-authored-by: Luís Duarte <lduarte@cloudflare.com>
Co-authored-by: Rui Figueira <rfigueira@cloudflare.com>
---
 src/document.rs          | 27 +++++++++++++++++++++++++++
 src/layout/paint_tree.rs | 11 ++++++++---
 src/node/node.rs         |  9 ++++++++-
 src/tree.rs              | 23 +++++++++++++++++++++++
 4 files changed, 66 insertions(+), 4 deletions(-)

diff --git a/src/document.rs b/src/document.rs
index c5be928..d6db0e5 100644
--- a/src/document.rs
+++ b/src/document.rs
@@ -2997,6 +2997,17 @@ impl BaseDocument {
         self.nodes.set_viewport_scroll(scroll);
     }

+    /// Paint at `scroll` while keeping fixed boxes anchored at `anchor`.
+    /// Clipped paints change translation, not page scroll. The next
+    /// `set_viewport_scroll` drops the anchor.
+    pub fn set_viewport_scroll_with_fixed_anchor(
+        &mut self,
+        scroll: crate::Point<f64>,
+        anchor: crate::Point<f64>,
+    ) {
+        self.nodes.set_viewport_scroll_with_fixed_anchor(scroll, anchor);
+    }
+
     /// Find the node targeted by a URL fragment (the `#...` part of a URL).
     ///
     /// Per the HTML spec, this is the element whose `id` matches the fragment, falling
@@ -3028,6 +3039,22 @@ impl BaseDocument {
             pos.x += node.unrounded_layout().location.x - node.scroll_offset().x as f32;
             pos.y += node.unrounded_layout().location.y - node.scroll_offset().y as f32;
             current = node.containing_block();
+            // A fixed box contained by the root element is positioned against
+            // the viewport and does not scroll with it: cancel the root and viewport
+            // scroll the walk (and the caller's viewport-relative conversion) applies,
+            // as paint and hit-testing do (`hoisted_child_position`). Otherwise
+            // getBoundingClientRect on a fixed header drifts up by the page scroll.
+            if node.taffy_position() == taffy::Position::Fixed
+                && let Some(cb) = current.and_then(|cb| self.nodes.get(cb))
+                && cb
+                    .containing_block()
+                    .and_then(|id| self.nodes.get(id))
+                    .is_none_or(|parent| matches!(parent.data, NodeData::Document(_)))
+            {
+                let viewport_scroll = self.viewport_scroll();
+                pos.x += cb.scroll_offset().x as f32 + viewport_scroll.x as f32;
+                pos.y += cb.scroll_offset().y as f32 + viewport_scroll.y as f32;
+            }
         }
         (pos, *self.nodes[node_id].unrounded_layout())
     }
diff --git a/src/layout/paint_tree.rs b/src/layout/paint_tree.rs
index a86aaa6..c17685e 100644
--- a/src/layout/paint_tree.rs
+++ b/src/layout/paint_tree.rs
@@ -15,7 +15,7 @@ use thin_vec::ThinVec;

 use crate::layout::damage::ALL_DAMAGE;
 use crate::tree::NodeTree;
-use crate::{BaseDocument, Node};
+use crate::{BaseDocument, Node, NodeData};
 use style::properties::generated::longhands::position::computed_value::T as Position;
 use style::selector_parser::RestyleDamage;
 use style::values::computed::Float;
@@ -39,12 +39,17 @@ pub fn hoisted_child_position(tree: &NodeTree, sc_root_id: NodeId, child_id: Nod
     // positioned against the viewport and does not scroll with it: cancel the
     // scroll the walk below (or the stacking-context root itself) applies.
     // A fixed box contained by a transformed ancestor scrolls with it.
+    // The root element is a layout child of the Document node, so it is
+    // recognised by its containing block being the Document, not `None`.
     if child.taffy_position() == taffy::Position::Fixed
         && let Some(cb) = current.and_then(|id| tree.get(id))
-        && cb.containing_block().is_none()
+        && cb
+            .containing_block()
+            .and_then(|id| tree.get(id))
+            .is_none_or(|parent| matches!(parent.data, NodeData::Document(_)))
     {
         let scroll_offset = *cb.scroll_offset();
-        let viewport_scroll = tree.viewport_scroll();
+        let viewport_scroll = tree.fixed_anchor_scroll();
         position.x += scroll_offset.x as f32 + viewport_scroll.x as f32;
         position.y += scroll_offset.y as f32 + viewport_scroll.y as f32;
     }
diff --git a/src/node/node.rs b/src/node/node.rs
index 8e28f97..d16e38f 100644
--- a/src/node/node.rs
+++ b/src/node/node.rs
@@ -1842,7 +1842,14 @@ impl Node {
                 // against the viewport and do not scroll with it. (A fixed box
                 // whose containing block is a transformed ancestor scrolls with
                 // that ancestor like any other out-of-flow box.)
-                if child_position == taffy::Position::Fixed && self.containing_block().is_none() {
+                // The root element is a layout child of the Document
+                // node, so recognise it by that, not by a `None` containing block.
+                if child_position == taffy::Position::Fixed
+                    && self
+                        .containing_block()
+                        .map(|id| self.with(id))
+                        .is_none_or(|parent| matches!(parent.data, NodeData::Document(_)))
+                {
                     child_x -= self.scroll_offset().x as f32;
                     child_y -= self.scroll_offset().y as f32;
                     let viewport_scroll = self.tree().viewport_scroll();
diff --git a/src/tree.rs b/src/tree.rs
index c8de940..964a44f 100644
--- a/src/tree.rs
+++ b/src/tree.rs
@@ -41,6 +41,10 @@ pub struct NodeTree {
     /// Scroll offset of the viewport (the root element scrolls the viewport,
     /// so its offset lives here rather than on the node).
     viewport_scroll: crate::Point<f64>,
+    /// The page scroll fixed boxes stay anchored at while a clipped
+    /// paint moves `viewport_scroll` to translate the scene. `None` means the
+    /// fixed boxes follow `viewport_scroll` as usual.
+    fixed_anchor: Option<crate::Point<f64>>,
 }

 impl NodeTree {
@@ -49,6 +53,7 @@ impl NodeTree {
             map: SlotMap::with_key(),
             geometry_generation: AtomicU64::new(1),
             viewport_scroll: crate::Point::ZERO,
+            fixed_anchor: None,
         }
     }

@@ -60,5 +65,23 @@ impl NodeTree {
     /// bumps the geometry generation like any other scroll write.
     pub(crate) fn set_viewport_scroll(&mut self, scroll: crate::Point<f64>) {
         self.viewport_scroll = scroll;
+        self.fixed_anchor = None;
+        self.bump_geometry_generation();
+    }
+
+    /// The scroll that viewport-fixed boxes cancel when painted:
+    /// the anchor set by `set_viewport_scroll_with_fixed_anchor`, else the
+    /// viewport scroll.
+    pub fn fixed_anchor_scroll(&self) -> crate::Point<f64> {
+        self.fixed_anchor.unwrap_or(self.viewport_scroll)
+    }
+
+    pub(crate) fn set_viewport_scroll_with_fixed_anchor(
+        &mut self,
+        scroll: crate::Point<f64>,
+        anchor: crate::Point<f64>,
+    ) {
+        self.viewport_scroll = scroll;
+        self.fixed_anchor = Some(anchor);
         self.bump_geometry_generation();
     }

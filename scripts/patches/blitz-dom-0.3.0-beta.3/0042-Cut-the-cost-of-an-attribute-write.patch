+
+/// Note `name` as changed on a snapshot. Deduped because the pre-mutation
+/// attribute list already contributes every attribute the element had.
+fn note_changed_attr(snapshot: &mut ServoElementSnapshot, name: &LocalName) {
+    let ident = GenericAtomIdent(name.clone());
+    if !snapshot.changed_attrs.contains(&ident) {
+        snapshot.changed_attrs.push(ident);
+    }
+}

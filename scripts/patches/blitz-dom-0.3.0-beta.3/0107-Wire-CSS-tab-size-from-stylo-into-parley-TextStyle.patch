From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kitesurf vendor <vendor@kitesurf.invalid>
Date: Fri, 18 Sep 2026 21:34:26 +0100
Subject: [PATCH] Wire CSS tab-size from stylo into parley TextStyle

tab-size is a NonNegativeLengthOrNumber: a <number> (the CSS initial,
8) is a count of space-advances per tab; a <length> is an absolute
advance. Map both onto parley's TabSize so the line-breaker's tab-stop
expansion honors the computed value.
---
 src/stylo_to_parley.rs | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/stylo_to_parley.rs b/src/stylo_to_parley.rs
index 450fa4c..dffd7dd 100644
--- a/src/stylo_to_parley.rs
+++ b/src/stylo_to_parley.rs
@@ -643,6 +643,17 @@ pub(crate) fn style(
     };
     let text_wrap_mode = text_wrap_mode(itext_styles.text_wrap_mode);

+    // CSS `tab-size`: a <number> is a count of space-advances per tab
+    // (the CSS initial, 8); a <length> is an absolute advance.
+    let tab_size = match itext_styles.tab_size {
+        style::values::computed::NonNegativeLengthOrNumber::Number(n) => {
+            parley::TabSize::Chars(n.0)
+        }
+        style::values::computed::NonNegativeLengthOrNumber::Length(l) => {
+            parley::TabSize::Px(l.px())
+        }
+    };
+
     parley::TextStyle {
         // font_family: parley::FontFamily::Single(FontFamilyName::Generic(GenericFamily::SystemUi)),
         font_family: parley::FontFamily::List(Cow::Owned(families)),
@@ -662,6 +673,7 @@ pub(crate) fn style(
         overflow_wrap,
         word_break,
         line_break,
+        tab_size,

         // Contains NodeId
         brush: TextBrush::from_id(span_id),

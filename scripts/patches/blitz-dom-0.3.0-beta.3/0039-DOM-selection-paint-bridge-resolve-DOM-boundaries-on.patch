                             );
                         }
                         builder.pop_style_span();
@@ -1625,6 +1635,7 @@ pub(crate) fn build_inline_layout_into(
                                     nodes,
                                     before_id,
                                     &text_transform,
+                                    node_ranges,
                                 );
                             }

@@ -1635,6 +1646,7 @@ pub(crate) fn build_inline_layout_into(
                                     nodes,
                                     child_id,
                                     &text_transform,
+                                    node_ranges,
                                 );
                             }
                             if let Some(after_id) = node.after() {
@@ -1644,6 +1656,7 @@ pub(crate) fn build_inline_layout_into(
                                     nodes,
                                     after_id,
                                     &text_transform,
+                                    node_ranges,
                                 );
                             }

@@ -1680,9 +1693,14 @@ pub(crate) fn build_inline_layout_into(
                 // node.remove_damage(CONSTRUCT_DESCENDENT | CONSTRUCT_FC | CONSTRUCT_BOX);
                 // dbg!(&data.content);

+                let range_start = builder.current_text_len();
                 let text =
                     text_transformer.transform(&data.content, parent_text_transform, builder);
                 builder.push_text(text);
+                let range_end = builder.current_text_len();
+                if range_end > range_start {
+                    node_ranges.push((node_id, range_start..range_end));
+                }
             }
             NodeData::Comment { .. } => {

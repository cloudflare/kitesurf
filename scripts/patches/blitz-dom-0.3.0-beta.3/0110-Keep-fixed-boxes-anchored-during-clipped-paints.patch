From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Mon, 21 Sep 2026 20:12:48 +0100
Subject: [PATCH] Keep fixed boxes anchored during clipped paints

Against blitz-dom 0.3.0-beta.3: fixed boxes are no longer re-anchored by
writing their layout locations; paint cancels the viewport scroll for
fixed boxes of the root instead. The anchor now lives on NodeTree
(fixed_anchor_scroll(), cleared by the next set_viewport_scroll), and
the paint-tree hoisted position cancels it in place of the viewport
scroll. blitz-paint's fixed-child cancel has to read the same value.
---
 src/document.rs          | 11 +++++++++++
 src/layout/paint_tree.rs |  2 +-
 src/tree.rs              | 23 +++++++++++++++++++++++
 3 files changed, 35 insertions(+), 1 deletion(-)

diff --git a/src/document.rs b/src/document.rs
index e1e8037..7ad9488 100644
--- a/src/document.rs
+++ b/src/document.rs
@@ -3065,6 +3065,17 @@ impl BaseDocument {
         self.nodes.set_viewport_scroll(scroll);
     }

+    /// Paint at `scroll` while keeping fixed boxes anchored at `anchor`.
+    /// Clipped paints change translation, not page scroll. The next
+    /// `set_viewport_scroll` drops the anchor.
+    pub fn set_viewport_scroll_with_fixed_anchor(
+        &mut self,
+        scroll: crate::Point<f64>,
+        anchor: crate::Point<f64>,
+    ) {
+        self.nodes.set_viewport_scroll_with_fixed_anchor(scroll, anchor);
+    }
+
     /// Find the node targeted by a URL fragment (the `#...` part of a URL).
     ///
     /// Per the HTML spec, this is the element whose `id` matches the fragment, falling
diff --git a/src/layout/paint_tree.rs b/src/layout/paint_tree.rs
index e20c601..e631bff 100644
--- a/src/layout/paint_tree.rs
+++ b/src/layout/paint_tree.rs
@@ -44,7 +44,7 @@ pub fn hoisted_child_position(tree: &NodeTree, sc_root_id: NodeId, child_id: Nod
         && cb.containing_block().is_none()
     {
         let scroll_offset = *cb.scroll_offset();
-        let viewport_scroll = tree.viewport_scroll();
+        let viewport_scroll = tree.fixed_anchor_scroll();
         position.x += scroll_offset.x as f32 + viewport_scroll.x as f32;
         position.y += scroll_offset.y as f32 + viewport_scroll.y as f32;
     }
diff --git a/src/tree.rs b/src/tree.rs
index c8de940..964a44f 100644
--- a/src/tree.rs
+++ b/src/tree.rs
@@ -41,6 +41,10 @@ pub struct NodeTree {
     /// Scroll offset of the viewport (the root element scrolls the viewport,
     /// so its offset lives here rather than on the node).
     viewport_scroll: crate::Point<f64>,
+    /// The page scroll fixed boxes stay anchored at while a clipped
+    /// paint moves `viewport_scroll` to translate the scene. `None` means the
+    /// fixed boxes follow `viewport_scroll` as usual.
+    fixed_anchor: Option<crate::Point<f64>>,
 }

 impl NodeTree {
@@ -49,6 +53,7 @@ impl NodeTree {
             map: SlotMap::with_key(),
             geometry_generation: AtomicU64::new(1),
             viewport_scroll: crate::Point::ZERO,
+            fixed_anchor: None,
         }
     }

@@ -60,5 +65,23 @@ impl NodeTree {
     /// bumps the geometry generation like any other scroll write.
     pub(crate) fn set_viewport_scroll(&mut self, scroll: crate::Point<f64>) {
         self.viewport_scroll = scroll;
+        self.fixed_anchor = None;
+        self.bump_geometry_generation();
+    }
+
+    /// The scroll that viewport-fixed boxes cancel when painted:
+    /// the anchor set by `set_viewport_scroll_with_fixed_anchor`, else the
+    /// viewport scroll.
+    pub fn fixed_anchor_scroll(&self) -> crate::Point<f64> {
+        self.fixed_anchor.unwrap_or(self.viewport_scroll)
+    }
+
+    pub(crate) fn set_viewport_scroll_with_fixed_anchor(
+        &mut self,
+        scroll: crate::Point<f64>,
+        anchor: crate::Point<f64>,
+    ) {
+        self.viewport_scroll = scroll;
+        self.fixed_anchor = Some(anchor);
         self.bump_geometry_generation();
     }

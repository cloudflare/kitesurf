From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Fri, 20 Nov 2026 20:09:18 +0000
Subject: [PATCH] Map a glyph run's glyphs to the source text they show

A text layer, such as a PDF's, has to say which characters each glyph
shows. A reverse cmap cannot: shaped forms (Arabic joining, ligatures)
are not in it, and CJK glyphs shared with Kangxi radicals map back to
the radical. Expose, per glyph of a glyph run and in draw order, the
byte range of the source text its shaped cluster covers.

Signed-off-by: Rui Figueira <rfigueira@cloudflare.com>
---
 src/layout/line.rs | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/src/layout/line.rs b/src/layout/line.rs
index e3ed9e4..610255c 100644
--- a/src/layout/line.rs
+++ b/src/layout/line.rs
@@ -333,6 +333,26 @@ impl<'a, B: Brush> GlyphRun<'a, B> {
         self.run.glyphs_in(self.shaped_clusters.clone())
     }

+    /// Appends to `out`, for each glyph of [`Self::glyphs`] and in the same order, the byte
+    /// range of the source text that the glyph's shaped cluster covers.
+    ///
+    /// Every glyph of a shaped cluster gets the whole cluster's range: a ligature's glyph
+    /// covers all of its characters, and a base with a combining mark shares one range.
+    pub fn glyph_text_ranges(&self, out: &mut alloc::vec::Vec<Range<usize>>) {
+        let slice = self.run.full_slice().narrow(self.shaped_clusters.clone());
+        let mut push = |cluster: u32| {
+            let range = slice.text_byte_range(slice.shaped_cluster_char_range(cluster));
+            let glyphs = slice.shaped_clusters_in(cluster..cluster + 1)[0].glyph_len();
+            out.extend(core::iter::repeat_n(range, usize::from(glyphs)));
+        };
+        // Same order as `Glyphs`: logical for LTR runs, reversed for RTL runs.
+        if self.run.is_rtl() {
+            self.shaped_clusters.clone().rev().for_each(&mut push);
+        } else {
+            self.shaped_clusters.clone().for_each(&mut push);
+        }
+    }
+
     /// Returns an iterator over the fully positioned glyphs in the run.
     pub fn positioned_glyphs(&'a self) -> impl Iterator<Item = Glyph> + 'a + Clone {
         let mut offset = self.offset;

+/// Expand horizontal tabs to tab stops (CSS `tab-size`).
+///
+/// Chromium renders a tab as invisible whitespace that advances the
+/// pen to the next multiple of `tab-size × space advance` from the
+/// line start. HarfRust shapes `\t` as an ordinary glyph, usually
+/// the font's missing glyph painted as a box, so this rewrites the
+/// tab cluster's advance (and its glyph) at line-commit time, when
+/// the pen position within the line is known. The glyph is swapped
+/// for the font's space glyph (no outlines), so paint draws nothing
+/// while the pen still advances. Run offsets, line metrics,
+/// hit-testing and selection all read the same rewritten advance.
+///
+/// `line_items` are the line's items in logical order. Returns the
+/// line's advance with the tabs expanded, or `None` if it has no tab.
+/// Tabs in RTL runs are expanded against the logical-order pen; LTR
+/// (the practically universal case for tabbed code) is exact.
+fn expand_line_tabs<B: Brush>(layout: &mut Layout<B>, line_items: &[LineItemData]) -> Option<f32> {
+    let data = &layout.data;
+
+    // Pass 1, read-only: walk the line's items with a pen and
+    // record every tab cluster with the pen at its start.
+    let mut pen = 0.0f32;
+    let mut actions: Vec<TabAction> = Vec::new();
+    for line_item in line_items {
+        match line_item.kind {
+            LayoutItemKind::InlineBox => {
+                let inline_box = &data.inline_boxes[line_item.index].inline_box;
+                if inline_box.kind == InlineBoxKind::InFlow {
+                    pen += inline_box.width;
+                }
+            }
+            LayoutItemKind::TextRun => {
+                let run = &data.runs[line_item.index];
+                let spacing = EffectiveSpacing::new(run.spacing, Justification::NONE)
+                    .with_span_edges(data.span_edges(line_item.index));
+                let slice = data
+                    .shaped_text
+                    .run_slice(line_item.index as u32)
+                    .narrow(line_item.shaped_cluster_range.clone());
+                for atom in slice.atoms_start() {
+                    let cluster = &atom.shaped_clusters()[0];
+                    match cluster.whitespace() {
+                        // Newlines don't contribute to the line's advance.
+                        Whitespace::Newline => {}
+                        Whitespace::Tab => {
+                            let style = &data.styles[cluster.style_index as usize];
+                            let stop_spacing = style.tab_size.stop_spacing(run.space_advance);
+                            let advance = if stop_spacing > 0.0 {
+                                // Next multiple of `stop_spacing` strictly
+                                // beyond the pen; a pen already on a stop
+                                // advances a full stop, matching Chromium.
+                                ((pen / stop_spacing).floor() + 1.0) * stop_spacing - pen
+                            } else {
+                                0.0
+                            };
+                            actions.push(TabAction {
+                                cluster_idx: atom.shaped_clusters_range().start,
+                                advance: (advance - spacing.gaps(&atom).total()).max(0.0),
+                                space_glyph_id: run.space_glyph_id,
+                            });
+                            pen += advance;
+                        }
+                        _ => pen += spacing.atom_advance(&atom),
+                    }
+                }
+            }
+        }
+    }
+
+    if actions.is_empty() {
+        return None;
+    }
+
+    // Pass 2, apply: rewrite cluster advances and glyph ids so every
+    // downstream reader (run offsets, positioned glyphs, selection,
+    // line metrics) agrees on the tab-stop geometry.
+    let shaped_text = &mut layout.data.shaped_text;
+    for action in &actions {
+        let cluster = &mut shaped_text.shaped_clusters_mut()[action.cluster_idx as usize];
+        cluster.advance = action.advance;
+        if cluster.has_inline_glyph() {
+            // Single-glyph cluster: the glyph id is stored inline.
+            cluster.glyph_offset = action.space_glyph_id;
+        } else {
+            let start = cluster.glyph_offset as usize;
+            let len = usize::from(cluster.glyph_len());
+            let glyphs = shaped_text.glyphs_mut();
+            let end = (start + len).min(glyphs.len());
+            for glyph in &mut glyphs[start..end] {
+                glyph.id = action.space_glyph_id;
+                glyph.advance = 0.0;
+            }
+            if let Some(last) = glyphs[start..end].last_mut() {
+                last.advance = action.advance;
+            }
+        }
+    }
+
+    Some(pen)
+}

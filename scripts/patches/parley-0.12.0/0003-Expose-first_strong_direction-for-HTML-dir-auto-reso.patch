From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Wed, 29 Jul 2026 13:42:31 +0100
Subject: [PATCH] Expose first_strong_direction for HTML dir=auto resolution

HTML's dir=auto directionality is a DOM-side scan (it excludes bdi/
script/style/textarea subtrees and dir-attributed descendants),
which a text-stream resolver cannot express. The embedder walks
text nodes itself and needs only the per-chunk classification.
Classifies via the same parley_data properties analyze_text uses:
strong L is Ltr, strong R or AL is Rtl, and anything else is None, so
the caller keeps walking.

parley::first_strong_direction wraps the classifier, which lives in
the parley_engine series, so parley does not depend on parley_data.
---
 src/bidi.rs | 9 +++++++++
 src/lib.rs  | 2 +-
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/src/bidi.rs b/src/bidi.rs
index 45d8907..6e3a057 100644
--- a/src/bidi.rs
+++ b/src/bidi.rs
@@ -43,3 +43,12 @@ impl BaseDirection {
         }
     }
 }
+
+// First-strong scan for HTML's dir=auto directionality.
+// Callers walk DOM text nodes and stop at the first Some, applying
+// the spec's subtree exclusions themselves. This only classifies
+// one text chunk: strong L is Ltr, strong R or AL is Rtl.
+/// Returns the direction of the first strong character in `text`, or `None` if it has none.
+pub fn first_strong_direction(text: &str) -> Option<BaseDirection> {
+    parley_engine::first_strong_direction(text).map(BaseDirection::from)
+}
diff --git a/src/lib.rs b/src/lib.rs
index 4892433..31986b9 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -132,7 +132,7 @@ pub use parley_engine::break_overrides::{
     LineBreakContext, LineBreakOverrideFn,
 };

-pub use bidi::BaseDirection;
+pub use bidi::{BaseDirection, first_strong_direction};
 pub use builder::{RangedBuilder, StyleRunBuilder, TreeBuilder};
 pub use context::LayoutContext;
 pub use font::FontContext;

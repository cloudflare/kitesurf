From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Fri, 31 Jul 2026 17:06:41 +0100
Subject: [PATCH] Add Layout::truncate_lines for CSS line-clamp

Parley has no max-lines concept; blitz needs to drop lines beyond N
for -webkit-line-clamp. Truncate the line list and recompute the
stored height from the last kept line's block_max_coord (layout-
absolute, so no re-accumulation is needed). Painting, alignment and
hit-testing all iterate the same line Vec, so the clamp applies
everywhere.
---
 src/layout/layout.rs | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/src/layout/layout.rs b/src/layout/layout.rs
index 7509aca..59323fe 100644
--- a/src/layout/layout.rs
+++ b/src/layout/layout.rs
@@ -279,6 +279,23 @@ impl<B: Brush> Layout<B> {
             .break_remaining(max_advance.unwrap_or(f32::MAX));
     }

+    /// Truncates the layout to at most `max_lines` lines, recomputing the
+    /// stored height. This is the layout half of CSS -webkit-line-clamp.
+    pub fn truncate_lines(&mut self, max_lines: usize) {
+        if self.data.lines.len() <= max_lines {
+            return;
+        }
+        self.data.lines.truncate(max_lines);
+        // block_max_coord is layout-absolute (baseline accumulates line_y),
+        // so the clamped height is simply the last kept line's bottom edge.
+        self.data.height = self
+            .data
+            .lines
+            .last()
+            .map(|l| l.metrics.block_max_coord)
+            .unwrap_or(0.);
+    }
+
     /// Apply alignment to the layout.
     ///
     /// You must perform line breaking prior to aligning, through [`Layout::break_lines`] or

+impl<B: Brush> BreakLines<'_, B> {
+    /// Post-pass: walk every committed line and emit a
+    /// `SpanFragment` for each inline span whose first and last
+    /// cluster live on that line (single-line spans).
+    ///
+    /// `cluster_lead_advance[i] > 0` marks the first cluster of a
+    /// span (where the lead charge fires) and
+    /// `cluster_trail_advance[i] > 0` marks the last. A span whose
+    /// lead and trail are both within one line produces a single
+    /// fragment; a span that straddles a line break produces none.
+    ///
+    /// Tracking is done via a small "open spans" stack of
+    /// (style_index, x_start_for_span). A lead pushes onto it, and
+    /// a trail pops and emits. If a line ends with
+    /// open spans on the stack, those are spans that wrap to the
+    /// next line, and they are discarded without a fragment.
+    fn compute_span_fragments(&mut self) {

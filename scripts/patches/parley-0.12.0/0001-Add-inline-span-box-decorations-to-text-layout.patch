+        builder.push_style_modification_span([ResolvedProperty::LetterSpacing(1.)].into_iter());
+        builder.push_text("B");
+        builder.pop_style_span();
+        builder.push_text("C");
+        builder.pop_style_span();
+        builder.push_text("D");
+
+        let mut style_table = Vec::new();
+        let mut style_runs = Vec::new();
+        let _ = builder.finish(&mut style_table, &mut style_runs);
+
+        assert_eq!(style_runs.len(), 5);
+        // Run R: span 0 root, first text, more to come.
+        assert!(style_runs[0].is_span_first, "R should be span_first");
+        assert!(!style_runs[0].is_span_last, "R should NOT be span_last");
+        // Run A: first text inside span 1, but a child span 2 will
+        // open, so "A" itself is not the last text of span 1.
+        assert!(style_runs[1].is_span_first, "A should be span_first");
+        assert!(!style_runs[1].is_span_last, "A should NOT be span_last");
+        // Run B: singleton inside span 2.
+        assert!(style_runs[2].is_span_first, "B should be span_first");
+        assert!(style_runs[2].is_span_last, "B should be span_last");
+        // Run C: span 1 continuation, back in span 1 after popping
+        // span 2. Not the first text of span 1 (A was), but it is
+        // the last (because the next op is pop_style_span
+        // for span 1).
+        assert!(!style_runs[3].is_span_first, "C should NOT be span_first");
+        assert!(style_runs[3].is_span_last, "C should be span_last");
+        // Run D: span 0 continuation (final text). Not first; but
+        // it's the last text emitted before finish() drains the
+        // remaining open spans.
+        assert!(!style_runs[4].is_span_first, "D should NOT be span_first");
+        assert!(style_runs[4].is_span_last, "D should be span_last");
+    }
 }

+
+impl<B: Brush> BoxDecorations<B> {
+    /// `true` if every dimension is zero and every brush `None`,
+    /// meaning this span carries no box decorations and the painter
+    /// can skip its fragment pass.
+    pub fn is_empty(&self) -> bool {

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Mon, 12 Oct 2026 18:36:43 +0100
Subject: [PATCH] Add Blink's extra pixel to sub and super shifts

parley resolves `vertical-align: sub` to a fifth of the parent font
size and `super` to a third, and calls those the WebKit and Blink
constants. Both engines add one pixel to each: Blink lowers sub by
`font-size / 5 + 1` and raises super by `font-size / 3 + 1`. A 20px
parent put a `super` inline-block 6.67px up, where Chrome puts it
7.67px up.

Add the pixel, in layout units, so the shift still scales with the
display scale.
---
 src/builder.rs                  |  1 +
 src/layout/style_metrics.rs     | 16 ++++++++++++----
 src/tests/test_style_metrics.rs | 11 +++++++----
 3 files changed, 20 insertions(+), 8 deletions(-)

diff --git a/src/builder.rs b/src/builder.rs
index c00326c..399784a 100644
--- a/src/builder.rs
+++ b/src/builder.rs
@@ -442,6 +442,7 @@ fn build_into_layout<B: Brush>(
         fcx,
         &lcx.style_table,
         &layout.data.shaped_text,
+        options.scale,
         options.quantize,
         &mut layout.data.style_metrics,
     );
diff --git a/src/layout/style_metrics.rs b/src/layout/style_metrics.rs
index 7b7b147..81c0c03 100644
--- a/src/layout/style_metrics.rs
+++ b/src/layout/style_metrics.rs
@@ -94,18 +94,23 @@ pub(crate) struct StyleMetrics {
     pub(crate) parent: u16,
     /// The style's font size, against which `sub`/`super` of children are resolved.
     pub(crate) font_size: f32,
+    /// One CSS pixel in layout units (the display scale), which `sub`/`super` of children add to
+    /// the font-size fraction.
+    pub(crate) pixel: f32,
 }

 /// Resolve the [`StyleMetrics`] of every style in `styles`, in table order.
 ///
 /// Relies on the style table being ordered parent-first (`style.parent <= index`), which both
 /// style builders guarantee. `shaped_text` is the already shaped text of the layout, whose run
-/// metrics are reused where a style's first available font was also used for shaping.
+/// metrics are reused where a style's first available font was also used for shaping. `scale` is
+/// the display scale the styles were resolved at.
 pub(crate) fn resolve_style_metrics<B: Brush>(
     rcx: &ResolveContext,
     fcx: &mut FontContext,
     styles: &[ResolvedStyle<B>],
     shaped_text: &ShapedText,
+    scale: f32,
     quantize: bool,
     out: &mut Vec<StyleMetrics>,
 ) {
@@ -129,6 +134,7 @@ pub(crate) fn resolve_style_metrics<B: Brush>(

         let mut metrics = StyleMetrics::from_font(&font_metrics, line_height, quantize);
         metrics.font_size = style.font_size;
+        metrics.pixel = scale;

         if index == 0 {
             // The root span box (the strut).
@@ -265,6 +271,7 @@ impl StyleMetrics {
             aligned_subtree_root: 0,
             parent: 0,
             font_size: 0.,
+            pixel: 0.,
         }
     }
 }
@@ -287,9 +294,10 @@ pub(crate) fn shift_from_parent(
     };
     let shift = match align.shift {
         BaselineShift::Length(length) => length,
-        // Constants as used by WebKit and Blink.
-        BaselineShift::Sub => -(parent.font_size / 5.),
-        BaselineShift::Super => parent.font_size / 3.,
+        // Constants as used by WebKit and Blink, both of which add a pixel to the font-size
+        // fraction.
+        BaselineShift::Sub => -(parent.font_size / 5. + parent.pixel),
+        BaselineShift::Super => parent.font_size / 3. + parent.pixel,
         BaselineShift::Top | BaselineShift::Bottom => 0.,
     };
     alignment + shift
diff --git a/src/tests/test_style_metrics.rs b/src/tests/test_style_metrics.rs
index d10ea73..859be44 100644
--- a/src/tests/test_style_metrics.rs
+++ b/src/tests/test_style_metrics.rs
@@ -92,8 +92,8 @@ fn super_shifts_relative_to_parent() {
     let layout = build();
     let b = metrics(&layout)[2];
     assert_eq!(layout.data.styles[2].parent, 1);
-    // WebKit/Blink constant: a third of the *parent's* font size (40px).
-    assert!((b.baseline_offset - 40. / 3.).abs() < 1e-4);
+    // WebKit/Blink constant: a third of the *parent's* font size (40px), plus a pixel.
+    assert!((b.baseline_offset - (40. / 3. + 1.)).abs() < 1e-4);
     assert_eq!(b.aligned_subtree_root, 0);
 }

@@ -165,8 +165,11 @@ fn alignment_baseline_and_baseline_shift_compose() {
     let m = metrics(&layout);
     // `vertical-align: text-top -4px` is `text-top` lowered by 4px ...
     assert!((m[2].baseline_offset - (m[1].baseline_offset - 4.)).abs() < 1e-4);
-    // ... and `text-top super` is `text-top` raised by a third of the parent font size.
-    assert!((m[3].baseline_offset - (m[1].baseline_offset + m[0].font_size / 3.)).abs() < 1e-4);
+    // ... and `text-top super` is `text-top` raised by a third of the parent font size plus a
+    // pixel.
+    assert!(
+        (m[3].baseline_offset - (m[1].baseline_offset + m[0].font_size / 3. + 1.)).abs() < 1e-4
+    );
 }

 #[test]

+// BaseDirection::AutoPerParagraph tests for the plaintext
+// per-paragraph first-strong splitter (see parley_engine's analysis).
+
+#[test]
+fn test_base_direction_auto_matches_legacy() {
+    // No configuration: whole-text first-strong (Hebrew) → base 1,
+    // the LTR run after the newline stays inside the one paragraph.
+    verify_analysis("\u{5d0}\u{5d1}\nab", |_| {})
+        .expect_bidi_embed_level_list(&[1, 1, 1, 2, 2]);
+}
+
+#[test]
+fn test_base_direction_auto_per_paragraph() {
+    use crate::BaseDirection;
+    // plaintext: each paragraph re-detects. Para 1 (Hebrew) base 1
+    // with its separator at the paragraph level; para 2 (Latin) 0.
+    verify_analysis("\u{5d0}\u{5d1}\nab", |builder| {
+        builder.set_base_direction(BaseDirection::AutoPerParagraph);
+    })
+    .expect_bidi_embed_level_list(&[1, 1, 1, 0, 0]);
+}
+
+#[test]
+fn test_base_direction_per_paragraph_crlf() {
+    use crate::BaseDirection;
+    // CRLF is one separator: both chars stay in the RTL paragraph.
+    verify_analysis("\u{5d0}\u{5d1}\r\nab", |builder| {
+        builder.set_base_direction(BaseDirection::AutoPerParagraph);
+    })
+    .expect_bidi_embed_level_list(&[1, 1, 1, 1, 0, 0]);
+}

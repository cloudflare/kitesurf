diff --git a/src/bidi.rs b/src/bidi.rs
index 25aa622..bf85bcd 100644
--- a/src/bidi.rs
+++ b/src/bidi.rs
@@ -7,6 +7,24 @@ use alloc::vec::Vec;
 use icu_properties::props::{BidiClass, BidiMirroringGlyph, BidiPairedBracketType};
 use parlance::{BaseDirection, BidiLevel};

+// First-strong scan for HTML's dir=auto directionality.
+// Callers walk DOM text nodes and stop at the first Some, applying
+// the spec's subtree exclusions themselves. This only classifies
+// one text chunk: strong L is Ltr, strong R or AL is Rtl.
+/// Returns the direction of the first strong character in `text`, or `None` if it has none.
+pub fn first_strong_direction(text: &str) -> Option<BaseDirection> {
+    for ch in text.chars() {
+        match parley_data::Properties::get(ch).bidi_class() {
+            BidiClass::LeftToRight => return Some(BaseDirection::Ltr),
+            BidiClass::RightToLeft | BidiClass::ArabicLetter => {
+                return Some(BaseDirection::Rtl);
+            }
+            _ => {}
+        }
+    }
+    None
+}
+
 /// Resolver for the Unicode bidirectional algorithm.
 #[derive(Clone, Default)]
 pub(crate) struct BidiResolver {
@@ -36,6 +54,18 @@ impl BidiResolver {
         self.base_level
     }

+    // Splice a resolved paragraph into this resolver so
+    // per-paragraph resolution can reuse the single-paragraph core.
+    //
+    // The first appended paragraph donates the layout-wide base
+    // level (consumed only by alignment; reorder is per-run).
+    pub(crate) fn append_paragraph(&mut self, other: &Self) {
+        if self.levels.is_empty() {
+            self.base_level = other.base_level;
+        }
+        self.levels.extend_from_slice(&other.levels);
+    }
+
     /// Clears the resolver state.
     pub(crate) fn clear(&mut self) {
         self.initial_types.clear();

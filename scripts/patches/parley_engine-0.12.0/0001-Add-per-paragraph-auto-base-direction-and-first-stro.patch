+++ b/src/analysis.rs
@@ -808,7 +808,15 @@ pub(crate) fn analyze_text(
         ));
     }

-    if needs_bidi_resolution || options.base_direction == BaseDirection::Rtl {
+    // `unicode-bidi: plaintext` re-runs first-strong per
+    // paragraph; only text that needs bidi resolution at all does.
+    if options.auto_per_paragraph && options.base_direction == BaseDirection::Auto {

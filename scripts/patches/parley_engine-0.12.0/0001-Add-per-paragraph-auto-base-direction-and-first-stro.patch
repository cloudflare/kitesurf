             text.chars().map(|ch| {
                 let bidi_class = data_sources.properties(ch).bidi_class();
@@ -823,6 +831,43 @@ pub(crate) fn analyze_text(
     }
 }

+// For `unicode-bidi: plaintext`, split at UAX#9 class-B
+// paragraph separators and run P2/P3 first-strong per segment.
+//
+// Each segment (separator included, so L1 applies inside the core
+// resolver) resolves on the scratch resolver and splices back.
+fn resolve_per_paragraph(analyzer: &mut Analyzer, text: &str, data_sources: &AnalysisDataSources) {
+    use icu_properties::props::BidiClass;
+    let Analyzer { bidi, bidi_scratch } = analyzer;
+    bidi.clear();
+    let classify = |ch: char| {
+        let bidi_class = data_sources.properties(ch).bidi_class();
+        let bracket = data_sources.brackets().get(ch);
+        (ch, (bidi_class, bracket))
+    };
+    let mut split_and_append = |segment: &str| {
+        bidi_scratch.resolve(segment.chars().map(classify), BaseDirection::Auto);
+        bidi.append_paragraph(bidi_scratch);
+    };
+
+    let mut start = 0;
+    let mut chars = text.char_indices().peekable();
+    while let Some((i, ch)) = chars.next() {
+        let is_sep = data_sources.properties(ch).bidi_class() == BidiClass::ParagraphSeparator;
+        // A CR immediately followed by LF is one separator: keep
+        // the pair together and split after the LF instead.
+        let is_crlf_cr = ch == '\r' && chars.peek().is_some_and(|&(_, next)| next == '\n');
+        if is_sep && !is_crlf_cr {
+            let end = i + ch.len_utf8();
+            split_and_append(&text[start..end]);
+            start = end;
+        }
+    }
+    if start < text.len() {
+        split_and_append(&text[start..]);
+    }
+}
+
 /// All characters contribute to shaping except:
 /// - Control characters
 /// - Format characters, unless they use the "Inherited" script

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Wed, 4 Nov 2026 22:23:38 +0000
Subject: [PATCH] Reuse the line boundary buffer across analyses

The analyzer keeps the line boundary positions between calls instead of growing a fresh Vec for every paragraph.

Signed-off-by: bpereira <bpereira@cloudflare.com>
---
 src/analysis.rs | 6 ++++--
 src/analyzer.rs | 3 +++
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/src/analysis.rs b/src/analysis.rs
index 6a4df3e..630171f 100644
--- a/src/analysis.rs
+++ b/src/analysis.rs
@@ -551,7 +551,8 @@ pub(crate) fn analyze_text(
     let contiguous_substrings = LineBreakSegmentIter::new(text, segments, first_segment);

     let mut global_offset = 0;
-    let mut line_boundary_positions: Vec<usize> = Vec::new();
+    let mut line_boundary_positions = core::mem::take(&mut analyzer.line_boundaries);
+    line_boundary_positions.clear();

     let data_sources = AnalysisDataSources::new();

@@ -807,6 +808,7 @@ pub(crate) fn analyze_text(
             properties.is_emoji_modifier_base(),
         ));
     }
+    analyzer.line_boundaries = line_boundary_positions;

     // `unicode-bidi: plaintext` re-runs first-strong per
     // paragraph; only text that needs bidi resolution at all does.
@@ -838,7 +840,7 @@ pub(crate) fn analyze_text(
 // resolver) resolves on the scratch resolver and splices back.
 fn resolve_per_paragraph(analyzer: &mut Analyzer, text: &str, data_sources: &AnalysisDataSources) {
     use icu_properties::props::BidiClass;
-    let Analyzer { bidi, bidi_scratch } = analyzer;
+    let Analyzer { bidi, bidi_scratch, .. } = analyzer;
     bidi.clear();
     let classify = |ch: char| {
         let bidi_class = data_sources.properties(ch).bidi_class();
diff --git a/src/analyzer.rs b/src/analyzer.rs
index d3b9ba0..e619369 100644
--- a/src/analyzer.rs
+++ b/src/analyzer.rs
@@ -3,6 +3,7 @@

 //! The analyzer API.

+use alloc::vec::Vec;
 use core::ops::Range;

 use parlance::{BaseDirection, Language, LineBreak, WordBreak};
@@ -18,6 +19,8 @@ pub struct Analyzer {
     // Scratch resolver for `auto_per_paragraph`. It resolves
     // one paragraph at a time, and the result is spliced back into `bidi`.
     pub(crate) bidi_scratch: BidiResolver,
+    /// Line boundary positions, kept so each analysis reuses the buffer.
+    pub(crate) line_boundaries: Vec<usize>,
 }

 impl core::fmt::Debug for Analyzer {

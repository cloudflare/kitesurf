From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Wed, 29 Jul 2026 12:42:24 +0100
Subject: [PATCH] Base-direction control: per-paragraph auto (plaintext)

parley_engine can force a base direction (BaseDirection::Ltr/Rtl) but
always resolves Auto with a single whole-text first-strong detection.
HTML's unicode-bidi:plaintext (textarea/pre dir=auto) re-runs
first-strong per UAX#9 paragraph.

AnalysisOptions::auto_per_paragraph splits Auto resolution at class-B
separators (CRLF = one separator), resolves each segment on a scratch
resolver, and splices levels back; the first paragraph donates the
layout-wide base_level, which only alignment uses; reordering is
per run.

The parley half of this patch (BaseDirection::AutoPerParagraph on the
builders and PlainEditor) lives in the parley series.
---
 src/analysis.rs | 47 ++++++++++++++++++++++++++++++++++++++++++++++-
 src/analyzer.rs | 10 ++++++++++
 src/bidi.rs     | 12 ++++++++++++
 3 files changed, 68 insertions(+), 1 deletion(-)

diff --git a/src/analysis.rs b/src/analysis.rs
index 7d871af..6a4df3e 100644
--- a/src/analysis.rs
+++ b/src/analysis.rs
@@ -808,7 +808,15 @@ pub(crate) fn analyze_text(
         ));
     }

-    if needs_bidi_resolution || options.base_direction == BaseDirection::Rtl {
+    // `unicode-bidi: plaintext` re-runs first-strong per
+    // paragraph; only text that needs bidi resolution at all does.
+    if options.auto_per_paragraph && options.base_direction == BaseDirection::Auto {
+        if needs_bidi_resolution {
+            resolve_per_paragraph(analyzer, text, &data_sources);
+            core::mem::swap(&mut analysis.levels, &mut analyzer.bidi.levels);
+            analysis.paragraph_level = analyzer.bidi.base_level();
+        }
+    } else if needs_bidi_resolution || options.base_direction == BaseDirection::Rtl {
         analyzer.bidi.resolve(
             text.chars().map(|ch| {
                 let bidi_class = data_sources.properties(ch).bidi_class();
@@ -823,6 +831,43 @@ pub(crate) fn analyze_text(
     }
 }

+// For `unicode-bidi: plaintext`, split at UAX#9 class-B
+// paragraph separators and run P2/P3 first-strong per segment.
+//
+// Each segment (separator included, so L1 applies inside the core
+// resolver) resolves on the scratch resolver and splices back.
+fn resolve_per_paragraph(analyzer: &mut Analyzer, text: &str, data_sources: &AnalysisDataSources) {
+    use icu_properties::props::BidiClass;
+    let Analyzer { bidi, bidi_scratch } = analyzer;
+    bidi.clear();
+    let classify = |ch: char| {
+        let bidi_class = data_sources.properties(ch).bidi_class();
+        let bracket = data_sources.brackets().get(ch);
+        (ch, (bidi_class, bracket))
+    };
+    let mut split_and_append = |segment: &str| {
+        bidi_scratch.resolve(segment.chars().map(classify), BaseDirection::Auto);
+        bidi.append_paragraph(bidi_scratch);
+    };
+
+    let mut start = 0;
+    let mut chars = text.char_indices().peekable();
+    while let Some((i, ch)) = chars.next() {
+        let is_sep = data_sources.properties(ch).bidi_class() == BidiClass::ParagraphSeparator;
+        // A CR immediately followed by LF is one separator: keep
+        // the pair together and split after the LF instead.
+        let is_crlf_cr = ch == '\r' && chars.peek().is_some_and(|&(_, next)| next == '\n');
+        if is_sep && !is_crlf_cr {
+            let end = i + ch.len_utf8();
+            split_and_append(&text[start..end]);
+            start = end;
+        }
+    }
+    if start < text.len() {
+        split_and_append(&text[start..]);
+    }
+}
+
 /// All characters contribute to shaping except:
 /// - Control characters
 /// - Format characters, unless they use the "Inherited" script

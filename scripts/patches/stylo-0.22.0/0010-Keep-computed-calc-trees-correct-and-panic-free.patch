                     debug_assert!(
                             false,
@@ -643,8 +637,7 @@ impl CalcLengthPercentage {
     /// Resolves the percentage.
     #[inline]
     pub fn resolve(&self, basis: Length) -> Length {
-        // unwrap() is fine because the conversion below is infallible.
-        if let ComputedLeaf::Length(px) = self
+        let resolved = self
             .node
             .resolve_map(|leaf| {
                 Ok(if let ComputedLeaf::Percentage(p) = leaf {
@@ -652,13 +645,15 @@ impl CalcLengthPercentage {
                 } else {
                     leaf.clone()
                 })
-            })
-            .unwrap()
-        {
-            Length::new(self.clamping_mode.clamp(px.px())).normalized()
-        } else {
-            unreachable!("resolve_map should turn percentages to lengths, and parsing should ensure that we don't end up with a number");
-        }
+            });
+        let px = match resolved {
+            Ok(ComputedLeaf::Length(px)) => px.px(),
+            // new_calc() already treats a final numeric leaf as a length.
+            Ok(ComputedLeaf::Number(number)) => number,
+            // Invalid computed calc trees must not panic during layout.
+            Ok(_) | Err(()) => 0.0,
+        };
+        Length::new(self.clamping_mode.clamp(px)).normalized()
     }


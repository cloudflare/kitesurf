From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Fri, 31 Jul 2026 21:35:42 +0100
Subject: [PATCH] Enable break-* and box-decoration-break in the servo build

Same pattern as the appearance and accent-color enablements: drop the
engine=gecko gates so servo generates break-before, break-after,
break-inside and box-decoration-break. Print stylesheets set
break-inside:avoid on nearly every table and figure, and without the
parse a PDF pipeline can never honour them. Fragmentation itself is not
implemented here.
---
 properties/longhands.toml  | 3 ---
 properties/shorthands.toml | 3 ---
 2 files changed, 6 deletions(-)

diff --git a/properties/longhands.toml b/properties/longhands.toml
index 7eee22c..39e790a 100644
--- a/properties/longhands.toml
+++ b/properties/longhands.toml
@@ -474,7 +474,6 @@ affects = "overflow"
 type = "BreakBetween"
 initial = "computed::BreakBetween::Auto"
 struct = "box"
-engine = "gecko"
 spec = "https://drafts.csswg.org/css-break/#propdef-break-after"
 animation_type = "discrete"
 affects = "layout"
@@ -483,7 +482,6 @@ affects = "layout"
 type = "BreakBetween"
 initial = "computed::BreakBetween::Auto"
 struct = "box"
-engine = "gecko"
 spec = "https://drafts.csswg.org/css-break/#propdef-break-before"
 animation_type = "discrete"
 affects = "layout"
@@ -492,7 +490,6 @@ affects = "layout"
 type = "BreakWithin"
 initial = "computed::BreakWithin::Auto"
 struct = "box"
-engine = "gecko"
 spec = "https://drafts.csswg.org/css-break/#propdef-break-inside"
 animation_type = "discrete"
 affects = "layout"
diff --git a/properties/shorthands.toml b/properties/shorthands.toml
index 4d91af1..0d98180 100644
--- a/properties/shorthands.toml
+++ b/properties/shorthands.toml
@@ -218,19 +218,16 @@ sub_properties = ["alignment-baseline", "baseline-shift", "baseline-source"]
 spec = "https://drafts.csswg.org/css-inline-3/#transverse-alignment"

 [page-break-before]
-engine = "gecko"
 flags = "IS_LEGACY_SHORTHAND"
 sub_properties = ["break-before"]
 spec = "https://drafts.csswg.org/css-break-3/#page-break-properties"

 [page-break-after]
-engine = "gecko"
 flags = "IS_LEGACY_SHORTHAND"
 sub_properties = ["break-after"]
 spec = "https://drafts.csswg.org/css-break-3/#page-break-properties"

 [page-break-inside]
-engine = "gecko"
 flags = "IS_LEGACY_SHORTHAND"
 sub_properties = ["break-inside"]
 spec = "https://drafts.csswg.org/css-break-3/#page-break-properties"

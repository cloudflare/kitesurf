diff --git a/color/component.rs b/color/component.rs
index 2603aa6..c86ff68 100644
--- a/color/component.rs
+++ b/color/component.rs
@@ -151,6 +151,21 @@ impl<ValueType: ColorComponentType> ColorComponent<ValueType> {
         }
     }

+    /// Compute a component, but map a bare channel keyword whose origin is
+    /// `none` to zero. Lab-family and `color()` relative colors use this rule.
+    pub fn to_computed_value_kw_none_as_zero(
+        &self,
+        context: Option<&computed::Context>,
+        origin_color: Option<&AbsoluteColor>,
+    ) -> Self {
+        let result = self.to_computed_value(context, origin_color);
+        if matches!(self, Self::ChannelKeyword(_)) && matches!(result, Self::None) {
+            Self::Value(ValueType::from_value(0.0))
+        } else {
+            result
+        }
+    }
+
     /// Resolve an already-computed [ColorComponent] into a float. None is
     /// "none". This assumes color channel references have already been
     /// substituted by [`to_computed_value`], and so does not require an origin
diff --git a/color/mix.rs b/color/mix.rs
index 8333456..1a9833f 100644
--- a/color/mix.rs
+++ b/color/mix.rs
@@ -168,7 +168,7 @@ pub fn mix_many(
     items: impl IntoIterator<Item = ColorMixItem>,
     flags: ColorMixFlags,
 ) -> AbsoluteColor {
-    let mut items = items.into_iter().collect::<ColorMixItemList<_>>();
+    let items = items.into_iter().collect::<ColorMixItemList<_>>();

     // Convert a mix result into the syntax required by the flags:
     // - modern syntax when requested (converting legacy spaces like hsl/hwb to srgb), otherwise;
@@ -202,16 +202,12 @@ pub fn mix_many(
     let normalize = flags.contains(ColorMixFlags::NORMALIZE_WEIGHTS);
     let mut weight_scale = 1.0;
     let mut alpha_multiplier = 1.0;
+    let mut zero_sum = false;
     if normalize {
         // https://drafts.csswg.org/css-color-5/#color-mix-percent-norm
         let sum: f32 = items.iter().map(|item| item.weight).sum();
         if sum == 0.0 {
-            // All-zero weights mix equally and zero out the result's
-            // alpha (css-values-5 normalization; WPT zero-sum rows).
-            let equal = 1.0 / items.len() as f32;
-            for item in items.iter_mut() {
-                item.weight = equal;
-            }
+            zero_sum = true;
             alpha_multiplier = 0.0;
         } else if (sum - 1.0).abs() > f32::EPSILON {
             weight_scale = 1.0 / sum;
@@ -229,13 +225,15 @@ pub fn mix_many(
     for item in rest {
         let weight = item.weight * weight_scale;
         let combined = accumulated_weight + weight;
-        if combined == 0.0 {
+        if combined == 0.0 && !zero_sum {
             // If both are 0, this fold doesn't contribute anything to the result.
             continue;
         }
         let right = convert_for_mix(&item.color, interpolation.space);

-        let (left_weight, right_weight) = if normalize {
+        let (left_weight, right_weight) = if zero_sum {
+            (0.5, 0.5)
+        } else if normalize {
             (accumulated_weight / combined, weight / combined)
         } else {
             (accumulated_weight, weight)
@@ -269,6 +267,7 @@ pub fn mix_many(
         alpha,
     );
     result.flags = accumulated_color.flags;
+    result.flags.remove(ColorFlags::HSL_HWB_AS_PERCENT);

     finalize(result)
 }
diff --git a/color/mod.rs b/color/mod.rs
index 598d71e..715545f 100644
--- a/color/mod.rs
+++ b/color/mod.rs
@@ -238,6 +238,8 @@ bitflags! {
         /// Marks that this color is in the legacy color format. This flag is
         /// only valid for the `Srgb` color space.
         const IS_LEGACY_SRGB = 1 << 4;
+        /// Serialize directly-authored HSL/HWB missing components as percentages.
+        const HSL_HWB_AS_PERCENT = 1 << 5;
     }
 }


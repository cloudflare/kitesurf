From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Fri, 31 Jul 2026 17:20:03 +0100
Subject: [PATCH] Enable appearance in the servo build

Same pattern as the accent-color enablement: drop the engine=gecko gate
so servo generates the longhand. The Appearance value type was already
un-gated, and the existing extra_prefixes line gives the
-webkit-appearance legacy alias, which is the spelling stylesheets use
for form-control resets. This is parse and computed value only; the
embedder's form paint does not read it, so appearance:none does not
suppress widget chrome.
---
 properties/longhands.toml | 1 -
 1 file changed, 1 deletion(-)

diff --git a/properties/longhands.toml b/properties/longhands.toml
index cfffa70..7eee22c 100644
--- a/properties/longhands.toml
+++ b/properties/longhands.toml
@@ -322,7 +322,6 @@ affects = ""
 type = "Appearance"
 initial = "computed::Appearance::None"
 struct = "box"
-servo_pref = "layout.unimplemented"
 extra_prefixes = ["webkit"]
 spec = "https://drafts.csswg.org/css-ui-4/#propdef-appearance"
 animation_type = "discrete"

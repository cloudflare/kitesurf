From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Fri, 31 Jul 2026 17:06:51 +0100
Subject: [PATCH] Enable -webkit-box, -webkit-line-clamp and box-orient in
 servo

The legacy multiline-ellipsis pattern (display:-webkit-box,
-webkit-box-orient:vertical and -webkit-line-clamp:N) needs three
gecko-gated pieces:

- the WebkitBox display variant (with its parse arms, consts and
  FlowRoot const);
- the line-clamp property. Servo gets the line-clamp longhand behind
  layout.css.line-clamp.enabled (like gecko) and the -webkit-line-clamp
  legacy shorthand unconditionally;
- -moz-box-orient (struct xul, generated fresh for servo like the
  fill/InheritedSVG precedent), whose -webkit-box-orient alias carries
  the spelling the web uses.

Also un-gate adjust_for_webkit_line_clamp (the Blink-matching
computed-value rewrite of the clamp trio to flow-root) and set a new
IS_WEBKIT_LINE_CLAMP_CONTEXT flag when it fires. Layout cannot
otherwise tell an adjusted flow-root from an authored one, and the
clamp must not apply to plain blocks that merely set the property.
---
 properties/computed_value_flags.rs | 3 +++
 properties/longhands.toml          | 3 +--
 properties/shorthands.toml         | 1 -
 style_adjuster.rs                  | 4 ++--
 values/specified/box.rs            | 7 -------
 5 files changed, 6 insertions(+), 12 deletions(-)

diff --git a/properties/computed_value_flags.rs b/properties/computed_value_flags.rs
index 80944d8..6a80522 100644
--- a/properties/computed_value_flags.rs
+++ b/properties/computed_value_flags.rs
@@ -137,6 +137,9 @@ bitflags! {

         /// Whether this style uses `sibling-index()`.
         const USES_SIBLING_INDEX = 1 << 27;
+
+        /// Whether the legacy WebKit line-clamp adjustment rewrote display.
+        const IS_WEBKIT_LINE_CLAMP_CONTEXT = 1 << 28;
     }
 }

diff --git a/properties/longhands.toml b/properties/longhands.toml
index 7369076..cfffa70 100644
--- a/properties/longhands.toml
+++ b/properties/longhands.toml
@@ -101,7 +101,7 @@ type = "LineClamp"
 initial = "computed::LineClamp::none()"
 struct = "box"
 boxed = true
-engine = "gecko"
+servo_pref = "layout.css.line-clamp.enabled"
 gecko_pref = "layout.css.line-clamp.enabled"
 gecko_ffi_name = "mWebkitLineClamp"
 spec = "https://drafts.csswg.org/css-overflow-4/#propdef-line-clamp"
@@ -4218,7 +4218,6 @@ keyword = { values = ["normal", "reverse"] }

 [-moz-box-orient]
 struct = "xul"
-engine = "gecko"
 spec = "Nonstandard (https://developer.mozilla.org/en-US/docs/Web/CSS/box-orient)"
 animation_type = "discrete"
 affects = "layout"
diff --git a/properties/shorthands.toml b/properties/shorthands.toml
index bd1c5dd..4d91af1 100644
--- a/properties/shorthands.toml
+++ b/properties/shorthands.toml
@@ -564,7 +564,6 @@ spec = "https://compat.spec.whatwg.org/#the-webkit-text-stroke"
 derive_serialize = true

 [-webkit-line-clamp]
-engine = "gecko"
 flags = "IS_LEGACY_SHORTHAND ALLOWS_DISABLED_SUBPROPERTIES"
 sub_properties = ["line-clamp"]
 spec = "https://drafts.csswg.org/css-overflow-4/#webkit-line-clamp"
diff --git a/style_adjuster.rs b/style_adjuster.rs
index c14a93f..cd0f53c 100644
--- a/style_adjuster.rs
+++ b/style_adjuster.rs
@@ -161,7 +161,6 @@ impl<'a, 'b: 'a> StyleAdjuster<'a, 'b> {
     /// This makes the element not be a flex container, with all that it
     /// implies, but it should be safe. It matches blink, see
     /// https://bugzilla.mozilla.org/show_bug.cgi?id=1786147#c10
-    #[cfg(feature = "gecko")]
     fn adjust_for_webkit_line_clamp(&mut self) {
         use crate::properties::longhands::_moz_box_orient::computed_value::T as BoxOrient;
         use crate::values::specified::box_::{DisplayInside, DisplayOutside};
@@ -186,6 +185,8 @@ impl<'a, 'b: 'a> StyleAdjuster<'a, 'b> {
         self.style
             .mutate_box()
             .set_adjusted_display(new_display, false);
+        self.style
+            .add_flags(ComputedValueFlags::IS_WEBKIT_LINE_CLAMP_CONTEXT);
     }

     /// CSS 2.1 section 9.7:
@@ -1061,7 +1062,6 @@ impl<'a, 'b: 'a> StyleAdjuster<'a, 'b> {
         }
         self.adjust_for_top_layer();
         self.blockify_if_necessary(layout_parent_style, element);
-        #[cfg(feature = "gecko")]
         self.adjust_for_webkit_line_clamp();
         self.adjust_for_position();
         self.adjust_for_overflow();

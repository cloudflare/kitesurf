diff --git a/color/to_css.rs b/color/to_css.rs
index 91f0f5c..87b792b 100644
--- a/color/to_css.rs
+++ b/color/to_css.rs
@@ -41,6 +41,29 @@ impl<'a> ToCss for ModernComponent<'a> {
     }
 }

+/// Write the `hsl()` or `hwb()` functional form while preserving `none`.
+pub(crate) fn write_hsl_hwb_functional<W>(
+    color: &AbsoluteColor,
+    dest: &mut CssWriter<W>,
+    percent: bool,
+) -> fmt::Result
+where
+    W: Write,
+{
+    debug_assert!(matches!(color.color_space, ColorSpace::Hsl | ColorSpace::Hwb));
+    dest.write_str(if color.color_space == ColorSpace::Hsl { "hsl(" } else { "hwb(" })?;
+    ModernComponent(&color.c0()).to_css(dest)?;
+    for component in [color.c1(), color.c2()] {
+        dest.write_char(' ')?;
+        ModernComponent(&component).to_css(dest)?;
+        if percent && matches!(component, Some(value) if value.is_finite()) {
+            dest.write_char('%')?;
+        }
+    }
+    serialize_color_alpha(dest, color.alpha(), false)?;
+    dest.write_char(')')
+}
+
 impl ToCss for NumberOrPercentageComponent {
     fn to_css<W>(&self, dest: &mut CssWriter<W>) -> fmt::Result
     where
@@ -78,6 +101,11 @@ impl ToCss for AbsoluteColor {
     {
         match self.color_space {
             ColorSpace::Srgb if self.flags.contains(ColorFlags::IS_LEGACY_SRGB) => {
+                if self.has_none_components() {
+                    let mut modern = *self;
+                    modern.flags.remove(ColorFlags::IS_LEGACY_SRGB);
+                    return modern.to_css(dest);
+                }
                 // The "none" keyword is not supported in the rgb/rgba legacy syntax.
                 let has_alpha = self.alpha != OPAQUE;

@@ -96,6 +124,8 @@ impl ToCss for AbsoluteColor {
             ColorSpace::Hsl | ColorSpace::Hwb => {
                 if self.flags.contains(ColorFlags::IS_LEGACY_SRGB) {
                     self.into_srgb_legacy().to_css(dest)
+                } else if self.has_none_components() {
+                    write_hsl_hwb_functional(self, dest, true)
                 } else {
                     self.to_color_space(ColorSpace::Srgb).to_css(dest)
                 }

+                    });
+                let alpha = alpha!(alpha);
+                let use_rgb_sytax = no_origin && h.is_some() && w.is_some() && b.is_some() && alpha.is_some();
+                let mut result = AbsoluteColor::new(ColorSpace::Hwb, h, w, b, alpha);

                 if use_rgb_sytax {
                     result.flags.insert(ColorFlags::IS_LEGACY_SRGB);

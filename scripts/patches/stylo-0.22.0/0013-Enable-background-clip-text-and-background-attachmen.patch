From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Fri, 31 Jul 2026 16:24:51 +0100
Subject: [PATCH] Enable background-clip:text and background-attachment:local
 in servo

Both keywords were extra_gecko_values, so the servo build rejected
them. The background shorthand drops the whole declaration when any
layer keyword fails to parse, so stylesheets using the gradient-text
pattern (background: linear-gradient(..) plus -webkit-background-clip:
text) or scroll shadows (background-attachment: local) lost their
entire background, not just the modern keyword. Mirror them into
extra_servo_values; the paint-side fallback for clip:text lives in
blitz-paint.
---
 properties/longhands.toml      | 2 +-
 values/specified/background.rs | 2 --
 2 files changed, 1 insertion(+), 3 deletions(-)

diff --git a/properties/longhands.toml b/properties/longhands.toml
index 733bc2f..7369076 100644
--- a/properties/longhands.toml
+++ b/properties/longhands.toml
@@ -3639,7 +3639,7 @@ animation_type = "discrete"
 affects = "paint"
 servo_restyle_damage = "repaint"
 vector = {}
-keyword = { values = ["scroll", "fixed"], extra_gecko_values = ["local"], gecko_enum_prefix = "StyleImageLayerAttachment" }
+keyword = { values = ["scroll", "fixed"], extra_gecko_values = ["local"], extra_servo_values = ["local"], gecko_enum_prefix = "StyleImageLayerAttachment" }

 [background-clip]
 type = "BackgroundClip"
diff --git a/values/specified/background.rs b/values/specified/background.rs
index 405d50e..662f90b 100644
--- a/values/specified/background.rs
+++ b/values/specified/background.rs
@@ -210,7 +210,6 @@ pub enum BackgroundClip {
     #[value_info(skip)]
     NoClip,
     // TODO: text and border-area are supposed to combine in backgrounds-4...
-    #[cfg(feature = "gecko")]
     Text,
     #[parse(condition = "background_clip_border_area_enabled")]
     #[value_info(skip)]
@@ -241,7 +240,6 @@ impl BackgroundClip {
             Self::ViewBox => ClipValidity::MASK,
             #[cfg(feature = "gecko")]
             Self::NoClip => ClipValidity::MASK,
-            #[cfg(feature = "gecko")]
             Self::Text => ClipValidity::BACKGROUND,
             Self::BorderArea => ClipValidity::BACKGROUND,
         }

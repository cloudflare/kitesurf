From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Thu, 17 Sep 2026 17:23:34 +0100
Subject: [PATCH] Shrink retained CSS buffers to their contents

Stylesheet rule lists and declaration blocks retain parser-grown capacity
after parsing. Shrink each buffer at its parse boundary so unused
allocation is not retained for the object's lifetime.
---
 properties/declaration_block.rs | 49 ++++++++++++++++++++++++++++++++-
 stylesheets/stylesheet.rs       |  1 +
 2 files changed, 49 insertions(+), 1 deletion(-)

diff --git a/properties/declaration_block.rs b/properties/declaration_block.rs
index df7a2e0..4ffe313 100644
--- a/properties/declaration_block.rs
+++ b/properties/declaration_block.rs
@@ -1532,7 +1532,9 @@ impl<'i> DeclarationParserState<'i> {

     /// Takes the parsed declarations.
     pub fn take_declarations(&mut self) -> PropertyDeclarationBlock {
-        std::mem::take(&mut self.output_block)
+        let mut declarations = std::mem::take(&mut self.output_block);
+        declarations.declarations.shrink_to_fit();
+        declarations
     }

     /// Parse a single declaration value.
@@ -1784,5 +1786,50 @@ pub fn parse_property_declaration_list(
         }
     }
     parser.state.report_errors_if_needed(context, selectors);
+    state.output_block.declarations.shrink_to_fit();
     state.output_block
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn context(url_data: &UrlExtraData) -> ParserContext<'_> {
+        ParserContext::new(
+            Origin::Author,
+            url_data,
+            Some(CssRuleType::Style),
+            style_traits::ParsingMode::DEFAULT,
+            QuirksMode::NoQuirks,
+            Default::default(),
+            None,
+            None,
+            Default::default(),
+        )
+    }
+
+    fn parsed_declarations() -> PropertyDeclarationBlock {
+        let url_data = UrlExtraData::from(::url::Url::parse("https://example.test/").unwrap());
+        let context = context(&url_data);
+        parse_property_declaration_list(&context, &mut Parser::new("color: red;"), &[])
+    }
+
+    #[test]
+    fn parse_property_declaration_list_shrinks_declarations() {
+        let block = parsed_declarations();
+        assert_eq!(block.len(), 1);
+        assert_eq!(block.declarations.capacity(), block.len());
+    }
+
+    #[test]
+    fn take_declarations_shrinks_declarations() {
+        let mut state = DeclarationParserState::default();
+        state.output_block = parsed_declarations();
+        state.output_block.declarations.reserve(16);
+        assert!(state.output_block.declarations.capacity() > state.output_block.len());
+
+        let block = state.take_declarations();
+
+        assert_eq!(block.declarations.capacity(), block.len());
+    }
+}
diff --git a/stylesheets/stylesheet.rs b/stylesheets/stylesheet.rs
index 7c064fd..e37c68e 100644
--- a/stylesheets/stylesheet.rs
+++ b/stylesheets/stylesheet.rs
@@ -485,6 +485,7 @@ impl Stylesheet {

         let source_map_url = input.current_source_map_url().map(String::from);
         let source_url = input.current_source_url().map(String::from);
+        rule_parser.rules.shrink_to_fit();
         (
             rule_parser.context.namespaces.into_owned(),
             rule_parser.rules,

@@ -1964,7 +1962,6 @@ affects = "layout"
 type = "PageSize"
 initial = "computed::PageSize::auto()"
 struct = "page"
-engine = "gecko"
 spec = "https://drafts.csswg.org/css-page-3/#page-size-prop"
 animation_type = "none"
 rule_types_allowed = ["page"]
diff --git a/servo/selector_parser.rs b/servo/selector_parser.rs
index 8db7135..f03d9a1 100644
--- a/servo/selector_parser.rs
+++ b/servo/selector_parser.rs
@@ -596,7 +596,10 @@ impl<'a, 'i> ::selectors::Parser<'i> for SelectorParser<'a> {

     #[inline]
     fn parse_has(&self) -> bool {
-        crate::pref!("layout.css.has-selector.enabled")
+        // Enable :has() for the servo build. Matching is
+        // engine-agnostic, and an embedder that recascades fully does not
+        // need the gecko-only relative-selector invalidation map.
+        true
     }

     #[inline]
diff --git a/stylesheet_set.rs b/stylesheet_set.rs
index 6f6ee52..b23dfba 100644
--- a/stylesheet_set.rs
+++ b/stylesheet_set.rs
@@ -226,11 +226,14 @@ where

     fn remove(&mut self, sheet: &S) {
         let index = self.find_sheet_index(sheet);
-        if cfg!(feature = "gecko") && index.is_none() {
-            // FIXME(emilio): Make Gecko's PresShell::AddUserSheet not suck.
+        // Tolerate removing a stylesheet not in the set (servo
+        // build, like gecko above). Real pages remove a load-failed or
+        // already-removed sheet through CSSOM; upstream only guards gecko
+        // and panics on index.unwrap() for servo.
+        let Some(index) = index else {
             return;
-        }
-        let sheet = self.entries.remove(index.unwrap());
+        };
+        let sheet = self.entries.remove(index);
         // Removing sheets makes us tear down the whole cascade and invalidation
         // data, but only if the sheet has been involved in at least one flush.
         // Checking whether the sheet has been committed allows us to avoid
diff --git a/stylesheets/rule_parser.rs b/stylesheets/rule_parser.rs
index 0d83dcf..885eef9 100644
--- a/stylesheets/rule_parser.rs
+++ b/stylesheets/rule_parser.rs
@@ -287,7 +287,7 @@ impl AtRuleType {
             "keyframes" => Self::Keyframes(None),
             "-webkit-keyframes" => Self::Keyframes(Some(VendorPrefix::WebKit)),
             "-moz-keyframes" if cfg!(feature = "gecko") => Self::Keyframes(Some(VendorPrefix::Moz)),
-            "page" if cfg!(feature = "gecko") => Self::Page,
+            "page" => Self::Page,
             "property" if crate::pref!("layout.css.properties-and-values.enabled") => Self::Property,
             "-moz-document" if cfg!(feature = "gecko") => Self::Document,
             "import" => Self::Import,

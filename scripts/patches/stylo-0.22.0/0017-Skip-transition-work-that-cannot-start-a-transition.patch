From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Mon, 2 Nov 2026 05:23:19 +0000
Subject: [PATCH] Skip transition work that cannot start a transition

Testing interpolability constructs a midpoint even when equal animation values cannot
start a transition. Evaluate the existing predicate only in the branches that consume
it, preserving running-transition cancellation and retargeting.

With no existing transitions and normal transition behavior, a discrete property cannot
start a transition or cancel an existing one. Return before cloning and converting its
computed values. Keep the full path when any transition record exists or discrete
transitions are allowed.
---
 servo/animation.rs | 21 ++++++++++++++++-----
 1 file changed, 16 insertions(+), 5 deletions(-)

diff --git a/servo/animation.rs b/servo/animation.rs
index 615004b..1553c11 100644
--- a/servo/animation.rs
+++ b/servo/animation.rs
@@ -1537,6 +1537,14 @@ impl ElementAnimationSet {
         let allow_discrete =
             style.transition_behavior_mod(index) == TransitionBehavior::AllowDiscrete;

+        // With no existing transitions, discrete values cannot start one unless allowed.
+        if self.transitions.is_empty()
+            && !allow_discrete
+            && property_declaration_id.is_discrete_animatable()
+        {
+            return;
+        }
+
         // FIXME(emilio): Handle the case where old_style and new_style's writing mode differ.
         let Some(from) = AnimationValue::from_computed_values(*property_declaration_id, old_style)
         else {
@@ -1551,9 +1559,12 @@ impl ElementAnimationSet {
         let duration = style.transition_duration_mod(index).seconds() as f64;
         let delay = style.transition_delay_mod(index).seconds() as f64;
         let now = context.current_time_for_animations;
-        let transitionable = property_declaration_id.is_animatable()
-            && (allow_discrete || !property_declaration_id.is_discrete_animatable())
-            && (allow_discrete || from.interpolable_with(&to));
+        // Unchanged values cannot start a transition; defer interpolation until needed.
+        let transitionable = || {
+            property_declaration_id.is_animatable()
+                && (allow_discrete || !property_declaration_id.is_discrete_animatable())
+                && (allow_discrete || from.interpolable_with(&to))
+        };

         let mut existing_transition = self.transitions.iter_mut().find(|transition| {
             transition.property_animation.property_id() == *property_declaration_id
@@ -1584,7 +1595,7 @@ impl ElementAnimationSet {
             });
         if !has_running_transition
             && from != to
-            && transitionable
+            && transitionable()
             && no_completed_transition_or_end_values_differ
             && (duration + delay > 0.0)
         {
@@ -1647,7 +1658,7 @@ impl ElementAnimationSet {
             // > must cancel the running transition.
             let current_value = existing_transition.calculate_value(now);
             let transitionable_from_current_value =
-                transitionable && (allow_discrete || current_value.interpolable_with(&to));
+                transitionable() && (allow_discrete || current_value.interpolable_with(&to));
             if current_value == to || !transitionable_from_current_value {
                 existing_transition.state = AnimationState::Canceled;
                 self.dirty = true;

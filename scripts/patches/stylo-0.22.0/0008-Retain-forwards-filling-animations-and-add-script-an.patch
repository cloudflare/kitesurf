+/// Only sets the keyframe-easing bezier epsilon, 1 / (200 * duration) = 1e-7: Blink's
+/// kBezierEpsilon. Solving tighter than Blink shifts the sixth digit pages read back.
+const SCRIPT_ANIMATION_EASING_DURATION: f64 = 5e4;
+
+/// A Web Animations effect (`Element.animate`) on an element. Its keyframes cascade like a
+/// CSS animation's, but the embedder owns its timing and hands over the progress to sample.
+#[derive(Clone, MallocSizeOf)]
+pub struct ScriptAnimation {
+    id: u64,
+    #[ignore_malloc_size_of = "Arc"]
+    keyframes: Arc<KeyframesAnimation>,
+    progress: Option<f64>,
+    /// Keyframes computed against the element's style, and the non-animation rules
+    /// they were computed for.
+    #[ignore_malloc_size_of = "rule nodes are shared"]
+    built: Option<(Animation, StrongRuleNode)>,
+}
+
+impl ScriptAnimation {
+    /// An effect whose keyframes were parsed against the document's shared lock. Script
+    /// animations composite above CSS animations, in the order the embedder lists them.
+    pub fn new(id: u64, keyframes: Arc<KeyframesAnimation>) -> Self {
+        ScriptAnimation {
+            id,
+            keyframes,
+            progress: None,
+            built: None,
+        }
+    }
+
+    /// The embedder's id for this effect, which it uses to find the effect again
+    /// when the effect's timing changes.
+    pub fn id(&self) -> u64 {
+        self.id
+    }
+
+    /// Set the iteration progress to sample (after direction and effect easing), or
+    /// `None` while the effect is not in effect. Returns whether anything changed.
+    pub fn set_progress(&mut self, progress: Option<f64>) -> bool {
+        if self.progress == progress {
+            return false;
+        }
+        self.progress = progress;
+        if let (Some(progress), Some((animation, _))) = (progress, self.built.as_mut()) {
+            animation.state = AnimationState::Paused(progress);
+        }
+        true
+    }
+
+    fn build<E>(
+        &mut self,
+        element: E,
+        context: &SharedStyleContext,
+        new_style: &Arc<ComputedValues>,
+        base_rules: &StrongRuleNode,
+        resolver: &mut StyleResolverForElement<E>,
+    ) -> bool
+    where
+        E: TElement,
+    {
+        if self.built.as_ref().is_some_and(|(_, rules)| rules == base_rules) {
+            return false;
+        }
+        let mut animating_properties = PropertyDeclarationIdSet::default();
+        let mut number_of_animating_properties = 0;
+        for property in self.keyframes.properties_changed.iter() {
+            if animating_properties.insert(property.to_physical(new_style.writing_mode)) {
+                number_of_animating_properties += 1;
+            }
+        }
+        let computed_steps = ComputedKeyframe::generate_for_keyframes(
+            element,
+            &self.keyframes,
+            context,
+            new_style,
+            TimingFunction::Keyword(crate::values::generics::easing::TimingKeyword::Linear),
+            AnimationComposition::Replace,
+            resolver,
+            animating_properties,
+            number_of_animating_properties,
+        );
+        let animation = Animation {
+            name: Atom::from(""),
+            properties_changed: self.keyframes.properties_changed.clone(),
+            computed_steps,
+            started_at: 0.,
+            duration: SCRIPT_ANIMATION_EASING_DURATION,
+            delay: 0.,
+            fill_mode: AnimationFillMode::Both,
+            iteration_state: KeyframesIterationState::Finite(0., 1.),
+            state: AnimationState::Paused(self.progress.unwrap_or(0.)),
+            direction: AnimationDirection::Normal,
+            current_direction: AnimationDirection::Normal,
+            number_of_animating_properties,
+            is_new: false,
+        };
+        self.built = Some((animation, base_rules.clone()));
+        true
+    }
+
+    fn add_values(&self, map: &mut AnimationValueMap) {
+        if let (Some(_), Some((animation, _))) = (self.progress, self.built.as_ref()) {
+            animation.get_property_declaration_at_time(0., map);
+        }
+    }
+}
+
+impl fmt::Debug for ScriptAnimation {
+    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        f.debug_struct("ScriptAnimation")
+            .field("id", &self.id)
+            .field("progress", &self.progress)
+            .field("built", &self.built.is_some())
+            .finish()
+    }
+}
+
 impl fmt::Debug for Animation {
     fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
         f.debug_struct("Animation")
@@ -1184,6 +1307,10 @@ pub struct ElementAnimationSet {
     /// The transitions for this element.
     pub transitions: Vec<Transition>,

+    /// The Web Animations effects on this element. The embedder owns and times them;
+    /// stylo only computes their keyframes and samples them.
+    pub script_animations: Vec<ScriptAnimation>,
+
     /// Whether or not this ElementAnimationSet has had animations or transitions
     /// which have been added, removed, or had their state changed.
     pub dirty: bool,
@@ -1241,7 +1368,9 @@ impl ElementAnimationSet {
     /// Whether this `ElementAnimationSet` is empty, which means it doesn't
     /// hold any animations in any state.
     pub fn is_empty(&self) -> bool {
-        self.animations.is_empty() && self.transitions.is_empty()
+        self.animations.is_empty()
+            && self.transitions.is_empty()
+            && self.script_animations.is_empty()
     }

     /// Whether or not this state needs animation ticks for its transitions
@@ -1274,6 +1403,32 @@ impl ElementAnimationSet {
         self.animations
             .iter()
             .any(|animation| animation.state != AnimationState::Canceled)
+            || self
+                .script_animations
+                .iter()
+                .any(|animation| animation.progress.is_some())
+    }
+
+    /// Compute the keyframes of any script animation that has none yet, or whose
+    /// element's non-animation rules changed since they were computed.
+    pub fn build_script_animations<E>(
+        &mut self,
+        element: E,
+        context: &SharedStyleContext,
+        new_style: &Arc<ComputedValues>,
+        resolver: &mut StyleResolverForElement<E>,
+    ) where
+        E: TElement,
+    {
+        if self.script_animations.is_empty() {
+            return;
+        }
+        let base_rules = context.stylist.rule_tree().remove_animation_rules(new_style.rules());
+        for animation in self.script_animations.iter_mut() {
+            if animation.build(element, context, new_style, &base_rules, resolver) {
+                self.dirty = true;
+            }
+        }
     }

     /// If this `ElementAnimationSet` has any any active transitions.
@@ -1297,6 +1452,9 @@ impl ElementAnimationSet {
         for animation in self.animations.iter_mut() {
             if animation.is_cancelled_in_new_style(new_style) {
                 animation.state = AnimationState::Canceled;
+                // Cancelling drops this animation's declarations, so the caller
+                // has to recascade, as with `cancel_active_transitions`.
+                self.dirty = true;
             }
         }

@@ -1606,6 +1764,9 @@ impl ElementAnimationSet {
         for animation in &self.animations {
             animation.get_property_declaration_at_time(now, &mut map);
         }
+        for animation in &self.script_animations {
+            animation.add_values(&mut map);
+        }

         Some(map)
     }

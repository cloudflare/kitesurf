From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Thu, 17 Sep 2026 17:23:34 +0100
Subject: [PATCH] perf: reduce retained CSS capacity

---
 properties/declaration_block.rs | 2 +-
 stylesheets/stylesheet.rs       | 1 +
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/properties/declaration_block.rs b/properties/declaration_block.rs
index df7a2e0..d5f6f59 100644
--- a/properties/declaration_block.rs
+++ b/properties/declaration_block.rs
@@ -669,7 +669,7 @@ impl PropertyDeclarationBlock {
         let push_calls_count = drain.declarations.len() + all_shorthand_len;

         // With deduplication the actual length increase may be less than this.
-        self.declarations.reserve(push_calls_count);
+        self.declarations.reserve_exact(push_calls_count);

         let mut changed = false;
         for decl in &mut drain.declarations {
diff --git a/stylesheets/stylesheet.rs b/stylesheets/stylesheet.rs
index 7c064fd..e37c68e 100644
--- a/stylesheets/stylesheet.rs
+++ b/stylesheets/stylesheet.rs
@@ -485,6 +485,7 @@ impl Stylesheet {

         let source_map_url = input.current_source_map_url().map(String::from);
         let source_url = input.current_source_url().map(String::from);
+        rule_parser.rules.shrink_to_fit();
         (
             rule_parser.context.namespaces.into_owned(),
             rule_parser.rules,

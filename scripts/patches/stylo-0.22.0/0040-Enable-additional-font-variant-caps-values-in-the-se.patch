From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ruskin Constant <ruskin@cloudflare.com>
Date: Wed, 16 Sep 2026 11:30:03 +0100
Subject: [PATCH] Enable additional font-variant-caps values in the servo build

all-small-caps, petite-caps, all-petite-caps, unicase and titling-caps
were extra_gecko_values only. They're mature (css-fonts-3) and map
directly to OpenType feature tags with no gecko-only machinery
involved; add them as extra_servo_values too. The OpenType feature
mapping lands as a blitz-dom patch (stylo_to_parley::font_variant_caps
needs a match arm per new variant to stay exhaustive).
---
 properties/longhands.toml | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/properties/longhands.toml b/properties/longhands.toml
index 5ee0fd5..135e2b8 100644
--- a/properties/longhands.toml
+++ b/properties/longhands.toml
@@ -3735,6 +3735,10 @@ servo_restyle_damage = "rebuild_box"
 [font-variant-caps.keyword]
 values = ["normal", "small-caps"]
 extra_gecko_values = ["all-small-caps", "petite-caps", "all-petite-caps", "unicase", "titling-caps"]
+# Same five values, mature in the spec and just OpenType feature tags
+# (see stylo_to_parley::font_variant_caps); no gecko-only machinery
+# needed to expose them for servo.
+extra_servo_values = ["all-small-caps", "petite-caps", "all-petite-caps", "unicase", "titling-caps"]
 gecko_constant_prefix = "NS_FONT_VARIANT_CAPS"

 [font-kerning]

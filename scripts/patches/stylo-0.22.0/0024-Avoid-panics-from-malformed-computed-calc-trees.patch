From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Sat, 5 Sep 2026 11:13:20 +0100
Subject: [PATCH] Avoid panics from malformed computed calc trees

Computed calc trees can contain empty sums, incompatible dimensions, or
final numeric leaves. Treat them as safe fallback values so layout does
not repeatedly unwind or crash the worker.
---
 values/computed/length_percentage.rs | 19 ++++++++++---------
 values/generics/calc.rs              | 10 +++++++++-
 2 files changed, 19 insertions(+), 10 deletions(-)

diff --git a/values/computed/length_percentage.rs b/values/computed/length_percentage.rs
index da52986..afbff91 100644
--- a/values/computed/length_percentage.rs
+++ b/values/computed/length_percentage.rs
@@ -643,8 +643,7 @@ impl CalcLengthPercentage {
     /// Resolves the percentage.
     #[inline]
     pub fn resolve(&self, basis: Length) -> Length {
-        // unwrap() is fine because the conversion below is infallible.
-        if let ComputedLeaf::Length(px) = self
+        let resolved = self
             .node
             .resolve_map(|leaf| {
                 Ok(if let ComputedLeaf::Percentage(p) = leaf {
@@ -652,13 +651,15 @@ impl CalcLengthPercentage {
                 } else {
                     leaf.clone()
                 })
-            })
-            .unwrap()
-        {
-            Length::new(self.clamping_mode.clamp(px.px())).normalized()
-        } else {
-            unreachable!("resolve_map should turn percentages to lengths, and parsing should ensure that we don't end up with a number");
-        }
+            });
+        let px = match resolved {
+            Ok(ComputedLeaf::Length(px)) => px.px(),
+            // new_calc() already treats a final numeric leaf as a length.
+            Ok(ComputedLeaf::Number(number)) => number,
+            // Invalid computed calc trees must not panic during layout.
+            Ok(_) | Err(()) => 0.0,
+        };
+        Length::new(self.clamping_mode.clamp(px)).normalized()
     }

     /// Return a clone of this node with all anchor functions computed and replaced with
diff --git a/values/generics/calc.rs b/values/generics/calc.rs
index 9454e20..4c0fa27 100644
--- a/values/generics/calc.rs
+++ b/values/generics/calc.rs
@@ -1269,7 +1269,10 @@ impl<L: CalcNodeLeaf> CalcNode<L> {
                 Ok((1.0 / value, ty))
             },
             Self::Sum(children) => {
-                let (mut value, mut ty) = children[0].resolve_internal(leaf_to_output_fn)?;
+                let Some(first) = children.first() else {
+                    return Ok((0.0, NumericType::number()));
+                };
+                let (mut value, mut ty) = first.resolve_internal(leaf_to_output_fn)?;

                 for child in children.iter().skip(1) {
                     let (right, right_ty) = child.resolve_internal(leaf_to_output_fn)?;
@@ -2032,6 +2035,11 @@ impl<L: CalcNodeLeaf> CalcNode<L> {
                 SimplificationResult::Simplified
             },
             Self::Sum(ref mut children_slot) => {
+                if children_slot.is_empty() {
+                    *self = Self::Leaf(L::new_number(0.0));
+                    return SimplificationResult::Simplified;
+                }
+
                 let mut sums_to_merge = SmallVec::<[_; 3]>::new();
                 let mut extra_kids = 0;
                 for (i, child) in children_slot.iter().enumerate() {

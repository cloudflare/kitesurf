From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Thu, 30 Jul 2026 15:25:28 +0100
Subject: [PATCH] color-mix items with none serialize like relative origins

WPT color-valid-color-mix-function expects nested hsl()/hwb() items
carrying none to read back as the resolved legacy rgb form (none as
0), the same as relative-color origins. Extract the origin stamping
into Color::stamp_nested_legacy_authored and apply it to mix items; the
stored value keeps its none flags for the actual mixing.
---
 color/parsing.rs          | 18 +-----------------
 values/specified/color.rs | 21 ++++++++++++++++++++-
 2 files changed, 21 insertions(+), 18 deletions(-)

diff --git a/color/parsing.rs b/color/parsing.rs
index ea02708..1007ea7 100644
--- a/color/parsing.rs
+++ b/color/parsing.rs
@@ -260,23 +260,7 @@ fn parse_origin_color(
     }

     let mut origin = SpecifiedColor::parse(context, arguments)?;
-
-    // WPT color-valid-relative-color: an hsl()/hwb() ORIGIN with none
-    // components serializes in the resolved legacy form (none as 0),
-
-    // unlike a top-level hsl()/hwb() which keeps its functional form.
-    // Stamp the legacy text as authored; the value keeps its nones.
-    if let SpecifiedColor::Absolute(ref mut abs) = origin {
-        use crate::color::ColorSpace;
-        if abs.authored.is_none()
-            && abs.color.has_none_components()
-            && matches!(abs.color.color_space, ColorSpace::Hsl | ColorSpace::Hwb)
-        {
-            use style_traits::ToCss;
-            let legacy = abs.color.into_srgb_legacy();
-            abs.authored = Some(legacy.to_css_string().into_boxed_str());
-        }
-    }
+    origin.stamp_nested_legacy_authored();

     Ok(Some(origin))
 }
diff --git a/values/specified/color.rs b/values/specified/color.rs
index ff2d780..bb74bb9 100644
--- a/values/specified/color.rs
+++ b/values/specified/color.rs
@@ -67,7 +67,8 @@ impl ColorMix {
             loop {
                 let mut percentage = try_parse_percentage(input);

-                let color = Color::parse_internal(context, input, preserve_authored)?;
+                let mut color = Color::parse_internal(context, input, preserve_authored)?;
+                color.stamp_nested_legacy_authored();

                 if percentage.is_none() {
                     percentage = try_parse_percentage(input);
@@ -695,6 +696,24 @@ impl ToTyped for Color {
 }

 impl Color {
+    /// Stamp the legacy serialization used for nested missing-component HSL/HWB colors.
+    pub fn stamp_nested_legacy_authored(&mut self) {
+        if let Self::Absolute(ref mut absolute) = *self {
+            if absolute.authored.is_none()
+                && absolute.color.has_none_components()
+                && matches!(absolute.color.color_space, ColorSpace::Hsl | ColorSpace::Hwb)
+            {
+                absolute.authored = Some(
+                    absolute
+                        .color
+                        .into_srgb_legacy()
+                        .to_css_string()
+                        .into_boxed_str(),
+                );
+            }
+        }
+    }
+
     /// Returns whether this color is allowed in forced-colors mode.
     pub fn honored_in_forced_colors_mode(
         &self,

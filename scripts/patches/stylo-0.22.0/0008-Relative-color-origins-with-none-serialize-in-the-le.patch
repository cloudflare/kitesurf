From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Thu, 30 Jul 2026 15:06:54 +0100
Subject: [PATCH] Relative-color origins with none serialize in the legacy form

WPT color-valid-relative-color expects hsl() and hwb() origins carrying
none components to read back as the resolved legacy rgb, with none as
0: hsl(from rgba(128, 128, 128, 0.5) h s l). Top-level hsl() and hwb()
keep the functional form. Stamp the legacy text as the origin's
authored serialization at parse time; the stored value keeps its none
flags so channel keywords still carry them forward.
---
 color/parsing.rs | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/color/parsing.rs b/color/parsing.rs
index c3010bf..ea02708 100644
--- a/color/parsing.rs
+++ b/color/parsing.rs
@@ -259,7 +259,26 @@ fn parse_origin_color(
         return Ok(None);
     }

-    SpecifiedColor::parse(context, arguments).map(Some)
+    let mut origin = SpecifiedColor::parse(context, arguments)?;
+
+    // WPT color-valid-relative-color: an hsl()/hwb() ORIGIN with none
+    // components serializes in the resolved legacy form (none as 0),
+
+    // unlike a top-level hsl()/hwb() which keeps its functional form.
+    // Stamp the legacy text as authored; the value keeps its nones.
+    if let SpecifiedColor::Absolute(ref mut abs) = origin {
+        use crate::color::ColorSpace;
+        if abs.authored.is_none()
+            && abs.color.has_none_components()
+            && matches!(abs.color.color_space, ColorSpace::Hsl | ColorSpace::Hwb)
+        {
+            use style_traits::ToCss;
+            let legacy = abs.color.into_srgb_legacy();
+            abs.authored = Some(legacy.to_css_string().into_boxed_str());
+        }
+    }
+
+    Ok(Some(origin))
 }

 #[inline]

 }

+impl RasterizerSettings {
+    /// Panic unless `source_y` starts on a tile row boundary.
+    fn assert_source_y_aligned(&self) {
+        assert_eq!(
+            self.source_y % Tile::HEIGHT,
+            0,
+            "source_y must be aligned to four pixels"
+        );
+    }
+}

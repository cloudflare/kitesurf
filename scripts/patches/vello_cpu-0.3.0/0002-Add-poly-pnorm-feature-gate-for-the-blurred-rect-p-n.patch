From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Thu, 13 Aug 2026 00:48:27 +0100
Subject: [PATCH] Add poly-pnorm feature gate for the blurred-rect p-norm fit

Put the polynomial replacement for powf behind the poly-pnorm cargo
feature, off by default. Without it, the filler keeps the original
scalar powf per pixel. An embedder opts in to the approximation, and
the upstream path stays available.
---
 Cargo.toml                              |   3 +
 src/fine/common/rounded_blurred_rect.rs | 181 +++++++++++++++++++-----
 src/fine/mod.rs                         |   1 +
 3 files changed, 152 insertions(+), 33 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index 8acf5d7..58c377e 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -71,6 +71,9 @@ std = [
 ]
 text = ["dep:glifo"]
 u8_pipeline = []
+# Polynomial fit of the blurred-rect p-norm, replacing per-pixel powf
+# with a degree-7 coefficient table. See the vello_cpu-0.3.0 patch series.
+poly-pnorm = []

 [lib]
 name = "vello_cpu"

+    /// Apply a `backdrop-filter` to the already-painted scene behind `clip_path`.
+    pub fn push_backdrop_filter(
+        &mut self,
+        clip_path: &BezPath,
+        opacity: Option<f32>,
+        filter: Filter,
+    ) {
+        let opacity = opacity.unwrap_or(1.0).clamp(0.0, 1.0);
+        let layer_transform = self
+            .root_transforms
+            .effective_path_transform(self.transforms());
+        let filter_data = FilterData::new(filter, layer_transform);
+        self.dispatcher.push_backdrop_filter(
+            clip_path,
+            self.state.fill_rule,
+            layer_transform,
+            opacity,
+            self.aliasing_threshold,
+            filter_data,
+        );
+    }
+
     /// Set the aliasing threshold.
     ///
     /// If set to `None` (which is the recommended option in nearly all cases),

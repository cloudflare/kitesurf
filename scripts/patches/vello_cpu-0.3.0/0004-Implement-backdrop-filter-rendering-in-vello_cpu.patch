+
+    fn rasterize_backdrop_filter_layers<S: Simd, F: FineKernel<S>>(
+        &self,
+        simd: S,
+        filter_ctx: &mut FilterContext,
+        target_init: TargetInit<PremulColor>,
+        encoded_paints: &[EncodedPaint],
+        image_resolver: &dyn ImageResolver,
+    ) {
+        for id in self.recorder.backdrop_filter_layers.iter().copied() {
+            let RecordedLayerKind::BackdropFilter {
+                filter_data: filter_plan,
+                placement,
+                backdrop_root,
+            } = &self.recorder.layers[id as usize].kind
+            else {
+                unreachable!("backdrop_filter_layers only contains backdrop filter layers");
+            };
+            let pixmap_bbox = placement.pixmap_bbox();
+            if pixmap_bbox.is_empty() {
+                continue;
+            }
+            let width = pixmap_bbox.width();
+            let height = pixmap_bbox.height();
+            let mut pixmap = Pixmap::new(width, height);
+            let params = FineRenderParams {
+                scene_size: (width, height),
+                target_offset: (0, 0),
+                source_y: 0,
+            };
+            let (root_nodes, root_init, root_blend) = match backdrop_root {
+                Some(root_id) => (
+                    self.recorder.layers[*root_id as usize].nodes.as_slice(),
+                    TargetInit::Clear(PremulColor::from_alpha_color(AlphaColor::TRANSPARENT)),
+                    false,
+                ),
+                None => (
+                    self.recorder.nodes.as_slice(),
+                    target_init,
+                    self.recorder.root_is_blend_target,
+                ),
+            };
+
+            self.bucket_and_rasterize::<S, F>(
+                simd,
+                root_nodes,
+                pixmap_bbox,
+                filter_ctx,
+                (&mut pixmap).into(),
+                params,
+                root_init,
+                root_blend,
+                encoded_paints,
+                image_resolver,
+                Some(id),
+            );
+
+            F::filter_layer(
+                &mut pixmap,
+                &filter_plan.filter,
+                filter_ctx.scratch(),
+                filter_plan.transform,
+            );
+
+            filter_ctx.set_layer(id as usize, pixmap);
+        }
+    }
 }

 impl Dispatcher for SingleThreadedDispatcher {

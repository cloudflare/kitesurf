+    /// Compute the active vertical band window `[y0, y1)` in each layer's parent
+    /// coordinate space, propagating outer filter `source_shift` and halo padding
+    /// into nested filter/backdrop-filter layers so nested filters band-clip too.
+    fn compute_filter_band_windows(&self, root_band: (u16, u16)) -> alloc::vec::Vec<(u16, u16)> {
+        let mut windows = alloc::vec![root_band; self.recorder.layers.len()];
+        fn propagate(
+            layers: &[vello_common::record::RecordedLayer],
+            nodes: &[Node],
+            child_window: (u16, u16),
+            windows: &mut [(u16, u16)],
+        ) {
+            for node in nodes {
+                let Some(id) = node.layer else { continue };
+                let idx = id as usize;
+                if idx >= layers.len() {
+                    continue;
+                }
+                windows[idx] = child_window;
+                if matches!(layers[idx].kind, RecordedLayerKind::Regular) {
+                    propagate(layers, &layers[idx].nodes, child_window, windows);
+                }
+            }
+        }
+        // `filter_layers` is recorded in outer-to-inner push order, so each outer
+        // filter's window is finalized before its nested filter children run.
+        for &id in &self.recorder.filter_layers {
+            let idx = id as usize;
+            let Some(layer) = self.recorder.layers.get(idx) else {
+                continue;
+            };
+            let RecordedLayerKind::Filter {
+                filter_data: filter_plan,
+                ..
+            } = &layer.kind
+            else {
+                continue;
+            };
+            let (wy0, wy1) = windows[idx];
+            let shift_y = filter_plan.source_shift().1;
+            let pad = filter_plan.filter_padding;
+            let halo_y = pad.top.max(pad.bottom);
+            let child_window = (
+                wy0.saturating_add(shift_y).saturating_sub(halo_y),
+                wy1.saturating_add(shift_y).saturating_add(halo_y),
+            );
+            propagate(&self.recorder.layers, &layer.nodes, child_window, &mut windows);
+        }
+        windows
+    }

 use alloc::sync::Arc;
 use alloc::vec::Vec;
+use vello_common::filter::FilterLayerPlacement;
 use vello_common::pixmap::Pixmap;

+#[derive(Debug, Clone)]
+pub(crate) enum FilterLayerState {
+    Ready(Arc<Pixmap>, FilterLayerPlacement),
+    /// Layer exceeded the filter pixel budget; inline its children unfiltered
+    /// rather than dropping content.
+    UnfilteredFallback,
+}
+
 #[derive(Debug, Default)]
 pub(crate) struct FilterContext {
-    /// The rendered pixmaps for each filter layer.
-    layers: Vec<Option<Arc<Pixmap>>>,
+    /// The rendered pixmaps (or unfiltered fallback markers) for each filter layer.
+    layers: Vec<Option<FilterLayerState>>,
     scratch: ScratchBuffer,
 }

@@ -24,14 +33,21 @@ impl FilterContext {
         &mut self.scratch
     }

-    pub(crate) fn set_layer(&mut self, id: usize, pixmap: Pixmap) {
+    pub(crate) fn set_layer(&mut self, id: usize, pixmap: Pixmap, placement: FilterLayerPlacement) {
+        if id >= self.layers.len() {
+            self.layers.resize_with(id + 1, || None);
+        }
+        self.layers[id] = Some(FilterLayerState::Ready(Arc::new(pixmap), placement));
+    }
+
+    pub(crate) fn set_unfiltered_fallback(&mut self, id: usize) {
         if id >= self.layers.len() {
             self.layers.resize_with(id + 1, || None);
         }
-        self.layers[id] = Some(Arc::new(pixmap));
+        self.layers[id] = Some(FilterLayerState::UnfilteredFallback);
     }

-    pub(crate) fn filter_layer(&self, id: usize) -> Option<Arc<Pixmap>> {
+    pub(crate) fn filter_layer(&self, id: usize) -> Option<FilterLayerState> {
         self.layers.get(id).and_then(Option::as_ref).cloned()
     }

+    /// Paint `background-clip: text` backgrounds on the inline root and on any
+    /// inline descendant spans by drawing the background into an isolated layer
+    /// and masking it with opaque glyph silhouettes via `Compose::DestIn`.
+    fn draw_text_clipped_backgrounds(
+        &self,
+        scene: &mut impl PaintScene,
+        layout: &parley::layout::Layout<TextBrush>,
+        text_layout: &blitz_dom::node::TextLayout,
+        text_transform: Affine,
+        inline_root_id: NodeId,
+    ) {
+        const ALMOST_OPAQUE: f32 = 1.0 - f32::EPSILON;
+
+        if self.has_text_clipped_background() {
+            let clip_path = self.frame.border_box_path();
+            scene.push_layer(
+                Fill::NonZero,
+                Mix::Normal,
+                ALMOST_OPAQUE,
+                self.transform,
+                &clip_path,
+                None,
+                None,
+            );
+            self.draw_text_clipped_background(scene);
+            scene.push_layer(
+                Fill::NonZero,
+                BlendMode::new(Mix::Normal, Compose::DestIn),
+                1.0,
+                self.transform,
+                &clip_path,
+                None,
+                None,
+            );
+            let mut draw_text_context = self.context.draw_text_context.borrow_mut();
+            crate::text::stroke_text_filtered(
+                scene,
+                layout.lines(),
+                self.context.dom,
+                text_transform,
+                self.scale,
+                inline_root_id,
+                text_layout.line_node_offsets(),
+                &mut draw_text_context,
+                Some(Color::BLACK),
+                None,
+                None,
+            );
+            drop(draw_text_context);
+            scene.pop_layer();
+            scene.pop_layer();
+        }
+
+        // Collect unique inline descendant nodes whose style has `background-clip: text`.
+        let mut span_ids: Vec<NodeId> = Vec::new();
+        for style in layout.styles() {
+            let mut walk = Some(style.brush.id);
+            while let Some(id) = walk {
+                if id == inline_root_id {
+                    break;
+                }
+                if !span_ids.contains(&id) {
+                    if let Some(node) = self.context.dom.get_node(id) {
+                        if node
+                            .primary_styles()
+                            .is_some_and(|s| background::style_has_text_clipped_background(&s))
+                        {
+                            span_ids.push(id);
+                        }
+                    }
+                }
+                walk = self.context.dom.get_node(id).and_then(|n| n.parent_id());
+            }
+        }
+
+        for span_id in span_ids {
+            let Some(span_node) = self.context.dom.get_node(span_id) else {
+                continue;
+            };
+            let Some(span_element) = span_node.element_data() else {
+                continue;
+            };
+            let Some(span_style) = span_node.primary_styles() else {
+                continue;
+            };
+            let Some(span_rect) = span_glyph_bounds(
+                self.context.dom,
+                layout,
+                text_layout.line_node_offsets(),
+                inline_root_id,
+                span_id,
+            ) else {
+                continue;
+            };
+            let local_rect = Rect::new(0.0, 0.0, span_rect.width(), span_rect.height());
+            let span_frame = CssBox::new(
+                local_rect,
+                Insets::ZERO,
+                Insets::ZERO,
+                0.0,
+                NonUniformRoundedRectRadii::default(),
+            );
+            let span_transform =
+                text_transform * Affine::translate((span_rect.x0, span_rect.y0));
+            let span_cx = ElementCx {
+                context: self.context,
+                frame: span_frame,
+                style: (*span_style).clone(),
+                scale: self.scale,
+                node: span_node,
+                element: span_element,
+                transform: span_transform,
+                #[cfg(feature = "svg")]
+                svg: None,
+                text_input: None,
+                list_item: None,
+                devtools: self.devtools,
+                custom_widget_scene: None,
+            };
+            let clip_path = span_cx.frame.border_box_path();
+            scene.push_layer(
+                Fill::NonZero,
+                Mix::Normal,
+                ALMOST_OPAQUE,
+                span_transform,
+                &clip_path,
+                None,
+                None,
+            );
+            span_cx.draw_text_clipped_background(scene);
+            scene.push_layer(
+                Fill::NonZero,
+                BlendMode::new(Mix::Normal, Compose::DestIn),
+                1.0,
+                span_transform,
+                &clip_path,
+                None,
+                None,
+            );
+            let mut draw_text_context = self.context.draw_text_context.borrow_mut();
+            crate::text::stroke_text_filtered(
+                scene,
+                layout.lines(),
+                self.context.dom,
+                text_transform,
+                self.scale,
+                inline_root_id,
+                text_layout.line_node_offsets(),
+                &mut draw_text_context,
+                Some(Color::BLACK),
+                None,
+                Some(span_id),
+            );
+            drop(draw_text_context);
+            scene.pop_layer();
+            scene.pop_layer();
+        }
+    }

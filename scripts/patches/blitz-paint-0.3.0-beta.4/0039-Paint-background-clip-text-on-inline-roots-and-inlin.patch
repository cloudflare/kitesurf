+
+/// Union bounding rect (in scaled inline-layout coordinates) of all glyph runs
+/// belonging to `span_id` (or its descendants).
+fn span_glyph_bounds(
+    doc: &BaseDocument,
+    layout: &parley::layout::Layout<TextBrush>,
+    line_node_offsets: &[Vec<(NodeId, f32)>],
+    inline_root_id: NodeId,
+    span_id: NodeId,
+) -> Option<Rect> {
+    use parley::PositionedLayoutItem;
+
+    let belongs = |mut id: NodeId| -> bool {
+        loop {
+            if id == span_id {
+                return true;
+            }
+            if id == inline_root_id {
+                return false;
+            }
+            let Some(parent) = doc.get_node(id).and_then(|n| n.parent_id()) else {
+                return false;
+            };
+            id = parent;
+        }
+    };
+
+    let mut bounds: Option<Rect> = None;
+    for (line_index, line) in layout.lines().enumerate() {
+        let line_offsets = line_node_offsets
+            .get(line_index)
+            .map(Vec::as_slice)
+            .unwrap_or(&[]);
+        for item in line.items() {
+            let PositionedLayoutItem::GlyphRun(glyph_run) = item else {
+                continue;
+            };
+            let run_node = glyph_run.style().brush.id;
+            if !belongs(run_node) {
+                continue;
+            }
+            let shift = line_offsets
+                .iter()
+                .find(|(id, _)| *id == run_node)
+                .map(|(_, offset)| *offset as f64)
+                .unwrap_or(0.0);
+            let metrics = glyph_run.run().font_metrics();
+            let baseline = glyph_run.baseline() as f64;
+            let x0 = glyph_run.offset() as f64 + shift;
+            let x1 = x0 + glyph_run.advance() as f64;
+            let y0 = baseline - metrics.ascent as f64;
+            let y1 = baseline + metrics.descent as f64;
+            let run_rect = Rect::new(x0, y0, x1, y1);
+            bounds = Some(match bounds {
+                Some(acc) => acc.union(run_rect),
+                None => run_rect,
+            });
+        }
+    }
+    bounds.filter(|r| r.width() > 0.0 && r.height() > 0.0)
+}

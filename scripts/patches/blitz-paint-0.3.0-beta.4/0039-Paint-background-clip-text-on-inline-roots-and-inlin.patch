+/// Whether a style has any background color or non-`none` background image
+/// layer clipped to `text`.
+/// https://drafts.csswg.org/css-backgrounds-4/#valdef-background-clip-text
+pub(super) fn style_has_text_clipped_background(
+    style: &style::properties::ComputedValues,
+) -> bool {
+    let bg_styles = style.get_background();
+    let layer_count = bg_styles.background_image.0.len();
+    if layer_count == 0 {
+        return false;
+    }
+    let last_clip = *get_cyclic(&bg_styles.background_clip.0, layer_count - 1);
+    if last_clip == StyloBackgroundClip::Text {
+        let current_color = style.clone_color();
+        let bg_color = bg_styles
+            .background_color
+            .resolve_to_absolute(&current_color)
+            .as_srgb_color();
+        if bg_color != Color::TRANSPARENT {
+            return true;
+        }
+    }
+    (0..layer_count).any(|idx| {
+        *get_cyclic(&bg_styles.background_clip.0, idx) == StyloBackgroundClip::Text
+            && !matches!(bg_styles.background_image.0[idx], GenericImage::None)
+    })
+}
+
 impl ElementCx<'_, '_> {
+    pub(super) fn has_text_clipped_background(&self) -> bool {
+        style_has_text_clipped_background(&self.style)
+    }
+
+    /// Paint only the background layers whose `background-clip` is `text`
+    /// (called inside an isolation layer that is then masked with the glyphs
+    /// via `Compose::DestIn`).
+    pub(super) fn draw_text_clipped_background(&self, scene: &mut impl PaintScene) {
+        let bg_styles = &self.style.get_background();
+        let image_data = self.element.background_images();
+        let layer_count = bg_styles.background_image.0.len();
+        if layer_count == 0 {
+            return;
+        }
+
+        let last_clip = *get_cyclic(&bg_styles.background_clip.0, layer_count - 1);
+        if last_clip == StyloBackgroundClip::Text {
+            self.draw_solid_bg(scene, BoxModelBox::BorderBox);
+        }
+
+        for idx in (0..layer_count).rev() {
+            if *get_cyclic(&bg_styles.background_clip.0, idx) != StyloBackgroundClip::Text {
+                continue;
+            }
+            let layer = ImageLayerStyles::from_background(bg_styles, image_data, idx);
+            if layer_paints_nothing(&layer) {
+                continue;
+            }
+            self.draw_image_layer(scene, &layer);
+        }
+    }

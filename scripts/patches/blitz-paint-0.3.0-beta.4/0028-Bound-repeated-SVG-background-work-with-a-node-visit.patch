+/// leave the work unmetered.
+pub fn paint_scene_bounded(
+    scene: &mut impl PaintScene,
+    doc: &mut BaseDocument,
+    scale: f64,
+    width: u32,
+    height: u32,
+    x_offset: u32,
+    y_offset: u32,
+) {
+    paint_document(
+        scene,
+        doc,
+        scale,
+        width,
+        height,
+        x_offset,
+        y_offset,
+        Some(PAINT_WORK_BUDGET),
+    );
+}

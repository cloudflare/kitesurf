From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bernardo Pereira <bpereira@cloudflare.com>
Date: Mon, 23 Nov 2026 15:02:55 +0000
Subject: [PATCH] Resolve drop-shadow filter currentColor from element style
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Pass the element's computed color to `convert_filters` so `filter: drop-shadow(...)`
without an explicit color uses `currentColor` per CSS Filter Effects 1 §9.
---
 src/filters.rs | 19 ++++++++++++++-----
 src/render.rs  |  6 ++++--
 2 files changed, 18 insertions(+), 7 deletions(-)

diff --git a/src/filters.rs b/src/filters.rs
index d7389f0..a066e13 100644
--- a/src/filters.rs
+++ b/src/filters.rs
@@ -4,17 +4,25 @@ pub(crate) use style::computed_values::filter::single_value::T as StyloFilter;

 use anyrender::filters::{Filter, FilterEffect};

-pub(crate) fn convert_filters(filters: &[StyloFilter]) -> Option<Filter> {
+pub(crate) fn convert_filters(
+    filters: &[StyloFilter],
+    current_color: &AbsoluteColor,
+) -> Option<Filter> {
     if filters.is_empty() {
         return None;
     }

     Some(Filter::linear_list(
-        filters.iter().filter_map(convert_single_filter),
+        filters
+            .iter()
+            .filter_map(|f| convert_single_filter(f, current_color)),
     ))
 }

-pub(crate) fn convert_single_filter(filter: &StyloFilter) -> Option<FilterEffect> {
+pub(crate) fn convert_single_filter(
+    filter: &StyloFilter,
+    current_color: &AbsoluteColor,
+) -> Option<FilterEffect> {
     Some(match filter {
         StyloFilter::Blur(radius) => FilterEffect::blur(radius.px()),
         StyloFilter::Brightness(amount) => FilterEffect::brightness(amount.0),
@@ -25,14 +33,15 @@ pub(crate) fn convert_single_filter(filter: &StyloFilter) -> Option<FilterEffect
         StyloFilter::Opacity(amount) => FilterEffect::opacity(amount.0),
         StyloFilter::Saturate(amount) => FilterEffect::saturate(amount.0),
         StyloFilter::Sepia(amount) => FilterEffect::sepia(amount.0),
+        // CSS Filter Effects 1 §9: omitted drop-shadow color defaults to currentColor.
+        // https://drafts.fxtf.org/filter-effects/#funcdef-filter-drop-shadow
         StyloFilter::DropShadow(shadow) => FilterEffect::drop_shadow(
             shadow.horizontal.px(),
             shadow.vertical.px(),
             shadow.blur.px(),
-            // TODO: pass in correct currentColor
             shadow
                 .color
-                .resolve_to_absolute(&AbsoluteColor::BLACK)
+                .resolve_to_absolute(current_color)
                 .as_color_color(),
         ),
         StyloFilter::Url(_) => return None,
diff --git a/src/render.rs b/src/render.rs
index 99a6a39..cd13110 100644
--- a/src/render.rs
+++ b/src/render.rs
@@ -622,8 +622,10 @@ impl<'dom, 'a> BlitzDomPainter<'dom, 'a> {
                 // Save it so that the mask can be drawn untransformed by scroll offsets.
                 let unscrolled_transform = cx.transform;

-                let filter = convert_filters(&effects.filter.0).map(Arc::new);
-                let backdrop_filter = convert_filters(&effects.backdrop_filter.0).map(Arc::new);
+                let current_color = styles.clone_color();
+                let filter = convert_filters(&effects.filter.0, &current_color).map(Arc::new);
+                let backdrop_filter =
+                    convert_filters(&effects.backdrop_filter.0, &current_color).map(Arc::new);

                 // Adjust effect layer clip by filter expansion area
                 //

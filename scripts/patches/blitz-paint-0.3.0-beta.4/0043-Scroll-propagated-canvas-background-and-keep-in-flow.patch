From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Tue, 24 Nov 2026 21:52:23 +0000
Subject: [PATCH] Scroll propagated canvas background and keep in-flow paint
 under root filter

---
 src/render.rs            | 95 ++++++++++++++++++++++++++--------------
 src/render/background.rs | 37 +++++++++++++---
 src/text.rs              |  4 +-
 3 files changed, 94 insertions(+), 42 deletions(-)

diff --git a/src/render.rs b/src/render.rs
index dd415bf..21e85ec 100644
--- a/src/render.rs
+++ b/src/render.rs
@@ -254,8 +254,24 @@ impl<'dom, 'a> BlitzDomPainter<'dom, 'a> {
             return;
         };
         let root_id = root_element.id();
-        let bg_width = (self.width as f32).max(root_element.final_layout().size.width);
-        let bg_height = (self.height as f32).max(root_element.final_layout().size.height);
+        let root_overflow = root_element.scrollable_overflow();
+        // CSS Backgrounds 3 §2.11.1: size and position propagated canvas
+        // backgrounds against the root element's box (not document overflow),
+        // and widen only the painting area to cover overflow and scroll.
+        let viewport_css_w = (self.width as f64 / self.scale.max(1e-6)) as f32;
+        let viewport_css_h = (self.height as f64 / self.scale.max(1e-6)) as f32;
+        let pos_width = viewport_css_w.max(root_element.final_layout().size.width);
+        let pos_height = viewport_css_h.max(root_element.final_layout().size.height);
+        let paint_width = pos_width
+            .max(root_overflow.x1 as f32)
+            .max(viewport_scroll.x as f32 + viewport_css_w);
+        let paint_height = pos_height
+            .max(root_overflow.y1 as f32)
+            .max(viewport_scroll.y as f32 + viewport_css_h);
+        let root_filter = root_element.primary_styles().and_then(|style| {
+            let current_color = style.clone_color();
+            convert_filters(&style.get_effects().filter.0, &current_color).map(Arc::new)
+        });

         // CSS Backgrounds 3 section 2.11.1 canvas-background propagation. Pick
         // the element whose complete background paints over the canvas, then
@@ -285,26 +301,46 @@ impl<'dom, 'a> BlitzDomPainter<'dom, 'a> {
             }
         };

+        let root_transform = Affine::translate(Vec2 {
+            x: self.initial_x - (viewport_scroll.x * self.scale),
+            y: self.initial_y - (viewport_scroll.y * self.scale),
+        });
         self.canvas_bg_source_id.set(propagation_source.map(|s| s.id()));
         if let Some(source) = propagation_source {
             let canvas_layout = taffy::Layout {
                 location: taffy::Point { x: 0.0, y: 0.0 },
                 size: taffy::Size {
-                    width: bg_width,
-                    height: bg_height,
+                    width: pos_width,
+                    height: pos_height,
                 },
                 ..root_element.final_layout()
             };
-            let canvas_cx = self.element_cx(
-                source,
-                canvas_layout,
-                Affine::translate(Vec2 {
-                    x: self.initial_x,
-                    y: self.initial_y,
-                }),
-                None,
+            let canvas_paint_rect = Rect::new(
+                0.0,
+                0.0,
+                paint_width as f64 * self.scale,
+                paint_height as f64 * self.scale,
             );
-            canvas_cx.draw_background(scene);
+            let mut canvas_cx = self.element_cx(source, canvas_layout, root_transform, None);
+            canvas_cx.canvas_paint_rect = Some(canvas_paint_rect);
+            // Apply the root element's CSS filter (e.g. `html { filter: invert(1) }`)
+            // to the propagated canvas background as well so it stays consistent with
+            // filtered root descendants across the full viewport.
+            if let Some(filter) = root_filter {
+                scene.push_layer(
+                    Fill::NonZero,
+                    BlendMode::default(),
+                    1.0,
+                    root_transform,
+                    &canvas_paint_rect,
+                    Some(filter),
+                    None,
+                );
+                canvas_cx.draw_background(scene);
+                scene.pop_layer();
+            } else {
+                canvas_cx.draw_background(scene);
+            }
         }

         // The root clip rectangle is the viewport (in screen coordinates, with the
@@ -312,15 +348,7 @@ impl<'dom, 'a> BlitzDomPainter<'dom, 'a> {
         // scrollports narrow this rectangle further for their descendants.
         let viewport_clip_rect = Rect::new(0.0, 0.0, self.width as f64, self.height as f64);

-        self.render_element(
-            scene,
-            root_id,
-            Affine::translate(Vec2 {
-                x: self.initial_x - (viewport_scroll.x * self.scale),
-                y: self.initial_y - (viewport_scroll.y * self.scale),
-            }),
-            viewport_clip_rect,
-        );
+        self.render_element(scene, root_id, root_transform, viewport_clip_rect);

         // Render debug overlay
         if self.dom.devtools().highlight_hover {
@@ -873,6 +901,7 @@ impl<'dom, 'a> BlitzDomPainter<'dom, 'a> {
             list_item: element.list_item_data(),
             devtools: self.dom.devtools(),
             custom_widget_scene,
+            canvas_paint_rect: None,
         }
     }
 }
@@ -930,6 +959,9 @@ struct ElementCx<'dom, 'a> {
     devtools: &'dom DevtoolSettings,
     #[cfg_attr(not(feature = "custom-widget"), expect(unused))]
     custom_widget_scene: Option<&'a Scene>,
+    /// Expanded painting area for propagated canvas backgrounds; keeps the
+    /// element's own `frame` as the positioning area.
+    canvas_paint_rect: Option<Rect>,
 }

 /// Converts parley BoundingBox into peniko Rect
@@ -1198,7 +1230,7 @@ impl ElementCx<'_, '_> {
                 text_transform,
                 self.scale,
                 inline_root_id,

                 Some(Color::BLACK),
                 None,
@@ -1244,7 +1276,7 @@ impl ElementCx<'_, '_> {
             let Some(span_rect) = span_glyph_bounds(
                 self.context.dom,
                 layout,
-                text_layout.line_node_offsets(),

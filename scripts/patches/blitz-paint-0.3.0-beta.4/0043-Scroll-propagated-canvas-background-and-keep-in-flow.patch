                 inline_root_id,
                 span_id,
             ) else {
@@ -1274,6 +1306,7 @@ impl ElementCx<'_, '_> {
                 list_item: None,
                 devtools: self.devtools,
                 custom_widget_scene: None,
+                canvas_paint_rect: None,
             };
             let clip_path = span_cx.frame.border_box_path();
             scene.push_layer(
@@ -1303,7 +1336,7 @@ impl ElementCx<'_, '_> {
                 text_transform,
                 self.scale,
                 inline_root_id,
-                text_layout.line_node_offsets(),
+                text_layout.line_item_offsets(),
                 &mut draw_text_context,
                 Some(Color::BLACK),
                 None,
@@ -1952,7 +1985,7 @@ fn create_css_rect(style: &ComputedValues, layout: &Layout, scale: f64) -> CssBo
 fn span_glyph_bounds(
     doc: &BaseDocument,

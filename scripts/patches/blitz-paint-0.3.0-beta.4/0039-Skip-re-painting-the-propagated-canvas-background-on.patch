From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bernardo Pereira <bpereira@cloudflare.com>
Date: Mon, 23 Nov 2026 13:50:50 +0000
Subject: [PATCH] Skip re-painting the propagated canvas background on root or
 body
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

When `paint_scene` propagated `<body>`'s (or `<html>`'s) background to the
canvas, `render_element` still painted that element's background a second time
in normal flow, covering any `z-index: -1` children hoisted into the root
stacking context.

Record `canvas_bg_source_id` during canvas propagation and skip
`draw_background` for that element per CSS Backgrounds 3 §2.11.2.
---
 src/render.rs | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/src/render.rs b/src/render.rs
index 11cddc8..7c664ed 100644
--- a/src/render.rs
+++ b/src/render.rs
@@ -129,6 +129,10 @@ pub struct BlitzDomPainter<'dom, 'a> {
     pub(crate) initial_y: f64,
     /// The id of the document's root element (cached to avoid re-resolving it for every element)
     pub(crate) root_element_id: Option<NodeId>,
+    /// The element (`<html>` or `<body>`) whose background was propagated to the
+    /// canvas; skipped during normal element paint so it does not cover negative
+    /// `z-index` children hoisted into the root stacking context.
+    pub(crate) canvas_bg_source_id: Cell<Option<NodeId>>,
     /// Scrollbar hover/drag state, resolved once per scene like the root element
     #[cfg(feature = "scrollbars")]
     pub(crate) hovered_scrollbar: Option<blitz_dom::node::ScrollbarRef>,
@@ -175,6 +179,7 @@ impl<'dom, 'a> BlitzDomPainter<'dom, 'a> {
             initial_x,
             initial_y,
             root_element_id,
+            canvas_bg_source_id: Cell::new(None),
             #[cfg(feature = "scrollbars")]
             hovered_scrollbar: dom.hovered_scrollbar(),
             #[cfg(feature = "scrollbars")]
@@ -280,6 +285,7 @@ impl<'dom, 'a> BlitzDomPainter<'dom, 'a> {
             }
         };

+        self.canvas_bg_source_id.set(propagation_source.map(|s| s.id()));
         if let Some(source) = propagation_source {
             let canvas_layout = taffy::Layout {
                 location: taffy::Point { x: 0.0, y: 0.0 },
@@ -674,8 +680,14 @@ impl<'dom, 'a> BlitzDomPainter<'dom, 'a> {
                     backdrop_filter,
                     |scene| {
                         let part_id = node_id.as_u64();
+                        // CSS Backgrounds 3 §2.11.2: once the root or body background has
+                        // been propagated to the canvas, its used background is transparent
+                        // so it does not overpaint negative `z-index` stacking children.
+                        // https://drafts.csswg.org/css-backgrounds-3/#body-background
                         scene.begin_part(part_id, ScenePart::Background);
-                        cx.draw_background(scene);
+                        if self.canvas_bg_source_id.get() != Some(node_id) {
+                            cx.draw_background(scene);
+                        }
                         scene.end_part();
                         cx.draw_inset_box_shadow(scene);
                         scene.begin_part(part_id, ScenePart::TableRowBackground);

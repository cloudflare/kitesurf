From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Thu, 23 Jul 2026 22:19:20 +0100
Subject: [PATCH] Only shrink natural-size replaced content into the available
 width
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

replaced_measure_function folded the available space into max-size on
both axes, which acted as an implicit max-width:100% and
max-height:100% on every replaced element. Real browsers do neither:
CSS2 §10.3.4 sizes replaced boxes from their style, attributes and
natural dimensions and lets them overflow, and page CSS opts into
shrinking with max-width:100%.

The block-axis fold broke the padding-bottom aspect-ratio hack: under a
height:0 ancestor the block-axis available space is Definite(0), the
element got max-height 0, and the aspect-ratio clamp then dragged the
width to 0 too. A width:100% img inside such a container laid out as
0x0 where every browser renders it at container-width x ratio. Drop
it.

The inline-axis fold is a leniency photo-heavy layouts depend on, so it
stays, but only for natural-size content. It no longer applies when
style or a width attribute sets the width, when an explicit height and
an intrinsic ratio derive one, or to a canvas, whose natural size is
its bitmap size and is set by the author. An 8000px svg clamped into
its container also contributed nothing to body scrollWidth and
scrollHeight, so scrollTo and scrollIntoView pinned at 0 (WPT
scrollIntoView-svg-shape), and a <canvas width=400> in a 200px box
laid out at 200x150 where Chrome and Firefox overflow at 400x300.
---
 src/layout/mod.rs      |  2 ++
 src/layout/replaced.rs | 28 ++++++++++++++++++++++++++++
 2 files changed, 30 insertions(+)

diff --git a/src/layout/mod.rs b/src/layout/mod.rs
index fa5bbc8..d1312b7 100644
--- a/src/layout/mod.rs
+++ b/src/layout/mod.rs
@@ -490,6 +490,8 @@ impl LayoutPassState<'_> {
                     let replaced_context = ReplacedContext {
                         intrinsic_sizes,
                         default_object_size,
+                        natural_size_is_authored: *element_data.name.local
+                            == local_name!("canvas"),
                     };

                     let mut style = node.layout_style();
diff --git a/src/layout/replaced.rs b/src/layout/replaced.rs
index ce8b2b1..01afd24 100644
--- a/src/layout/replaced.rs
+++ b/src/layout/replaced.rs
@@ -35,6 +35,9 @@ pub struct ReplacedContext {
     /// used to fill in dimensions the intrinsic sizes leave unresolved. 300x150
     /// for most replaced elements; zero for an image with no loaded resource.
     pub default_object_size: taffy::Size<f32>,
+    /// A canvas's natural size is its bitmap size, which the author sets; unlike an
+    /// image's, it must overflow a narrower container rather than shrink into it.
+    pub natural_size_is_authored: bool,
 }

 /// Whether a height/width value is violating it's min- and max- constraints
@@ -250,8 +253,33 @@ pub fn compute_replaced_layout(
         .min_size()
         .maybe_resolve(parent_size, &resolve_calc_value)
         .maybe_sub(box_sizing_adjustment);
+    // Fold available space into max-size on the inline axis only: the
+    // both-axes form collapsed padding-bottom aspect-ratio hacks to 0x0.
+
+    // And only for natural-size-only content: explicit sizing (style or
+    // width/height attr) must overflow a too-narrow container, CSS2
+    // §10.3.4 has no implicit max-width:100%. The shrink-into-container
+    // leniency is pristine-blitz behavior photo-heavy layouts depend on.
+
+    // An explicit height counts too when a ratio can derive the width from
+    // it: that width is just as author-specified as a literal one.
+    // Width/height attributes are already presentational hints in style_size.
+    let explicit_height = style_size.height.is_some();
+    let explicit_width = style_size.width.is_some()
+        || (explicit_height && aspect_ratio.is_some())
+        || context.natural_size_is_authored;
+    let avail_max = Size {
+        width: if explicit_width {
+            None
+        } else {
+            available_space.into_options().width
+        },
+        height: None,
+    };
     let max_size = style
         .max_size()
         .maybe_resolve(basis_for_max_and_preferred, &resolve_calc_value)
+        .or(avail_max)
+        .maybe_min(avail_max)
         .maybe_max(min_size)
         .maybe_sub(box_sizing_adjustment);

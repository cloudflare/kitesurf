+        if !node.is_non_atomic_inline() {
+            continue;
         }
+        let (ml, mr) = resolve_inline_horizontal_margins(node, basis, scale);
+        if ml != 0.0 {
+            *starts.entry(first_pos).or_insert(0.0) += ml;
+        }
+        if mr != 0.0 {
+            *ends.entry(last_pos).or_insert(0.0) += mr;
+        }
+    }
+
+    if starts.is_empty() && ends.is_empty() {
+        return Vec::new();
     }
+
+    let mut any_nonzero = false;
+    let result: Vec<Vec<f32>> = layout
+        .lines()
+        .enumerate()
+        .map(|(line_index, line)| {
+            let mut shift = 0.0f32;
+            let mut line_offsets = Vec::new();
+            for (item_index, _item) in line.items().enumerate() {
+                if let Some(&delta) = starts.get(&(line_index, item_index)) {
+                    shift += delta;
+                }
+                if shift != 0.0 {
+                    any_nonzero = true;
+                }
+                line_offsets.push(shift);
+                if let Some(&delta) = ends.get(&(line_index, item_index)) {
+                    shift += delta;
+                }
+            }
+            line_offsets
+        })
+        .collect();
+    if any_nonzero { result } else { Vec::new() }
+}
+
+fn resolve_inline_horizontal_margins(node: &crate::Node, basis: f32, scale: f32) -> (f32, f32) {
+    let Some(styles) = node.primary_styles() else {
+        return (0.0, 0.0);
+    };
+    let margin = styles.clone_margin();
+    let resolve = |value: &style::values::generics::length::GenericMargin<
+        style::values::computed::LengthPercentage,
+    >| match value {
+        style::values::generics::length::GenericMargin::LengthPercentage(lp) => {
+            lp.resolve(style::values::computed::CSSPixelLength::new(basis))
+                .px()
+                * scale
+        }
+        _ => 0.0,
+    };
+    (resolve(&margin.margin_left), resolve(&margin.margin_right))
 }

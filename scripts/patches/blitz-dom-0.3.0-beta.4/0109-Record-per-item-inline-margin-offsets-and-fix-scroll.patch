+/// Find the horizontal inline-margin shift (in scaled px) of the item covering
+/// or nearest to `(px, py)` so `Cluster::from_point` resolves in Parley space.
+fn inline_margin_shift_at_point(
+    layout: &parley::layout::Layout<crate::node::TextBrush>,
+    line_item_offsets: &[Vec<f32>],
+    px: f32,
+    py: f32,
+) -> f32 {
+    if line_item_offsets.is_empty() {
+        return 0.0;
+    }
+    let mut best_line: Option<usize> = None;
+    let mut best_line_dist = f32::INFINITY;
+    for (line_index, line) in layout.lines().enumerate() {
+        let m = line.metrics();
+        let dist = if py < m.block_min_coord {
+            m.block_min_coord - py
+        } else if py >= m.block_max_coord {
+            py - m.block_max_coord
+        } else {
+            0.0
+        };
+        if dist < best_line_dist {
+            best_line_dist = dist;
+            best_line = Some(line_index);
+            if dist == 0.0 {
+                break;
+            }
+        }
+    }
+    let Some(line_index) = best_line else {
+        return 0.0;
+    };
+    let Some(line) = layout.lines().nth(line_index) else {
+        return 0.0;
+    };
+    let offsets = line_item_offsets
+        .get(line_index)
+        .map(Vec::as_slice)
+        .unwrap_or(&[]);
+    let mut best_shift = 0.0f32;
+    let mut best_x_dist = f32::INFINITY;
+    for (item_index, item) in line.items().enumerate() {
+        let parley::PositionedLayoutItem::GlyphRun(run) = item else {
+            continue;
+        };
+        let shift = offsets.get(item_index).copied().unwrap_or(0.0);
+        let x0 = run.offset() + shift;
+        let x1 = x0 + run.advance();
+        let dist = if px < x0 {
+            x0 - px
+        } else if px > x1 {
+            px - x1
+        } else {
+            return shift;
+        };
+        if dist < best_x_dist {
+            best_x_dist = dist;
+            best_shift = shift;
+        }
+    }
+    best_shift
+}

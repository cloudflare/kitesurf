+/// The horizontal-margin spacers pushed while building one inline root.
+struct MarginSpacers {
+    next_id: u64,
+    spacers: Vec<InlineMarginSpacer>,
+}
+
+impl MarginSpacers {
+    fn new() -> Self {
+        Self {
+            next_id: MARGIN_SPACER_ID_BASE,
+            spacers: Vec::new(),
+        }
+    }
+
+    /// Push a zero-height inline box carrying one horizontal margin, outside
+    /// the element's style span so the margin stays outside its background and
+    /// border box. Parley sizes the box during inline layout.
+    fn push(
+        &mut self,
+        builder: &mut TreeBuilder<TextBrush>,
+        node_id: NodeId,
+        side: InlineMarginSide,
+    ) {
+        let id = self.next_id;
+        self.next_id += 1;
+        builder.push_inline_box(InlineBox {
+            id,
+            kind: InlineBoxKind::InFlow,
+            index: 0,
+            width: 0.0,
+            height: 0.0,
+            baseline: None,
+            vertical_align: Default::default(),
+        });
+        self.spacers.push(InlineMarginSpacer { id, node_id, side });
+    }
+}
+
+/// Whether a non-replaced inline box's margin on `side` can shift its line.
+/// `auto` margins are zero on inline boxes (CSS2 §10.3.1); a percentage is
+/// resolved during inline layout against the root's content width.
+fn inline_margin_needs_spacer(
+    style: Option<&style::servo_arc::Arc<style::properties::ComputedValues>>,
+    side: InlineMarginSide,
+) -> bool {
+    let Some(style) = style else {
+        return false;
+    };
+    let margin = style.clone_margin();
+    let value = match side {
+        InlineMarginSide::Start => &margin.margin_left,
+        InlineMarginSide::End => &margin.margin_right,
+    };
+    match value {
+        GenericMargin::LengthPercentage(lp) => {
+            lp.has_percentage() || lp.resolve(CSSPixelLength::new(0.0)).px() != 0.0
+        }
+        _ => false,
+    }
+}

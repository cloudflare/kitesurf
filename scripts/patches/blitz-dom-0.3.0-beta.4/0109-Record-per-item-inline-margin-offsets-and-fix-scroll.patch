+/// Per line and positioned item index (`line.items()`), the inline-start offset
+/// in scaled px contributed by horizontal margins of non-replaced inline boxes.
+/// Start margin applies only before a box's first fragment across the layout,
+/// and end margin only after its last fragment. Runs in O(items + distinct nodes)
+/// and returns an empty Vec when no non-zero shift occurs.
+/// https://drafts.csswg.org/css2/#inline-box-dimensions
+pub(crate) fn compute_inline_margin_offsets(
+    nodes: &crate::NodeTree,
+    root_id: NodeId,
+    basis_override: Option<f32>,
+    layout: &parley::layout::Layout<crate::node::TextBrush>,
+) -> Vec<Vec<f32>> {
+    use parley::PositionedLayoutItem;
+    use std::collections::HashMap;
+
+    let scale = layout.scale() as f32;
+    let basis = basis_override.unwrap_or_else(|| {
+        nodes
+            .get(root_id)
+            .map(|root| root.final_layout().content_box_width())
+            .unwrap_or(0.0)
+    });
+
+    // Pass 1 (O(items)): record (first_pos, last_pos) per distinct item node.
+    let mut item_spans: HashMap<NodeId, ((usize, usize), (usize, usize))> = HashMap::new();
+    for (line_index, line) in layout.lines().enumerate() {
+        for (item_index, item) in line.items().enumerate() {
+            let item_node = match &item {
+                PositionedLayoutItem::GlyphRun(run) => run.style().brush.id,
+                PositionedLayoutItem::InlineBox(ibox) => NodeId::from_u64(ibox.id),
+            };
+            let pos = (line_index, item_index);
+            item_spans
+                .entry(item_node)
+                .and_modify(|span| span.1 = pos)
+                .or_insert((pos, pos));
+        }
     }


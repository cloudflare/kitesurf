+/// Resolve one horizontal margin of a non-replaced inline box to scaled px.
+/// `basis` is the inline root's content-box width in CSS px.
+fn resolve_inline_margin_width(
+    node: &crate::Node,
+    side: InlineMarginSide,
+    basis: f32,
+    scale: f32,
+) -> f32 {
+    let Some(styles) = node.primary_styles() else {
+        return 0.0;
+    };
+    let margin = styles.clone_margin();
+    let value = match side {
+        InlineMarginSide::Start => &margin.margin_left,
+        InlineMarginSide::End => &margin.margin_right,
+    };
+    match value {
+        style::values::generics::length::GenericMargin::LengthPercentage(lp) => {
+            lp.resolve(CSSPixelLength::new(basis)).px() * scale
+        }
+        _ => 0.0,
+    }
+}

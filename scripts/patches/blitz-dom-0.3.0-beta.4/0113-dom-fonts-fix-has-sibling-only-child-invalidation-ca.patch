-fn push_non_ws_chars(out: &mut Vec<char>, seen: &mut HashSet<char>, text: &str) {
+fn pe_content_string(computed: &ComputedValues) -> Option<String> {
+    let Content::Items(item_data) = &computed.get_counters().content else {
+        return None;
+    };
+    let items = &item_data.items[0..item_data.alt_start];
+    let mut text = String::new();
+    for item in items {
+        if let ContentItem::String(owned_str) = item {
+            text.push_str(owned_str);
+        }
+    }
+    (!text.is_empty()).then_some(text)
+}
+
+fn has_non_ws_char(text: &str) -> bool {
+    text.chars().any(|ch| !ch.is_ascii_whitespace())
+}
+
+fn push_non_ws_set(out: &mut HashSet<char>, text: &str) {
     for ch in text.chars() {
-        if !ch.is_ascii_whitespace() && seen.insert(ch) {
-            out.push(ch);
+        if !ch.is_ascii_whitespace() {
+            out.insert(ch);
+        }
+    }
+}
+
+enum FontPlanStep {
+    MarkUsedAndContinue(String),
+    MarkUsedAndStop(String),
+    MarkUsedAndCheckLoaded(String),
+    CheckLoaded(String),
+}
+
+struct FontPlan {
+    req_italic: bool,
+    req_weight: u16,
+    steps: Vec<FontPlanStep>,
+    needs_glyph_check: bool,
+    saw_text: bool,
+    chars: HashSet<char>,
+}
+
+fn build_font_plan(
+    font: &Font,
+    pending_by_family: &HashMap<&str, Vec<(bool, (u16, u16), bool)>>,
+    declared_font_faces: &HashMap<String, Vec<DeclaredFontFace>>,
+    atom_lc: &mut HashMap<Atom, String>,
+) -> Option<FontPlan> {
+    let touches_pending = font.font_family.families.iter().any(|family| {
+        if let SingleFontFamily::FamilyName(name) = family {
+            let lc = atom_lc
+                .entry(name.name.clone())
+                .or_insert_with(|| name.name.to_string().to_lowercase());
+            pending_by_family.contains_key(lc.as_str())
+        } else {
+            false
+        }
+    });
+    if !touches_pending {
+        return None;
+    }
+
+    let req_weight = font.font_weight.value().round().clamp(1.0, 1000.0) as u16;
+    let req_italic = !matches!(
+        stylo_to_parley::font_style(font.font_style),
+        ParleyFontStyle::Normal
+    );
+    let want_fq_style = if req_italic {
+        FontiqueStyle::Italic
+    } else {
+        FontiqueStyle::Normal
+    };
+
+    let mut steps: Vec<FontPlanStep> = Vec::new();
+    for family in font.font_family.families.iter() {
+        let SingleFontFamily::FamilyName(name) = family else {
+            continue;
+        };
+        let fam_lc = atom_lc
+            .entry(name.name.clone())
+            .or_insert_with(|| name.name.to_string().to_lowercase())
+            .as_str();
+        if let Some(declared) = declared_font_faces.get(fam_lc) {
+            let has_selected_plain = declared.iter().any(|d| {
+                !d.has_unicode_range
+                    && face_matches_css_selection(
+                        declared,
+                        req_italic,
+                        req_weight,
+                        d.italic,
+                        d.weight_range,
+                    )
+            });
+            let has_selected_range = declared.iter().any(|d| {
+                d.has_unicode_range
+                    && face_matches_css_selection(
+                        declared,
+                        req_italic,
+                        req_weight,
+                        d.italic,
+                        d.weight_range,
+                    )
+            });
+            if !has_selected_plain && has_selected_range {
+                steps.push(FontPlanStep::MarkUsedAndContinue(fam_lc.to_string()));
+                continue;
+            }
+            let has_pending_plain = pending_by_family.get(fam_lc).is_some_and(|faces| {
+                faces.iter().any(|&(face_italic, weight_range, has_range)| {
+                    !has_range
+                        && face_matches_css_selection(
+                            declared,
+                            req_italic,
+                            req_weight,
+                            face_italic,
+                            weight_range,
+                        )
+                })
+            });
+            if has_pending_plain || face_pending_for_style(fam_lc, want_fq_style) {
+                steps.push(FontPlanStep::MarkUsedAndStop(fam_lc.to_string()));
+                break;
+            }
+            steps.push(FontPlanStep::MarkUsedAndCheckLoaded(fam_lc.to_string()));
+        } else {
+            steps.push(FontPlanStep::CheckLoaded(fam_lc.to_string()));
+        }
+    }
+
+    while matches!(steps.last(), Some(FontPlanStep::CheckLoaded(_))) {
+        steps.pop();
+    }
+    if steps.is_empty() {
+        return None;
+    }
+
+    let last_idx = steps.len() - 1;
+    let needs_glyph_check = steps[..last_idx].iter().any(|step| {
+        matches!(
+            step,
+            FontPlanStep::MarkUsedAndCheckLoaded(_) | FontPlanStep::CheckLoaded(_)
+        )
+    });
+
+    Some(FontPlan {
+        req_italic,
+        req_weight,
+        steps,
+        needs_glyph_check,
+        saw_text: false,
+        chars: HashSet::new(),
+    })
+}
+
+fn record_used_request(
+    used: &mut HashMap<String, Vec<(bool, u16)>>,
+    fam_lc: &str,
+    req_italic: bool,
+    req_weight: u16,
+) {
+    let pair = (req_italic, req_weight);
+    if let Some(list) = used.get_mut(fam_lc) {
+        if !list.contains(&pair) {
+            list.push(pair);
         }
+    } else {
+        used.insert(fam_lc.to_string(), vec![pair]);
     }
 }


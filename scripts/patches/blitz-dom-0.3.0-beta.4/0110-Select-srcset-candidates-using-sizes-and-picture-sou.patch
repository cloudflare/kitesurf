+/// Parse a CSS length token used in `sizes` or width media queries (`px`, `vw`,
+/// `em`, `rem`, or a plain `0`) into CSS pixels.
+fn parse_css_length_px(token: &str, viewport_width: f32) -> Option<f32> {
+    let trimmed = token.trim();
+    if trimmed == "0" {
+        return Some(0.0);
+    }
+    if let Some(inner) = trimmed
+        .strip_prefix("calc(")
+        .and_then(|rest| rest.strip_suffix(')'))
+    {
+        return eval_simple_calc_px(inner, viewport_width);
+    }
+    let lower = trimmed.to_ascii_lowercase();
+    if let Some(num) = lower.strip_suffix("px") {
+        let value = num.trim().parse::<f32>().ok()?;
+        return value.is_finite().then_some(value);
+    }
+    if let Some(num) = lower.strip_suffix("vw") {
+        let value = num.trim().parse::<f32>().ok()?;
+        return value.is_finite().then_some(viewport_width * (value / 100.0));
+    }
+    if let Some(num) = lower
+        .strip_suffix("rem")
+        .or_else(|| lower.strip_suffix("em"))
+    {
+        let value = num.trim().parse::<f32>().ok()?;
+        return value.is_finite().then_some(value * 16.0);
+    }
+    None
+}
+
+/// Evaluate a single binary `+`/`-` `calc(...)` expression in `sizes`, such as
+/// `calc(100vw - 32px)`.
+fn eval_simple_calc_px(expr: &str, viewport_width: f32) -> Option<f32> {
+    if let Some((lhs, rhs)) = expr.split_once(" - ") {
+        let a = parse_css_length_px(lhs, viewport_width)?;
+        let b = parse_css_length_px(rhs, viewport_width)?;
+        return Some((a - b).max(0.0));
+    }
+    if let Some((lhs, rhs)) = expr.split_once(" + ") {
+        let a = parse_css_length_px(lhs, viewport_width)?;
+        let b = parse_css_length_px(rhs, viewport_width)?;
+        return Some((a + b).max(0.0));
+    }
+    parse_css_length_px(expr, viewport_width)
+}
+
+/// Evaluate a single parenthesized width media feature against `viewport_width`.
+/// Unrecognized features return `true` so unsupported queries do not hide valid sources.
+fn evaluate_media_feature(feature: &str, viewport_width: f32) -> bool {
+    let inner = feature.trim();
+    let inner = inner
+        .strip_prefix('(')
+        .and_then(|s| s.strip_suffix(')'))
+        .unwrap_or(inner)
+        .trim();
+    if let Some((name, value)) = inner.split_once(':') {
+        let name = name.trim().to_ascii_lowercase();
+        let Some(px) = parse_css_length_px(value, viewport_width) else {
+            return true;
+        };
+        return match name.as_str() {
+            "min-width" => viewport_width >= px,
+            "max-width" => viewport_width <= px,
+            "width" => (viewport_width - px).abs() < 0.5,
+            _ => true,
+        };
+    }
+    let lower = inner.to_ascii_lowercase();
+    if let Some(rhs) = lower.strip_prefix("width >=") {
+        return parse_css_length_px(rhs, viewport_width)
+            .is_none_or(|px| viewport_width >= px);
+    }
+    if let Some(rhs) = lower.strip_prefix("width <=") {
+        return parse_css_length_px(rhs, viewport_width)
+            .is_none_or(|px| viewport_width <= px);
+    }
+    true
+}
+
+/// Evaluate a `<source media="...">` or `sizes` media condition against `viewport_width`.
+/// https://html.spec.whatwg.org/multipage/images.html#sizes-attribute
+fn evaluate_media_condition(query: &str, viewport_width: f32) -> bool {
+    let trimmed = query.trim();
+    if trimmed.is_empty() {
+        return true;
+    }
+    // A comma-separated media query list matches if any query matches.
+    trimmed.split(',').any(|branch| {
+        let branch = branch.trim();
+        if branch.is_empty() {
+            return false;
+        }
+        let (negated, rest) = if let Some(after) = branch
+            .strip_prefix("not ")
+            .or_else(|| branch.strip_prefix("NOT "))
+        {
+            (true, after.trim())
+        } else {
+            (false, branch)
+        };
+        let mut matched = true;
+        for part in rest.split(" and ") {
+            let part = part.trim();
+            let lower = part.to_ascii_lowercase();
+            if lower == "all" || lower == "screen" || lower == "only screen" || lower.is_empty() {
+                continue;
+            }
+            if lower == "print" {
+                matched = false;
+                break;
+            }
+            if part.starts_with('(') && !evaluate_media_feature(part, viewport_width) {
+                matched = false;
+                break;
+            }
+        }
+        if negated { !matched } else { matched }
+    })
+}
+
+/// Parse an HTML `sizes` attribute into the effective source width in CSS pixels.
+/// Falls back to `viewport_width` (`100vw`) when empty or no entry parses.
+/// https://html.spec.whatwg.org/multipage/images.html#parsing-a-sizes-attribute
+fn parse_sizes_attribute(sizes: &str, viewport_width: f32) -> f32 {
+    for raw in sizes.split(',') {
+        let entry = raw.trim();
+        if entry.is_empty() {
+            continue;
+        }
+        // A media condition precedes the source-size value and ends with ')'.
+        // Take care not to split inside `calc(...)`.
+        let (condition, length_str) = if entry.starts_with('(')
+            || entry.to_ascii_lowercase().starts_with("not ")
+        {
+            if let Some(split_pos) = find_media_condition_end(entry) {
+                (Some(entry[..split_pos].trim()), entry[split_pos..].trim())
+            } else {
+                (None, entry)
+            }
+        } else {
+            (None, entry)
+        };
+        let Some(px) = parse_css_length_px(length_str, viewport_width) else {
+            continue;
+        };
+        if px < 0.0 {
+            continue;
+        }
+        if condition.is_none_or(|cond| evaluate_media_condition(cond, viewport_width)) {
+            return px;
+        }
+    }
+    viewport_width
+}
+
+/// Find the byte index right after the media condition in a `sizes` entry like
+/// `(max-width: 600px) calc(100vw - 32px)`.
+fn find_media_condition_end(entry: &str) -> Option<usize> {
+    let mut depth = 0usize;
+    let mut last_close = None;
+    for (idx, ch) in entry.char_indices() {
+        match ch {
+            '(' => depth += 1,
+            ')' if depth > 0 => {
+                depth -= 1;
+                if depth == 0 {
+                    let tail = entry[idx + 1..].trim_start();
+                    // If `and` follows, the media condition continues.
+                    if !tail.to_ascii_lowercase().starts_with("and ") {
+                        last_close = Some(idx + 1);
+                        break;
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+    last_close
+}
+
+/// Select an image candidate from `srcset` using `sizes` (defaulting to `100vw`)
+/// and the viewport width / DPR. Picks the smallest width descriptor that meets
+/// `source_size * dpr`, or the largest available width descriptor if none does.
+/// https://html.spec.whatwg.org/multipage/images.html#selecting-an-image-source-from-the-source-set
+fn pick_srcset_candidate_for_viewport(
+    srcset: &str,
+    sizes: Option<&str>,
+    viewport_width: f32,
+    dpr: f32,
+) -> Option<String> {
+    let mut width_candidates: Vec<(&str, f64)> = Vec::new();
+    let mut has_width = false;
+
+    let bytes = srcset.as_bytes();
+    let mut i = 0;
+    while i < bytes.len() {
+        while i < bytes.len() && (bytes[i].is_ascii_whitespace() || bytes[i] == b',') {
+            i += 1;
+        }
+        if i >= bytes.len() {
+            break;
+        }
+        let url_start = i;
+        while i < bytes.len() && !bytes[i].is_ascii_whitespace() {
+            i += 1;
+        }
+        let mut url_end = i;
+        let mut had_trailing_comma = false;
+        if url_end > url_start && bytes[url_end - 1] == b',' {
+            url_end -= 1;
+            had_trailing_comma = true;
+        }
+        if url_end == url_start {
+            continue;
+        }
+        let url = &srcset[url_start..url_end];
+        let descriptor = if had_trailing_comma {
+            ""
+        } else {
+            while i < bytes.len() && bytes[i].is_ascii_whitespace() && bytes[i] != b'\n' {
+                i += 1;
+            }
+            let desc_start = i;
+            while i < bytes.len() && bytes[i] != b',' {
+                i += 1;
+            }
+            srcset[desc_start..i].trim()
+        };
+        if i < bytes.len() && bytes[i] == b',' {
+            i += 1;
+        }
+        if let Some(SrcsetDescriptor::Width(w_str)) = parse_srcset_descriptor(descriptor) {
+            has_width = true;
+            if let Ok(w) = w_str.parse::<f64>() {
+                width_candidates.push((url, w));
+            }
+        }
+    }
+
+    if !has_width || width_candidates.is_empty() {
+        return pick_srcset_candidate(srcset);
+    }
+
+    let source_size = sizes
+        .map(|s| parse_sizes_attribute(s, viewport_width))
+        .unwrap_or(viewport_width);
+    let target_width = (source_size * dpr) as f64;
+
+    // Pick the smallest candidate >= target_width; otherwise the largest available.
+    let best_ge = width_candidates
+        .iter()
+        .filter(|(_, w)| *w >= target_width)
+        .min_by(|a, b| a.1.total_cmp(&b.1));
+    if let Some((url, _)) = best_ge {
+        return Some((*url).to_string());
+    }
+    width_candidates
+        .iter()
+        .max_by(|a, b| a.1.total_cmp(&b.1))
+        .map(|(url, _)| (*url).to_string())
+}

+                        };
+                        if should_stamp_stroke {
+                            if let Some(stroke) = paint_attr_for(stroke_kind) {
+                                stamps.push(("stroke", stroke));
+                            }
+                        }
+                        // usvg resolves the `currentColor` keyword against a
+                        // `color=` attribute and falls back to black without
+                        // one. Stamp the computed color (which includes any
+                        // inherited HTML `color`) beside a root keyword; an own
+                        // `<svg color>` still wins because it is left untouched.
+                        // The paint grammar serializes it to sRGB-legacy rgb(),
+                        // which usvg parses (unlike modern color syntax).
+                        if nesting == 0
+                            && !has_own_color
+                            && stamps.iter().any(|(name, value)| {
+                                matches!(*name, "fill" | "stroke") && value == "currentColor"
+                            })
+                        {
+                            if let Some(color) = crate::layout::construct::paint_attr(
+                                &style::values::generics::svg::SVGPaintKind::Color(
+                                    style::values::generics::color::GenericColor::CurrentColor,
+                                ),
+                                style,
+                            ) {
+                                stamps.push(("color", color));
                             }
                         }
                     }

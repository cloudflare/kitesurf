+impl BaseDocument {
+    /// Re-run candidate selection for responsive `<img>` elements (`srcset` or
+    /// `<picture>` children) after the viewport width changes, reloading only
+    /// those whose selected URL actually changed.
+    /// https://html.spec.whatwg.org/multipage/images.html#updating-the-image-data
+    pub fn refresh_responsive_images(&mut self) {
+        if self.responsive_image_urls.is_empty() {
+            return;
+        }
+        let tracked: Vec<(NodeId, String)> = self
+            .responsive_image_urls
+            .iter()
+            .map(|(&id, url)| (id, url.clone()))
+            .collect();
+        let mut stale_ids = Vec::new();
+        let mut changed_ids = Vec::new();
+        {
+            let mutator = self.mutate();
+            for (id, prev_url) in tracked {
+                let alive = mutator.doc.nodes.get(id).is_some_and(|n| {
+                    n.flags.is_in_document()
+                        && n.data.is_element_with_tag_name(&local_name!("img"))
+                });
+                if !alive {
+                    stale_ids.push(id);
+                    continue;
+                }
+                if mutator.select_image_url(id).as_deref() != Some(prev_url.as_str()) {
+                    changed_ids.push(id);
+                }
+            }
+        }
+        for id in stale_ids {
+            self.responsive_image_urls.remove(&id);
+        }
+        if changed_ids.is_empty() {
+            return;
+        }
+        let mut mutator = self.mutate();
+        for id in changed_ids {
+            mutator.load_image(id);
+        }
+    }
+}

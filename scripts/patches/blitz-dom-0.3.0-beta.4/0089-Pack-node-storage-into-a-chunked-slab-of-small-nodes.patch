+                |f, v| f.focussable = v,
+            ),
+            (|el, v| el.set_has_snapshot(v), |f, v| f.has_snapshot = v),
+            (
+                |el, v| el.set_display_constructed_as(display(v)),
+                |f, v| f.display = display(v).to_u16(),
+            ),
+        ];

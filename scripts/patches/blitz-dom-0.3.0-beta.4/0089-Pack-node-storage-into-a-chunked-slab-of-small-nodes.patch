+    debug_assert_eq!(
+        // SAFETY: `tree` is always a node's own tree pointer (see `version_at`).
+        unsafe { crate::tree::version_at(tree, index) },
+        (id.as_u64() >> 32) as u32,
+        "tree link to a node that is not live: {id:?}"
+    );
+    index

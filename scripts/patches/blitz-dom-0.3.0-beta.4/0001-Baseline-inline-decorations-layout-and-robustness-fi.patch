+        let take = match &best {
+            None => true,
+            Some((_, _, prev_is_width)) if is_width && !*prev_is_width => true,
+            Some((_, _, prev_is_width)) if !is_width && *prev_is_width => false,
+            Some((_, prev_value, _)) => value > *prev_value,
+        };
+        if take {
+            best = Some((url.to_string(), value, is_width));
+        }

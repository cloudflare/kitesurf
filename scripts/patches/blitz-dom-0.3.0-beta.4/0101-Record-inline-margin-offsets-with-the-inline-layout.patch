+
+impl crate::BaseDocument {
+    /// Per line, the inline-start offset each item is drawn at, from the
+    /// horizontal margins of the non-replaced inline boxes the line runs
+    /// through. Parley lays text out without box margins, so both the paint and
+    /// the geometry walks add this offset.
+    /// https://drafts.csswg.org/css2/#inline-box-dimensions
+    pub(crate) fn inline_margin_offsets(
+        &self,
+        layout: &parley::layout::Layout<crate::node::TextBrush>,
+    ) -> Vec<Vec<(NodeId, f32)>> {
+        use parley::PositionedLayoutItem;
+        let scale = layout.scale() as f32;
+        layout
+            .lines()
+            .map(|line| {
+                let mut shift = 0.0f32;
+                let mut current: Option<NodeId> = None;
+                let mut offsets: Vec<(NodeId, f32)> = Vec::new();
+                for item in line.items() {
+                    let node_id = match &item {
+                        PositionedLayoutItem::GlyphRun(run) => Some(run.style().brush.id),
+                        PositionedLayoutItem::InlineBox(ibox) => Some(NodeId::from_u64(ibox.id)),
+                    };
+                    let Some(node_id) = node_id else { continue };
+                    if current != Some(node_id) {
+                        if let Some(previous) = current {
+                            shift += self.inline_box_margin(previous, false, scale);
+                        }
+                        shift += self.inline_box_margin(node_id, true, scale);
+                        current = Some(node_id);
+                    }
+                    if !offsets.iter().any(|(id, _)| *id == node_id) {
+                        offsets.push((node_id, shift));
+                    }
+                }
+                offsets
+            })
+            .collect()
+    }
+
+    /// One inline box's horizontal margin in scaled px, resolved against the
+    /// inline root's content width.
+    fn inline_box_margin(&self, node_id: NodeId, leading: bool, scale: f32) -> f32 {
+        let Some(node) = self.get_node(node_id) else {
+            return 0.0;
+        };
+        // Only a non-replaced inline box contributes; the inline root and block
+        // boxes already sit at their own margin-adjusted position.
+        if !node.is_non_atomic_inline() {
+            return 0.0;
+        }
+        let Some(styles) = node.primary_styles() else {
+            return 0.0;
+        };
+        let margin = styles.clone_margin();
+        let value = if leading {
+            &margin.margin_left
+        } else {
+            &margin.margin_right
+        };
+        let basis = node
+            .inline_root_ancestor()
+            .map(|root| root.final_layout().size.width)
+            .unwrap_or(0.0);
+        match value {
+            style::values::generics::length::GenericMargin::LengthPercentage(lp) => {
+                lp.resolve(style::values::computed::CSSPixelLength::new(basis)).px() * scale
+            }
+            _ => 0.0,
+        }
+    }
+}
+
+impl LayoutPassState<'_> {
+    /// One inline box's horizontal margin in CSS px, for the item-positioning
+    /// walk (unscaled, because it is added to a CSS-px location).
+    fn inline_box_margin_px(&self, node_id: NodeId, leading: bool) -> f32 {
+        let Some(node) = self.nodes.get(node_id) else {
+            return 0.0;
+        };
+        if !node.is_non_atomic_inline() {
+            return 0.0;
+        }
+        let Some(styles) = node.primary_styles() else {
+            return 0.0;
+        };
+        let margin = styles.clone_margin();
+        let value = if leading {
+            &margin.margin_left
+        } else {
+            &margin.margin_right
+        };
+        let basis = node
+            .inline_root_ancestor()
+            .map(|root| root.final_layout().size.width)
+            .unwrap_or(0.0);
+        match value {
+            style::values::generics::length::GenericMargin::LengthPercentage(lp) => {
+                lp.resolve(style::values::computed::CSSPixelLength::new(basis)).px()
+            }
+            _ => 0.0,
+        }
+    }
+}

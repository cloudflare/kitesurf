+/// Hit-test inline glyph runs at scaled inline-root content coordinates `(px, py)`,
+/// applying each line's recorded horizontal inline-box margin offsets so hit
+/// testing agrees with painted text and client rects.
+/// https://drafts.csswg.org/css2/#inline-box-dimensions
+fn hit_inline_text(
+    layout: &parley::layout::Layout<crate::node::TextBrush>,
+    line_node_offsets: &[Vec<(NodeId, f32)>],
+    px: f32,
+    py: f32,
+) -> Option<NodeId> {
+    let has_margin_offsets = line_node_offsets
+        .iter()
+        .any(|offsets| offsets.iter().any(|&(_, shift)| shift != 0.0));
+    if !has_margin_offsets {
+        // Parley's `from_point_exact` is exact in the inline axis only:
+        // `line_for_offset` clamps a block offset above the first line or below
+        // the last one onto that line, so check the line's block extent too.
+        let (cluster, _side) = Cluster::from_point_exact(layout, px, py)?;
+        let line = cluster.line();
+        let metrics = line.metrics();
+        if py >= metrics.block_min_coord && py < metrics.block_max_coord {
+            return Some(cluster.style().brush.id);
+        }
+        return None;
+    }
+
+    for (line_index, line) in layout.lines().enumerate() {
+        let metrics = line.metrics();
+        if py < metrics.block_min_coord || py >= metrics.block_max_coord {
+            continue;
+        }
+        let offsets = line_node_offsets
+            .get(line_index)
+            .map(Vec::as_slice)
+            .unwrap_or(&[]);
+        for item in line.items() {
+            let parley::PositionedLayoutItem::GlyphRun(glyph_run) = item else {
+                continue;
+            };
+            let node_id = glyph_run.style().brush.id;
+            let shift = offsets
+                .iter()
+                .find(|(id, _)| *id == node_id)
+                .map(|(_, offset)| *offset)
+                .unwrap_or(0.0);
+            let x0 = glyph_run.offset() + shift;
+            let x1 = x0 + glyph_run.advance();
+            if px >= x0 && px <= x1 {
+                return Some(node_id);
+            }
+        }
+    }
+    None
+}

+/// Gecko's `inherit_relative_selector_search_direction`: a mutated element continues the `:has()`
+/// searches that reached its parent downward and its previous sibling sideways, including
+/// `:has(~ .a .b)`, which runs through the sibling's subtree.
+fn inherited_search_direction(element: BlitzNode<'_>) -> ElementSelectorFlags {
+    use selectors::Element as _;
+
+    let direction = |e: Option<BlitzNode<'_>>, mask: ElementSelectorFlags| {
+        e.map_or_else(ElementSelectorFlags::empty, |e| e.relative_selector_search_direction() & mask)
+    };
+    direction(
+        selectors::Element::parent_element(&element),
+        ElementSelectorFlags::RELATIVE_SELECTOR_SEARCH_DIRECTION_ANCESTOR,
+    ) | direction(
+        element.prev_sibling_element(),
+        ElementSelectorFlags::RELATIVE_SELECTOR_SEARCH_DIRECTION_ANCESTOR_SIBLING,
+    )
 }


+    /// Gecko's `RestyleManager::ContentWillBeRemoved`, run while `child_id` is still linked under
+    /// `parent_id`: restyle the siblings whose structural selectors can change, and the `:has()`
+    /// anchors that read their positions, instead of the whole parent.
+    fn restyle_for_removal(&mut self, parent_id: NodeId, child_id: NodeId) {
+        use selectors::matching::ElementSelectorFlags;
+
+        let parent = &self.doc.nodes[parent_id];
+        parent.set_dirty_descendants();
+        parent.mark_ancestors_dirty();
+        let whole_parent = insertion_restyles_whole_parent(parent);
+        let flags = if whole_parent {
+            ElementSelectorFlags::empty()
+        } else {
+            parent.selector_flags().get()
+        };
+        let children = parent.children();
+        let index = children.position(child_id);
+        let later_siblings = flags.contains(ElementSelectorFlags::HAS_SLOW_SELECTOR_LATER_SIBLINGS);
+        // Removing the first child restyles every later sibling anyway, and Gecko takes the whole
+        // parent there to keep emptying a parent from the front linear.
+        if whole_parent || index.is_none_or(|i| later_siblings && i == 0) {
+            self.doc.nodes[parent_id].set_restyle_hint(RestyleHint::restyle_subtree());
+            self.invalidate_structural_has_for_whole_parent(parent_id);
+            return;
+        }
+        let edge_children = flags.contains(ElementSelectorFlags::HAS_EDGE_CHILD_SELECTOR);
+        let Some(index) = index.filter(|_| self.doc.nodes[child_id].is_element()) else {
+            // Structural selectors count element siblings only.
+            return;
+        };
+        let is_element = |id: &NodeId| self.doc.nodes[*id].is_element();
+        let mut targets: Vec<NodeId> = Vec::new();
+        let mut ts_targets: Vec<(NodeId, TSStateForInvalidation)> = Vec::new();
+        if later_siblings {
+            let later: Vec<NodeId> = children.iter().skip(index + 1).filter(is_element).collect();
+            if flags.intersects(NTH_FLAGS) {
+                ts_targets.extend(later.iter().map(|&id| (id, TSStateForInvalidation::NTH)));
+            }
+            targets.extend(later);
+        }
+        if edge_children {
+            let before = children.iter().take(index).rev().find(is_element);
+            let after = children.iter().skip(index + 1).find(is_element);
+            // The element that becomes the first or the last child.
+            if let (None, Some(id)) = (before, after) {
+                targets.push(id);
+                ts_targets.push((id, TSStateForInvalidation::NTH_EDGE_FIRST));
+            }
+            if let (Some(id), None) = (before, after) {
+                targets.push(id);
+                ts_targets.push((id, TSStateForInvalidation::NTH_EDGE_LAST));
+            }
+        }
+        for id in targets {
+            self.doc.nodes[id].set_restyle_hint(RestyleHint::restyle_subtree());
+        }
+        for (id, state) in ts_targets {
+            self.doc.invalidate_relative_selector_ts_dependency(id, state);
+        }
+    }
+
+    /// The `:has()` half of Gecko's `RestyleWholeContainer` and `RestyleForEmptyChange`: an anchor
+    /// that reads the parent's `:empty` or a child's position sits outside the parent's subtree,
+    /// so the parent's own restyle cannot reach it.
+    fn invalidate_structural_has_for_whole_parent(&self, parent_id: NodeId) {
+        use selectors::matching::ElementSelectorFlags;
+
+        let parent = &self.doc.nodes[parent_id];
+        // Shadow roots and fragments hold no selector flags.
+        if !parent.is_element() {
+            return;
+        }
+        let flags = parent.selector_flags().get();
+        if flags.contains(ElementSelectorFlags::HAS_EMPTY_SELECTOR) {
+            self.doc
+                .invalidate_relative_selector_ts_dependency(parent_id, TSStateForInvalidation::EMPTY);
+        }
+        if !flags.intersects(NTH_FLAGS | ElementSelectorFlags::HAS_EDGE_CHILD_SELECTOR) {
+            return;
+        }
+        let positions = TSStateForInvalidation::NTH
+            | TSStateForInvalidation::NTH_EDGE_FIRST
+            | TSStateForInvalidation::NTH_EDGE_LAST;
+        for id in parent.children().iter() {
+            if self.doc.nodes[id].is_element() {
+                self.doc.invalidate_relative_selector_ts_dependency(id, positions);
+            }
+        }
     }


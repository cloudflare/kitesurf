index cdb49ac..ba78c26 100644
--- a/src/stylo.rs
+++ b/src/stylo.rs
@@ -390,6 +390,26 @@ impl crate::document::BaseDocument {
                 .any(|(data, _)| data.relative_invalidation_map_attributes().used)
     }

+    /// Whether some `:has()` starts with `+` or `~`, in the document or any shadow tree, so
+    /// an inserted element can change an earlier sibling's match. An inserted element only
+    /// inherits its parent's search direction, which never carries the sibling one, so the
+    /// invalidator misses those anchors and the insertion must restyle the whole parent.
+    pub(crate) fn has_sibling_relative_selectors(&self) -> bool {
+        let reaches_siblings = |data: &style::stylist::CascadeData| {
+            data.relative_invalidation_map_attributes()
+                .has_sibling_relative_selectors
+        };
+        self.stylist
+            .iter_origins()
+            .any(|(data, _)| reaches_siblings(data))
+            || self.shadow_roots.iter().any(|&id| {
+                self.nodes
+                    .get(id)
+                    .and_then(|node| node.shadow_root_data())
+                    .is_some_and(|data| reaches_siblings(&data.author_styles.data))
+            })
+    }
+
     /// Structural sibling of the pass above, for tree mutations rather than

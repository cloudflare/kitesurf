From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Wed, 18 Nov 2026 20:21:20 +0000
Subject: [PATCH] Let the embedder take an author font family from its own
 faces

An embedder can register its own faces under platform family names, such
as a UA face aliased as Arial. Fontique keys families by name and appends
new faces to an existing family, so an author @font-face for the same
name landed behind the embedder's faces. Matching returns faces in
registration order, so the author face was never used.

Add set_author_font_family_hook. The Resource::Font arm calls it with the
@font-face family name before the face registers, so the embedder can set
its own faces aside, and again with whether fontique accepted the face,
so a rejected face (a truncated WOFF2, say) gives the family back.

Only the top-level document calls it. A subdocument shares the parent's
collection, so an iframe's @font-face must not remove the faces that the
parent document draws with.
---
 src/document.rs | 19 +++++++++++++++++++
 src/util.rs     | 25 +++++++++++++++++++++++++
 2 files changed, 44 insertions(+)

diff --git a/src/document.rs b/src/document.rs
index f1f3aa2..7dc76d6 100644
--- a/src/document.rs
+++ b/src/document.rs
@@ -2510,9 +2510,28 @@ impl BaseDocument {

                 // TODO: Investigate eliminating double-box
                 let mut global_font_ctx = self.font_ctx.lock().unwrap();
+                // A subdocument shares the parent's collection, so only the top-level
+                // document's faces may take a family from the embedder.
+                let family_hook = match (
+                    self.subdocument_depth,
+                    crate::util::author_font_family_hook(),
+                    overrides.family_name.as_deref(),
+                ) {
+                    (0, Some(hook), Some(family)) => Some((hook, family)),
+                    _ => None,
+                };
+                if let Some((hook, family)) = family_hook {
+                    use crate::util::AuthorFontFamilyEvent::BeforeRegister;
+                    hook(&mut global_font_ctx.collection, family, BeforeRegister);
+                }
                 let registered = global_font_ctx
                     .collection
                     .register_fonts(font.clone(), Some(info_override));
+                if let Some((hook, family)) = family_hook {
+                    use crate::util::AuthorFontFamilyEvent::Registered;
+                    let ok = !registered.is_empty();
+                    hook(&mut global_font_ctx.collection, family, Registered(ok));
+                }
                 // Record (blob, family, attrs) so the
                 // shaping-until-raster upgrade can swap this face.
                 for (family, fonts) in &registered {
diff --git a/src/util.rs b/src/util.rs
index d1ab6b4..3868d64 100644
--- a/src/util.rs
+++ b/src/util.rs
@@ -113,6 +113,31 @@ pub fn clear_svg_tree_cache() {
     }
 }

+/// When an author `@font-face` face of the top-level document registers, the hook sees the
+/// family name twice: before the face registers, then with whether fontique accepted it. An
+/// embedder whose own faces answer to the same name (a platform-name alias) sets them aside
+/// first, so the author's faces own the family, and restores them if the author face failed.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum AuthorFontFamilyEvent {
+    BeforeRegister,
+    Registered(bool),
+}
+
+pub type AuthorFontFamilyHook =
+    fn(&mut parley::fontique::Collection, &str, AuthorFontFamilyEvent);
+
+static AUTHOR_FONT_FAMILY_HOOK: std::sync::OnceLock<AuthorFontFamilyHook> =
+    std::sync::OnceLock::new();
+
+/// Install the author-family hook. The first call wins.
+pub fn set_author_font_family_hook(hook: AuthorFontFamilyHook) {
+    let _ = AUTHOR_FONT_FAMILY_HOOK.set(hook);
+}
+
+pub(crate) fn author_font_family_hook() -> Option<AuthorFontFamilyHook> {
+    AUTHOR_FONT_FAMILY_HOOK.get().copied()
+}
+
 /// Which generic family a registered SVG font should answer for.
 #[cfg(feature = "svg")]
 #[derive(Clone, Copy, Debug, PartialEq, Eq)]

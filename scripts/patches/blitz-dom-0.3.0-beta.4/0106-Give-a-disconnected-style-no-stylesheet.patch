From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Thu, 19 Nov 2026 13:53:52 +0000
Subject: [PATCH] Give a disconnected <style> no stylesheet

A <style> whose text changed was registered with the document stylist
even when it was not connected, so its rules applied to the document
and each new detached element changed the stylesheet set, which made
stylo restyle every element on the next style read. HTML's "update a
style block" gives a disconnected style element no sheet; connecting
it queues it again.
---
 src/mutator.rs | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/mutator.rs b/src/mutator.rs
index af80424..ac6153e 100644
--- a/src/mutator.rs
+++ b/src/mutator.rs
@@ -1435,6 +1435,16 @@ impl<'doc> DocumentMutator<'doc> {
         // A first sheet is parsed now so its @import and @font-face loads start
         // early; replacing an already registered one waits for resolve.
         for id in self.style_nodes.drain() {
+            // HTML "update a style block": a disconnected <style> has no sheet. Connecting it
+            // queues it again (process_added_subtree), and removal drops its sheet.
+            let connected = self
+                .doc
+                .nodes
+                .get(id)
+                .is_some_and(|node| node.flags.is_in_document());
+            if !connected {
+                continue;
+            }
             if self.doc.nodes_to_stylesheet.contains_key(&id) {
                 self.doc.pending_style_nodes.insert(id);
             } else {

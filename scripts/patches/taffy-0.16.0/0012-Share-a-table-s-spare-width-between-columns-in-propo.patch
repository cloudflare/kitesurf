     // For the purpose of the final two expansion steps ("Expand Flexible Tracks" and "Stretch auto Tracks"), we only want to expand
     // into space generated by the grid container's size (as defined by either it's preferred size style or by it's parent node through
@@ -1211,7 +1212,11 @@ fn distribute_item_space_to_growth_limit(
 /// 11.6 Maximise Tracks
 /// Distributes free space (if any) to tracks with FINITE growth limits, up to their limits.
 #[inline(always)]
-fn maximise_tracks(axis_tracks: &mut [GridTrack], axis_available_grid_space: AvailableSpace) {
+///
+/// The columns of a table share the space in proportion to how far each can grow, which moves
+/// every column the same fraction of the way from its minimum to its maximum width, as in the
+/// css-tables-3 §3.9.4 interpolation between sizing guesses. Grid tracks share it equally.
+fn maximise_tracks(axis_tracks: &mut [GridTrack], axis_available_grid_space: AvailableSpace, is_table_columns: bool) {
     let used_space: f32 = axis_tracks.iter().map(|track| track.base_size).sum();
     let free_space = axis_available_grid_space.compute_free_space(used_space);
     if free_space == f32::INFINITY {
@@ -1221,7 +1226,14 @@ fn maximise_tracks(axis_tracks: &mut [GridTrack], axis_available_grid_space: Ava
             free_space,
             axis_tracks,
             |_| true,
-            |_| 1.0,
+            move |track: &GridTrack| {
+                let room = track.fit_content_limited_growth_limit() - track.base_size;
+                if is_table_columns && room.is_finite() {
+                    room.max(0.0)
+                } else {
+                    1.0
+                }
+            },
             |track| track.base_size,
             move |track: &GridTrack| track.fit_content_limited_growth_limit(),
         );

+    /// Placement for a `backdrop-filter` layer sampled from the unshifted scene
+    /// behind `clip_bbox`, expanded by the filter padding and clamped to `scene_size`.
+    pub fn for_backdrop(clip_bbox: RectU16, filter_plan: &FilterData, scene_size: SizeU16) -> Self {
+        if clip_bbox.is_empty() || scene_size.width() == 0 || scene_size.height() == 0 {
+            return Self::EMPTY;
+        }
+        let pad = filter_plan.filter_padding;
+        let x0 = clip_bbox.x0.saturating_sub(pad.left);
+        let y0 = clip_bbox.y0.saturating_sub(pad.top);
+        let x1 = clip_bbox.x1.saturating_add(pad.right).min(scene_size.width());
+        let y1 = clip_bbox.y1.saturating_add(pad.bottom).min(scene_size.height());
+        let scene_rect = RectU16::new(0, 0, scene_size.width(), scene_size.height());
+        let pixmap_bbox = RectU16::new(x0, y0, x1, y1)
+            .snap_to_tile_coordinates()
+            .intersect(scene_rect);
+        if pixmap_bbox.is_empty() {
+            return Self::EMPTY;
+        }
+        Self {
+            pixmap_bbox,
+            dest_bbox: pixmap_bbox,
+            src_x: 0,
+            src_y: 0,
+        }
+    }
+
     /// Return the bounds of the pixmap allocated for the filter layer.
     ///
     /// The bbox is guaranteed to be aligned to tile coordinates.

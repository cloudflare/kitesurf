+    /// Record a self-contained backdrop-filter layer at the current paint position.
+    pub fn push_backdrop_filter_layer(&mut self, props: LayerProps, filter_plan: FilterData) {
+        let clip_bbox = props
+            .clip_path
+            .as_ref()
+            .map(|c| c.bbox)
+            .unwrap_or_else(|| {
+                RectU16::new(0, 0, self.scene_size.width(), self.scene_size.height())
+            });
+        let placement = FilterLayerPlacement::for_backdrop(clip_bbox, &filter_plan, self.scene_size);
+        if placement.pixmap_bbox().is_empty() {
+            return;
+        }
+        let depth = self.layer_stack.len() + 1;
+        self.max_layer_depth = self.max_layer_depth.max(depth);
+        let filter_size: SizeU16 = placement.pixmap_bbox().into();
+        self.largest_layer_size = Some(
+            self.largest_layer_size
+                .map_or(filter_size, |current| current.max(filter_size)),
+        );
+        self.largest_filter_layer_size = Some(
+            self.largest_filter_layer_size
+                .map_or(filter_size, |current| current.max(filter_size)),
+        );
+        let backdrop_root = self.layer_stack.iter().rev().find_map(|open| {
+            let p = &self.layers[open.id as usize].props;
+            let isolates = p.opacity < 1.0
+                || p.blend_mode != BlendMode::default()
+                || p.mask.is_some();
+            isolates.then_some(open.id)
+        });
+        let layer = RecordedLayer {
+            props,
+            nodes: SmallVec::new(),
+            kind: RecordedLayerKind::BackdropFilter {
+                filter_data: filter_plan,
+                placement,
+                backdrop_root,
+            },
+            depth,
+            bbox: placement.dest_bbox(),
+        };
+        let id = self.push_layer_metadata(layer);
+        self.push_layer_node(id);
+        self.backdrop_filter_layers.push(id);
+        self.record_bbox(|| Some(placement.dest_bbox()));
+    }
+
     fn push_recorded_layer(&mut self, layer: RecordedLayer) -> u32 {
         let parent_layer = self.active_layer;
         self.max_layer_depth = self.max_layer_depth.max(layer.depth);
@@ -354,5 +416,8 @@ impl<D> CommandRecorder<D> {

                     (PoppedLayer::Filter, placement.dest_bbox())
                 }

+// Kitesurf impl of the shared tests/page fixture surface (PWPAGE_IMPL=kitesurf).
+// Drives a running kitesurf engine over CDP; KITESURF_WS points at it.
+
+import { chromium } from 'playwright-core';
+import type { Browser, BrowserContext } from 'playwright-core';
+import { baseTest } from '../config/baseTest';
+import type { PageTestFixtures, PageWorkerFixtures } from '../page/pageTestApi';
+
+export { expect } from '@playwright/test';
+
+type KitesurfWorkerFixtures = PageWorkerFixtures & {
+  kitesurfBrowser: Browser;
+  kitesurfContext: BrowserContext;
+};
+
+export const kitesurfTest = baseTest.extend<PageTestFixtures, KitesurfWorkerFixtures>({
+  kitesurfBrowser: [async ({}, use) => {
+    const ws = process.env.KITESURF_WS;
+    if (!ws)
+      throw new Error('KITESURF_WS must point at a kitesurf /devtools/browser ws endpoint');
+    const browser = await chromium.connectOverCDP(ws);
+    await use(browser);
+    await browser.close();
+  }, { scope: 'worker' }],
+
+  // connectOverCDP surfaces the engine's single default context; kitesurf
+  // fakes createBrowserContext, so all tests share it (and its cookie jar).
+  kitesurfContext: [async ({ kitesurfBrowser }, use) => {
+    await use(kitesurfBrowser.contexts()[0]);
+  }, { scope: 'worker' }],
+
+  browserVersion: [async ({ kitesurfBrowser }, use) => {
+    await use(kitesurfBrowser.version());
+  }, { scope: 'worker' }],
+
+  browserMajorVersion: [async ({ browserVersion }, use) => {
+    await use(Number(browserVersion.split('.')[0]) || 0);
+  }, { scope: 'worker' }],
+
+  isBidi: [false, { scope: 'worker' }],
+  isAndroid: [false, { scope: 'worker' }],
+  isElectron: [false, { scope: 'worker' }],
+  electronMajorVersion: [0, { scope: 'worker' }],
+  isHeadlessShell: [false, { scope: 'worker' }],
+  isFrozenWebkit: [false, { scope: 'worker' }],
+
+  // Fresh page per test, closed after; cookies cleared between tests
+  // (Storage.clearCookies) since the single context persists until
+  // kitesurf grows real browser contexts (TODO-playwright.md 3.7).
+  page: async ({ kitesurfContext }, use) => {
+    const page = await kitesurfContext.newPage();
+    await use(page);
+    await page.close().catch(() => {});
+    await kitesurfContext.clearCookies().catch(() => {});
+  },
+});

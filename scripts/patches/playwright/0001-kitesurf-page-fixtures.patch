+// Config for running the shared tests/page suite against kitesurf over CDP.
+// Invoked by kitesurf's scripts/pw-run.mjs (which owns the engine lifecycle).
+
+import type { Config, PlaywrightTestOptions, PlaywrightWorkerOptions } from '@playwright/test';
+import * as path from 'path';
+import type { ServerWorkerOptions } from '../config/serverFixtures';
+
+process.env.PWTEST_UNDER_TEST = '1';
+process.env.PWPAGE_IMPL = 'kitesurf';
+
+const outputDir = path.join(__dirname, '..', '..', 'test-results');
+const testDir = path.join(__dirname, '..', 'page');
+
+const config: Config<ServerWorkerOptions & PlaywrightWorkerOptions & PlaywrightTestOptions> = {
+  testDir,
+  outputDir,
+  expect: {
+    timeout: 10000,
+  },
+  timeout: 30000,
+  globalTimeout: 5400000,
+  // Serial by owner decision: parallel workers share one dev engine
+  // and the contention flakes redirect/timeout-sensitive specs.
+
+  // Isolation is correct (per-WS BrowserState and real browser contexts),
+  // so this is a stability choice, not a correctness one.
+  workers: 1,
+  retries: 0,
+  forbidOnly: !!process.env.CI,
+  reporter: [
+    ['line'],
+    ['json', { outputFile: process.env.PWTEST_JSON_OUTPUT || path.join(outputDir, 'kitesurf-report.json') }],
+    // pw-run names one blob per batch; tests/pw:html_report merges them into one HTML report.
+    ...(process.env.PLAYWRIGHT_BLOB_OUTPUT_FILE ? [['blob'] as const] : []),
+  ],
+  projects: [
+    {
+      name: 'kitesurf-page',
+      use: {
+        browserName: 'chromium',
+      },
+      testDir,
+      metadata: {
+        platform: 'kitesurf',
+        headless: 'headless',
+        browserName: 'chromium',
+        mode: 'default',
+        video: false,
+      },
+    },
+  ],
+};
+
+export default config;

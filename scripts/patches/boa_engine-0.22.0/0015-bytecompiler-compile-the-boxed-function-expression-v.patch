From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Mon, 12 Oct 2026 11:07:37 +0100
Subject: [PATCH] bytecompiler: compile the boxed function expression variants

Follows boa_ast boxing the function expression variants of Expression.
---
 src/bytecompiler/expression/mod.rs | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/src/bytecompiler/expression/mod.rs b/src/bytecompiler/expression/mod.rs
index 00daf68..cb6acd1 100644
--- a/src/bytecompiler/expression/mod.rs
+++ b/src/bytecompiler/expression/mod.rs
@@ -135,22 +135,22 @@ impl ByteCompiler<'_> {
             Expression::This(_this) => self.access_get(Access::This, dst),
             Expression::Spread(spread) => self.compile_expr(spread.target(), dst),
             Expression::FunctionExpression(function) => {
-                self.function_with_binding(function.into(), NodeKind::Expression, dst);
+                self.function_with_binding(function.as_ref().into(), NodeKind::Expression, dst);
             }
             Expression::ArrowFunction(function) => {
-                self.function_with_binding(function.into(), NodeKind::Expression, dst);
+                self.function_with_binding(function.as_ref().into(), NodeKind::Expression, dst);
             }
             Expression::AsyncArrowFunction(function) => {
-                self.function_with_binding(function.into(), NodeKind::Expression, dst);
+                self.function_with_binding(function.as_ref().into(), NodeKind::Expression, dst);
             }
             Expression::GeneratorExpression(function) => {
-                self.function_with_binding(function.into(), NodeKind::Expression, dst);
+                self.function_with_binding(function.as_ref().into(), NodeKind::Expression, dst);
             }
             Expression::AsyncFunctionExpression(function) => {
-                self.function_with_binding(function.into(), NodeKind::Expression, dst);
+                self.function_with_binding(function.as_ref().into(), NodeKind::Expression, dst);
             }
             Expression::AsyncGeneratorExpression(function) => {
-                self.function_with_binding(function.into(), NodeKind::Expression, dst);
+                self.function_with_binding(function.as_ref().into(), NodeKind::Expression, dst);
             }
             Expression::Call(call) => {
                 self.call(Callable::Call(call), CallResultDest::Register(dst));

+/// Direct own-property overwrite or creation for ordinary objects when `receiver === obj`,
+/// skipping temporary `PropertyDescriptor` construction and redundant `[[GetOwnProperty]]` calls.
+fn try_ordinary_set_direct(
+    obj: &JsObject,
+    key: &PropertyKey,
+    value: &JsValue,
+    receiver: &JsValue,
+    context: &mut InternalMethodPropertyContext<'_>,
+) -> Option<JsResult<bool>> {
+    if !receiver.as_object().is_some_and(|r| JsObject::equals(&r, obj)) {
+        return None;
+    }
+    let vtable = obj.vtable();
+    let ordinary_get_own = ptr::fn_addr_eq(
+        vtable.__get_own_property__,
+        ORDINARY_INTERNAL_METHODS.__get_own_property__,
+    );
+    if !ordinary_get_own {
+        return None;
+    }
+
+    // Existing own SparseElement on an Array (index < length is guaranteed by Array invariant).
+    if let PropertyKey::Index(idx) = key
+        && ptr::fn_addr_eq(
+            vtable.__define_own_property__,
+            ARRAY_EXOTIC_INTERNAL_METHODS.__define_own_property__,
+        )
+    {
+        let mut borrowed = obj.borrow_mut();
+        if let IndexedProperties::SparseElement(map) = &mut borrowed.properties.indexed_properties
+            && let Some(slot) = map.get_mut(&idx.get())
+        {
+            *slot = value.clone();
+            return Some(Ok(true));
+        }
+        return None;
+    }
+
+    if !ptr::fn_addr_eq(
+        vtable.__define_own_property__,
+        ORDINARY_INTERNAL_METHODS.__define_own_property__,
+    ) {
+        return None;
+    }
+
+    match key {
+        PropertyKey::Index(idx) => {
+            let mut borrowed = obj.borrow_mut();
+            if borrowed.properties.set_dense_property(idx.get(), value) {
+                return Some(Ok(true));
+            }
+            if let IndexedProperties::SparseElement(map) =
+                &mut borrowed.properties.indexed_properties
+                && let Some(slot) = map.get_mut(&idx.get())
+            {
+                *slot = value.clone();
+                return Some(Ok(true));
+            }
+            if borrowed.properties.contains_key(key) {
+                // Existing SparseProperty (may be accessor or read-only); take full path.
+                return None;
+            }
+        }
+        PropertyKey::String(_) | PropertyKey::Symbol(_) => {
+            let mut borrowed = obj.borrow_mut();
+            if let Some(slot) = borrowed.properties.shape.lookup(key) {
+                let out_slot = context.slot();
+                out_slot.index = slot.index;
+                out_slot.attributes = (out_slot.attributes & SlotAttributes::INLINE_CACHE_BITS)
+                    | slot.attributes
+                    | SlotAttributes::FOUND;
+                if slot.attributes.is_accessor_descriptor() {
+                    if !slot.attributes.has_set() {
+                        return Some(Ok(false));
+                    }
+                    let setter = borrowed.properties.storage[slot.index as usize + 1].clone();
+                    drop(borrowed);
+                    if setter.is_undefined() {
+                        return Some(Ok(false));
+                    }
+                    return Some(
+                        setter
+                            .call(receiver, slice::from_ref(value), context)
+                            .map(|_| true),
+                    );
+                }
+                if !slot.attributes.contains(SlotAttributes::WRITABLE) {
+                    return Some(Ok(false));
+                }
+                borrowed.properties.storage[slot.index as usize] = value.clone();
+                return Some(Ok(true));
+            }
+        }
+    }
+
+    // Key is not an own property. If the prototype chain is ordinary and none carry `key`,
+    // create the new own data property directly.
+    if !ptr::fn_addr_eq(
+        vtable.__get_prototype_of__,
+        ORDINARY_INTERNAL_METHODS.__get_prototype_of__,
+    ) || !ptr::fn_addr_eq(
+        vtable.__is_extensible__,
+        ORDINARY_INTERNAL_METHODS.__is_extensible__,
+    ) {
+        return None;
+    }
+    let mut cur = obj.prototype();
+    while let Some(proto) = cur {
+        let pv = proto.vtable();
+        if !ptr::fn_addr_eq(
+            pv.__get_own_property__,
+            ORDINARY_INTERNAL_METHODS.__get_own_property__,
+        ) || !ptr::fn_addr_eq(
+            pv.__get_prototype_of__,
+            ORDINARY_INTERNAL_METHODS.__get_prototype_of__,
+        ) || !ptr::fn_addr_eq(pv.__set__, ORDINARY_INTERNAL_METHODS.__set__)
+        {
+            return None;
+        }
+        if proto.borrow().properties.contains_key(key) {
+            return None;
+        }
+        cur = proto.prototype();
+    }
+
+    context
+        .slot()
+        .attributes
+        .remove(SlotAttributes::PROTOTYPE | SlotAttributes::NOT_CACHEABLE);
+    let mut borrowed = obj.borrow_mut();
+    if !borrowed.extensible {
+        return Some(Ok(false));
+    }
+    borrowed.properties.insert_with_slot(
+        key,
+        PropertyDescriptor::builder()
+            .value(value.clone())
+            .writable(true)
+            .enumerable(true)
+            .configurable(true)
+            .build(),
+        context.slot(),
+    );
+    Some(Ok(true))
+}
+
 /// Abstract operation `OrdinarySet`.
 ///
 /// More information:
@@ -839,6 +987,10 @@ pub(crate) fn ordinary_set(
     receiver: JsValue,
     context: &mut InternalMethodPropertyContext<'_>,
 ) -> JsResult<bool> {
+    if let Some(result) = try_ordinary_set_direct(obj, &key, &value, &receiver, context) {
+        return result;
+    }

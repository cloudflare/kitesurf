+// Live module bindings for baked-chunk imports. A bridged export can be
+// undefined until its rolldown `__esm` init runs, so it is stored as a marker.
+type LiveResolveHook = fn(f64, &JsString, &mut Context) -> JsValue;
+
+thread_local! {
+    static LIVE_RESOLVE_HOOK: Cell<Option<LiveResolveHook>> = const { Cell::new(None) };
+}
+
+/// Register the host callback that resolves a live baked-export binding.
+pub fn set_live_resolve_hook(f: LiveResolveHook) {
+    LIVE_RESOLVE_HOOK.with(|h| h.set(Some(f)));
+}
+
+/// Create a live-binding marker object for a baked export (host bridge).
+pub fn make_live_binding(ns_handle: f64, name: JsString, ctx: &mut Context) -> JsValue {
+    let o = JsObject::with_null_proto();
+    o.create_data_property_or_throw(js_string!("__ks_live_ns"), ns_handle, ctx)
+        .ok();
+    o.create_data_property_or_throw(js_string!("__ks_live_name"), name, ctx)
+        .ok();
+    JsValue::from(o)
+}
+
+/// If `value` is a live-binding marker, resolve it to the current V8 value via the
+/// host hook, caching it on the marker (shared by every importer) once defined.
+pub(crate) fn resolve_live_if_marker(value: &JsValue, ctx: &mut Context) -> Option<JsValue> {
+    let obj = value.as_object()?;
+    let (ns_handle, name, cached) = {
+        let b = obj.try_borrow().ok()?;
+        // Markers are the only null-prototype objects this path mints, so any
+        // prototype means "not a marker" without a single key lookup.
+        if b.prototype().is_some() {
+            return None;
+        }
+        let props = b.properties();
+        let ns = props
+            .get(&PropertyKey::from(js_string!("__ks_live_ns")))?
+            .value()?
+            .as_number()?;
+        let name = props
+            .get(&PropertyKey::from(js_string!("__ks_live_name")))?
+            .value()?
+            .as_string()?;
+        let cached = props
+            .get(&PropertyKey::from(js_string!("__ks_resolved")))
+            .and_then(|d| d.value().cloned());
+        (ns, name, cached)
+    };
+    if let Some(c) = cached {
+        return Some(c);
+    }
+    let hook = LIVE_RESOLVE_HOOK.with(Cell::get)?;
+    let resolved = hook(ns_handle, &name, ctx);
+    if !resolved.is_undefined() {
+        obj.create_data_property_or_throw(js_string!("__ks_resolved"), resolved.clone(), ctx)
+            .ok();
+    }
+    Some(resolved)
+}

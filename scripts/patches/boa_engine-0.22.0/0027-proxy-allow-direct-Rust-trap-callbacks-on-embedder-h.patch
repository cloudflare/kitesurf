+/// Direct Rust callbacks attached as `JsData` to an embedder's Proxy handler so hot
+/// proxy operations avoid handler property lookup, key stringification and call frames.
+#[derive(Clone, Copy)]
+pub struct HostProxyTraps {
+    /// Direct `[[Get]]` hook: `(target, key, receiver, context)`.
+    pub get: Option<fn(&JsObject, &PropertyKey, &JsValue, &mut Context) -> JsResult<JsValue>>,
+    /// Direct `[[Set]]` hook: `(target, key, value, receiver, context)`.
+    pub set:
+        Option<fn(&JsObject, &PropertyKey, &JsValue, &JsValue, &mut Context) -> JsResult<bool>>,
+    /// Direct `[[HasProperty]]` hook: `(target, key, context)`.
+    pub has: Option<fn(&JsObject, &PropertyKey, &mut Context) -> JsResult<bool>>,
+    /// Direct `[[Call]]` hook: `(target, this_arg, args, context)`.
+    pub call: Option<fn(&JsObject, &JsValue, &[JsValue], &mut Context) -> JsResult<JsValue>>,
+}
+
+impl fmt::Debug for HostProxyTraps {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("HostProxyTraps").finish_non_exhaustive()
+    }
+}
+
+impl Finalize for HostProxyTraps {}
+
+// SAFETY: `HostProxyTraps` stores only plain function pointers with no GC-managed fields.
+unsafe impl Trace for HostProxyTraps {
+    empty_trace!();
+}
+
+impl JsData for HostProxyTraps {}
+
+fn target_has_no_own_properties(target: &JsObject) -> bool {
+    if !ptr::eq(target.vtable(), &ORDINARY_INTERNAL_METHODS) {
+        return false;
+    }
+    let borrowed = target.borrow();
+    let props = borrowed.properties();
+    let indexed_empty = match &props.indexed_properties {
+        IndexedProperties::DenseI32(v) => v.is_empty(),
+        IndexedProperties::DenseF64(v) => v.is_empty(),
+        IndexedProperties::DenseElement(v) => v.is_empty(),
+        IndexedProperties::SparseElement(m) => m.is_empty(),
+        IndexedProperties::SparseProperty(m) => m.is_empty(),
+    };
+    props.storage.is_empty() && indexed_empty
+}

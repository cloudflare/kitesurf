+#[test]
+fn host_proxy_traps_dispatch_and_enforce_invariants() {
+    use super::{HostProxyTraps, Proxy};
+    use crate::{
+        Context, JsObject, JsResult, JsValue, Source, js_string,
+        native_function::NativeFunction,
+        object::FunctionObjectBuilder,
+        property::{Attribute, PropertyDescriptor, PropertyKey},
+    };
+
+    fn get_hook(
+        _target: &JsObject,
+        key: &PropertyKey,
+        _recv: &JsValue,
+        _ctx: &mut Context,
+    ) -> JsResult<JsValue> {
+        match key {
+            PropertyKey::Index(i) => Ok(JsValue::from(i.get() * 10)),
+            PropertyKey::String(s) if s == "x" => Ok(JsValue::from(99)),
+            _ => Ok(JsValue::from(7)),
+        }
+    }
+
+    fn set_hook(
+        _target: &JsObject,
+        _key: &PropertyKey,
+        _val: &JsValue,
+        _recv: &JsValue,
+        _ctx: &mut Context,
+    ) -> JsResult<bool> {
+        Ok(true)
+    }
+
+    fn has_hook(_target: &JsObject, key: &PropertyKey, _ctx: &mut Context) -> JsResult<bool> {
+        Ok(matches!(key, PropertyKey::Index(i) if i.get() == 2))
+    }
+
+    fn call_hook(
+        _target: &JsObject,
+        _this: &JsValue,
+        args: &[JsValue],
+        _ctx: &mut Context,
+    ) -> JsResult<JsValue> {
+        let sum: i32 = args.iter().filter_map(|v| v.as_i32()).sum();
+        Ok(JsValue::from(sum))
+    }
+
+    let mut ctx = Context::default();
+    let target = JsObject::from(
+        FunctionObjectBuilder::new(
+            ctx.realm(),
+            NativeFunction::from_fn_ptr(|_, _, _| Ok(JsValue::undefined())),
+        )
+        .build(),
+    );
+    let handler = JsObject::from_proto_and_data(
+        Some(ctx.intrinsics().constructors().object().prototype()),
+        HostProxyTraps {
+            get: Some(get_hook),
+            set: Some(set_hook),
+            has: Some(has_hook),
+            call: Some(call_hook),
+        },
+    );
+    let proxy = Proxy::from_target_and_handler(target.clone(), handler, &mut ctx);
+    ctx.register_global_property(js_string!("p"), proxy, Attribute::all())
+        .unwrap();
+
+    assert_eq!(ctx.eval(Source::from_bytes("p[3]")).unwrap(), JsValue::from(30));
+    assert_eq!(ctx.eval(Source::from_bytes("p.x")).unwrap(), JsValue::from(99));
+    assert_eq!(ctx.eval(Source::from_bytes("2 in p")).unwrap(), JsValue::from(true));
+    assert_eq!(ctx.eval(Source::from_bytes("3 in p")).unwrap(), JsValue::from(false));
+    assert_eq!(ctx.eval(Source::from_bytes("p(10, 20, 3)")).unwrap(), JsValue::from(33));
+
+    // Adding a non-configurable, non-writable property on target must still enforce the
+    // ES Proxy [[Get]] invariant even through HostProxyTraps.
+    target
+        .define_property_or_throw(
+            js_string!("x"),
+            PropertyDescriptor::builder()
+                .value(1)
+                .writable(false)
+                .configurable(false)
+                .build(),
+            &mut ctx,
+        )
+        .unwrap();
+    assert!(ctx.eval(Source::from_bytes("p.x")).is_err());
+}

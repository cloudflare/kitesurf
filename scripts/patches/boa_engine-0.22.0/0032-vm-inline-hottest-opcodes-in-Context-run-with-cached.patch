+                                self.vm.stack.stack[rp + usize::from(dst)] = JsValue::new(inc);
+                                pc = next_pc;
+                                continue;
+                            }
+                        }
+                        Opcode::Dec => {
+                            let ((dst, src), next_pc) =
+                                <(RegisterOperand, RegisterOperand)>::decode(slice, pc + 1);
+                            if let Some(n) = self.vm.stack.stack[rp + usize::from(src)].as_i32()
+                                && let Some(dec) = n.checked_sub(1)
+                            {
+                                self.vm.stack.stack[rp + usize::from(dst)] = JsValue::new(dec);
+                                pc = next_pc;
+                                continue;
+                            }
+                        }
+                        Opcode::Add => {
+                            let ((dst, lhs, rhs), next_pc) =
+                                <(RegisterOperand, RegisterOperand, RegisterOperand)>::decode(
+                                    slice,
+                                    pc + 1,
+                                );
+                            if let (Some(a), Some(b)) = (
+                                self.vm.stack.stack[rp + usize::from(lhs)].as_i32(),
+                                self.vm.stack.stack[rp + usize::from(rhs)].as_i32(),
+                            ) && let Some(sum) = a.checked_add(b)
+                            {
+                                self.vm.stack.stack[rp + usize::from(dst)] = JsValue::new(sum);
+                                pc = next_pc;
+                                continue;
+                            }
+                        }
+                        Opcode::Sub => {
+                            let ((dst, lhs, rhs), next_pc) =
+                                <(RegisterOperand, RegisterOperand, RegisterOperand)>::decode(
+                                    slice,
+                                    pc + 1,
+                                );
+                            if let (Some(a), Some(b)) = (
+                                self.vm.stack.stack[rp + usize::from(lhs)].as_i32(),
+                                self.vm.stack.stack[rp + usize::from(rhs)].as_i32(),
+                            ) && let Some(diff) = a.checked_sub(b)
+                            {
+                                self.vm.stack.stack[rp + usize::from(dst)] = JsValue::new(diff);
+                                pc = next_pc;
+                                continue;
+                            }
+                        }
+                        Opcode::BitAnd => {
+                            let ((dst, lhs, rhs), next_pc) =
+                                <(RegisterOperand, RegisterOperand, RegisterOperand)>::decode(
+                                    slice,
+                                    pc + 1,
+                                );
+                            if let (Some(a), Some(b)) = (
+                                self.vm.stack.stack[rp + usize::from(lhs)].as_i32(),
+                                self.vm.stack.stack[rp + usize::from(rhs)].as_i32(),
+                            ) {
+                                self.vm.stack.stack[rp + usize::from(dst)] = JsValue::new(a & b);
+                                pc = next_pc;
+                                continue;
+                            }
+                        }
+                        Opcode::BitOr => {
+                            let ((dst, lhs, rhs), next_pc) =
+                                <(RegisterOperand, RegisterOperand, RegisterOperand)>::decode(
+                                    slice,
+                                    pc + 1,
+                                );
+                            if let (Some(a), Some(b)) = (
+                                self.vm.stack.stack[rp + usize::from(lhs)].as_i32(),
+                                self.vm.stack.stack[rp + usize::from(rhs)].as_i32(),
+                            ) {
+                                self.vm.stack.stack[rp + usize::from(dst)] = JsValue::new(a | b);
+                                pc = next_pc;
+                                continue;

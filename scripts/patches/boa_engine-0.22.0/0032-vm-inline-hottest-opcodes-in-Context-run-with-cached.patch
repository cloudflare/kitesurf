+                                self.vm.stack.stack[rp + usize::from(rhs)].as_i32(),
+                            ) {
+                                self.vm.stack.stack[rp + usize::from(dst)] =
+                                    JsValue::new(a.wrapping_shr((b as u32) & 0x1f));
+                                pc = next_pc;
+                                continue;
+                            }
+                        }
+                        Opcode::UnsignedShiftRight => {
+                            let ((dst, lhs, rhs), next_pc) =
+                                <(RegisterOperand, RegisterOperand, RegisterOperand)>::decode(
+                                    slice,
+                                    pc + 1,

+        #[cfg(not(any(feature = "trace", feature = "fuzz")))]
+        {
+            'frame_reload: loop {
+                let frame = self.vm.frame();
+                let mut pc = frame.pc as usize;
+                let rp = frame.rp as usize;
+                // SAFETY: only `expand` writes the box, and only while it is empty; frames pin
+                // their bytecode so the slice stays valid until a fallback handler changes frames.
+                let bytes: *const [u8] = unsafe { frame.code_block.bytecode.executable() };
+                let bytes_len = unsafe { (&*bytes).len() };
+                if pc >= bytes_len {
+                    if frame.code_block.bytecode.is_packed() {
+                        frame.code_block.bytecode.expand();
+                        continue 'frame_reload;
+                    }
+                    break 'frame_reload;
+                }
+
+                // Inline the hottest non-frame-changing opcodes in a `br_table` loop with
+                // cached `pc`, `rp`, and `bytes` to avoid `call_indirect` and frame reloads.
+                loop {
+                    // SAFETY: `bytes` stays valid while this frame remains top-of-stack and no
+                    // fallback handler has run.
+                    let slice: &[u8] = unsafe { &*bytes };
+                    let Some(&byte) = slice.get(pc) else {
+                        self.vm.frame_mut().pc = pc as u32;
+                        break 'frame_reload;
+                    };
+                    let opcode = Opcode::decode(byte);
+
+                    match opcode {
+                        Opcode::Move => {
+                            let ((dst, src), next_pc) =
+                                <(RegisterOperand, RegisterOperand)>::decode(slice, pc + 1);
+                            let val = self.vm.stack.stack[rp + usize::from(src)].clone();
+                            self.vm.stack.stack[rp + usize::from(dst)] = val;
+                            pc = next_pc;
+                            continue;
+                        }
+                        Opcode::PushFromRegister => {
+                            let (src, next_pc) = RegisterOperand::decode(slice, pc + 1);
+                            let val = self.vm.stack.stack[rp + usize::from(src)].clone();
+                            self.vm.stack.push(val);
+                            pc = next_pc;
+                            continue;
+                        }
+                        Opcode::PopIntoRegister => {
+                            let (dst, next_pc) = RegisterOperand::decode(slice, pc + 1);
+                            let val = self.vm.stack.pop();
+                            self.vm.stack.stack[rp + usize::from(dst)] = val;
+                            pc = next_pc;
+                            continue;
+                        }
+                        Opcode::Pop => {
+                            let _ = self.vm.stack.pop();
+                            pc += 1;
+                            continue;
+                        }
+                        Opcode::SetRegisterFromAccumulator => {
+                            let (dst, next_pc) = RegisterOperand::decode(slice, pc + 1);
+                            let val = self.vm.get_return_value();
+                            self.vm.stack.stack[rp + usize::from(dst)] = val;
+                            pc = next_pc;
+                            continue;
+                        }
+                        Opcode::Jump => {
+                            let (address, _) = Address::decode(slice, pc + 1);
+                            pc = u32::from(address) as usize;
+                            continue;
+                        }
+                        Opcode::JumpIfFalse => {
+                            let ((address, val), next_pc) =
+                                <(Address, RegisterOperand)>::decode(slice, pc + 1);
+                            pc = if self.vm.stack.stack[rp + usize::from(val)].to_boolean() {
+                                next_pc
+                            } else {
+                                u32::from(address) as usize
+                            };
+                            continue;
+                        }
+                        Opcode::JumpIfTrue => {
+                            let ((address, val), next_pc) =
+                                <(Address, RegisterOperand)>::decode(slice, pc + 1);
+                            pc = if self.vm.stack.stack[rp + usize::from(val)].to_boolean() {
+                                u32::from(address) as usize
+                            } else {
+                                next_pc
+                            };
+                            continue;
+                        }
+                        Opcode::JumpIfNotLessThan => {
+                            let ((address, lhs, rhs), next_pc) =
+                                <(Address, RegisterOperand, RegisterOperand)>::decode(
+                                    slice,
+                                    pc + 1,
+                                );
+                            if let Some(lt) = self.vm.stack.stack[rp + usize::from(lhs)]
+                                .lt_fast(&self.vm.stack.stack[rp + usize::from(rhs)])
+                            {
+                                pc = if lt {
+                                    next_pc
+                                } else {
+                                    u32::from(address) as usize
+                                };
+                                continue;
+                            }
+                        }
+                        Opcode::JumpIfNotLessThanOrEqual => {
+                            let ((address, lhs, rhs), next_pc) =
+                                <(Address, RegisterOperand, RegisterOperand)>::decode(
+                                    slice,
+                                    pc + 1,
+                                );
+                            if let Some(le) = self.vm.stack.stack[rp + usize::from(lhs)]
+                                .le_fast(&self.vm.stack.stack[rp + usize::from(rhs)])
+                            {
+                                pc = if le {
+                                    next_pc
+                                } else {
+                                    u32::from(address) as usize
+                                };
+                                continue;
+                            }
+                        }
+                        Opcode::StoreZero => {
+                            let (dst, next_pc) = RegisterOperand::decode(slice, pc + 1);
+                            self.vm.stack.stack[rp + usize::from(dst)] = JsValue::new(0);
+                            pc = next_pc;
+                            continue;
+                        }
+                        Opcode::StoreOne => {
+                            let (dst, next_pc) = RegisterOperand::decode(slice, pc + 1);
+                            self.vm.stack.stack[rp + usize::from(dst)] = JsValue::new(1);
+                            pc = next_pc;
+                            continue;
+                        }
+                        Opcode::StoreInt8 => {
+                            let ((dst, v), next_pc) =
+                                <(RegisterOperand, i8)>::decode(slice, pc + 1);
+                            self.vm.stack.stack[rp + usize::from(dst)] = JsValue::new(i32::from(v));
+                            pc = next_pc;
+                            continue;
+                        }
+                        Opcode::StoreInt16 => {
+                            let ((dst, v), next_pc) =
+                                <(RegisterOperand, i16)>::decode(slice, pc + 1);
+                            self.vm.stack.stack[rp + usize::from(dst)] = JsValue::new(i32::from(v));
+                            pc = next_pc;
+                            continue;
+                        }
+                        Opcode::StoreInt32 => {
+                            let ((dst, v), next_pc) =
+                                <(RegisterOperand, i32)>::decode(slice, pc + 1);
+                            self.vm.stack.stack[rp + usize::from(dst)] = JsValue::new(v);
+                            pc = next_pc;
+                            continue;
+                        }
+                        Opcode::StoreUndefined => {
+                            let (dst, next_pc) = RegisterOperand::decode(slice, pc + 1);
+                            self.vm.stack.stack[rp + usize::from(dst)] = JsValue::undefined();
+                            pc = next_pc;
+                            continue;
+                        }
+                        Opcode::StoreNull => {
+                            let (dst, next_pc) = RegisterOperand::decode(slice, pc + 1);
+                            self.vm.stack.stack[rp + usize::from(dst)] = JsValue::null();
+                            pc = next_pc;
+                            continue;
+                        }
+                        Opcode::StoreTrue => {
+                            let (dst, next_pc) = RegisterOperand::decode(slice, pc + 1);
+                            self.vm.stack.stack[rp + usize::from(dst)] = JsValue::new(true);
+                            pc = next_pc;
+                            continue;
+                        }
+                        Opcode::StoreFalse => {
+                            let (dst, next_pc) = RegisterOperand::decode(slice, pc + 1);
+                            self.vm.stack.stack[rp + usize::from(dst)] = JsValue::new(false);
+                            pc = next_pc;
+                            continue;
+                        }
+                        Opcode::StoreLiteral => {
+                            let ((dst, index), next_pc) =
+                                <(RegisterOperand, IndexOperand)>::decode(slice, pc + 1);
+                            let val: JsValue = match &self.vm.frame().code_block().body().constants
+                                [usize::from(index)]
+                            {
+                                Constant::BigInt(v) => v.clone().into(),
+                                Constant::String(v) => v.clone().into(),
+                                _ => unreachable!("constant should be a string or bigint"),
+                            };
+                            self.vm.stack.stack[rp + usize::from(dst)] = val;
+                            pc = next_pc;
+                            continue;
+                        }
+                        Opcode::Inc => {
+                            let ((dst, src), next_pc) =
+                                <(RegisterOperand, RegisterOperand)>::decode(slice, pc + 1);
+                            if let Some(n) = self.vm.stack.stack[rp + usize::from(src)].as_i32()
+                                && let Some(inc) = n.checked_add(1)

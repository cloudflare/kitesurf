+                            pc = next_pc;
+                            continue;
+                        }
+                        Opcode::StrictNotEq => {
+                            let ((dst, lhs, rhs), next_pc) =
+                                <(RegisterOperand, RegisterOperand, RegisterOperand)>::decode(
+                                    slice,
+                                    pc + 1,
+                                );
+                            let eq = JsValue::strict_equals(
+                                &self.vm.stack.stack[rp + usize::from(lhs)],
+                                &self.vm.stack.stack[rp + usize::from(rhs)],
+                            );
+                            self.vm.stack.stack[rp + usize::from(dst)] = JsValue::new(!eq);
+                            pc = next_pc;
+                            continue;
+                        }
+                        Opcode::LessThan => {
+                            let ((dst, lhs, rhs), next_pc) =
+                                <(RegisterOperand, RegisterOperand, RegisterOperand)>::decode(
+                                    slice,
+                                    pc + 1,
+                                );
+                            if let Some(lt) = self.vm.stack.stack[rp + usize::from(lhs)]
+                                .lt_fast(&self.vm.stack.stack[rp + usize::from(rhs)])
+                            {
+                                self.vm.stack.stack[rp + usize::from(dst)] = JsValue::new(lt);
+                                pc = next_pc;
+                                continue;
+                            }
+                        }
+                        Opcode::LessThanOrEq => {
+                            let ((dst, lhs, rhs), next_pc) =
+                                <(RegisterOperand, RegisterOperand, RegisterOperand)>::decode(
+                                    slice,
+                                    pc + 1,
+                                );
+                            if let Some(le) = self.vm.stack.stack[rp + usize::from(lhs)]
+                                .le_fast(&self.vm.stack.stack[rp + usize::from(rhs)])
+                            {
+                                self.vm.stack.stack[rp + usize::from(dst)] = JsValue::new(le);
+                                pc = next_pc;
+                                continue;
+                            }
+                        }
+                        Opcode::GreaterThan => {
+                            let ((dst, lhs, rhs), next_pc) =
+                                <(RegisterOperand, RegisterOperand, RegisterOperand)>::decode(
+                                    slice,
+                                    pc + 1,
+                                );
+                            if let Some(gt) = self.vm.stack.stack[rp + usize::from(rhs)]
+                                .lt_fast(&self.vm.stack.stack[rp + usize::from(lhs)])
+                            {
+                                self.vm.stack.stack[rp + usize::from(dst)] = JsValue::new(gt);
+                                pc = next_pc;
+                                continue;
+                            }
+                        }
+                        Opcode::GreaterThanOrEq => {
+                            let ((dst, lhs, rhs), next_pc) =
+                                <(RegisterOperand, RegisterOperand, RegisterOperand)>::decode(
+                                    slice,
+                                    pc + 1,
+                                );
+                            if let Some(ge) = self.vm.stack.stack[rp + usize::from(rhs)]
+                                .le_fast(&self.vm.stack.stack[rp + usize::from(lhs)])

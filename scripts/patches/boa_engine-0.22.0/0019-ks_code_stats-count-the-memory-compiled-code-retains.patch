--- a/src/vm/opcode/mod.rs
+++ b/src/vm/opcode/mod.rs
@@ -264,10 +264,17 @@ impl Clone for Bytecode {
             len: self.len,
         };
         self.packed.set(packed);
+        clone.charge(1);

@@ -126,6 +132,25 @@ pub(crate) struct Stack {
     stack: Vec<JsValue>,
 }

+/// Stack-allocated argument buffer for up to 4 call arguments, avoiding a heap
+/// `Vec` allocation on every built-in or host proxy call.
+pub(crate) enum CallArgs {
+    Inline { len: u8, data: [JsValue; 4] },
+    Heap(Vec<JsValue>),
+}
+
+impl Deref for CallArgs {
+    type Target = [JsValue];
+
+    #[inline]
+    fn deref(&self) -> &[JsValue] {
+        match self {
+            Self::Inline { len, data } => &data[..usize::from(*len)],
+            Self::Heap(vec) => vec.as_slice(),
+        }
+    }
+}
+
 impl Stack {
     /// Creates a new stack with the given capacity.
     fn new(capacity: usize) -> Self {
@@ -233,6 +258,34 @@ impl Stack {
         self.stack.pop().expect("stack was empty")
     }

+    /// Pop the function arguments according to the calling convention into a stack-allocated
+    /// buffer when there are at most 4 arguments, falling back to a heap `Vec` otherwise.
+    #[inline]
+    pub(crate) fn calling_convention_pop_call_args(&mut self, argument_count: usize) -> CallArgs {
+        if argument_count == 0 {
+            return CallArgs::Inline {
+                len: 0,
+                data: [const { JsValue::undefined() }; 4],
+            };
+        }
+        if argument_count <= 4 {
+            let mut data = [const { JsValue::undefined() }; 4];
+            let base = self.stack.len() - argument_count;
+            for (dst, src) in data[..argument_count]
+                .iter_mut()
+                .zip(self.stack.drain(base..))
+            {
+                *dst = src;
+            }
+            return CallArgs::Inline {
+                len: argument_count as u8,
+                data,
+            };
+        }
+        let index = self.stack.len() - argument_count;
+        CallArgs::Heap(self.stack.split_off(index))
+    }
+
     /// Pop the function arguments according to the calling convention.
     /// This will pop the last `argument_count` values from the stack.
     pub(crate) fn calling_convention_pop_arguments(

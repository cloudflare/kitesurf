 src/vm/code_block.rs          | 28 ++++++++++++++++++++--------
 src/vm/inline_cache/tests.rs  | 34 +++++++++++++++++-----------------
 src/vm/opcode/get/name.rs     |  4 ++--
 src/vm/opcode/get/property.rs |  4 ++--
 src/vm/opcode/mod.rs          |  4 +---
 src/vm/opcode/set/property.rs |  4 ++--
 7 files changed, 51 insertions(+), 40 deletions(-)


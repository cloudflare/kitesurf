+    /// Appends `value` at `index` when `self` holds dense indexed properties and
+    /// `index` equals the current dense length. Returns `true` if appended.
+    pub(crate) fn push_dense_property(&mut self, index: u32, value: &JsValue) -> bool {
+        let index = index as usize;
+
+        match &mut self.indexed_properties {
+            IndexedProperties::DenseI32(properties) => {
+                if properties.len() != index {
+                    return false;
+                }
+
+                // If it can fit in an i32 and the truncated version is equal to the original
+                // (preserving -0.0 as f64), keep dense i32 storage.
+                let is_rational_integer = |n: f64| n.to_bits() == f64::from(n as i32).to_bits();
+
+                match value.variant() {
+                    JsVariant::Integer32(n) => properties.push(n),
+                    JsVariant::Float64(n) if is_rational_integer(n) => properties.push(n as i32),
+                    JsVariant::Float64(n) => {
+                        let mut wide = ThinVec::with_capacity(properties.len() + 1);
+                        wide.extend(properties.iter().copied().map(f64::from));
+                        wide.push(n);
+                        self.indexed_properties = IndexedProperties::DenseF64(wide);
+                    }
+                    _ => {
+                        let mut wide = ThinVec::with_capacity(properties.len() + 1);
+                        wide.extend(properties.iter().copied().map(JsValue::from));
+                        wide.push(value.clone());
+                        self.indexed_properties = IndexedProperties::DenseElement(wide);
+                    }
+                }
+                true
+            }
+            IndexedProperties::DenseF64(properties) => {
+                if properties.len() != index {
+                    return false;
+                }
+                if let Some(n) = value.as_number() {
+                    properties.push(n);
+                } else {
+                    let mut wide = ThinVec::with_capacity(properties.len() + 1);
+                    wide.extend(properties.iter().copied().map(JsValue::from));
+                    wide.push(value.clone());
+                    self.indexed_properties = IndexedProperties::DenseElement(wide);
+                }
+                true
+            }
+            IndexedProperties::DenseElement(properties) => {
+                if properties.len() != index {
+                    return false;
+                }
+                properties.push(value.clone());
+                true
+            }
+            IndexedProperties::SparseProperty(_) | IndexedProperties::SparseElement(_) => false,
+        }
+    }
+

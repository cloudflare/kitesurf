+/// Fast `TypedArrayGetElement` for a `u32` index already proven non-negative and integral.
+pub(crate) fn typed_array_get_element_u32(obj: &JsObject, index: u32) -> Option<JsValue> {
+    let inner = obj.downcast_ref::<TypedArray>()?;
+    let buffer = inner.viewed_array_buffer();
+    let buffer = buffer.as_buffer();
+    let buffer = buffer.bytes(Ordering::Relaxed)?;
+    let index = inner.validate_index_u64(u64::from(index), buffer.len())?;
+    let offset = inner.byte_offset();
+    let size = inner.kind.element_size();
+    let byte_index = ((index * size) + offset) as usize;
+    let elem_type = inner.kind();
+    // SAFETY: `TypedArray` guarantees buffer alignment and `validate_index_u64` checked bounds.
+    let value = unsafe {
+        buffer
+            .subslice(byte_index..)
+            .get_value(elem_type, Ordering::Relaxed)
+    };
+    Some(value.into())
+}
+
+/// Fast `TypedArraySetElement` for a `u32` index already proven non-negative and integral.
+pub(crate) fn typed_array_set_element_u32(
+    obj: &JsObject,
+    index: u32,
+    value: &JsValue,
+    context: &mut Context,
+) -> JsResult<()> {
+    let elem_type = obj
+        .downcast_ref::<TypedArray>()
+        .js_expect("typed_array_set_element_u32 requires a TypedArray")?
+        .kind();
+
+    // Perform ToNumber/ToBigInt before validating the buffer, matching spec steps 1-2.
+    let element = elem_type.get_element(value, context)?;
+
+    let inner = obj
+        .downcast_ref::<TypedArray>()
+        .js_expect("typed_array_set_element_u32 requires a TypedArray")?;
+    let mut buffer = inner.viewed_array_buffer().as_buffer_mut();
+    let Some(mut buffer) = buffer.bytes(Ordering::Relaxed) else {
+        return Ok(());
+    };
+    let Some(index) = inner.validate_index_u64(u64::from(index), buffer.len()) else {
+        return Ok(());
+    };
+    let offset = inner.byte_offset();
+    let size = elem_type.element_size();
+    let byte_index = ((index * size) + offset) as usize;
+    // SAFETY: `TypedArray` guarantees buffer alignment and `validate_index_u64` checked bounds.
+    unsafe {
+        buffer
+            .subslice_mut(byte_index..)
+            .set_value(element, Ordering::Relaxed);
+    }
+    Ok(())
+}

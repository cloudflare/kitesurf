+fn prototype_chain_has_no_indexed_properties(obj: &JsObject) -> bool {
+    let mut cur = obj.prototype();
+    while let Some(proto) = cur {
+        let vtable = proto.vtable();
+        if !ptr::eq(vtable, &ORDINARY_INTERNAL_METHODS)
+            && !ptr::eq(vtable, &ARRAY_EXOTIC_INTERNAL_METHODS)
+        {
+            return false;
+        }
+        if !proto.borrow().properties().indexed_properties.is_empty() {
+            return false;
+        }
+        cur = proto.prototype();
+    }
+    true
+}
+
+fn try_set_dense_array_index(
+    object: &JsObject,
+    index: u32,
+    value: &JsValue,
+    receiver_is_object: bool,
+    array_template_shape_addr: usize,
+) -> bool {
+    if !receiver_is_object {
+        return false;
+    }
+
+    // Fast overwrite of an existing dense element.
+    {
+        let mut object_borrowed = object.borrow_mut();
+        if !object_borrowed.extensible {
+            return false;
+        }
+        if object_borrowed
+            .properties_mut()
+            .set_dense_property(index, value)
+        {
+            return true;
+        }
+        // Only append when shape matches the default Array template
+        // (writable `length` at storage[0]) and index + 1 fits within max array length.
+        if index >= u32::MAX - 1
+            || object_borrowed.properties().shape.to_addr_usize() != array_template_shape_addr
+        {
+            return false;
+        }
+    }
+
+    if !prototype_chain_has_no_indexed_properties(object) {
+        return false;
+    }
+
+    let mut object_borrowed = object.borrow_mut();
+    let old_len = match object_borrowed.properties().storage[0].variant() {
+        JsVariant::Integer32(n) if n >= 0 => n as u32,
+        JsVariant::Float64(n) if n >= 0.0 && n <= f64::from(u32::MAX) && n.fract() == 0.0 => {
+            n as u32
+        }
+        _ => return false,
+    };
+    if !object_borrowed
+        .properties_mut()
+        .push_dense_property(index, value)
+    {
+        return false;
+    }
+    let new_len = index + 1;
+    if new_len > old_len {
+        object_borrowed.properties_mut().storage[0] = JsValue::new(new_len);
+    }
+    true
+}

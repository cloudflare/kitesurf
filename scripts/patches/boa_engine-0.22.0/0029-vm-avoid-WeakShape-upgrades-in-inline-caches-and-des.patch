@@ -709,38 +711,63 @@ pub(crate) fn ordinary_get(
     receiver: JsValue,
     context: &mut InternalMethodPropertyContext<'_>,
 ) -> JsResult<JsValue> {
-    // 1. Assert: IsPropertyKey(P) is true.
-    // 2. Let desc be ? O.[[GetOwnProperty]](P).
-    match obj.__get_own_property__(key, context)? {
-        // If desc is undefined, then
-        None => {
-            // a. Let parent be ? O.[[GetPrototypeOf]]().
-            if let Some(parent) = obj.__get_prototype_of__(context)? {
-                context.slot().set_not_cacheable_if_already_prototype();
-                context.slot().attributes |= SlotAttributes::PROTOTYPE;
-
-                // c. Return ? parent.[[Get]](P, Receiver).
-                parent.__get__(key, receiver, context)
-            }
-            // b. If parent is null, return undefined.
-            else {
-                Ok(JsValue::undefined())
+    let mut current = obj.clone();
+    loop {
+        let vtable = current.vtable();
+        let uses_ordinary_own_and_proto = ptr::fn_addr_eq(
+            vtable.__get_own_property__,
+            ORDINARY_INTERNAL_METHODS.__get_own_property__,
+        ) && ptr::fn_addr_eq(
+            vtable.__get_prototype_of__,
+            ORDINARY_INTERNAL_METHODS.__get_prototype_of__,
+        );
+        if uses_ordinary_own_and_proto {
+            let found = current
+                .borrow()
+                .properties
+                .get_value_with_slot(key, context.slot());
+            match found {
+                Some(PropertyValue::Data(value)) => return Ok(value),
+                Some(PropertyValue::Getter(getter)) => {
+                    return getter.call(&receiver, &[], context);
+                }
+                Some(PropertyValue::UndefinedGetter) => return Ok(JsValue::undefined()),
+                None => {
+                    let Some(parent) = current.prototype() else {
+                        return Ok(JsValue::undefined());
+                    };
+                    context.slot().set_not_cacheable_if_already_prototype();
+                    context.slot().attributes |= SlotAttributes::PROTOTYPE;
+                    if ptr::fn_addr_eq(parent.vtable().__get__, ORDINARY_INTERNAL_METHODS.__get__)
+                    {
+                        current = parent;
+                        continue;
+                    }
+                    return parent.__get__(key, receiver, context);
+                }
             }
         }
-        Some(ref desc) => {
-            match desc.kind() {
-                // 4. If IsDataDescriptor(desc) is true, return desc.[[Value]].
-                DescriptorKind::Data {
-                    value: Some(value), ..
-                } => Ok(value.clone()),
-                // 5. Assert: IsAccessorDescriptor(desc) is true.
-                // 6. Let getter be desc.[[Get]].
-                DescriptorKind::Accessor { get: Some(get), .. } if !get.is_undefined() => {
-                    // 8. Return ? Call(getter, Receiver).
-                    get.call(&receiver, &[], context)
+
+        // Fallback for objects whose [[GetOwnProperty]] or [[GetPrototypeOf]] is exotic.
+        match current.__get_own_property__(key, context)? {
+            None => {
+                if let Some(parent) = current.__get_prototype_of__(context)? {
+                    context.slot().set_not_cacheable_if_already_prototype();
+                    context.slot().attributes |= SlotAttributes::PROTOTYPE;
+                    return parent.__get__(key, receiver, context);
                 }
-                // 7. If getter is undefined, return undefined.
-                _ => Ok(JsValue::undefined()),
+                return Ok(JsValue::undefined());
+            }
+            Some(ref desc) => {
+                return match desc.kind() {
+                    DescriptorKind::Data {
+                        value: Some(value), ..
+                    } => Ok(value.clone()),
+                    DescriptorKind::Accessor { get: Some(get), .. } if !get.is_undefined() => {
+                        get.call(&receiver, &[], context)
+                    }
+                    _ => Ok(JsValue::undefined()),
+                };
             }
         }
     }

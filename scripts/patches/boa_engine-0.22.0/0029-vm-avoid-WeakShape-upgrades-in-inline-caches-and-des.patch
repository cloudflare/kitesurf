     #[must_use]
@@ -554,6 +564,64 @@ impl PropertyMap {
         None
     }

+    /// Direct read of an own property's value or getter without building a [`PropertyDescriptor`].
+    #[must_use]
+    pub(crate) fn get_value_with_slot(
+        &self,
+        key: &PropertyKey,
+        out_slot: &mut Slot,
+    ) -> Option<PropertyValue> {
+        if let PropertyKey::Index(index) = key {
+            let idx = index.get();
+            return match &self.indexed_properties {
+                IndexedProperties::DenseI32(vec) => vec
+                    .get(idx as usize)
+                    .copied()
+                    .map(|v| PropertyValue::Data(v.into())),
+                IndexedProperties::DenseF64(vec) => vec
+                    .get(idx as usize)
+                    .copied()
+                    .map(|v| PropertyValue::Data(v.into())),
+                IndexedProperties::DenseElement(vec) => {
+                    vec.get(idx as usize).cloned().map(PropertyValue::Data)
+                }
+                IndexedProperties::SparseElement(map) => {
+                    map.get(&idx).cloned().map(PropertyValue::Data)
+                }
+                IndexedProperties::SparseProperty(map) => {
+                    let desc = map.get(&idx)?;
+                    Some(match desc.kind() {
+                        DescriptorKind::Data {
+                            value: Some(value), ..
+                        } => PropertyValue::Data(value.clone()),
+                        DescriptorKind::Accessor { get: Some(get), .. } if !get.is_undefined() => {
+                            PropertyValue::Getter(get.clone())
+                        }
+                        _ => PropertyValue::UndefinedGetter,
+                    })
+                }
+            };
+        }
+        if let Some(slot) = self.shape.lookup(key) {
+            out_slot.index = slot.index;
+            out_slot.attributes = (out_slot.attributes & SlotAttributes::INLINE_CACHE_BITS)
+                | slot.attributes
+                | SlotAttributes::FOUND;
+            let idx = slot.index as usize;
+            if slot.attributes.is_accessor_descriptor() {
+                if slot.attributes.has_get() {
+                    let getter = &self.storage[idx];
+                    if !getter.is_undefined() {
+                        return Some(PropertyValue::Getter(getter.clone()));
+                    }
+                }
+                return Some(PropertyValue::UndefinedGetter);
+            }
+            return Some(PropertyValue::Data(self.storage[idx].clone()));
+        }
+        None
+    }
+
     /// Get the property with the given key from the [`PropertyMap`].
     #[must_use]
     pub(crate) fn get_with_slot(

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bpereira <bpereira@cloudflare.com>
Date: Fri, 20 Nov 2026 09:36:29 +0000
Subject: [PATCH] Add direct-mapped VM megamorphic property cache for
 SharedShape own slots

Cache own SharedShape property slots on ordinary objects in a 256-entry direct-mapped WeakShape cache on Vm for megamorphic Get/SetPropertyByName sites and string-keyed GetPropertyByValue.
---
 src/vm/inline_cache/mod.rs    | 71 ++++++++++++++++++++++++++++++++++-
 src/vm/mod.rs                 |  2 +
 src/vm/opcode/get/property.rs | 46 +++++++++++++++++++----
 src/vm/opcode/set/property.rs | 29 +++++++++++++-
 4 files changed, 138 insertions(+), 10 deletions(-)

diff --git a/src/vm/inline_cache/mod.rs b/src/vm/inline_cache/mod.rs
index c3b3601..449de0b 100644
--- a/src/vm/inline_cache/mod.rs
+++ b/src/vm/inline_cache/mod.rs
@@ -7,13 +7,82 @@ use boa_macros::{Finalize, Trace};

 use crate::{
     JsString,
-    object::shape::{Shape, WeakShape, slot::Slot},
+    object::shape::{
+        Shape, WeakShape,
+        slot::{Slot, SlotAttributes},
+    },
 };

 #[cfg(test)]
 mod tests;

 pub(crate) const PIC_CAPACITY: usize = 4;
+const MEGAMORPHIC_CACHE_SIZE: usize = 256;
+
+#[derive(Clone, Debug)]
+struct MegamorphicEntry {
+    shape: WeakShape,
+    shape_addr: usize,
+    name: JsString,
+    slot: Slot,
+}
+
+/// Direct-mapped VM-wide cache for own properties on immutable [`SharedShape`]s
+/// accessed from megamorphic sites or string-keyed `GetPropertyByValue`.
+#[derive(Debug)]
+pub(crate) struct MegamorphicCache {
+    entries: Box<[Option<MegamorphicEntry>; MEGAMORPHIC_CACHE_SIZE]>,
+}
+
+impl Default for MegamorphicCache {
+    fn default() -> Self {
+        Self {
+            entries: Box::new([const { None }; MEGAMORPHIC_CACHE_SIZE]),
+        }
+    }
+}
+
+impl MegamorphicCache {
+    #[inline(always)]
+    fn slot_index(shape_addr: usize, name: &JsString) -> usize {
+        let len = name.len();
+        let first = name.code_unit_at(0).unwrap_or(0) as usize;
+        let last = if len > 1 {
+            name.code_unit_at(len - 1).unwrap_or(0) as usize
+        } else {
+            0
+        };
+        let name_hash = len ^ (first << 5) ^ (last << 11);
+        ((shape_addr >> 4).wrapping_mul(0x9E37_79B9) ^ name_hash) & (MEGAMORPHIC_CACHE_SIZE - 1)
+    }
+
+    #[inline]
+    pub(crate) fn get(&self, shape: &Shape, name: &JsString) -> Option<Slot> {
+        let shape_addr = shape.to_addr_usize();
+        let entry = self.entries[Self::slot_index(shape_addr, name)].as_ref()?;
+        if entry.shape_addr == shape_addr && entry.shape.is_upgradable() && entry.name == *name {
+            return Some(entry.slot);
+        }
+        None
+    }
+
+    pub(crate) fn set(&mut self, shape: &Shape, name: &JsString, slot: Slot) {
+        if !shape.is_shared()
+            || !slot.is_cacheable()
+            || slot.attributes.contains(SlotAttributes::PROTOTYPE)
+        {
+            return;
+        }
+        let shape_addr = shape.to_addr_usize();
+        let idx = Self::slot_index(shape_addr, name);
+        self.entries[idx] = Some(MegamorphicEntry {
+            shape: shape.into(),
+            shape_addr,
+            name: name.clone(),
+            slot,
+        });
+    }
+}

 /// A cached shape-to-slot mapping for a polymorphic inline cache.
 #[derive(Clone, Debug, Trace, Finalize)]

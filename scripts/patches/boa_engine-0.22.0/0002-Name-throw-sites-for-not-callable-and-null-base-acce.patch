 src/vm/opcode/call/mod.rs     | 41 ++++++++++++++-----------
 src/vm/opcode/get/property.rs | 13 ++++++--
 src/vm/opcode/mod.rs          | 58 +++++++++++++++++++++++++++++++++++
 src/vm/opcode/set/property.rs | 12 ++++++--
 5 files changed, 120 insertions(+), 30 deletions(-)


+// Names the enclosing function, built only on the throw path and kept
+// out of line so the hot primitive arms of to_object/base_class stay small.
+#[cold]
+#[inline(never)]
+fn null_to_object_error(context: &Context) -> crate::JsError {
+    JsNativeError::typ()
+        .with_message(format!(
+            "cannot convert 'null' or 'undefined' to object (in fn '{}')",
+            context
+                .vm
+                .frame()
+                .code_block()
+                .name()
+                .to_std_string_escaped()
+        ))
+        .into()
+}

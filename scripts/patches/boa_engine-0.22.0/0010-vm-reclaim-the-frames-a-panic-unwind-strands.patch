From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Mon, 17 Aug 2026 11:52:29 +0100
Subject: [PATCH] vm: reclaim the frames a panic unwind strands

A panic out of the interpreter (boa's own `index out of bounds` on a
minified third-party script, say) unwinds straight past every
`pop_frame`, so the frames it was running stay on `vm.frames` and their
registers stay on `vm.stack` for the life of the context. Nothing ever
undercuts them: `ks_clear_residual_stack` only touches the value stack
when no frames are left, which is exactly what a strand rules out.

The residue then only grows, and once it reaches `stack_size_limit`
every execution throws "exceeded maximum call stack length". The
embedder is left with a context that can no longer run JS.

Reclaim the frames too, gated on `ks_execution_depth() == 0`: with no
bytecode run live on the native stack, whatever is on the VM is by
definition unreachable. The counter is a thread-local kept by a Drop
guard in `run`/`run_async_with_budget`, so it unwinds with the panic
rather than counting it forever. Popping (not truncating) restores the
environment and realm each frame saved, the same way a normal return
does.

JsObject::call/construct track host_call_depth with a manual increment
and decrement that a panic also skips, which inflates the recursion
count for good, so the reclaim resets it too. The VM's dummy frame is
never popped.
---
 src/context/mod.rs | 20 +++++++++++++-------
 src/vm/mod.rs      | 31 +++++++++++++++++++++++++++++++
 2 files changed, 44 insertions(+), 7 deletions(-)

diff --git a/src/context/mod.rs b/src/context/mod.rs
index 144240c..982dedf 100644
--- a/src/context/mod.rs
+++ b/src/context/mod.rs
@@ -494,16 +494,22 @@ impl Context {
         self.job_executor().enqueue_job(job, self);
     }

-    /// With only the dummy frame left, stack content is residue an unwind
-    /// leaked (it would trip stack_size_limit forever); drop it, returning the count.
+    /// With no bytecode run live, whatever an unwind or panic left on the VM
+    /// is garbage that would trip the limits forever; reclaim it, returning the slots freed.
     #[inline]
     pub fn ks_clear_residual_stack(&mut self) -> usize {
-        if self.vm.frames.len() <= 1 && self.vm.stack.len() > 0 {
-            let n = self.vm.stack.len();
-            self.vm.stack.clear();
-            return n;
+        // A panic unwind skips every `pop_frame` and every host-call decrement, so
+        // stranded frames pin their registers and the recursion count never drops.
+        if crate::vm::ks_execution_depth() != 0 {
+            return 0;
         }
-        0
+        while self.vm.pop_frame().is_some() {}
+        self.vm.host_call_depth = 0;
+        self.vm.pending_exception = None;
+        self.vm.set_return_value(JsValue::undefined());
+        let n = self.vm.stack.len();
+        self.vm.stack.clear();
+        n
     }

     /// (call frames excluding the dummy, value-stack slots). frames == 0
diff --git a/src/vm/mod.rs b/src/vm/mod.rs
index 00a2c09..85f3b47 100644
--- a/src/vm/mod.rs
+++ b/src/vm/mod.rs
@@ -687,6 +687,35 @@ impl Vm {
     }
 }

+// How many bytecode runs are live on the native stack. An embedder that
+// survives panics needs to know when what is left on the VM is garbage.
+thread_local! {
+    static KS_EXEC_DEPTH: std::cell::Cell<usize> = const { std::cell::Cell::new(0) };
+}
+
+/// Zero means no `run`/`run_async_with_budget` is executing, so anything
+/// left on `vm.frames`/`vm.stack` was stranded by a panic unwind.
+pub(crate) fn ks_execution_depth() -> usize {
+    KS_EXEC_DEPTH.with(std::cell::Cell::get)
+}
+
+// Drop (not a plain decrement) so the count is restored while a panic unwinds
+// through the interpreter, which is the case that matters.
+struct KsExecDepthGuard;
+
+impl KsExecDepthGuard {
+    fn enter() -> Self {
+        KS_EXEC_DEPTH.with(|d| d.set(d.get() + 1));
+        Self
+    }
+}
+
+impl Drop for KsExecDepthGuard {
+    fn drop(&mut self) {
+        KS_EXEC_DEPTH.with(|d| d.set(d.get().saturating_sub(1)));
+    }
+}
+

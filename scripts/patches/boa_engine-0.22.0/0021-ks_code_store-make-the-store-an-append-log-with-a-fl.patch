From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lu=C3=ADs=20Duarte?= <lduarte@cloudflare.com>
Date: Fri, 16 Oct 2026 16:26:42 +0100
Subject: [PATCH] ks_code_store: make the store an append log with a flush
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The store took one whole value per put and released by key alone,
which fits a script's source (kilobytes to megabytes) but not a
function's bytecode, about a hundred bytes: one store row each would
cost more than it frees. An embedder now appends: keys are u32 log
offsets, small values can share storage until flush, which every swap
round ends with, and release names the length it frees, so the store
can count live bytes per row without a key table.

ks_swap_at_idle replaces ks_swap_source_texts as the one idle entry
point, so later kinds of swap join the same round and the same flush.

beep-boop-🤖
---
 src/ks_code_store.rs       | 45 ++++++++++++++++++++++++--------------
 src/ks_swap.rs             | 15 +++++++++++++
 src/lib.rs                 |  5 ++++-
 src/spanned_source_text.rs | 23 +++++++++++++------
 4 files changed, 63 insertions(+), 25 deletions(-)
 create mode 100644 src/ks_swap.rs

diff --git a/src/ks_code_store.rs b/src/ks_code_store.rs
index 9085083..13c004d 100644
--- a/src/ks_code_store.rs
+++ b/src/ks_code_store.rs
@@ -1,26 +1,30 @@
 //! Kitesurf: a place outside the heap where an embedder keeps bytes that compiled code
-//! rarely reads (a script's source text for `toString`), fetched back on demand.
+//! rarely reads (source text for `toString`, bytecode that has not run), fetched on demand.

 use std::{cell::RefCell, rc::Rc};

-/// Kitesurf: an embedder's store for cold code bytes. Every method may fail; a refused
-/// `put` keeps the bytes resident and a failed `read` falls back the way a reader chooses.
+/// Kitesurf: an embedder's append-only store for cold code bytes. A refused `put` keeps the
+/// bytes resident, and a failed `read` falls back the way its reader chooses.
 pub trait CodeStore {
-    /// Kitesurf: values smaller than this stay resident, since a store write and its
-    /// later delete cost more than the memory they would free.
+    /// Kitesurf: source texts smaller than this stay resident, since their write and later
+    /// delete cost more than the memory they would free. Bytecode has a floor of its own.
     fn min_bytes(&self) -> usize;

-    /// Kitesurf: stores `bytes` and returns the key to read them back with, or None to
-    /// keep them resident (the store is full, failing, or does not want them).
-    fn put(&self, bytes: &[u8]) -> Option<u64>;
+    /// Kitesurf: appends `bytes` and returns the key to read them back with, or None to keep
+    /// them resident. Small values share storage, so a put may only reach it at `flush`.
+    fn put(&self, bytes: &[u8]) -> Option<u32>;

-    /// Kitesurf: replaces `out` with `len` bytes of the value `key` from `offset` on.
-    /// Returns false when they cannot be read; `out` is then unspecified.
-    fn read(&self, key: u64, offset: usize, len: usize, out: &mut Vec<u8>) -> bool;
+    /// Kitesurf: replaces `out` with `len` bytes of the value `key` from `offset` on. Returns
+    /// false when they cannot be read; `out` is then unspecified.
+    fn read(&self, key: u32, offset: usize, len: usize, out: &mut Vec<u8>) -> bool;

-    /// Kitesurf: the value's owner is gone, so the store may drop it. Called at most
-    /// once per key, and possibly while the thread tears its state down.
-    fn release(&self, key: u64);
+    /// Kitesurf: the `len` bytes stored under `key` lost their owner. Called at most once
+    /// per key, and possibly while the thread tears its state down.
+    fn release(&self, key: u32, len: usize);
+
+    /// Kitesurf: persists what earlier puts left pending. Called at the end of every swap
+    /// round, so the store is never asked to hold an unbounded amount in waiting.
+    fn flush(&self);
 }

 thread_local! {
@@ -28,11 +32,18 @@ thread_local! {
 }

 /// Kitesurf: installs (or, with None, removes) this thread's code store. Values already
-/// stored keep the store they went to; source texts made from now on may be swapped.
+/// stored keep the store they went to; code made from now on may be swapped to this one.
 pub fn ks_set_code_store(store: Option<Rc<dyn CodeStore>>) {
-    let _ = STORE.try_with(|s| *s.borrow_mut() = store);
+    let _ = STORE.try_with(|s| {
+        if let Ok(mut slot) = s.try_borrow_mut() {
+            *slot = store;
+        }
+    });
 }

 pub(crate) fn current() -> Option<Rc<dyn CodeStore>> {
-    STORE.try_with(|s| s.borrow().clone()).ok().flatten()
+    STORE
+        .try_with(|s| s.try_borrow().ok().and_then(|s| s.clone()))
+        .ok()
+        .flatten()
 }
diff --git a/src/ks_swap.rs b/src/ks_swap.rs
new file mode 100644
index 0000000..30b35f9
--- /dev/null
+++ b/src/ks_swap.rs
@@ -0,0 +1,15 @@
+//! Kitesurf: swap rounds, which hand cold code to the embedder's code store (ks_code_store)
+//! so it leaves memory that, in wasm, never shrinks.
+
+/// Kitesurf: swaps what outlived its eval since the last call and flushes the store; call it
+/// at quiescent points. Returns how many values went to the store.
+pub fn ks_swap_at_idle() -> usize {
+    let Some(store) = crate::ks_code_store::current() else {
+        return 0;
+    };
+    let swapped = crate::spanned_source_text::swap_source_texts();
+    if swapped > 0 {
+        store.flush();
+    }
+    swapped
+}
diff --git a/src/lib.rs b/src/lib.rs
index c54dd6f..9deef47 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -113,9 +113,12 @@ pub use ks_code_stats::ks_code_stats;
 mod ks_code_store;
 pub use ks_code_store::{CodeStore, ks_set_code_store};

+mod ks_swap;
+pub use ks_swap::ks_swap_at_idle;
+
 mod spanned_source_text;
 use spanned_source_text::SourceText;
-pub use spanned_source_text::{SpannedSourceText, ks_swap_source_texts};
+pub use spanned_source_text::SpannedSourceText;

 #[cfg(test)]
 mod tests;
diff --git a/src/spanned_source_text.rs b/src/spanned_source_text.rs
index 02cd197..a6dd1a8 100644
--- a/src/spanned_source_text.rs
+++ b/src/spanned_source_text.rs
@@ -14,7 +14,7 @@ enum Repr {
     Resident(boa_ast::SourceText),

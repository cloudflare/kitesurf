index e36442d..697874b 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -44,8 +44,13 @@ crossterm = ["ratatui/crossterm"]
 default = [
     "image-defaults",
     "crossterm",
+    "query",
 ]
 image-defaults = ["image/default"]
+query = [
+    "dep:rustix",
+    "dep:windows",
+]
 serde = ["dep:serde"]
 termion = ["ratatui/termion"]
 termwiz = ["ratatui/termwiz"]
@@ -138,6 +143,7 @@ features = [

 [target."cfg(not(windows))".dependencies.rustix]
 version = "^0.38.4"
+optional = true
 features = [
     "stdio",
     "termios",
@@ -146,6 +152,7 @@ features = [

 [target."cfg(windows)".dependencies.windows]

{
  "name": "triage bot: triagebot/* branches only",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": ["refs/heads/triagebot/**", "refs/heads/dependabot/**"]
    }
  },
  "bypass_actors": [
    {
      "actor_type": "RepositoryRole",
      "actor_id": 4,
      "bypass_mode": "always"
    },
    {
      "actor_type": "RepositoryRole",
      "actor_id": 2,
      "bypass_mode": "always"
    },
    {
      "actor_type": "RepositoryRole",
      "actor_id": 5,
      "bypass_mode": "always"
    }
  ],
  "rules": [
    {
      "type": "creation"
    },
    {
      "type": "update"
    },
    {
      "type": "deletion"
    }
  ]
}

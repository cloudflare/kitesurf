load("@pw_specs//:defs.bzl", PW_SPECS = "SPECS")
load(":defs.bzl", "pw_html_report", "pw_spec")

[pw_spec(name = spec, spec = spec) for spec in PW_SPECS]

filegroup(
    name = "specs",
    srcs = [":" + spec for spec in PW_SPECS],
)

pw_html_report(
    name = "html_report",
    specs = [":" + spec for spec in PW_SPECS],
)

test_suite(
    name = "expectations_test",
    tests = ["//scripts:pw_expectations_test"],
)

alias(
    name = "update_expectations",
    actual = "//scripts:pw_update_expectations",
)

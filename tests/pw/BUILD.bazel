load(":defs.bzl", "PW_SHARDS", "pw_shard")

[pw_shard(name = "shard_%d" % index, shard = index) for index in range(1, PW_SHARDS + 1)]

filegroup(
    name = "shards",
    srcs = [":shard_%d" % index for index in range(1, PW_SHARDS + 1)],
)

test_suite(
    name = "expectations_test",
    tests = ["//scripts:pw_expectations_test"],
)

alias(
    name = "update_expectations",
    actual = "//scripts:pw_update_expectations",
)

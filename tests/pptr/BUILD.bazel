load(":defs.bzl", "PPTR_SHARDS", "pptr_shard")

[pptr_shard(name = "shard_%d" % index, shard = index) for index in range(1, PPTR_SHARDS + 1)]

filegroup(
    name = "shards",
    srcs = [":shard_%d" % index for index in range(1, PPTR_SHARDS + 1)],
)

test_suite(
    name = "expectations_test",
    tests = ["//scripts:pptr_expectations_test"],
)

alias(
    name = "update_expectations",
    actual = "//scripts:pptr_update_expectations",
)

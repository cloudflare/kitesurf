{
  "name": "kitesurf",
  "private": true,
  "version": "0.0.1",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "format": "bazel run //scripts:lint -- format --write",
    "format:check": "bazel run //scripts:lint -- format --check",
    "lint": "bazel run //scripts:lint -- lint",
    "lint:js": "bazel run //scripts:lint -- lint:js",
    "lint:complexity": "bazel run //scripts:lint_complexity",
    "lint:rust": "bazel run //scripts:lint -- lint:rust",
    "lint:test": "bazel test //scripts:lint_test && cargo test --manifest-path scripts/lint/rust-check/Cargo.toml --locked nesting",
    "dev": "pnpm --filter @kitesurf/engine dev",
    "dev:memprof": "pnpm --filter @kitesurf/engine dev:memprof",
    "dev:tty-css": "pnpm --filter @kitesurf/tty-css-preview dev",
    "dev:tracing": "docker compose -f docker-compose.dev.yml up tracing",
    "dev:wpt": "pnpm --filter @kitesurf/engine dev:wpt",
    "bench:scene": "node scripts/bench-scene-record.mjs",
    "build": "bazel run //packages/engine:dev_build",
    "build:dist": "bazel build //packages/engine:dist",
    "webidl:generate": "node scripts/generate-webidl-bindings.mjs",
    "webidl:check": "bazel test //scripts:webidl_check",
    "script-gate:test": "bazel test //packages/script-gate:test",
    "tty-css-preview:test": "bazel test //packages/tty-css-preview:checks",
    "vendor:apply": "node scripts/get-patched-vendor-crates.mjs",
    "vendor:regen": "node scripts/regen-vendor-patches.mjs",
    "check": "bazel test //:check && bazel run //scripts:workspace_checks",
    "types:lint": "tsc -p scripts/lint/tsconfig.json",
    "test:vitest": "bazel test //packages/engine:vitest",
    "test:rust": "bazel test //packages/core:host_tests",
    "test:unit": "bazel test //packages/engine:vitest //packages/core:host_tests",
    "test:script-helpers": "bazel test //scripts:helpers_test",
    "test:e2e": "bazel run //packages/engine:e2e --",
    "test:e2e:all": "bazel test //tests/e2e:gate",
    "test:wpt": "node scripts/wpt-batched.mjs",
    "test:wpt:ci": "node scripts/wpt-batched.mjs --start-server",
    "test:wpt:fast": "node scripts/wpt-batched.mjs --skip-expected-timeouts --skip-expected-crashes --skip-slow",
    "test:playwright": "node scripts/pw-run.mjs",
    "pw:setup": "node scripts/pw-setup.mjs",
    "wpt:setup": "node scripts/wpt-setup.mjs",
    "wpt:serve": "node scripts/wpt-serve.mjs",
    "wpt:inventory": "node scripts/wpt-inventory.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@oxlint/plugins": "1.88.0",
    "@types/node": "^25.6.2",
    "dotenv": "^17.4.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^24.0.0",
    "typescript": "^5.6.0",
    "webidl2": "^24.5.0"
  },
  "pnpm": {
    "overrides": {
      "@cloudflare/puppeteer>devtools-protocol": "0.0.1669207"
    }
  }
}

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc"],
  "jsPlugins": ["./scripts/lint/index.ts"],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    "no-debugger": "error",
    "no-constant-condition": "error",
    "no-duplicate-case": "error",
    "no-unsafe-finally": "error",
    "no-unreachable": "error",
    "valid-typeof": "error",
    "eqeqeq": ["error", "smart"],
    "no-unused-vars": "error",
    "max-depth": ["error", 4],
    "max-params": ["error", { "max": 7, "countThis": "never" }],
    "oxc/no-accumulating-spread": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "separate-type-imports",
        "disallowTypeAnnotations": false
      }
    ],
    "kitesurf/no-chained-type-assertions": "error",
    "kitesurf/no-unnecessary-unknown": "error",
    "kitesurf/no-widen-then-assert": "error",
    "kitesurf/explicit-boundary-returns": "error",
    "kitesurf/concise-comments": "error"
  },
  "ignorePatterns": [
    "vendor/**",
    "**/vendor/**",
    "scripts/patches/**/*.patch",
    "**/LICENSE*",
    "**/NOTICE*",
    "**/COPYING*",
    "scripts/lint/ANTI_SLOP_LICENSE.txt",
    "**/*.generated.*",
    "**/*.gen.ts",
    "**/src/generated/**",
    "**/*.d.ts",
    "**/node_modules/**",
    "**/target/**",
    "**/dist/**",
    "**/pkg/**",
    ".wrangler/**",
    ".pnpm-store/**",
    ".cargo/**",
    ".cache/**",
    "output/**",
    "artifacts-metadata.json",
    ".wpt/**",
    ".playwright/**",
    ".puppeteer/**",
    ".base-wasm/**",
    "packages/engine/public/rbi/**",
    "packages/engine/wrangler.json",
    "packages/engine/wrangler.json.*.tmp",
    "**/.engine-dist/**",
    "**/.fixtures-dist/**",
    "packages/engine/test/e2e/idl-gaps.json",
    "packages/wpt-report/data/**",
    "pnpm-lock.yaml",
    "bench/fixtures/**",
    "packages/engine/test/fixtures-worker/assets/**",
    "packages/engine/test/e2e/html/**",
    "packages/core/tests_data/**",
    "packages/core/src/angular_snapshot.html",
    "examples/*-output.json",
    "bench/results/**",
    "bench/gold/*.actual.*"
  ]
}

{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 100,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "embeddedLanguageFormatting": "off",
  "sortImports": false,
  "sortPackageJson": false,
  "sortTailwindcss": false,
  "jsdoc": false,
  "ignorePatterns": [
    "licenses/**",
    "vendor/**",
    "**/vendor/**",
    "scripts/patches/**/*.patch",
    "**/LICENSE*",
    "**/NOTICE*",
    "**/COPYING*",
    "scripts/lint/ANTI_SLOP_LICENSE.txt",
    "**/*.generated.*",
    "**/*.gen.ts",
    "**/src/generated/**",
    "**/*.d.ts",
    "**/node_modules/**",
    "**/target/**",
    "**/dist/**",
    "**/pkg/**",
    ".wrangler/**",
    ".pnpm-store/**",
    ".cargo/**",
    ".cache/**",
    "output/**",
    "artifacts-metadata.json",
    ".wpt/**",
    ".playwright/**",
    ".base-wasm/**",
    "packages/engine/public/rbi/**",
    "packages/engine/wrangler.json",
    "packages/engine/wrangler.json.*.tmp",
    "**/.engine-dist/**",
    "**/.fixtures-dist/**",
    "packages/engine/test/e2e/idl-gaps.json",
    "packages/wpt-report/data/**",
    "tests/wpt-buckets.json",
    "pnpm-lock.yaml",
    "bench/fixtures/**",
    "packages/engine/test/fixtures-worker/assets/**",
    "packages/engine/test/e2e/html/**",
    "packages/core/tests_data/**",
    "packages/core/src/angular_snapshot.html",
    "examples/*-output.json",
    "bench/results/**",
    "bench/gold/*.actual.*"
  ]
}

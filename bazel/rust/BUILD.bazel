load("@rules_rust//rust/private:lto.bzl", "rust_lto_flag")
load("@rules_rust//rust:defs.bzl", "rust_shared_library")
load("@wasm32_unwind_std//:flags.bzl", "RUSTFLAGS")
load("//bazel:executors.bzl", "RUST")
load(":wasm32.bzl", "HOSTS", "wasm32_rust")
load("//bazel:rust_checks.bzl", "rust_comments_test", "rust_lint_tests", "rust_nesting_test")

constraint_setting(name = "panic")
constraint_value(name = "unwind", constraint_setting = ":panic")

constraint_setting(name = "exec_pool")
# Public so a module that wraps this one can put its own wasm32 toolchains on the same executor.
constraint_value(
    name = "rust_pool",
    constraint_setting = ":exec_pool",
    visibility = ["//visibility:public"],
)

platform(
    name = "rust_exec",
    constraint_values = [":rust_pool"],
    exec_properties = RUST,
    parents = ["@platforms//host"],
)

# One config_setting per supported execution platform (wasm32.bzl HOSTS).
[
    config_setting(
        name = host,
        constraint_values = constraints,
        visibility = ["//bazel:__subpackages__"],
    )
    for host, (_, constraints) in HOSTS.items()
]

# Build-std links its build scripts against the execution platform's prebuilt standard library.
alias(
    name = "host_std",
    actual = select({
        ":" + host: "@rust_exec_%s//:rust_std-%s" % (host, triple)
        for host, (triple, _) in HOSTS.items()
    }),
    visibility = ["//visibility:public"],
)

# Build-std tools follow the action's execution platform, not the Bazel client's host.
[
    alias(
        name = "exec_" + tool,
        actual = select({
            ":" + host: "@rust_exec_%s//:%s" % (host, tool)
            for host in HOSTS
        }),
    )
    for tool in ["cargo", "rustc", "rustc_lib", "rust-lld"]
]

rust_lto_flag(
    name = "lto_manual",
    build_setting_default = "manual",
)

wasm32_rust(
    name = "wasm32_unwind",
    constraint = ":unwind",
    rust_std = "@wasm32_unwind_std//:rust_std",
    rustflags = RUSTFLAGS,
)

constraint_setting(name = "stock_rustflags")
constraint_value(name = "scene_host", constraint_setting = ":stock_rustflags")
constraint_value(name = "memprof", constraint_setting = ":stock_rustflags")

wasm32_rust(
    name = "wasm32_scene_host",
    constraint = ":scene_host",
    rust_std = "@wasm32_stock_std//:rust_std",
    rustflags = ["-Ctarget-feature=+simd128"],
)

wasm32_rust(
    name = "wasm32_memprof",
    codegen_units = 16,
    constraint = ":memprof",
    rust_std = "@wasm32_stock_std//:rust_std",
    rustflags = [("panic=abort" if flag == "panic=unwind" else flag) for flag in RUSTFLAGS],
)

rust_shared_library(
    name = "unwind_smoke",
    srcs = ["unwind_smoke.rs"],
    platform = ":wasm32_unwind",
    tags = ["manual"],
)

rust_nesting_test(
    name = "nesting_test",
    srcs = ["unwind_smoke.rs"],
)

rust_comments_test(
    name = "comments_test",
    srcs = ["unwind_smoke.rs"],
)

rust_lint_tests(
    targets = ["unwind_smoke"],
)

     return config
 
+# Kitesurf resolves patched crates from pinned registry sources instead of local paths.
+def _kitesurf_patched_crates(module_ctx, cfg):
+    if not getattr(cfg, "manifests", None):
+        return {}
+    spec = module_ctx.path(cfg.manifests[0]).dirname.get_child("patched.json")
+    return json.decode(module_ctx.read(spec)) if spec.exists else {}
+
+def _kitesurf_registry_lock(module_ctx, lock, patched):
+    lines, in_package, name = [], False, None
+    for line in module_ctx.read(lock).splitlines():
+        lines.append(line)
+        if line.startswith("["):
+            in_package, name = line == "[[package]]", None
+        elif in_package and line.startswith("name = "):
+            name = line[len("name = "):].strip('"')
+        elif in_package and line.startswith("version = "):
+            crate = patched.get("%s %s" % (name, line[len("version = "):].strip('"')))
+            if crate:
+                lines.append('source = "registry+https://github.com/rust-lang/crates.io-index"')
+                lines.append('checksum = "%s"' % crate["sha256"])
+    module_ctx.file(lock, "\n".join(lines) + "\n")
+

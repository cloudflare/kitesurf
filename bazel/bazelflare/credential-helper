# Bazel's credential helper for --config=bazelflare: a GitHub Actions job's OIDC token, or else the
# Cloudflare Access token cloudflared holds for bazelflare, which verifies either itself.
set -euo pipefail
export PATH=${PATH:+$PATH:}/usr/local/bin:/usr/bin:/bin:${HOME:-}/.local/bin:/opt/homebrew/bin # Bazel may strip PATH

ACCESS_APP=https://bazelflare.kitesurf.workers.dev
OIDC_AUDIENCE=bazelflare-kitesurf

[[ ${1:-} == get ]] || { echo "usage: $0 get" >&2; exit 2; }
cat >/dev/null # every bazelflare URI takes the same credentials

if [[ -n ${ACTIONS_ID_TOKEN_REQUEST_URL:-} ]]; then
  token=$(curl -fsS --retry 3 -H "Authorization: bearer $ACTIONS_ID_TOKEN_REQUEST_TOKEN" \
    "$ACTIONS_ID_TOKEN_REQUEST_URL&audience=$OIDC_AUDIENCE" | sed -n 's/.*"value" *: *"\([^"]*\)".*/\1/p')
  header=authorization value="Bearer $token"
else
  command -v cloudflared >/dev/null || { echo "bazelflare needs cloudflared for an Access login" >&2; exit 1; }
  # Bazel runs this with no terminal, so a login it would open could never be approved; logging in
  # is left to the person, once, at a terminal.
  token=$(cloudflared access token -app="$ACCESS_APP" 2>/dev/null) || {
    echo "Log in to bazelflare first: cloudflared access login $ACCESS_APP" >&2
    exit 1
  }
  header=cf-access-token value=$token
fi
[[ $token == *.*.* ]] || { echo "bazelflare: no token" >&2; exit 1; }

# The token's exp less a minute, so Bazel asks for a new token before this one lapses; without an
# exp claim, in four minutes.
payload=$(cut -d. -f2 <<<"$token" | tr '_-' '/+')
while ((${#payload} % 4)); do payload+='='; done
exp=$(base64 -d <<<"$payload" 2>/dev/null | sed -n 's/.*"exp" *: *\([0-9]*\).*/\1/p')
expires=$((${exp:-$(($(date +%s) + 300))} - 60))
expires=$(date -u -d "@$expires" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -r "$expires" +%Y-%m-%dT%H:%M:%SZ)

printf '{"headers":{"%s":["%s"]},"expires":"%s"}\n' "$header" "$value" "$expires"

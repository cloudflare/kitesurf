+++ b/kitesurf_host_config.js
@@ -0,0 +1,8 @@
+// Turns on DevTools features that the hosted-mode stub leaves off. The stub merges only
+// globalThis.hostConfigForTesting into hostConfig, which DevTools reads as it boots, so this is a
+// classic script ahead of the module. Not ?isChromeForTesting: it drops the self-XSS paste warning.
+// Protocol Monitor (More tools) only shows the CDP traffic the frontend already exchanges.
+globalThis.hostConfigForTesting = {
+  ...globalThis.hostConfigForTesting,
+  devToolsProtocolMonitor: { enabled: true },
+};

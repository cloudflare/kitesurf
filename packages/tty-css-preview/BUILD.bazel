load("@aspect_rules_js//js:defs.bzl", "js_test")
load("//bazel:checks.bzl", "node_test", "workspace_configs")

_CHECKED = [
    "extension/background.js",
    "extension/content.js",
    "extension/popup.js",
    "extension/scroll.js",
    "extension/snap.js",
    "extension/update.js",
    "src/server.mjs",
]

[
    js_test(
        name = "check_" + source.replace("/", "_").replace(".", "_"),
        size = "small",
        data = ["package.json"],
        entry_point = source,
        node_options = ["--check"],
    )
    for source in _CHECKED
]

test_suite(
    name = "checks",
    tests = [
        ":check_" + source.replace("/", "_").replace(".", "_")
        for source in _CHECKED
    ] + [":test"],
    visibility = ["//:__pkg__"],
)

node_test(
    name = "test",
    args = ["test/*.test.mjs"],
    data = [
        "package.json",
        "//packages/engine:tty_stylesheets",
    ] + glob(["extension/**", "src/**", "test/**"]),
)

workspace_configs()

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kitesurf",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",

  "compatibility_flags": ["global_fetch_strictly_public"],

  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.glue.js", "**/*.css"],
      "fallthrough": true,
    },
  ],

  "observability": {
    "enabled": true,
  },

  "limits": {
    "cpu_ms": 300000,
    "subrequests": 1000000,
  },

  "vars": {
    "KITESURF_ENV": "production",
    "KITESURF_VERSION": "dev",
    "KITESURF_RESOURCE_DRAIN_QUIET_TURNS": "",
    "KITESURF_SIMULATE_PROD_EVAL": "",
    "KITESURF_DISABLE_PARTIAL_RASTER": "",
    "KITESURF_PAGE_CPU_MS_CAP": "",
    "KITESURF_PAGE_WALL_MS_CAP": "",
    "KITESURF_LAG_WATCHDOG": "",
    // DevTools frontend for the landing page, `/?url=` and `/json/list`. It must accept
    // `?wss=<endpoint>` or `?ws=<endpoint>`. Empty disables the web shortcut; Chrome
    // discovery falls back to its bundled frontend. A `--config=devtools` build serves
    // a same-origin copy: set the path `/inspector/inspector.html`.
    "KITESURF_INSPECTOR_BASE_URL": "",
    // Replaces a path base that the assets do not have (src/inspector.ts). Empty: no fallback.
    "KITESURF_INSPECTOR_FALLBACK_URL": "",
    // Web Bot Auth: origin of the key directory that publishes the public
    // half of the WEB_BOT_AUTH_JWK secret. Empty disables signing.
    "WEB_BOT_AUTH_SIGNATURE_AGENT": "",
  },

  "worker_loaders": [{ "binding": "LOADER" }],

  "assets": {
    "directory": "./public",
    "binding": "FONT_ASSETS",
    "run_worker_first": ["/", "/rbi/*"],
  },

  "env": {
    "local": {
      // Envs do not inherit the top-level vars, and wrangler dev warns about each one an env
      // leaves off. The engine reads "" the same as unset, so the empty ones only quiet that.
      "vars": {
        "KITESURF_ENV": "local",
        "KITESURF_VERSION": "dev",
        "KITESURF_RESOURCE_DRAIN_QUIET_TURNS": "5",
        "KITESURF_SIMULATE_PROD_EVAL": "",
        "KITESURF_DISABLE_PARTIAL_RASTER": "",
        "KITESURF_PAGE_CPU_MS_CAP": "",
        "KITESURF_PAGE_WALL_MS_CAP": "",
        "KITESURF_LAG_WATCHDOG": "1",
        // The same-origin copy when a --config=devtools build staged it, else Chrome's hosted
        // frontend at Chrome 156.0.8078.47 (chromiumdash `hashes.chromium`). The hosted CSP
        // allows only `ws://127.0.0.1:*`, and Chrome asks once to allow access to this device.
        "KITESURF_INSPECTOR_BASE_URL": "/inspector/inspector.html",
        "KITESURF_INSPECTOR_FALLBACK_URL": "https://chrome-devtools-frontend.appspot.com/serve_rev/@1d17a2e2ee147bb7d6ae2ab6abdb3a2510c17775/inspector.html",
        "WEB_BOT_AUTH_SIGNATURE_AGENT": "",
        "KITESURF_OTLP_ENDPOINT": "http://localhost:4318/v1/traces",
      },
      "worker_loaders": [{ "binding": "LOADER" }],
      "services": [{ "binding": "FIXTURES", "service": "kitesurf-fixtures" }],
    },
  },
}

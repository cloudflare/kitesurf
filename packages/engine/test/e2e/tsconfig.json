{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["@types/node", "@cloudflare/vitest-plugin/types"]
  },
  // Top-level e2e specs; demos/ has its own, non-strict tsconfig. The

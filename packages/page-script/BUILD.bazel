load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@npm//packages/page-script:typescript/package_json.bzl", tsc = "bin")
load("//bazel:checks.bzl", "node_test", "tsc_test", "workspace_configs")

npm_link_all_packages(name = "node_modules")

js_library(
    name = "srcs",
    srcs = ["package.json", "tsconfig.json"] + glob(["src/**"]),
    deps = [
        ":node_modules/@kitesurf/dom-shim",
        ":node_modules/@kitesurf/jsrpc-types",
        ":node_modules/@kitesurf/script-gate",
        ":node_modules/fake-indexeddb",
    ],
    visibility = [
        "//packages/engine:__pkg__",
        "//packages/engine/test/e2e:__pkg__",
    ],
)

js_library(
    name = "internal_state",
    srcs = ["src/internal-state.ts"],
    deps = [":node_modules/@kitesurf/jsrpc-types"],
    visibility = ["//packages/dom-shim:__pkg__"],
)

js_binary(
    name = "build_tool",
    data = [":node_modules/esbuild", "//scripts:declaration_twin_guard"],
    entry_point = "scripts/build.mjs",
)

js_run_binary(
    name = "dist",
    srcs = [":srcs"],
    out_dirs = ["dist"],
    chdir = package_name(),
    mnemonic = "PageScriptBuild",
    progress_message = "Bundling page-script",
    tool = ":build_tool",
)

js_library(
    name = "pkg",
    srcs = [":dist"],
    deps = [":srcs"],
    visibility = ["//visibility:public"],
)

tsc_test(
    name = "types",
    bin = tsc,
    data = [
        ":srcs",
        "//:node_modules/@cloudflare/workers-types",
        "//packages/core/pkg",
    ],
)

node_test(
    name = "test",
    args = ["test/*.test.mjs"],
    data = [":srcs"] + glob(["test/**"]),
    env = {"NODE_OPTIONS": "--experimental-vm-modules"},
)

build_test(name = "build", targets = [":dist"])
workspace_configs()

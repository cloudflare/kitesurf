{
  "name": "@kitesurf/page-script",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "In-isolate PageScript entrypoint authored as TypeScript, bundled to a string for Worker Loader injection.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./event-source": "./src/event-source.ts",
    "./fetch-shim": "./src/fetch-shim.ts",
    "./message-channel": "./src/message-channel.ts",
    "./session-outbound": "./src/session-outbound.ts",
    "./shared-memory": "./src/shared-memory.ts",
    "./source-scan": "./src/source-scan.ts",
    "./state": "./src/state.ts",
    "./tail-channel": "./src/tail-channel.ts",
    "./trusted-fetch": "./src/trusted-fetch.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "@kitesurf/dom-shim": "workspace:*",
    "@kitesurf/jsrpc-types": "workspace:*",
    "@kitesurf/script-gate": "workspace:*",
    "fake-indexeddb": "^6.2.5"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "typescript": "^5.6.0"
  }
}

{
  "name": "@kitesurf/dom-shim",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "In-sandbox DOM shim authored as TypeScript, bundled to a string for Worker Loader injection.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./html-encoding": "./src/html-encoding.ts",
    "./contract": "./src/contract.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "types": "tsc --noEmit && pnpm run types:strict",
    "types:strict": "node ../../scripts/ts-strict-ratchet.mjs --project tsconfig.strict.json --baseline strict-baseline.json",
    "types:strict:update": "node ../../scripts/ts-strict-ratchet.mjs --project tsconfig.strict.json --baseline strict-baseline.json --update"
  },
  "dependencies": {
    "@kitesurf/jsrpc-types": "workspace:*",
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "typescript": "^5.6.0",
    "vite": "^8.1.6",
    "vitest": "^4.1.7",
    "webmcp-types": "^0.1.5"
  }
}

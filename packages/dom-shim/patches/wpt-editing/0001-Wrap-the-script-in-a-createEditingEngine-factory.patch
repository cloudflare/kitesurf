From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rui Figueira <rfigueira@cloudflare.com>
Date: Sat, 26 Sep 2026 13:27:43 +0100
Subject: [PATCH] Wrap the script in a createEditingEngine factory

Upstream is a classic script that reads document, getSelection,
getComputedStyle and Node as page globals and defines its commands as
globals too. dom-shim imports it as a module instead: the shim passes
in its own document, getSelection, getComputedStyle and Node constants,
so page JS that shadows a global can't redirect the engine, and every
command table and override lives in the closure of one document.

The factory returns the six Document methods the shim delegates to.
---
 editing/include/implementation.js | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/editing/include/implementation.js b/editing/include/implementation.js
index 44a7afd..0eac1ca 100644
--- a/editing/include/implementation.js
+++ b/editing/include/implementation.js
@@ -1,3 +1,7 @@
+// Generated by packages/dom-shim/scripts/editing-implementation.mjs from
+// WPT editing/include/implementation.js. Do not edit: change the patches in
+// packages/dom-shim/patches/wpt-editing/ instead.
+export function createEditingEngine(document, getSelection, getComputedStyle, Node) {
 "use strict";
 
 var htmlNamespace = "http://www.w3.org/1999/xhtml";
@@ -8524,3 +8528,13 @@ commandNames.forEach(function(command) {
 //@}
 
 // vim: foldmarker=@{,@} foldmethod=marker
+
+return {
+    execCommand: myExecCommand,
+    queryCommandEnabled: myQueryCommandEnabled,
+    queryCommandIndeterm: myQueryCommandIndeterm,
+    queryCommandState: myQueryCommandState,
+    queryCommandSupported: myQueryCommandSupported,
+    queryCommandValue: myQueryCommandValue,
+};
+}

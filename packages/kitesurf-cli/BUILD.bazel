load("@crates_cli//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "cargo_toml_env_vars")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//bazel:checks.bzl", "workspace_configs")
load("//bazel:rust_checks.bzl", "rust_comments_test", "rust_lint_tests", "rust_nesting_test")

exports_files([
    "Cargo.lock",
    "Cargo.toml",
])

cargo_toml_env_vars(
    name = "cargo_env",
    src = "Cargo.toml",
)

rust_library(
    name = "kitesurf_playback",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(normal = True, proc_macro = True),
    crate_name = "kitesurf_playback",
    crate_root = "src/lib.rs",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env_files = [":cargo_env"],
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "lib_test",
    size = "medium",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(
        normal = True,
        normal_dev = True,
        proc_macro = True,
        proc_macro_dev = True,
    ),
    crate_name = "kitesurf_playback",
    crate_root = "src/lib.rs",
    data = [
        "//packages/engine:rbi_json",
        "//packages/engine:rbi_wasm",
    ],
    edition = "2021",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = {"CARGO_MANIFEST_DIR": package_name()},
    rustc_env_files = [":cargo_env"],
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "bin_test",
    size = "medium",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(
        normal = True,
        normal_dev = True,
        proc_macro = True,
        proc_macro_dev = True,
    ),
    crate_name = "kitesurf",
    crate_root = "src/main.rs",
    edition = "2021",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    rustc_env = {"CARGO_MANIFEST_DIR": package_name()},
    rustc_env_files = [":cargo_env"],
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [":kitesurf_playback"],
)

workspace_configs()

rust_nesting_test(
    name = "nesting_test",
    srcs = glob(["src/**/*.rs"]),
)

rust_comments_test(
    name = "comments_test",
    srcs = glob(["src/**/*.rs"]),
)

rust_lint_tests(
    targets = ["kitesurf_playback", "lib_test", "bin_test"],
)

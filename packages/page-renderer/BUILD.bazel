load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@npm//packages/page-renderer:typescript/package_json.bzl", tsc = "bin")
load("//bazel:checks.bzl", "tsc_test", "workspace_configs")

npm_link_all_packages(name = "node_modules")

js_library(
    name = "srcs",
    srcs = ["package.json", "tsconfig.json"] + glob(["src/**"]),
    deps = [":node_modules/@kitesurf/jsrpc-types"],
)

js_binary(
    name = "build_tool",
    data = [":node_modules/esbuild", "//scripts:declaration_twin_guard"],
    entry_point = "scripts/build.mjs",
)

js_run_binary(
    name = "dist",
    srcs = [":srcs"],
    out_dirs = ["dist"],
    chdir = package_name(),
    mnemonic = "PageRendererBuild",
    progress_message = "Bundling page-renderer",
    tool = ":build_tool",
)

js_library(
    name = "pkg",
    srcs = [":dist"],
    deps = [":srcs"],
    visibility = ["//visibility:public"],
)

tsc_test(
    name = "types",
    bin = tsc,
    data = [
        ":srcs",
        "//:node_modules/@cloudflare/workers-types",
    ] + glob(["test/**"]),
)

build_test(name = "build", targets = [":dist"])
workspace_configs()

load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "cargo_toml_env_vars")
load("@rules_rust//rust:defs.bzl", "rust_shared_library", "rust_test")
load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//bazel:executors.bzl", "RUST")
load("//bazel:rust_checks.bzl", "rust_comments_test", "rust_lint_tests", "rust_nesting_test")

exports_files(
    ["Cargo.toml"],
    visibility = ["//:__pkg__"],
)
exports_files([".cargo/config.toml"])

cargo_toml_env_vars(
    name = "cargo_env",
    src = "Cargo.toml",
    visibility = ["//packages/renderer-core:__pkg__"],
)

[
    rust_shared_library(
        name = name,
        srcs = glob(["src/**/*.rs"]),
        aliases = aliases(),
        crate_features = ["blitz", "console_error_panic_hook", "default", "pdf"],
        crate_name = "kitesurf_core",
        crate_root = "src/lib.rs",
        edition = "2021",
        platform = platform,
        proc_macro_deps = all_crate_deps(proc_macro = True),
        rustc_env_files = [":cargo_env"],
        rustc_flags = ["--crate-type=rlib"],
        tags = ["manual"],
        visibility = ["//packages/core/pkg:__pkg__"],
        deps = all_crate_deps(normal = True),
    )
    for name, platform in [
        ("kitesurf_core", "//bazel/rust:wasm32_unwind"),
        ("kitesurf_core_memprof", "//bazel/rust:wasm32_memprof"),
    ]
]

filegroup(
    name = "renderer_shared_srcs",
    srcs = [
        "src/ks_tracing.rs",
        "src/paint/font_container.rs",
        "src/paint/pdf_paint.rs",
        "src/paint/scene_decode.rs",
        "src/paint/scene_record.rs",
        "src/paint/scene_replay.rs",
        "src/paint/screenshot.rs",
    ],
    visibility = ["//packages/renderer-core:__pkg__"],
)

rust_test(
    name = "core_test",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(
        normal = True,
        normal_dev = True,
        proc_macro = True,
        proc_macro_dev = True,
    ),
    compile_data = glob(["tests_data/**"]) + ["//packages/engine:fonts"],
    crate_features = ["blitz", "console_error_panic_hook", "default", "pdf"],
    crate_name = "kitesurf_core",
    crate_root = "src/lib.rs",
    data = [
        "//packages/engine:fixture_assets",
        "//packages/engine:fonts",
        "//packages/engine:package.json",
    ],
    edition = "2021",
    # CARGO_MANIFEST_DIR below resolves only in the main repository; see src/test_assets.rs.
    env = {"KITESURF_ENGINE_PACKAGE_JSON": "$(rootpath //packages/engine:package.json)"},
    exec_properties = RUST,
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    rustc_env = {"CARGO_MANIFEST_DIR": package_name()},
    rustc_env_files = [":cargo_env"],
    deps = all_crate_deps(normal = True, normal_dev = True),
)

# A separate process keeps other core tests' font registrations from clearing the cache.
rust_test(
    name = "svg_cache_test",
    srcs = ["tests/svg_cache.rs"],
    edition = "2021",
    exec_properties = RUST,
    deps = ["@crates//:blitz-dom"],
)

rust_test(
    name = "blitz_dom_child_lists_test",
    srcs = ["tests/blitz_dom_child_lists.rs"],
    edition = "2021",
    exec_properties = RUST,
    deps = ["@crates//:blitz-dom"],
)

rust_test(
    name = "blitz_dom_undisplayed_layout_test",
    crate = "@crates//:blitz-dom",
    crate_features = ["svg", "floats", "woff"],
    args = [
        "nested_slot_edges_visit_each_reachable_node_once_and_release_layout",
        "display_none_retention_tests",
        "compact_node_tests",
        "rare_tests",
        "attribute_names_round_trip_and_match_exactly",
        "node_data_stays_four_words",
        "opaque_ids_follow_slot_reuse_and_reject_free_slots",
        "cloning_an_element_discards_derived_text_layouts",
        "node::attributes::tests",
        "node::child_list::tests",
        "node::stylo_data::tests",
        "pool::tests",
        "tree::tests",
        "mutator::test",
    ],
    exec_properties = RUST,
)

rust_test(
    name = "blitz_traits_node_id_test",
    crate = "@crates//:blitz-traits",
    args = ["halves_round_trip_and_hash_order_like_the_raw_u64"],
    exec_properties = RUST,
)

rust_test(
    name = "taffy_cache_test",
    srcs = ["tests/taffy_cache.rs"],
    edition = "2021",
    exec_properties = RUST,
    deps = ["@crates//:taffy"],
)

rust_test(
    name = "boa_gc_test",
    crate = "@crates__boa_gc-0.22.0//:boa_gc",
)

rust_test(
    name = "boa_interner_test",
    crate = "@crates__boa_interner-0.22.0//:boa_interner",
)

rust_test(
    name = "vello_common_test",
    crate = "@crates__vello_common-0.3.0//:vello_common",
    # rust_test does not inherit the library's features, and the crate needs std or libm.
    crate_features = ["std"],
)

build_test(
    name = "vello_cpu_fallback_test",
    targets = ["@crates__vello_cpu-0.3.0//:vello_cpu_fallback"],
)

test_suite(
    name = "host_tests",
    tests = [
        ":blitz_dom_child_lists_test",
        ":blitz_dom_undisplayed_layout_test",
        ":blitz_traits_node_id_test",
        ":boa_gc_test",
        ":boa_interner_test",
        ":core_test",
        ":svg_cache_test",
        ":taffy_cache_test",
        ":vello_common_test",
        ":vello_cpu_fallback_test",
    ],
)

filegroup(
    name = "scene_host_srcs",
    srcs = [
        "src/paint/font_container.rs",
        "src/paint/scene_decode.rs",
        "src/paint/scene_record.rs",
        "src/paint/scene_replay.rs",
        "src/paint/screenshot.rs",
        "src/tty/grid.rs",
    ],
    visibility = ["//packages/scene-host-wasm:__pkg__"],
)

copy_to_bin(
    name = "scene_record_rs",
    srcs = ["src/paint/scene_record.rs"],
    visibility = ["//packages/scene-host-wasm:__pkg__"],
)

rust_nesting_test(
    name = "nesting_test",
    srcs = glob(["src/**/*.rs", "tests/**/*.rs"]),
)

rust_comments_test(
    name = "comments_test",
    srcs = glob(["src/**/*.rs", "tests/**/*.rs"]),
)

rust_lint_tests(
    targets = [
        "blitz_dom_child_lists_test",
        "core_test",
        "kitesurf_core",
        "kitesurf_core_memprof",
        "svg_cache_test",
        "taffy_cache_test",
    ],
)

node_modules
# pnpm store, relocated into the repo in CI (npm_config_store_dir) so the
# CI cache can persist it; never present in a normal local checkout.
.pnpm-store/
# CI keeps CARGO_HOME and XDG_CACHE_HOME in the project so GitLab can cache them.
/.cargo/
/.cache/
# CI job artifacts unpacked into the checkout.
/output/
/artifacts-metadata.json
.turbo/
.wrangler/
# Generated by `wrangler types` from wrangler.jsonc. Regenerated on
# every `npm run types` (and on every `npm run dev`/`deploy` via the
# prebuild → types chain). Don't commit; treat as derived output.
worker-configuration.d.ts
dist/
target/
*.log
.DS_Store
.env
.env.*
!.env.example
# wasm-pack output. Regenerated by `npm run build:wasm` (in the
# repo root), which runs `wasm-pack build` + a small post-pass that
# copies the JS glue to a `.glue.js` text-import twin and emits its
# .d.ts companion. Reviewers need a Rust toolchain + wasm-pack to
# rebuild — see README.md "First-time setup".
# Keep package.json and Bazel metadata as inputs, ignoring generated wasm/js/.d.ts.
# package.json makes packages/core/pkg resolvable as workspace:* before a Wasm build.
packages/core/pkg/*
!packages/core/pkg/package.json
!packages/core/pkg/BUILD.bazel

# Bazel output and execution-root symlinks are local build artifacts.
/bazel-*
/.wasm-licenses/
# WPT editing reference implementation, fetched from a pinned WPT commit
# and patched by packages/dom-shim/scripts/editing-implementation.mjs.
packages/dom-shim/src/editing/implementation.js

# Generated renderer-core wasm and glue, and the scene-host wasm staged into
# the engine public dir. Both come from the wasm build. Cargo.lock IS committed.
packages/renderer-core/pkg/
packages/engine/public/rbi/

# Web Platform Tests checkout (shallow clone via `npm run wpt:setup`).
.wpt/
# Local WPT run reports. wpt-batched writes dated snapshots here unless it
# runs with --no-record.
.wpt-reports/

# playwright checkout (tag-pinned shallow clone via `pnpm run pw:setup`).
.playwright/

# slop
**/PLAN*.md
**/FINDINGS*.md
**/TODO*.md

# local secrets (never committed)
.secrets/

# e2e harness pre-built engine bundle (regenerated by globalSetup)
packages/engine/test/e2e/.engine-dist/
packages/engine/test/e2e/.fixtures-dist/
**/test/fixtures-worker/.fixtures-dist/

# Scratch vendored trees, except the vendored sources we track.
/vendor/*
!/vendor/wasm-memprof/

# Local Bazel flags, read by .bazelrc.
.bazelrc.user

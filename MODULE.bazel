rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    extra_target_triples = [],
    rustfmt_version = RUST_NIGHTLY,
    sha256s = RUST_NIGHTLY_SHA256S,
    versions = [RUST_NIGHTLY],
)
use_repo(rust, "rust_toolchains")
use_repo(
    rust,
    rust_exec_linux_aarch64 = "rust_linux_aarch64__aarch64-unknown-linux-gnu__nightly_tools",
    rust_exec_linux_x86_64 = "rust_linux_x86_64__x86_64-unknown-linux-gnu__nightly_tools",
    rust_exec_macos_aarch64 = "rust_macos_aarch64__aarch64-apple-darwin__nightly_tools",
)

# Repository rules (cargo update, crate_universe) run on the Bazel client's host, not its
# execution platform, and therefore still use host-specific tools.
rust_host_tools = use_extension("@rules_rust//rust:extensions.bzl", "rust_host_tools")
rust_host_tools.host_tools(
    name = "rust_tools",
    rustfmt_version = RUST_NIGHTLY,
    sha256s = RUST_NIGHTLY_SHA256S,
    version = RUST_NIGHTLY,
)
use_repo(rust_host_tools, "rust_tools")

register_execution_platforms(
    "@platforms//host",
    "//bazel/rust:rust_exec",
)

register_toolchains(
    # One wasm32 toolchain per flavour and supported host (bazel/rust/wasm32.bzl).
    "//bazel/rust:wasm32_unwind_linux_x86_64_toolchain",
    "//bazel/rust:wasm32_unwind_linux_aarch64_toolchain",
    "//bazel/rust:wasm32_unwind_macos_aarch64_toolchain",
    "//bazel/rust:wasm32_scene_host_linux_x86_64_toolchain",
    "//bazel/rust:wasm32_scene_host_linux_aarch64_toolchain",
    "//bazel/rust:wasm32_scene_host_macos_aarch64_toolchain",
    "//bazel/rust:wasm32_memprof_linux_x86_64_toolchain",
    "//bazel/rust:wasm32_memprof_linux_aarch64_toolchain",
    "//bazel/rust:wasm32_memprof_macos_aarch64_toolchain",
    "@rust_toolchains//:all",
)


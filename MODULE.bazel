"""Public Kitesurf build and test graph."""

module(name = "kitesurf")

bazel_dep(name = "aspect_rules_js", version = "3.5.1")
bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_nodejs", version = "6.7.6")
bazel_dep(name = "rules_rust", version = "0.74.0")

# Patched registry crates are downloaded and patched by Bazel rather than copied from Cargo paths.
single_version_override(
    module_name = "rules_rust",
    patch_strip = 1,
    patches = ["//bazel/rust:rules_rust-patched-crates.patch"],
    version = "0.74.0",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    extra_target_triples = [],
    rustfmt_version = "nightly/2026-05-14",
    sha256s = {
        "2026-05-14/cargo-nightly-x86_64-unknown-linux-gnu.tar.xz":
            "988cfdd39920fbccaf37ee48b4927fce02a566bbbdd687556669258b9679a5f8",
        "2026-05-14/clippy-nightly-x86_64-unknown-linux-gnu.tar.xz":
            "e94a424c323a2fdd61b57a15194b7fb8c539b472e2ac855f32d730953004deb9",
        "2026-05-14/llvm-tools-nightly-x86_64-unknown-linux-gnu.tar.xz":
            "8cb583a454d08eaa4d8ad0c5c82c45cd9c3f914d38836828fd9ff18bc40283cc",
        "2026-05-14/rust-std-nightly-x86_64-unknown-linux-gnu.tar.xz":
            "52c8cff09e19a8c08030d05f9ae26012ad488ad05850637311adb98df562b483",
        "2026-05-14/rustc-nightly-x86_64-unknown-linux-gnu.tar.xz":
            "889e0b0b8eefa198c8065b2786879bc451771e538f118e252b09bb1af6293a12",
        "2026-05-14/rustfmt-nightly-x86_64-unknown-linux-gnu.tar.xz":
            "426d37ab8a185c3278b13a7dfef7a64149d65f624a9410573bb3003814bfdc43",
    },
    versions = ["nightly/2026-05-14"],
)
use_repo(
    rust,
    "rust_toolchains",
    rust_tools = "rust_linux_x86_64__x86_64-unknown-linux-gnu__nightly_tools",
)

register_execution_platforms(
    "@platforms//host",
    "//bazel/rust:rust_exec",
)

register_toolchains(
    "//bazel/rust:wasm32_unwind_toolchain",
    "//bazel/rust:wasm32_scene_host_toolchain",
    "@rust_toolchains//:all",
)

cargo_workspaces = use_extension("//bazel/rust:crates.bzl", "cargo_workspaces")
cargo_workspaces.patched(
    manifest = "//:Cargo.toml",
    patches_marker = "//scripts:patches/README.md",
    sha256 = {
        "anyrender-0.14.0": "1755d0ef8e00e87b6b825dfbe5a35d34d3b302e97e80a48e93f9cd361fbada06",
        "anyrender_vello_cpu-0.18.0":
            "a09d9356dd2b2f032345711a350c0e2326a854cb5070f899265bc80fb33884b1",
        "blitz-dom-0.3.0-beta.3":
            "53e58a506e20e90b69ab8b03f933c125237361c31b0dae0e7e149c5bcbf9b28a",
        "blitz-html-0.3.0-beta.3":
            "0bf860f5757da5c14a2cb986987d2be392e9abc9e2a42d815a699649f08a7cee",
        "blitz-paint-0.3.0-beta.3":
            "31dd8929dd745efd8ada25f977a163b4c17fd8e9804cb7f42441df63215d2fdd",
        "boa_ast-0.22.0": "9221b0a090572b4a118b46c5874c0781fe4bc9546b85f0a615b8bfb609ca4ed7",

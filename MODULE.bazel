        "ratatui-image-8.1.1": "3ecc67e9f7d0ac69e0f712f58b1a9d5a04d8daeeb3628f4d6b67580abb88b7cb",
        "selectors-0.41.0": "8322aebea94a6cc288ff884e8a49bdbceef60206c400c6c46d22e62fc4fd91a6",
        "stylo-0.22.0": "7a255e46af2478628c48daab3774090caabd7812b1dd3ca98801c2b9c53491ed",
        "stylo_taffy-0.3.0-beta.3":
            "58d910649e40ac76167e51da4692180beadba181581b26d501024a132772f5a3",
        "taffy-0.15.0": "3c8480887e8803986d96a7173729565520d4bbb721ad6b7ad6941a22897207aa",
        "usvg-0.48.1": "977d0a4abdef933f424a99fe09f95576e089b90aebc6f016a3bc813762493e91",
        "vello_cpu-0.3.0": "ed1fec424fbba6acf6cbc78bb526447eb77590d95f40419d598870fe37535212",
    },
)
cargo_workspaces.workspace(
    name = "cargo_ws_core",
    lockfile = "//:Cargo.lock",
    members = {"packages/core": "//packages/core:Cargo.toml"},
)
cargo_workspaces.workspace(
    name = "cargo_ws_renderer",
    lockfile = "//:Cargo.lock",
    members = {"packages/renderer-core": "//packages/renderer-core:Cargo.toml"},
)
cargo_workspaces.workspace(
    name = "cargo_ws_scene_host",
    lockfile = "//:Cargo.lock",
    members = {"packages/scene-host-wasm": "//packages/scene-host-wasm:Cargo.toml"},
)
cargo_workspaces.vendor(
    name = "cargo_vendor",
    lockfile = "//:Cargo.lock",
)
use_repo(
    cargo_workspaces,
    "cargo_vendor",
    "cargo_ws_core",
    "cargo_ws_renderer",
    "cargo_ws_scene_host",
)

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "@cargo_ws_core//:Cargo.lock",
    host_tools = "@rust_tools",
    manifests = ["@cargo_ws_core//:Cargo.toml"],
    skip_cargo_lockfile_overwrite = True,
    supported_platform_triples = [
        "wasm32-unknown-unknown",
        "x86_64-unknown-linux-gnu",
    ],
)
crate.from_cargo(
    name = "crates_renderer",
    cargo_lockfile = "@cargo_ws_renderer//:Cargo.lock",
    host_tools = "@rust_tools",
    manifests = ["@cargo_ws_renderer//:Cargo.toml"],
    skip_cargo_lockfile_overwrite = True,
    supported_platform_triples = [
        "wasm32-unknown-unknown",
        "x86_64-unknown-linux-gnu",
    ],
)
crate.from_cargo(
    name = "crates_scene_host",
    cargo_lockfile = "@cargo_ws_scene_host//:Cargo.lock",
    host_tools = "@rust_tools",
    manifests = ["@cargo_ws_scene_host//:Cargo.toml"],
    skip_cargo_lockfile_overwrite = True,
    supported_platform_triples = [
        "wasm32-unknown-unknown",
        "x86_64-unknown-linux-gnu",
    ],
)

crate.annotation(
    crate = "write-fonts",
    repositories = [
        "crates",
        "crates_renderer",
    ],
    rustc_flags = [
        "-Copt-level=0",
        "-Cdebug-assertions=off",
    ],
)
crate.annotation(
    build_script_env = {"PYTHON3": "/usr/bin/python3"},
    crate = "stylo",
    repositories = ["crates"],
)
crate.annotation(
    additive_build_file_content = """
rust_library(
    name = "vello_cpu_fallback",
    crate_features = ["std", "text", "u8_pipeline"],
    crate_name = "vello_cpu",
    crate_root = "src/lib.rs",
    deps = existing_rule("vello_cpu")["deps"],
    edition = existing_rule("vello_cpu")["edition"],
    rustc_env_files = [":cargo_toml_env_vars"],
    srcs = glob(["src/**/*.rs"]),
    tags = ["manual"],
)
""",
    crate = "vello_cpu",
    repositories = ["crates"],
)
use_repo(crate, "crates", "crates_renderer", "crates_scene_host")
use_repo(crate, "crates__boa_gc-0.22.0", "crates__boa_interner-0.22.0", "crates__vello_cpu-0.3.0")

wasm_std_repo = use_repo_rule("//bazel/rust:repos.bzl", "wasm_std_repo")
wasm_std_repo(
    name = "wasm32_unwind_std",
    cargo_config = "//packages/core:.cargo/config.toml",
    rust_src_sha256 = "7750e3173dcd2bff481518bebeb9118856bd38930445718477cc56bbb858fe9b",
    rust_src_url = "https://static.rust-lang.org/dist/2026-05-14/rust-src-nightly.tar.xz",
)

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.20.0")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    data = [
        "//:package.json",
        "//:pnpm-workspace.yaml",
        "//:packages/core/pkg/package.json",
        "//:packages/dom-shim/package.json",
        "//:packages/engine/package.json",
        "//:packages/jsrpc-types/package.json",
        "//:packages/kitesurf-cli/package.json",
        "//:packages/page-renderer/package.json",
        "//:packages/page-script/package.json",
        "//:packages/script-gate/package.json",
        "//:packages/tty-css-preview/package.json",
        "//:packages/worker-script/package.json",
    ],
    npmrc = "//:.npmrc",
    pnpm_lock = "//:pnpm-lock.yaml",
    public_hoist_packages = {
        "buffer": [""],
        "devtools-protocol@0.0.1669207": [""],
        "undici": [""],
        "zod@4.6.5": [""],
    },
)
use_repo(npm, "npm")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(pnpm_version_from = "//:package.json")
use_repo(pnpm, "pnpm")

tracked_files = use_repo_rule("//bazel:tracked_files.bzl", "tracked_files")
tracked_files(name = "tracked_files")

wpt_buckets = use_repo_rule("//tests/wpt:buckets_repo.bzl", "wpt_buckets")
wpt_buckets(
    name = "wpt_buckets",
    buckets = "//:tests/wpt-buckets.json",
    tests = "//:tests/wpt-tests.json",
)


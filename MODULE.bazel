wpt_editing = use_repo_rule("//packages/dom-shim:editing_repo.bzl", "wpt_editing")
wpt_editing(
    name = "wpt_editing",
    script = "//packages/dom-shim:scripts/editing-implementation.mjs",
)

# Root modules may provide typed string maps for these profiles; empty maps run locally.
executor_profiles = use_extension("//bazel:executor_profiles.bzl", "executor_profiles")
use_repo(executor_profiles, "kitesurf_executor_profiles")
